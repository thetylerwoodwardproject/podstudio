{
  "name": "podstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "dev:phone": "astro dev --host",
    "build": "astro check && astro build",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "preview": "node --disable-warning=ExperimentalWarning server/main.ts --https --host 0.0.0.0",
    "check": "astro check",
    "test": "node --test 'src/**/*.test.ts' 'server/**/*.test.ts'",
    "reset-password": "node --disable-warning=ExperimentalWarning server/cli.ts reset-password",
    "reset-2fa": "node --disable-warning=ExperimentalWarning server/cli.ts reset-2fa"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "^4.3.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
