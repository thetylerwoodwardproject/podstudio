{
  "name": "podstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Tyler Woodward (https://tylerwoodward.me)",
  "homepage": "https://github.com/thetylerwoodwardproject/podstudio",
  "scripts": {
    "dev": "astro dev",
    "dev:phone": "astro dev --host",
    "build": "astro check && astro build",
    "build:deploy": "astro build",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "preview": "node --disable-warning=ExperimentalWarning server/main.ts --https --host 0.0.0.0",
    "check": "astro check",
    "test": "node --test 'src/**/*.test.ts' 'server/**/*.test.ts'",
    "test:browser": "node --no-warnings tests/browser/run.mjs",
    "reset-password": "node --disable-warning=ExperimentalWarning server/cli.ts reset-password",
    "reset-2fa": "node --disable-warning=ExperimentalWarning server/cli.ts reset-2fa",
    "setup-link": "node --disable-warning=ExperimentalWarning server/cli.ts setup-link"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/svelte": "^9.0.1",
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@lucide/svelte": "^0.544.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "qrcode-generator": "^2.0.4",
    "svelte": "^5.57.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@internationalized/date": "^3.12.4",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright-core": "1.63.0",
    "shadcn-svelte": "^1.7.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
