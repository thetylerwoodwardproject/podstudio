---
import { statfsSync } from 'node:fs';
import { context } from '../../../server/context.ts';
import StatusDot from '@/components/ui/StatusDot.astro';

interface Props { active?: 'episodes' | 'manual' | 'settings'; }
const { active = 'episodes' } = Astro.props;
const ctx = context();
let pct: number | null = null;
try {
  const fs = statfsSync(ctx.config.data);
  pct = Math.round(((fs.blocks * fs.bsize - fs.bavail * fs.bsize) / (fs.blocks * fs.bsize)) * 100);
} catch {}
const link = (key: Props['active']) => key === active ? 'border border-border bg-control text-text' : 'text-text-2 hover:bg-control hover:text-text';
const nav = 'group flex h-9 items-center gap-2.5 rounded-md px-3 text-[13px]';
---

<aside class="hidden w-60 flex-none flex-col border-r border-divider bg-nav px-3 py-4 md:flex" aria-label="Main navigation">
  <div class="px-3 pb-3 text-[11px] font-medium text-text-3">Workspace</div>
  <nav class="space-y-1">
    <a href="/" aria-current={active === 'episodes' ? 'page' : undefined} class={`${nav} ${link('episodes')}`}>
      <svg class="size-4 flex-none text-text-2 transition-colors group-hover:text-text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      <span>Episodes</span>
    </a>
  </nav>
  <div class="mt-7 px-3 pb-3 text-[11px] font-medium text-text-3">Create</div>
  <nav class="space-y-1">
    <a href={active === 'episodes' ? '#new-episode' : '/'} data-open-new-episode={active === 'episodes' ? true : undefined} class={`${nav} text-text-2 hover:bg-control hover:text-text`}>
      <svg class="size-4 flex-none text-text-2 transition-colors group-hover:text-text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      <span>New episode</span>
    </a>
    <a href="/screens" class={`${nav} text-text-2 hover:bg-control hover:text-text`}>
      <svg class="size-4 flex-none text-text-2 transition-colors group-hover:text-text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 16 3-3 2 2 3-4 3 5"/></svg>
      <span>Screen references</span>
    </a>
  </nav>
  <div class="mt-7 px-3 pb-3 text-[11px] font-medium text-text-3">System</div>
  <nav class="space-y-1">
    <a href="/manual" aria-current={active === 'manual' ? 'page' : undefined} class={`${nav} ${link('manual')}`}>
      <svg class="size-4 flex-none text-text-2 transition-colors group-hover:text-text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H20v17H7.5A2.5 2.5 0 0 0 5 21.5z"/><path d="M5 4.5v17M8 6h8M8 10h8"/></svg>
      <span>Manual</span>
    </a>
    <a href="/settings/general" aria-current={active === 'settings' ? 'page' : undefined} class={`${nav} ${link('settings')}`}>
      <svg class="size-4 flex-none text-text-2 transition-colors group-hover:text-text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/><circle cx="12" cy="12" r="3.5"/></svg>
      <span>Settings</span>
    </a>
  </nav>
  <button type="button" data-signout class={`${nav} mt-auto text-text-2 hover:bg-control hover:text-text`}>
    <svg class="size-4 flex-none text-text-2 transition-colors group-hover:text-text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M10 5H5v14h5M14 8l4 4-4 4M9 12h9"/></svg>
    <span>Sign out</span>
  </button>
  <div class="mt-3 rounded-lg border border-border bg-surface p-3">
    <div class="flex items-center gap-2 text-[11px] font-medium text-text-3"><StatusDot variant="success" size="sm" /> <span>Storage</span></div>
    {pct === null ? <div class="mt-2 font-mono text-[13px] text-text-3">Checking…</div> : <div class="mt-2 font-mono text-[13px] tabular-nums text-text-2">{pct}% used</div>}
    {pct !== null && <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-track-off"><div class="h-full rounded-full bg-accent" style={`width:${Math.min(pct, 100)}%`}></div></div>}
    <a href="/settings/server" class="mt-3 inline-flex text-[12px] text-accent hover:underline">Manage storage</a>
  </div>
</aside>
