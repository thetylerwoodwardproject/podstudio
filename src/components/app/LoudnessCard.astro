---
/*
 * Loudness of the finished episode (optional, Settings → Recording): live
 * while the Tone preview plays, and after an export what the episode file
 * measured. Integrated, short-term and momentary loudness, range and true
 * peak; a momentary bar with the target; loudness over time on the
 * framework's graph. Driven by lib/loudness-view.ts.
 */
const tag = 'font-mono text-[11px] font-medium tracking-[0.06em] text-text-3 uppercase';
const stats = [
  { key: 'short', label: 'Short-term', unit: 'LUFS' },
  { key: 'momentary', label: 'Momentary', unit: 'LUFS' },
  { key: 'range', label: 'Range', unit: 'LU' },
  { key: 'peak', label: 'True peak', unit: 'dBTP' },
];
---

<section class="flex flex-col gap-3" data-loudness data-pub-options hidden>
  <div class="flex items-baseline justify-between gap-3">
    <h2 class="section-label">Loudness · the episode</h2>
    <span class={tag} data-loud-source></span>
  </div>
  <div class="flex min-w-0 flex-col gap-4 rounded-[14px] bg-surface p-5">
    <div class="grid grid-cols-2 items-end gap-4 sm:grid-cols-[minmax(0,1.4fr)_repeat(4,minmax(0,1fr))]">
      <div class="col-span-2 flex min-w-0 flex-col gap-1.5 sm:col-span-1">
        <span class={tag}>Integrated</span>
        <span class="font-mono text-[36px] leading-none font-medium tabular-nums whitespace-nowrap"><span data-loud-integrated>—</span><span class="text-[13px] font-normal text-text-2"> LUFS</span></span>
      </div>
      {
        stats.map((s) => (
          <div class="flex min-w-0 flex-col gap-1.5">
            <span class={tag}>{s.label}</span>
            <span class="font-mono text-[18px] leading-none tabular-nums whitespace-nowrap">
              <span {...{ [`data-loud-${s.key}`]: '' }}>—</span>
              <span class="text-[13px] text-text-2"> {s.unit}</span>
            </span>
          </div>
        ))
      }
    </div>
    <div class="relative h-2 rounded-full bg-meter-off" aria-hidden="true">
      <span class="absolute inset-y-0 left-0 w-0 rounded-full" data-loud-bar></span>
      <span class="absolute -inset-y-1 w-0.5 -translate-x-1/2 rounded-full bg-text" data-loud-tick></span>
    </div>
    <ul class="flex flex-wrap items-center gap-4 text-[12px] text-text-2">
      <li class="flex items-center gap-2"><span class="h-0.5 w-4 rounded-full bg-text"></span>Target <span class="font-mono whitespace-nowrap" data-loud-target>−16 LUFS</span></li>
      <li class="flex items-center gap-2"><span class="h-2 w-4 rounded-sm bg-[color-mix(in_oklab,var(--color-ok)_45%,transparent)]"></span>Within <span class="font-mono whitespace-nowrap">1 LU</span></li>
      <li class="flex items-center gap-2"><span class="h-0.5 w-4 rounded-full bg-text-2"></span>Short-term loudness</li>
    </ul>
    <div class="h-[200px] min-w-0" data-loud-plot></div>
    <p class="help" data-loud-note>Preview the tone, or export, to measure the episode.</p>
  </div>
</section>
