---
import Logo from '@/components/ui/Logo.astro';
import Avatar from '@/components/ui/Avatar.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import { user } from '@/data/mock';

export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
  /** Hide the account avatar when the slot supplies its own right side */
  avatar?: boolean;
}
const { crumbs, avatar = true } = Astro.props;
---

<header class="flex h-14 flex-none items-center justify-between gap-4 border-b border-divider px-5">
  <div class="flex min-w-0 items-center gap-5.5">
    <Logo />
    <Breadcrumb {crumbs} />
  </div>
  <slot name="center" />
  <div class="flex flex-none items-center gap-3.5">
    <slot />
    {
      avatar && (
        <a href="/settings/general" aria-label="Account settings">
          <Avatar initial={user.initial} />
        </a>
      )
    }
  </div>
</header>
