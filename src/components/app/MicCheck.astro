---
// Green room (6a layout): what to do on the left, a live mic check on the right, before a session.
import AppShell from '@/layouts/AppShell.astro';
import StatusRow from '@/components/ui/StatusRow.astro';
import Button from '@/components/ui/Button.astro';
import { episode as mockEpisode, lineStarts, scriptWords } from '@/data/mock';
import EpisodeData from '@/components/app/EpisodeData.astro';
import type { EpisodeData as Data } from '@/lib/episode-page';

interface Props {
  episode?: { id: string; label: string; fullTitle: string };
  data?: Data;
}
const { episode = mockEpisode, data } = Astro.props;
import Select from '@/components/ui/Select.astro';
import LevelMeter from '@/components/audio/LevelMeter.astro';

const ok = 'var(--color-ok)';
const base = `/episodes/${episode.id}`;

const c = {
  eyebrow: 'Host · Tyler',
  title: 'Green room',
  sub: `Get set for ${episode.fullTitle}. The recording screen keeps this meter, so you can check again there.`,
  steps: [
    ['Check your level', 'Talk at your normal volume. Your peaks should land in the target zone, −18 to −6 dBFS.'],
    ['Make a test recording', 'Say a few lines at your loudest and play them back. Listen for distortion, crackle or clicks.'],
    ['Read a line from the script', 'Voice follow should find it. If it doesn’t, open the voice check from the Heard box.'],
  ],
  inputs: ['Shure MV7 (USB)'],
  heard: '“It was a quiet week in the studio, until the new transmitter arrived.”',
  checks: [
    ['Level', 'Right on target', ok],
    ['Clipping', 'None in the last 30 s', ok],
    ['Noise floor', '-61 dBFS', ok],
    ['Voice follow', 'Matched line 1', ok],
    ['Free space', '5.1 GB · about 9 h', 'var(--color-warn)'],
    ['Test recording', 'Played back · right on target', ok],
  ],
  next: `${base}/recording`,
};
---

<AppShell title={c.title} avatar={false} crumbs={[{ label: episode.label, href: `${base}/studio` }, { label: 'Green room' }]}>
  {data && <EpisodeData data={data} />}

  <form
    class="grid lg:min-h-full lg:grid-cols-[1fr_400px]"
    id="mic-check"
    data-next={c.next}
    data-episode={episode.id}
    data-words={JSON.stringify(scriptWords)}
    data-line-starts={JSON.stringify(lineStarts)}
  >
    <!-- What to do -->
    <section class="flex flex-col gap-6 border-line px-6 py-10 lg:border-r lg:px-14">
      <div>
        <div class="eyebrow">{c.eyebrow}</div>
        <h1 class="mt-2 text-[28px] tracking-[-0.03em]">{c.title}</h1>
        <p class="mt-2 max-w-[520px] text-[14px] leading-[1.55] text-muted">{c.sub}</p>
      </div>

      <ol class="flex flex-col gap-4">
        {
          c.steps.map(([title, body], i) => (
            <li class="grid grid-cols-[28px_1fr] gap-3.5">
              <span class="flex size-6.5 items-center justify-center rounded-full border border-edge-strong font-mono text-[11px] font-medium text-muted">
                {i + 1}
              </span>
              <div class="min-w-0">
                <div class="text-[15px]">{title}</div>
                <p class="mt-1 text-[13px] leading-normal text-muted">{body}</p>

              </div>
            </li>
          ))
        }
      </ol>


      <div class="rounded-xl bg-surface px-4 py-3 text-[14px] leading-normal">
        <span class="text-faint">Heard:</span>
        <span data-heard>{c.heard}</span>
      </div>

    </section>

    <!-- Live mic check -->
    <aside class="flex flex-col gap-4 px-6 py-7">
      <h2 class="text-[14px] font-medium">Mic check</h2>

      <div class="flex flex-col gap-2">
        <label for="mic" class="text-[12px] text-muted">Microphone</label>
        <Select id="mic" name="mic" options={c.inputs} data-mic />
      </div>

      <div class="flex flex-col gap-1.5">
        <LevelMeter segments={28} lit={19} compact />
        <!-- One plain-language line: where the level is and what to do about it -->
        <div class="flex items-center gap-2" data-live-only>
          <span class="inline-block size-2 flex-none rounded-full bg-faint" data-status-dot></span>
          <span class="text-[13px]" data-status>Talk at your normal volume</span>
          <span class="ml-auto font-mono text-[12px] text-muted" data-status-peak></span>
        </div>
      </div>

      <div class="flex flex-col">
        {c.checks.map(([k, v, color], i) => <StatusRow label={k!} value={v!} color={color} dense data-check={i} />)}
      </div>

      <div class="flex flex-col gap-2.5 rounded-xl border border-line p-3.5" data-live-only data-test>
        <div class="flex items-center justify-between gap-3">
          <div class="min-w-0">
            <div class="text-[13px]">Test recording</div>
            <div class="mt-0.5 text-[12px] leading-snug text-subtle" data-test-hint>Say a few lines at your loudest, then play it back.</div>
          </div>
          <button
            type="button"
            class="inline-flex h-8 flex-none items-center gap-2 rounded-lg bg-rec px-3 text-[12px] font-medium text-white disabled:opacity-50 data-[running]:bg-raised data-[running]:text-fg"
            data-test-btn
          >
            <span class="size-2 rounded-full bg-current" data-test-icon></span>
            <span data-test-label>Record 10 s</span>
          </button>
        </div>
        <audio controls class="h-8 w-full [color-scheme:dark]" data-test-audio hidden></audio>
        <div class="font-mono text-[11px]" data-test-result hidden></div>
        <!-- Noise suppression on the test recording, with a setting suggested from the room's noise floor -->
        <div class="flex flex-col gap-2.5 border-t border-line pt-3" data-ns-test hidden>
          <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="text-[13px]">Noise suppression</div>
              <div class="mt-0.5 text-[12px] leading-snug text-subtle" data-ns-suggest></div>
            </div>
            <button type="button" class="inline-flex h-8 flex-none items-center rounded-lg border border-edge px-3 text-[12px] hover:bg-raised disabled:opacity-50" data-ns-hear>
              Hear it cleaned
            </button>
          </div>
          <div class="flex items-center gap-3">
            <input type="range" min="0" max="100" step="5" value="0" class="min-w-0 flex-1 accent-fg" aria-label="Noise suppression" data-ns-test-amount />
            <span class="w-10 flex-none text-right font-mono text-[12px]" data-ns-test-value>Off</span>
            <button type="button" class="flex-none text-[12px] text-muted underline-offset-2 hover:text-fg hover:underline" data-ns-use>Use this setting</button>
          </div>
        </div>
      </div>

      <!-- The numbers, for comparing with an interface's own meters -->
      <details class="group rounded-xl border border-line" data-live-only>
        <summary class="flex cursor-pointer list-none items-center justify-between px-3.5 py-2.5 text-[13px] text-muted hover:text-fg">
          Advanced details
          <span class="text-faint transition-transform group-open:rotate-180">▾</span>
        </summary>
        <div class="flex flex-col gap-3 border-t border-line px-3.5 pt-3 pb-3.5">
          <div class="flex flex-col gap-1 font-mono text-[12px]">
            <span class="text-fg-soft" data-readout>Peak — · RMS —</span>
            <span class="flex items-center justify-between gap-3 text-subtle">
              <span data-max>Highest peak —</span>
              <button type="button" class="text-muted hover:text-fg" data-reset>Reset</button>
            </span>
          </div>
          <!-- One meter per input of an interface, to compare with its own meters -->
          <div class="flex flex-col gap-1.5" data-input-meters hidden></div>
          <div class="flex flex-col">
            <StatusRow label="Device" value="…" dense data-opened="device" />
            <StatusRow label="Inputs · rate" value="…" dense data-opened="format" />
            <StatusRow label="Browser processing" value="…" dense data-opened="processing" />
          </div>
          <p class="text-[12px] text-subtle">Format is set by the host in Recording settings.</p>
        </div>
      </details>

      <div class="mt-auto flex flex-col gap-3 pt-2">
        <Button type="submit" variant="record" size="lg" class="w-full" data-start>
          ●&nbsp; Start session
        </Button>
      </div>
    </aside>
  </form>
</AppShell>

<script>
  import { MicCapture, type Level } from '@/lib/audio/capture';
  import { encodeWav } from '@/lib/audio/wav';
  import { denoiseSamples, suggestAmount } from '@/lib/audio/denoise';
  import { segmentMeter, toFraction, verdict, zone } from '@/lib/audio/meter';
  import { availableInput, inputChoices, parseInput, sameInput } from '@/lib/audio/devices';
  import { storageLeft, formatBytes } from '@/lib/audio/takes';
  import { hz, loadSettings, saveSettings } from '@/lib/settings';
  import { locate, normalize } from '@/lib/voice/match';
  import { loadScript } from '@/lib/script-store';
  import { VoiceFollow, voiceErrorText, voiceFollowSupported } from '@/lib/voice/follow';

  const form = document.getElementById('mic-check') as HTMLFormElement;
  const demo = new URL(location.href).searchParams.has('demo');
  if (!demo) live();

  async function live() {
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => form.querySelector<T>(s)!;
    const settings = loadSettings().recording;
    // The room's noise floor (dBFS), once the check has measured it.
    let noiseFloor = -Infinity;
    const episodeId = form.dataset.episode!;
    const script = loadScript(episodeId);
    const words = script.words;
    const starts = script.lineStarts;
    const ok = 'var(--color-ok)';
    const warn = 'var(--color-warn)';
    const bad = 'var(--color-rec)';
    const faint = 'var(--color-faint)';

    // The Checks rows, by name.
    const rows: Record<string, number> = { level: 0, clip: 1, noise: 2, voice: 3, space: 4, test: 5 };
    // Clipping, noise floor and free space only show when they need attention.
    const quiet = new Set(['clip', 'noise', 'space']);
    const check = (key: string, value: string, color?: string) => {
      if (!(key in rows)) return;
      const row = form.querySelector<HTMLElement>(`[data-check="${rows[key]}"]`)!;
      if (quiet.has(key)) row.hidden = color !== warn && color !== bad;
      row.querySelector('[data-value]')!.textContent = value;
      const dot = row.querySelector<HTMLElement>('[data-dot]')!;
      dot.hidden = !color;
      if (color) dot.style.background = color;
    };
    ['level', 'clip', 'noise', 'voice'].forEach((k) => check(k, 'Waiting…'));
    check('test', 'Not done yet · record one below', warn);
    $('[data-heard]').textContent = 'Read a line from the script…';

    // Carry a starting line (?from=, continuing a recovered session) through to the recording screen.
    const params = new URL(location.href).search;
    form.dataset.next = `/episodes/${episodeId}/recording${params}`;

    const { free, hours } = await storageLeft(hz(settings.rate), settings.depth, settings.channels);
    check('space', `${formatBytes(free)} · about ${hours >= 10 ? Math.round(hours) : hours.toFixed(1)} h`, hours < 2 ? warn : ok);

    // Level meter in the standard dBFS zones (see lib/audio/meter).
    const segs = [...form.querySelectorAll<HTMLElement>('[data-seg]')];
    const meter = $('[data-meter]');
    const showLevel = segmentMeter(segs);
    const levelColor = zone;

    const capture = new MicCapture();
    const peaks: { t: number; db: number }[] = [];
    const floors: number[] = [];
    let lastClip = 0;
    let started = Date.now();

    // Numbers to compare with the interface's own meters: peak held for a second, RMS,
    // the highest peak since Reset, and a small meter per raw input.
    let held: { t: number; db: number } = { t: 0, db: -Infinity };
    let highest = -Infinity;
    let clippedSinceReset = false;
    let offInput: { i: number; since: number } | null = null;
    const dbText = (db: number) => (Number.isFinite(db) ? `${db.toFixed(1)}` : '−∞').replace('-', '−');
    $('[data-reset]').addEventListener('click', () => {
      highest = -Infinity;
      clippedSinceReset = false;
      $('[data-max]').textContent = 'Highest peak —';
    });
    const inputMeters = $('[data-input-meters]');
    let inputRows: { bar: HTMLElement; value: HTMLElement }[] = [];
    const recordedInputs = (count: number) => {
      const { channel } = parseInput(settings.deviceId);
      if (settings.channels === 2) return [0, 1];
      return channel !== null ? [channel] : Array.from({ length: count }, (_, i) => i);
    };
    const buildInputMeters = (count: number) => {
      inputMeters.hidden = count < 2;
      const used = recordedInputs(count);
      inputRows = Array.from({ length: count }, (_, i) => {
        const row = document.createElement('div');
        row.className = 'grid grid-cols-[120px_1fr_64px] items-center gap-3 font-mono text-[11px] text-muted';
        row.innerHTML = '<span></span><span class="relative h-2 overflow-hidden rounded-full bg-line"><span class="absolute inset-y-0 left-0 rounded-full"></span></span><span class="text-right"></span>';
        row.children[0].textContent = `Input ${i + 1}${used.includes(i) ? '' : ' · unused'}`;
        const bar = row.children[1].firstElementChild as HTMLElement;
        bar.style.background = used.includes(i) ? 'var(--color-fg)' : 'var(--color-faint)';
        return { bar, value: row.children[2] as HTMLElement, row };
      }).map(({ bar, value, row }) => (inputMeters.append(row), { bar, value }));
    };

    capture.addEventListener('level', (e) => {
      const { peak, hot, rms, inputs } = (e as CustomEvent<Level>).detail;
      const now = Date.now();
      if (peak >= held.db || now - held.t > 1000) held = { t: now, db: peak };
      if (hot > -0.5) clippedSinceReset = true;
      if (peak > highest || (hot > -0.5 && !$('[data-max]').textContent!.includes('CLIPPED'))) {
        highest = Math.max(highest, peak);
        $('[data-max]').textContent = `Highest peak ${dbText(Math.min(0, highest))} dBFS${clippedSinceReset ? ' · CLIPPED' : ''}`;
      }
      // Voice on an input that isn't recorded: louder there than in the recording, for a while.
      const used = recordedInputs(inputs.length);
      const elsewhere = inputs.findIndex((db, i) => !used.includes(i) && db > -40 && db > peak + 10);
      offInput = elsewhere >= 0 ? { i: elsewhere, since: offInput?.i === elsewhere ? offInput.since : now } : null;
      $('[data-readout]').textContent = `Peak ${dbText(Math.min(0, held.db))} · RMS ${dbText(rms)} dBFS`;
      $('[data-readout]').style.color = held.db > -6 ? levelColor(held.db) : '';
      if (inputs.length !== inputRows.length) {
        inputMeters.replaceChildren();
        buildInputMeters(inputs.length);
      }
      inputs.forEach((db, i) => {
        inputRows[i].bar.style.width = `${toFraction(db) * 100}%`;
        if (used.includes(i)) inputRows[i].bar.style.background = levelColor(db);
        inputRows[i].value.textContent = dbText(Math.min(0, db));
        inputRows[i].value.style.color = db > -0.5 ? 'var(--color-rec)' : '';
      });
      peaks.push({ t: now, db: peak });
      while (peaks.length && now - peaks[0].t > 3000) peaks.shift();
      // Digital silence measures as -Infinity; count it as very quiet.
      floors.push(Number.isFinite(rms) ? rms : -120);
      if (floors.length > 300) floors.shift();
      if (hot > -0.5) lastClip = now;
      showLevel(peak);
      meter.setAttribute('aria-valuenow', String(Math.round(peak)));
    });

    setInterval(() => {
      if (!capture.ctx) return;
      const max = Math.min(0, Math.max(...peaks.map((p) => p.db)));
      const since = Math.round((Date.now() - lastClip) / 1000);
      // One verdict for the line under the meter and the Level check.
      const [text, color, grade] =
        offInput && Date.now() - offInput.since > 1500
          ? [`Your voice is on Input ${offInput.i + 1} · pick it above`, warn, warn]
          : lastClip && since < 5
            ? ['Clipping · turn the gain down', bad, bad]
            : !Number.isFinite(max) || max < -45
              ? ['Talk at your normal volume', faint, warn]
              : verdict(max);
      $('[data-status]').textContent = text;
      $('[data-status-dot]').style.background = color;
      $('[data-status-peak]').textContent = Number.isFinite(max) && max >= -45 ? `peaks ${Math.round(max) || 0} dBFS` : '';
      check('level', text === 'Talk at your normal volume' ? 'Waiting for your voice' : text, grade);

      if (lastClip && since < 30) check('clip', `Clipped ${since} s ago`, bad);
      else check('clip', `None in the last ${Math.min(30, Math.round((Date.now() - started) / 1000))} s`, ok);

      if (floors.length > 60) {
        const floor = [...floors].sort((a, b) => a - b)[Math.floor(floors.length * 0.1)];
        noiseFloor = floor;
        check('noise', floor <= -90 ? 'Below -90 dBFS' : `${floor.toFixed(0)} dBFS`, floor <= -50 ? ok : floor <= -40 ? warn : bad);
      }
    }, 500);

    async function open(deviceId: string) {
      try {
        await capture.open({ deviceId, sampleRate: hz(settings.rate), channels: settings.channels });
      } catch (err) {
        const denied = (err as Error).name === 'NotAllowedError';
        check('level', denied ? 'Microphone blocked' : 'No microphone', bad);
        $('[data-heard]').textContent = denied
          ? 'Allow microphone access in the address bar, then reload this page.'
          : `Couldn’t open the microphone: ${(err as Error).message}`;
        return;
      }
      started = Date.now();
      peaks.length = 0;
      floors.length = 0;
      lastClip = 0;
      if (capture.ctx?.state === 'suspended') {
        $('[data-heard]').textContent = 'Click anywhere to start the meter.';
        addEventListener('pointerdown', () => capture.ctx?.resume(), { once: true });
      }
      // Real device names are only available after permission. "System default" follows the
      // computer's sound settings; interfaces list each input on its own.
      const select = $<HTMLSelectElement>('[data-mic]');
      const choices = await inputChoices(settings.channels);
      // The saved mic's entry, even when it's stored as the device alone ('id' is its input 1).
      const current = choices.find((c) => sameInput(c.value, deviceId))?.value ?? '';
      select.replaceChildren(...choices.map((c) => new Option(c.label, c.value, false, c.value === current)));
      select.value = current;
      voice?.setTrack(capture.voiceTrack());
      showOpened();
    }

    // What Chrome actually opened: the device, how many inputs at what rate, and whether
    // any of its voice processing is on (auto gain moves levels around).
    function showOpened() {
      const o = capture.opened();
      if (!o) return;
      const row = (key: string, value: string, color?: string) => {
        const el = form.querySelector<HTMLElement>(`[data-opened="${key}"]`)!;
        el.querySelector('[data-value]')!.textContent = value;
        const dot = el.querySelector<HTMLElement>('[data-dot]')!;
        dot.hidden = !color;
        if (color) dot.style.background = color;
      };
      row('device', o.label || 'Unknown');
      const rate = (hz: number) => `${hz / 1000} kHz`;
      // Sessions record at the device's own rate, with no resampling.
      row('format', `${o.inputs} input${o.inputs === 1 ? '' : 's'} · ${rate(capture.sampleRate)}`);
      row('processing', o.processing.length ? `${o.processing.join(', ')} on` : 'Off', o.processing.length ? bad : ok);
    }

    // Test recording: a short take through the real recording path, to play back and
    // measure before a session.
    const testBtn = $<HTMLButtonElement>('[data-test-btn]');
    const testHint = $('[data-test-hint]');
    let test: { chunks: Float32Array[]; rate: number; t0: number; timer: number } | null = null;
    const onTestChunk = (e: Event) => test?.chunks.push((e as CustomEvent<Float32Array>).detail);
    const onTestFormat = (e: Event) => test && (test.rate = (e as CustomEvent<number>).detail);
    capture.addEventListener('chunk', onTestChunk);
    capture.addEventListener('format', onTestFormat);
    testBtn.addEventListener('click', async () => {
      if (test) return finishTest();
      await capture.ctx?.resume();
      test = { chunks: [], rate: capture.sampleRate, t0: Date.now(), timer: 0 };
      capture.record();
      testBtn.dataset.running = '';
      $('[data-test-label]').textContent = 'Stop';
      $('[data-test-icon]').classList.replace('rounded-full', 'rounded-[1px]');
      test.timer = window.setInterval(() => {
        const left = 10 - (Date.now() - test!.t0) / 1000;
        testHint.textContent = `Recording… ${Math.max(0, Math.ceil(left))} s · talk at your loudest`;
        if (left <= 0) finishTest();
      }, 200);
    });
    // Noise suppression on the test recording.
    let testTake: { samples: Float32Array; rate: number } | null = null;
    let cleanedUrl: { amount: number; url: string } | null = null;
    const nsAmount = $<HTMLInputElement>('[data-ns-test-amount]');
    const nsHear = $<HTMLButtonElement>('[data-ns-hear]');
    const showNsAmount = () => ($('[data-ns-test-value]').textContent = Number(nsAmount.value) ? `${nsAmount.value}%` : 'Off');
    nsAmount.addEventListener('input', () => {
      showNsAmount();
      nsHear.textContent = 'Hear it cleaned';
    });
    $('[data-ns-use]').addEventListener('click', () => {
      saveSettings('recording', { noiseSuppression: Number(nsAmount.value) });
      $('[data-ns-use]').textContent = 'Saved for exports';
      setTimeout(() => ($('[data-ns-use]').textContent = 'Use this setting'), 2000);
    });
    let originalUrl = '';
    nsHear.addEventListener('click', async () => {
      const audio = $<HTMLAudioElement>('[data-test-audio]');
      if (!testTake) return;
      const amount = Number(nsAmount.value);
      if (nsHear.textContent === 'Hear the original') {
        audio.src = originalUrl;
        audio.play();
        nsHear.textContent = 'Hear it cleaned';
        return;
      }
      if (!amount) return;
      if (cleanedUrl?.amount !== amount) {
        nsHear.disabled = true;
        nsHear.textContent = 'Cleaning…';
        try {
          const out = await denoiseSamples(testTake.samples, settings.channels, testTake.rate, amount);
          if (cleanedUrl) URL.revokeObjectURL(cleanedUrl.url);
          cleanedUrl = { amount, url: URL.createObjectURL(encodeWav([out], { sampleRate: testTake.rate, bitDepth: settings.depth, channels: settings.channels })) };
        } catch (err) {
          $('[data-ns-suggest]').textContent = `Couldn’t clean it: ${(err as Error).message}`;
          nsHear.disabled = false;
          nsHear.textContent = 'Hear it cleaned';
          return;
        }
        nsHear.disabled = false;
      }
      audio.src = cleanedUrl!.url;
      audio.play();
      nsHear.textContent = 'Hear the original';
    });

    async function finishTest() {
      if (!test) return;
      const t = test;
      clearInterval(t.timer);
      testBtn.disabled = true;
      await capture.stop();
      test = null;
      delete testBtn.dataset.running;
      testBtn.disabled = false;
      $('[data-test-label]').textContent = 'Record again';
      $('[data-test-icon]').classList.replace('rounded-[1px]', 'rounded-full');
      testHint.textContent = 'Play it back: listen for distortion, crackle or clicks, especially on your loudest words.';
      const audio = $<HTMLAudioElement>('[data-test-audio]');
      if (audio.src) URL.revokeObjectURL(audio.src);
      audio.src = URL.createObjectURL(encodeWav(t.chunks, { sampleRate: t.rate, bitDepth: settings.depth, channels: settings.channels }));
      originalUrl = audio.src;
      audio.hidden = false;
      // Offer noise suppression on it, starting from what suits the room.
      const joined = new Float32Array(t.chunks.reduce((n, c) => n + c.length, 0));
      let o = 0;
      for (const c of t.chunks) {
        joined.set(c, o);
        o += c.length;
      }
      testTake = { samples: joined, rate: t.rate };
      cleanedUrl = null;
      const suggested = suggestAmount(noiseFloor);
      nsAmount.value = String(suggested || loadSettings().recording.noiseSuppression);
      showNsAmount();
      nsHear.textContent = 'Hear it cleaned';
      $('[data-ns-suggest]').textContent = !Number.isFinite(noiseFloor)
        ? 'Hear how it sounds with the room taken out.'
        : suggested
          ? `Room noise ${Math.round(noiseFloor)} dBFS · try ${suggested}%`
          : `Room noise ${Math.round(noiseFloor)} dBFS · quiet enough without it`;
      $('[data-ns-test]').hidden = !joined.length;
      // What the file itself measures.
      let peak = 0;
      let full = 0;
      for (const c of t.chunks) {
        for (const v of c) {
          const a = Math.abs(v);
          if (a > peak) peak = a;
          if (a >= 0.999) full++;
        }
      }
      const db = peak > 0 ? 20 * Math.log10(peak) : -Infinity;
      const result = $('[data-test-result]');
      result.hidden = false;
      const [text, color, grade] = full ? ['Clipped · turn the gain down', bad, bad] : verdict(db);
      result.style.color = color;
      result.textContent = !t.chunks.length ? 'Nothing was recorded' : `Peak ${dbText(Math.min(0, db))} dBFS · ${full ? `${full} samples clipped` : text.toLowerCase()}`;
      check('test', full ? 'Clipped · turn the gain down' : `Done · ${text.split(' · ')[0].toLowerCase()}`, grade);
    }

    let voice: VoiceFollow | null = null;
    $<HTMLSelectElement>('[data-mic]').addEventListener('change', (e) => {
      const deviceId = (e.target as HTMLSelectElement).value;
      saveSettings('recording', { deviceId });
      settings.deviceId = deviceId;
      // Rebuild the per-input meters for the new device.
      inputMeters.replaceChildren();
      inputRows = [];
      open(deviceId);
    });
    await open(await availableInput(settings.deviceId, settings.channels));

    // Voice follow check: can Chrome hear you, and does it match the script?
    if (!voiceFollowSupported()) {
      check('voice', 'Needs Chrome speech recognition', warn);
      return;
    }
    const tokens = words.flatMap((w) => normalize(w));
    const tokenLine: number[] = [];
    words.forEach((w, i) => normalize(w).forEach(() => tokenLine.push(starts.reduce((l, s, n) => (i >= s ? n : l), 0))));
    voice = new VoiceFollow(words);
    voice.engine = loadSettings().prompter.voiceEngine;
    // Listen to the selected input, not the system default mic.
    voice.track = capture.voiceTrack();
    const v = voice;
    // With the checks tucked away, a voice follow problem shows where the words would.
    let heardAny = false;
    const voiceProblem = (text: string) => {
      if (heardAny) return;
      const box = $('[data-heard]');
      box.textContent = `${text} · `;
      box.append(Object.assign(document.createElement('a'), { href: '/voice', target: '_blank', className: 'text-fg underline underline-offset-2', textContent: 'Voice check' }));
    };
    v.addEventListener('heard', (e) => {
      heardAny = true;
      const text = (e as CustomEvent<string>).detail;
      $('[data-heard]').textContent = `“${text}”`;
      const hit = locate(tokens, normalize(text).slice(-8), 0, { behind: 0, ahead: tokens.length });
      if (hit) check('voice', `Matched line ${tokenLine[hit.index] + 1}`, ok);
      else check('voice', 'Listening · no script match yet', warn);
    });
    v.addEventListener('error', (e) => {
      const err = (e as CustomEvent<string>).detail;
      check('voice', voiceErrorText(err), warn);
      voiceProblem(`Voice follow: ${voiceErrorText(err)}`);
    });
    v.addEventListener('status', (e) => (e as CustomEvent<string>).detail === 'listening' && check('voice', 'Listening…', warn));
    v.addEventListener('diag', (e) => {
      // This Chrome can't point voice follow at the chosen mic; it opened the default one
      // with its own auto gain, which can change that mic's level.
      if ((e as CustomEvent<string>).detail === 'default-mic') check('voice', 'Using the default mic · update Chrome', warn);
    });
    v.start();

    form.addEventListener('submit', () => {
      v.stop();
      capture.close();
    });
  }
</script>
