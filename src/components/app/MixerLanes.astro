---
/*
 * Mixer View 1b: host + guest with no script. One lane per person with the
 * last minute of level, a segmented meter in the mic check's zones, and talk
 * time underneath. Replaces the empty "Ad-lib" screen; driven by lib/mixer-view.ts.
 */
const lanes = [
  { who: 'host', dot: 'var(--color-spk-yellow)' },
  { who: 'guest', dot: 'var(--color-spk-teal)' },
];
---

<div class="absolute inset-0 hidden flex-col justify-center lg:flex gap-3 overflow-auto px-4 py-6 lg:px-16" data-mixer hidden>
  {
    lanes.map((l) => (
      <div
        class="grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-3 rounded-[14px] bg-surface px-5 py-4 transition-colors lg:grid-cols-[170px_1fr_auto]"
        data-lane={l.who}
      >
        <div class="min-w-0">
          <div class="flex items-center gap-2 text-[17px]">
            <span class="size-2.5 flex-none rounded-full" style={{ background: l.dot }} />
            <span class="truncate" data-lane-name />
          </div>
          <div class="mt-1 truncate text-[12px] text-muted" data-lane-meta />
        </div>
        <div class="text-right lg:order-last">
          <div class="font-mono text-[26px] leading-none font-medium lg:text-[30px]" data-lane-db>—</div>
          <div class="mt-1.5 font-mono text-[10px] tracking-[0.08em] text-muted" data-lane-status>IDLE</div>
        </div>
        <div class="col-span-2 flex min-w-0 flex-col gap-2 lg:col-span-1">
          <div class="flex h-16 items-center gap-[3px]" aria-hidden="true" data-lane-history />
          <div class="flex gap-[3px]" aria-hidden="true" data-lane-meter />
        </div>
      </div>
    ))
  }
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 font-mono text-[11px] tracking-[0.06em] text-subtle">
    <span>LAST 60 S · TARGET −18 TO −6</span>
    <span class="flex items-center gap-3">
      <span data-talk-text>TALK —</span>
      <span class="flex h-1 w-40 overflow-hidden rounded-full bg-line">
        <span class="h-full" style="background:var(--color-spk-yellow);width:0" data-talk-host></span>
        <span class="h-full" style="background:var(--color-spk-teal);width:0" data-talk-guest></span>
      </span>
    </span>
  </div>
</div>
