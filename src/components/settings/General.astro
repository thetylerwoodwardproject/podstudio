---
import Section from './Section.astro';
import Block from '@/components/ui/Block.astro';
import Card from '@/components/ui/Card.astro';
import Select from '@/components/ui/Select.astro';
import ThemePicker from '@/components/ui/ThemePicker.astro';
import { inputClass } from '@/lib/ui';

const zones = ['America/Chicago', 'America/New_York', 'America/Denver', 'America/Los_Angeles', 'Europe/London', 'UTC'];
const label = 'text-[14px] text-text';
---

<Section title="General" description="What the show is called and where it's recorded." />
<Card label="Appearance" rows>
  <Block>
    <ThemePicker />
    <p class="help">Follow this device, or use your chosen theme on every device.</p>
  </Block>
</Card>
<Card label="Show" rows>
  <Block>
    <label for="show-name" class={label}>Show name</label>
    <input id="show-name" name="show" class={inputClass} value="The Tyler Woodward Project" />
    <p class="help">Shown on episode pages, invites and exported files.</p>
  </Block>
  <Block>
    <label for="server-name" class={label}>Server name</label>
    <input id="server-name" name="server" class={inputClass} value="Podstudio · Studio A" />
    <p class="help">What guests see when they join.</p>
  </Block>
  <Block>
    <label for="tz" class={label}>Time zone</label>
    <Select id="tz" name="tz" options={zones} />
    <p class="help">Used for session dates and nightly backups.</p>
  </Block>
</Card>
