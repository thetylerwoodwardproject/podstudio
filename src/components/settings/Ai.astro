---
import Section from './Section.astro';
import Block from '@/components/ui/Block.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Dot from '@/components/ui/Dot.astro';
import Select from '@/components/ui/Select.astro';
import { inputClass } from '@/lib/ui';

// Placeholder model names: OpenAI's list changes, the server will fetch it.
const transcriptionModels = ['whisper-1'];
const writingModels = ['gpt-4o-mini'];
const banned = ['game-changer', 'unleash', 'dive in', '🚀'];
const chip = 'flex h-7 items-center gap-1 rounded-[999px] bg-control px-2.5 text-[13px] text-text';
const label = 'text-[14px] text-text';
const area = 'w-full resize-y rounded-[10px] border border-border bg-page p-3 text-[14px] leading-[1.6] text-text focus:border-handle focus:outline-none';
---

<Section
  title="Transcription & AI"
  description="Uses your own OpenAI key. You pay OpenAI directly, and the key is stored encrypted on your server."
/>
<Card label="OpenAI" rows>
  <Block>
    <label for="openai-key" class={label}>API key</label>
    <div class="relative">
      <input
        id="openai-key"
        name="openai-key"
        type="password"
        autocomplete="off"
        class:list={[inputClass, 'pr-28 font-mono text-[13px]']}
        value="sk-proj-000000000000000000004f2a"
      />
      <span class="pointer-events-none absolute top-1/2 right-3 flex -translate-y-1/2 items-center gap-1.5 font-mono text-[11px] font-medium tracking-[0.06em] text-ok uppercase">
        <Dot color="var(--color-ok)" />Connected
      </span>
    </div>
  </Block>
  <Block class="grid gap-4 sm:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label for="tx-model" class={label}>Transcription model</label>
      <Select id="tx-model" name="tx-model" options={transcriptionModels} />
    </div>
    <div class="flex flex-col gap-2">
      <label for="gen-model" class={label}>Writing model</label>
      <Select id="gen-model" name="gen-model" options={writingModels} />
    </div>
  </Block>
</Card>

<Card label="Show voice" rows>
  <Block>
    <label for="tone" class={label}>Describe your show’s tone</label>
    <textarea id="tone" name="tone" rows="3" class:list={[area, 'min-h-24']}>Casual and technical. Broadcast engineering for people who actually do the work. Dry humor, no hype. Short sentences.</textarea>
    <p class="help">Guides every title, description and social post Podstudio writes, so the drafts sound like your show.</p>
  </Block>
  <Block class="grid gap-4 sm:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label for="banned-input" class={label}>Never use these words</label>
      <div class="flex min-h-10 flex-wrap items-center gap-1.5 rounded-[10px] border border-border bg-page p-1.5 focus-within:border-handle" data-chips>
        {
          banned.map((w) => (
            <span class={chip}>
              {w}
              <button type="button" aria-label={`Remove ${w}`} class="text-text-2 hover:text-text" data-remove>×</button>
            </span>
          ))
        }
        <input id="banned-input" class="min-w-20 flex-1 bg-transparent px-1 text-[14px] placeholder:text-text-3 focus:outline-none" placeholder="Add…" data-chip-input />
      </div>
    </div>
    <div class="flex flex-col gap-2">
      <label for="hashtags" class={label}>Hashtags to include</label>
      <input id="hashtags" name="hashtags" class={inputClass} value="#broadcast #radioengineering" />
    </div>
  </Block>
  <Block data-examples>
    <div class={label}>Example posts</div>
    <textarea rows="2" aria-label="Example post 1" class={area}>New episode: we rebuilt Studio B in a weekend and only broke one thing. Mostly.</textarea>
    <p class="help">Paste two or three you liked.</p>
    <Button size="sm" variant="ghost" class="self-start" data-add-example>+ Add another</Button>
  </Block>
</Card>

<div class="flex justify-end gap-2">
  <Button href="/episodes/142/package">Test on Ep. 142</Button>
  <Button type="submit" variant="primary">Save</Button>
</div>

<template id="chip-tpl">
  <span class={chip}><span data-text></span><button type="button" class="text-text-2 hover:text-text" data-remove>×</button></span>
</template>

<script>
  const chips = document.querySelector<HTMLElement>('[data-chips]');
  if (chips) {
    const input = chips.querySelector<HTMLInputElement>('[data-chip-input]')!;
    chips.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-remove]');
      if (btn) btn.parentElement!.remove();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value) input.previousElementSibling?.remove();
      if (e.key !== 'Enter' && e.key !== ',') return;
      e.preventDefault();
      const word = input.value.trim();
      if (!word) return;
      const tpl = (document.getElementById('chip-tpl') as HTMLTemplateElement).content.firstElementChild!.cloneNode(true) as HTMLElement;
      tpl.querySelector('[data-text]')!.textContent = word;
      tpl.querySelector('[data-remove]')!.setAttribute('aria-label', `Remove ${word}`);
      input.before(tpl);
      input.value = '';
    });

    const examples = document.querySelector<HTMLElement>('[data-examples]')!;
    examples.querySelector('[data-add-example]')!.addEventListener('click', (e) => {
      const areas = examples.querySelectorAll('textarea');
      const next = areas[0].cloneNode() as HTMLTextAreaElement;
      next.value = '';
      next.setAttribute('aria-label', `Example post ${areas.length + 1}`);
      examples.querySelector('.help')!.before(next);
      next.focus();
    });
  }
</script>
