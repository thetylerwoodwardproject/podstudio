---
import Section from './Section.astro';
import Card from '@/components/ui/Card.astro';
import Kbd from '@/components/ui/Kbd.astro';
import Dot from '@/components/ui/Dot.astro';
import Row from '@/components/ui/Row.astro';
import { shortcuts } from '@/data/mock';
---

<Section
  title="Controls"
  description="Shortcuts work on every screen. Bluetooth page turners and foot pedals show up as keyboards, so any key they send can be mapped."
/>
<Card label="Keyboard" rows>
  <dl class="grid md:grid-cols-2">
    {
      shortcuts.map((s, i) => (
        <div class:list={['mx-5 flex items-center justify-between gap-4 border-divider py-3.5', i > 0 && 'border-t', i === 1 && 'md:border-t-0']}>
          <dt class="text-[14px] text-text">{s.action}</dt>
          <dd><Kbd>{s.keys}</Kbd></dd>
        </div>
      ))
    }
  </dl>
</Card>
<Card label="Remotes" rows>
  <Row title="Page turner · Satechi R1" hint="PageDown → next line · PageUp → previous line" monoHint>
    <span class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.06em] text-ok uppercase"><Dot color="currentColor" />Connected</span>
    <button type="button" class="h-9 rounded-[10px] px-3 text-[14px] text-text-2 hover:text-text">Edit</button>
  </Row>
  <Row title="Foot pedal" hint="Press the pedal now to map it to Pause / resume" data-pedal>
    <span class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.06em] text-warn uppercase" data-pedal-status>
      <Dot color="currentColor" />
      <span>Listening</span>
    </span>
  </Row>
</Card>

<script>
  // While "Listening", the next key the pedal sends becomes Pause / resume.
  const pedal = document.querySelector<HTMLElement>('[data-pedal]');
  if (pedal) {
    const onKey = (e: KeyboardEvent) => {
      if ((e.target as HTMLElement).matches('input, textarea, select, [contenteditable]')) return;
      e.preventDefault();
      const hint = pedal.querySelector<HTMLElement>('[data-row-hint]')!;
      hint.textContent = `${e.code} → Pause / resume`;
      hint.classList.add('font-mono', 'text-[12px]');
      const status = pedal.querySelector<HTMLElement>('[data-pedal-status]')!;
      status.classList.replace('text-warn', 'text-ok');
      status.querySelector('span:last-child')!.textContent = 'Mapped';
      removeEventListener('keydown', onKey);
    };
    addEventListener('keydown', onKey);
  }
</script>
