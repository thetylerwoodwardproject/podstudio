---
import Section from './Section.astro';
import { episode, pkg } from '@/data/mock';
---

<Section
  title="Hotkey pads"
  description="Nine sounds on the number keys, for recording on a laptop. They play in your headphones and are saved as their own Pads track. Wear headphones, so the mic doesn't pick them up."
/>
<div data-pads-mount data-episode={episode.id} data-episode-label={episode.label} data-bites={JSON.stringify(pkg.soundbites)}></div>

<script>
  const target = document.querySelector<HTMLElement>('[data-pads-mount]');
  if (target)
    Promise.all([import('svelte'), import('./PadsEditor.svelte')]).then(([{ mount }, { default: PadsEditor }]) =>
      mount(PadsEditor, {
        target,
        props: {
          episodeId: target.dataset.episode!,
          episodeLabel: target.dataset.episodeLabel!,
          bites: JSON.parse(target.dataset.bites || '[]'),
        },
      }),
    );
</script>
