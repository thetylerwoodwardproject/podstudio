---
/*
 * Hotkey pads 1b · Settings → Hotkey pads (or Edit on the rail): the show set,
 * an episode's overrides, and the selected pad's sound, colour and behaviour.
 * Everything is kept in this browser until the server exists (lib/pads.ts).
 */
import Section from './Section.astro';
import { episode, pkg } from '@/data/mock';

const field = 'flex flex-col gap-2';
const label = 'text-[12px] text-muted';
const input = 'h-9 rounded-lg border border-edge bg-surface px-2.5 text-[13px] focus:border-fg focus:outline-none';
const seg = 'grid gap-[3px] rounded-lg bg-raised p-[3px]';
const segBtn = 'h-8 rounded-md px-2 text-[13px] text-muted hover:text-fg aria-pressed:bg-fg aria-pressed:text-ink';
---

<Section
  title="Hotkey pads"
  description="Nine sounds on the number keys, for recording on a laptop. They play in your headphones, go under your voice if you want, and are saved as their own Pads track with a marker per press. Wear headphones, so the mic doesn't pick them up."
/>
<div
  class="grid gap-8 xl:grid-cols-[minmax(0,360px)_minmax(0,1fr)]"
  data-pads-editor
  data-episode={episode.id}
  data-episode-label={episode.label}
  data-bites={JSON.stringify(pkg.soundbites)}
>
  <div class="flex flex-col gap-3">
    <div class:list={[seg, 'grid-cols-2']} role="group" aria-label="Which set">
      <button type="button" class={segBtn} aria-pressed="true" data-layer="show">Show set</button>
      <button type="button" class={segBtn} aria-pressed="false" data-layer="episode">{episode.label} only</button>
    </div>
    <div class="grid grid-cols-3 gap-2" data-grid></div>
    <p class="text-[12px] leading-normal text-subtle" data-grid-note>
      Drag to swap keys. The show set is used for every episode, and an episode can override single pads without changing the set.
    </p>
    <fieldset class="mt-2 flex flex-col gap-3 rounded-xl border border-line p-4">
      <legend class="px-1 text-[12px] text-muted">Ducking, for every pad that ducks</legend>
      <div class="grid grid-cols-3 gap-3">
        <label class={field}><span class={label}>Attack, ms</span><input type="number" min="1" max="1000" class={input} data-g="duckAttackMs" /></label>
        <label class={field}><span class={label}>Release, ms</span><input type="number" min="10" max="5000" class={input} data-g="duckReleaseMs" /></label>
        <label class={field}><span class={label}>Voice above, dBFS</span><input type="number" min="-70" max="-10" class={input} data-g="threshold" /></label>
      </div>
      <p class="text-[12px] leading-normal text-subtle">Attack is how fast the pads drop when you start talking, release how fast they come back when you stop. The Pads track is ducked the same way, as you heard it.</p>
    </fieldset>
  </div>

  <div class="flex min-w-0 flex-col gap-5 rounded-2xl border border-line p-5" data-detail>
    <div class="flex items-start gap-4">
      <span class="flex size-12 flex-none items-center justify-center rounded-xl font-mono text-[20px] font-medium" data-d-key>1</span>
      <div class="min-w-0 flex-1">
        <input class="w-full bg-transparent text-[18px] focus:outline-none" aria-label="Pad name" placeholder="Name this pad" data-d-name />
        <p class="mt-0.5 truncate text-[12px] text-muted" data-d-source>No sound yet</p>
      </div>
      <button type="button" class="h-9 flex-none rounded-lg border border-edge px-3 text-[13px] hover:bg-raised disabled:opacity-40" data-d-preview disabled>Preview</button>
    </div>
    <canvas class="h-16 w-full rounded-lg bg-raised" height="64" data-d-wave></canvas>

    <div class={field}>
      <span class={label}>Sound</span>
      <div class:list={[seg, 'grid-cols-4']} role="group" aria-label="Sound kind">
        <button type="button" class={segBtn} aria-pressed="false" data-kind="bite">Soundbite</button>
        <button type="button" class={segBtn} aria-pressed="false" data-kind="clip">Clip</button>
        <button type="button" class={segBtn} aria-pressed="false" data-kind="music">Music</button>
        <button type="button" class={segBtn} aria-pressed="false" data-kind="sfx">Sound effect</button>
      </div>
      <div class="flex flex-col gap-2" data-src="bite" hidden>
        <select class={input} aria-label="Soundbite" data-bite></select>
        <p class="text-[12px] text-subtle" data-bite-note></p>
      </div>
      <div class="flex flex-col gap-2" data-src="clip" hidden>
        <select class={input} aria-label="Session" data-clip-take></select>
        <div class="flex items-center gap-2">
          <input class:list={[input, 'w-24 font-mono']} placeholder="0:00" aria-label="Clip start" data-clip-from />
          <span class="text-muted">–</span>
          <input class:list={[input, 'w-24 font-mono']} placeholder="0:10" aria-label="Clip end" data-clip-to />
          <button type="button" class="h-9 rounded-lg bg-raised px-3 text-[13px] hover:bg-surface" data-clip-use>Use this range</button>
        </div>
      </div>
      <div class="flex flex-col gap-2" data-src="upload" hidden>
        <div class="flex flex-wrap items-center gap-2">
          <label class="flex h-9 cursor-pointer items-center rounded-lg bg-raised px-3 text-[13px] hover:bg-surface">
            Upload a file
            <input type="file" accept=".wav,.mp3,.m4a,.flac,audio/*" class="sr-only" data-upload />
          </label>
          <select class:list={[input, 'min-w-0 flex-1']} aria-label="From the library" data-library></select>
        </div>
      </div>
      <p class="text-[12px] text-subtle" data-kind-note>
        Pick from past episodes' soundbites and clips, or upload WAV, MP3, M4A or FLAC.
      </p>
    </div>

    <div class={field}>
      <span class={label}>Color</span>
      <div class="flex gap-2" role="radiogroup" aria-label="Pad colour" data-colors></div>
    </div>

    <div class={field}>
      <span class={label}>When pressed</span>
      <div class:list={[seg, 'grid-cols-3']} role="group" aria-label="When pressed">
        <button type="button" class={segBtn} aria-pressed="false" data-mode="oneshot">One-shot</button>
        <button type="button" class={segBtn} aria-pressed="false" data-mode="loop">Loop</button>
        <button type="button" class={segBtn} aria-pressed="false" data-mode="hold">Hold</button>
      </div>
      <p class="text-[12px] text-subtle" data-mode-note></p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class={field}>
        <span class="flex justify-between"><span class={label}>Volume</span><span class="font-mono text-[12px]" data-d-gain-text></span></span>
        <input type="range" min="-24" max="6" step="1" class="w-full accent-fg" data-d-gain />
      </label>
      <div class={field}>
        <span class={label}>Fade in / out, ms</span>
        <div class="flex gap-2">
          <input type="number" min="0" max="10000" step="10" class:list={[input, 'w-full']} aria-label="Fade in" data-d-fadein />
          <input type="number" min="0" max="10000" step="10" class:list={[input, 'w-full']} aria-label="Fade out" data-d-fadeout />
        </div>
      </div>
      <div class={field}>
        <span class={label}>Trim, seconds</span>
        <div class="flex gap-2">
          <input type="number" min="0" step="0.1" class:list={[input, 'w-full']} aria-label="Trim start" data-d-trimstart />
          <input type="number" min="0" step="0.1" class:list={[input, 'w-full']} aria-label="Trim end (0 = end)" placeholder="end" data-d-trimend />
        </div>
      </div>
      <div class={field}>
        <span class={label}>Duck under your voice</span>
        <div class="flex items-center gap-2">
          <label class="flex h-9 items-center gap-2 text-[13px]"><input type="checkbox" class="size-4 accent-fg" data-d-duck /> On</label>
          <input type="number" min="1" max="40" class:list={[input, 'w-20']} aria-label="Duck amount, dB" data-d-duckdb />
          <span class="text-[12px] text-muted">dB</span>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-between gap-3 border-t border-line pt-4">
      <button type="button" class="text-[13px] text-muted hover:text-rec disabled:opacity-40" data-d-clear>Clear pad</button>
      <span class="flex items-center gap-3">
        <span class="text-[12px] text-subtle" data-d-status></span>
        <button type="button" class="h-9 rounded-lg bg-fg px-4 text-[13px] font-medium text-ink disabled:opacity-40" data-d-save disabled>Save</button>
      </span>
    </div>
  </div>
</div>
<p class="text-[12px] leading-normal text-subtle">
  Kept in this browser until the Podstudio server is set up, then stored per show. Sounds are converted to 48 kHz when
  added, so a press plays with no delay. Clearing a pad keeps its sound in the library. Put <span class="font-mono">[pad 3]</span>
  on its own line in a script to show a reminder chip there; it never fires by itself.
</p>

<script>
  import { PadEngine } from '@/lib/audio/pad-engine';
  import { getTake, listTakes, readFrames, type TakeMeta } from '@/lib/audio/takes';
  import {
    KIND_DEFAULTS,
    LIBRARY_RATE,
    PAD_COLORS,
    PAD_INK,
    decodeToLibraryRate,
    interleave,
    listLibrary,
    loadEpisodePads,
    loadPadSettings,
    loadShowPads,
    newPad,
    padColor,
    padTag,
    readLibraryFile,
    saveEpisodePads,
    saveLibraryFile,
    savePadSettings,
    saveShowPads,
    setPad,
    swapKeys,
    type Pad,
    type PadKind,
    type PadSet,
    type PadSettings,
  } from '@/lib/pads';

  import { pullEpisode } from '@/lib/sync';

  const root = document.querySelector<HTMLElement>('[data-pads-editor]');
  // The server's pads first (this page is the same for every episode, so it isn't rendered with them).
  if (root) pullEpisode(new URL(location.href).searchParams.get('episode') || root.dataset.episode!).then(() => editor(root));

  function editor(root: HTMLElement) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends HTMLElement = HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];
    const params = new URL(location.href).searchParams;
    const episodeId = params.get('episode') || root.dataset.episode!;
    let layer: 'show' | 'episode' = 'show';
    let key = Math.max(1, Math.min(9, Number(params.get('key')) || 1));
    let draft: Pad | null = null;
    let dirty = false;
    const audio = new Map<string, Float32Array>();

    const setOf = (l = layer): PadSet => (l === 'show' ? loadShowPads() : loadEpisodePads(episodeId));
    const saveSet = (set: PadSet, l = layer) => (l === 'show' ? saveShowPads(set) : saveEpisodePads(episodeId, set));
    const minSec = (s: number) => `${Math.floor(s / 60)}:${(s % 60).toFixed(1).padStart(4, '0')}`;
    const parseTime = (v: string) => {
      const parts = v.trim().split(':').map(Number);
      if (parts.some((n) => !Number.isFinite(n))) return NaN;
      return parts.reduce((t, n) => t * 60 + n, 0);
    };

    // ── The grid ──────────────────────────────────────────────────────────────
    function renderGrid() {
      const own = new Map(setOf().map((p) => [p.key, p]));
      const inherited = layer === 'episode' ? new Map(loadShowPads().map((p) => [p.key, p])) : new Map<number, Pad>();
      $('[data-grid]').replaceChildren(
        ...Array.from({ length: 9 }, (_, i) => {
          const k = i + 1;
          const p = own.get(k);
          const from = !p ? inherited.get(k) : undefined;
          const b = document.createElement('button');
          b.type = 'button';
          b.dataset.gridKey = String(k);
          b.draggable = !!p;
          b.className = 'relative flex aspect-[1.05] min-w-0 flex-col justify-between overflow-hidden rounded-xl p-2.5 text-left transition-shadow';
          if (k === key) b.style.boxShadow = '0 0 0 2px var(--color-panel), 0 0 0 4px var(--color-fg)';
          const pad = p ?? from;
          if (pad) {
            b.style.background = padColor(pad.color);
            b.style.color = PAD_INK;
            if (from) b.style.opacity = '0.4';
            b.innerHTML = `<span class="flex justify-between"><span class="font-mono text-[18px] leading-none font-medium">${k}</span><span class="font-mono text-[9px] opacity-70"></span></span><span class="line-clamp-2 text-[13px] leading-tight font-semibold"></span>${p && layer === 'episode' ? '<span class="absolute top-1.5 left-1/2 size-1.5 -translate-x-1/2 rounded-full bg-black/60"></span>' : ''}`;
            b.children[0].children[1].textContent = padTag(pad);
            b.children[1].textContent = pad.name;
            if (from) b.title = 'From the show set · click to override for this episode';
          } else {
            b.className += ' border border-dashed border-edge-strong text-subtle hover:border-fg';
            b.innerHTML = `<span class="font-mono text-[18px] leading-none font-medium">${k}</span><span class="text-[12px] leading-tight">Empty · click to assign</span>`;
          }
          b.addEventListener('click', () => select(k));
          b.addEventListener('dragstart', (e) => e.dataTransfer?.setData('text/plain', String(k)));
          b.addEventListener('dragover', (e) => e.preventDefault());
          b.addEventListener('drop', (e) => {
            e.preventDefault();
            const fromKey = Number(e.dataTransfer?.getData('text/plain'));
            if (!fromKey || fromKey === k) return;
            saveSet(swapKeys(setOf(), fromKey, k));
            if (key === fromKey) key = k;
            select(key, true);
          });
          return b;
        }),
      );
    }

    $$('[data-layer]').forEach((b) =>
      b.addEventListener('click', () => {
        layer = b.dataset.layer as typeof layer;
        $$('[data-layer]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        select(key, true);
      }),
    );

    // ── The selected pad ──────────────────────────────────────────────────────
    function select(k: number, force = false) {
      if (dirty && !force && k !== key && !confirm('Discard the changes to this pad?')) return;
      key = k;
      const own = setOf().find((p) => p.key === k);
      const inherited = layer === 'episode' ? loadShowPads().find((p) => p.key === k) : undefined;
      draft = own ? { ...own } : inherited ? { ...inherited, id: newPad(k, inherited.kind, { id: '', seconds: 0, name: '' }).id } : null;
      dirty = false;
      renderGrid();
      renderDetail();
      if (draft) ensureAudio(draft.fileId).then(drawWave);
    }

    const kindPressed = () => $$('[data-kind]').find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.kind as PadKind | undefined;
    function showKind(kind: PadKind | undefined) {
      $$('[data-kind]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === kind)));
      $('[data-src="bite"]').hidden = kind !== 'bite';
      $('[data-src="clip"]').hidden = kind !== 'clip';
      $('[data-src="upload"]').hidden = kind !== 'music' && kind !== 'sfx';
      $('[data-kind-note]').textContent =
        kind === 'music'
          ? 'Music loops under your voice with a 2 s fade out.'
          : kind === 'sfx'
            ? 'A sound effect plays once, with no fade and no ducking.'
            : kind === 'bite'
              ? 'A soundbite from an episode package, cut from its session.'
              : kind === 'clip'
                ? 'Any range of a saved session.'
                : "Pick from past episodes' soundbites and clips, or upload WAV, MP3, M4A or FLAC.";
    }

    function renderDetail() {
      const d = draft;
      const keyEl = $('[data-d-key]');
      keyEl.textContent = String(key);
      keyEl.style.background = d ? padColor(d.color) : 'var(--color-raised)';
      keyEl.style.color = d ? PAD_INK : '';
      $<HTMLInputElement>('[data-d-name]').value = d?.name ?? '';
      $('[data-d-source]').textContent = d
        ? `${d.source ?? 'Library'} · ${minSec(d.seconds)} · 48 kHz${layer === 'episode' ? ' · this episode only' : ''}`
        : layer === 'episode'
          ? 'Nothing on this key for this episode'
          : 'No sound yet. Pick one below.';
      showKind(d?.kind);
      for (const el of $$('[data-colors] button')) el.setAttribute('aria-checked', String(el.dataset.color === d?.color));
      for (const b of $$('[data-mode]')) b.setAttribute('aria-pressed', String(b.dataset.mode === d?.mode));
      $('[data-mode-note]').textContent = !d
        ? ''
        : d.mode === 'loop'
          ? `Plays until you press ${key} again, then fades out over the fade-out time.`
          : d.mode === 'hold'
            ? `Plays only while ${key} is held down.`
            : `Plays once. Pressing ${key} again starts it from the top.`;
      const gain = $<HTMLInputElement>('[data-d-gain]');
      gain.value = String(d?.gainDb ?? 0);
      $('[data-d-gain-text]').textContent = `${(d?.gainDb ?? 0) > 0 ? '+' : ''}${d?.gainDb ?? 0} dB`.replace('-', '−');
      $<HTMLInputElement>('[data-d-fadein]').value = String(d?.fadeInMs ?? 0);
      $<HTMLInputElement>('[data-d-fadeout]').value = String(d?.fadeOutMs ?? 0);
      $<HTMLInputElement>('[data-d-trimstart]').value = d ? String(d.trimStart) : '0';
      $<HTMLInputElement>('[data-d-trimend]').value = d && d.trimEnd ? String(d.trimEnd) : '';
      $<HTMLInputElement>('[data-d-duck]').checked = !!d?.duck;
      $<HTMLInputElement>('[data-d-duckdb]').value = String(d?.duckDb ?? 12);
      for (const el of $$<HTMLInputElement | HTMLButtonElement>('[data-detail] input:not([type=file]), [data-mode], [data-colors] button, [data-d-preview]'))
        if (!el.matches('[data-d-name]')) el.disabled = !d;
      $<HTMLInputElement>('[data-d-name]').disabled = !d;
      $<HTMLButtonElement>('[data-d-clear]').disabled = !setOf().some((p) => p.key === key);
      $<HTMLButtonElement>('[data-d-save]').disabled = !d || !dirty;
      $('[data-d-status]').textContent = dirty ? 'Not saved' : '';
      drawWave();
    }

    const change = (patch: Partial<Pad>) => {
      if (!draft) return;
      draft = { ...draft, ...patch };
      dirty = true;
      renderDetail();
    };

    // Colours
    $('[data-colors]').replaceChildren(
      ...PAD_COLORS.map((c) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.role = 'radio';
        b.dataset.color = c;
        b.ariaLabel = c;
        b.className = 'size-8 rounded-lg aria-checked:shadow-[0_0_0_2px_var(--color-panel),0_0_0_4px_var(--color-fg)] disabled:opacity-40';
        b.style.background = padColor(c);
        b.addEventListener('click', () => change({ color: c }));
        return b;
      }),
    );
    $$('[data-mode]').forEach((b) => b.addEventListener('click', () => change({ mode: b.dataset.mode as Pad['mode'] })));
    $<HTMLInputElement>('[data-d-name]').addEventListener('input', (e) => {
      if (!draft) return;
      draft.name = (e.target as HTMLInputElement).value;
      dirty = true;
      $<HTMLButtonElement>('[data-d-save]').disabled = false;
      $('[data-d-status]').textContent = 'Not saved';
    });
    const num = (sel: string, f: keyof Pad, scale = 1) =>
      $<HTMLInputElement>(sel).addEventListener('change', (e) => {
        const v = Number((e.target as HTMLInputElement).value || 0) * scale;
        if (Number.isFinite(v)) change({ [f]: Math.max(0, v) } as Partial<Pad>);
      });
    num('[data-d-fadein]', 'fadeInMs');
    num('[data-d-fadeout]', 'fadeOutMs');
    num('[data-d-trimstart]', 'trimStart');
    num('[data-d-trimend]', 'trimEnd');
    num('[data-d-duckdb]', 'duckDb');
    $<HTMLInputElement>('[data-d-gain]').addEventListener('input', (e) => change({ gainDb: Number((e.target as HTMLInputElement).value) }));
    $<HTMLInputElement>('[data-d-duck]').addEventListener('change', (e) => change({ duck: (e.target as HTMLInputElement).checked }));

    // The kind sets the source picker, and the defaults once a sound is chosen.
    $$('[data-kind]').forEach((b) =>
      b.addEventListener('click', () => {
        const kind = b.dataset.kind as PadKind;
        showKind(kind);
        if (draft && draft.kind !== kind) change({ kind, ...KIND_DEFAULTS[kind] });
      }),
    );

    /** A new sound for the selected pad: keep its settings, or start from the kind's. */
    function useFile(file: { id: string; seconds: number; name: string; source?: string }, kind: PadKind) {
      if (draft) change({ fileId: file.id, seconds: file.seconds, source: file.source, name: draft.name || file.name, trimStart: 0, trimEnd: 0, kind, ...(draft.kind !== kind ? KIND_DEFAULTS[kind] : {}) });
      else {
        draft = newPad(key, kind, file);
        dirty = true;
        renderDetail();
      }
      ensureAudio(file.id).then(drawWave);
    }

    // Uploads and the library
    const status = (t: string) => ($('[data-d-status]').textContent = t);
    $<HTMLInputElement>('[data-upload]').addEventListener('change', async (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      if (!f) return;
      status(`Converting ${f.name}…`);
      try {
        const stereo = await decodeToLibraryRate(await f.arrayBuffer());
        const saved = await saveLibraryFile(stereo, { name: f.name.replace(/\.[^.]+$/, ''), source: `Upload · ${f.name}` });
        audio.set(saved.id, stereo);
        useFile(saved, kindPressed() === 'sfx' ? 'sfx' : 'music');
        fillLibrary();
      } catch (err) {
        status(`Couldn’t read ${f.name}: ${(err as Error).message}`);
      }
      (e.target as HTMLInputElement).value = '';
    });
    const library = $<HTMLSelectElement>('[data-library]');
    async function fillLibrary() {
      const files = await listLibrary().catch(() => []);
      library.replaceChildren(new Option(files.length ? 'Or pick from the library…' : 'The library is empty', ''), ...files.map((f) => new Option(`${f.name} · ${minSec(f.seconds)}`, f.id)));
      library.onchange = () => {
        const f = files.find((x) => x.id === library.value);
        if (f) useFile(f, kindPressed() === 'sfx' ? 'sfx' : 'music');
        library.value = '';
      };
    }
    fillLibrary();

    // Soundbites (episode package) and clips (any session range), cut from saved sessions.
    const sessions: TakeMeta[] = [];
    const bites = JSON.parse(root.dataset.bites || '[]') as { s: string; e: string; title: string }[];
    async function fillSessions() {
      sessions.push(...(await listTakes().catch(() => [])).filter((t) => t.kind === 'session' && t.status === 'done' && !t.remote));
      const clip = $<HTMLSelectElement>('[data-clip-take]');
      clip.replaceChildren(
        ...(sessions.length ? sessions.map((t) => new Option(`Ep. ${t.episodeId} · ${t.name} · ${minSec(t.samples / t.sampleRate)}`, t.id)) : [new Option('No saved sessions in this browser', '')]),
      );
      const own = sessions.filter((t) => t.episodeId === episodeId).at(-1) ?? sessions.at(-1);
      const bite = $<HTMLSelectElement>('[data-bite]');
      bite.replaceChildren(new Option('Pick a soundbite…', ''), ...bites.map((b, i) => new Option(`${b.s.replace(/^00:/, '')} · ${b.title}`, String(i))));
      $('[data-bite-note]').textContent = own ? `Cut from ${own.name} (Ep. ${own.episodeId}).` : 'Record a session first: soundbites are cut from it.';
      bite.onchange = async () => {
        const b = bites[Number(bite.value)];
        if (!b || !own) return;
        await cut(own, parseTime(b.s), parseTime(b.e), b.title.split(/\s+/).slice(0, 4).join(' ') + '…', `Soundbite from Ep. ${own.episodeId}`, 'bite');
        bite.value = '';
      };
    }
    fillSessions();
    $('[data-clip-use]').addEventListener('click', async () => {
      const take = sessions.find((t) => t.id === $<HTMLSelectElement>('[data-clip-take]').value);
      const from = parseTime($<HTMLInputElement>('[data-clip-from]').value || '0');
      const to = parseTime($<HTMLInputElement>('[data-clip-to]').value);
      if (!take || !(to > from)) return status('Pick a session and a start and end, like 1:20 – 1:32.');
      await cut(take, from, to, `Clip ${minSec(from)}`, `Clip from Ep. ${take.episodeId} · ${minSec(from)}–${minSec(to)}`, 'clip');
    });

    async function cut(take: TakeMeta, from: number, to: number, name: string, source: string, kind: PadKind) {
      const t = (await getTake(take.id)) ?? take;
      const len = t.samples / t.sampleRate;
      if (!(from < len)) return status(`That session is only ${minSec(len)} long.`);
      status('Cutting…');
      const a = Math.floor(from * t.sampleRate);
      const n = Math.floor((Math.min(to, len) - from) * t.sampleRate);
      const x = await readFrames(t, a, n);
      const ch = t.channels ?? 1;
      const l = new Float32Array(n);
      const r = new Float32Array(n);
      for (let i = 0; i < n; i++) {
        l[i] = x[i * ch];
        r[i] = x[i * ch + (ch > 1 ? 1 : 0)];
      }
      // To the library's rate, if the session was recorded at another.
      let stereo = interleave(l, r);
      if (t.sampleRate !== LIBRARY_RATE) {
        const ctx = new OfflineAudioContext(2, Math.ceil((n / t.sampleRate) * LIBRARY_RATE), LIBRARY_RATE);
        const buf = ctx.createBuffer(2, n, t.sampleRate);
        buf.copyToChannel(l, 0);
        buf.copyToChannel(r, 1);
        const src = ctx.createBufferSource();
        src.buffer = buf;
        src.connect(ctx.destination);
        src.start();
        const out = await ctx.startRendering();
        stereo = interleave(out.getChannelData(0), out.getChannelData(1));
      }
      const saved = await saveLibraryFile(stereo, { name, source });
      audio.set(saved.id, stereo);
      useFile(saved, kind);
      fillLibrary();
    }

    // ── Waveform and preview ──────────────────────────────────────────────────
    async function ensureAudio(id: string) {
      if (!id || audio.has(id)) return;
      try {
        audio.set(id, await readLibraryFile(id));
      } catch {}
    }
    function drawWave() {
      const canvas = $<HTMLCanvasElement>('[data-d-wave]');
      const w = (canvas.width = canvas.clientWidth * devicePixelRatio || 600);
      const h = canvas.height;
      const g = canvas.getContext('2d')!;
      g.clearRect(0, 0, w, h);
      const x = draft && audio.get(draft.fileId);
      if (!draft || !x) return;
      const frames = x.length / 2;
      const color = getComputedStyle(document.documentElement).getPropertyValue(`--color-spk-${draft.color}`) || '#fff';
      const a = (draft.trimStart / draft.seconds) * w;
      const b = ((draft.trimEnd > 0 ? draft.trimEnd : draft.seconds) / draft.seconds) * w;
      const step = Math.max(1, Math.floor(frames / w));
      for (let px = 0; px < w; px++) {
        let peak = 0;
        for (let i = px * step; i < Math.min(frames, (px + 1) * step); i += 4) peak = Math.max(peak, Math.abs(x[2 * i]), Math.abs(x[2 * i + 1]));
        g.fillStyle = color;
        g.globalAlpha = px >= a && px <= b ? 1 : 0.25;
        const bar = Math.max(1, peak * h);
        g.fillRect(px, (h - bar) / 2, 1, bar);
      }
    }
    let preview: PadEngine | null = null;
    $('[data-d-preview]').addEventListener('click', async () => {
      if (!draft) return;
      preview?.stopAll();
      preview = new PadEngine({ ...loadPadSettings(), volumeDb: 0 });
      await preview.load([{ ...draft, key: 1 }]);
      preview.press(1);
      // Hold and loop pads stop on their own after a few seconds here.
      if (draft.mode !== 'oneshot') setTimeout(() => preview?.fadeAll(draft!.fadeOutMs / 1000 || 0.15), 4000);
    });

    // ── Save and clear ────────────────────────────────────────────────────────
    $('[data-d-save]').addEventListener('click', () => {
      if (!draft) return;
      if (!draft.name.trim()) draft.name = `Pad ${key}`;
      saveSet(setPad(setOf(), key, draft));
      dirty = false;
      select(key, true);
      status('Saved');
    });
    $('[data-d-clear]').addEventListener('click', () => {
      if (!confirm(layer === 'episode' ? 'Remove this episode’s pad? The show set’s pad comes back.' : 'Clear this pad? Its sound stays in the library.')) return;
      saveSet(setPad(setOf(), key, null));
      select(key, true);
    });

    // Ducking for the whole rail
    const settings = loadPadSettings();
    for (const el of $$<HTMLInputElement>('[data-g]')) {
      const f = el.dataset.g as keyof PadSettings;
      el.value = String(settings[f]);
      el.addEventListener('change', () => {
        const v = Number(el.value);
        if (Number.isFinite(v)) savePadSettings({ [f]: v });
      });
    }

    addEventListener('beforeunload', (e) => {
      if (dirty) e.preventDefault();
    });
    select(key, true);
  }
</script>
