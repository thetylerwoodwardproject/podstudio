---
import Section from './Section.astro';
import { server } from '@/data/mock';

// Everything Podstudio ships that someone else made, with its licence.
const credits = [
  {
    name: 'DeepFilterNet3',
    use: 'Noise suppression in exports, previews and the mic check',
    who: 'Hendrik Schröter, Tobias Rosenkranz, Alberto N. Escalante-B. and Andreas Maier',
    licence: 'MIT or Apache-2.0',
    href: 'https://github.com/Rikorose/DeepFilterNet',
    files: [
      ['MIT licence', '/vendor/deepfilter/LICENSE-MIT'],
      ['Apache licence', '/vendor/deepfilter/LICENSE-APACHE'],
    ],
    note: 'Schröter et al., “DeepFilterNet: Perceptually Motivated Real-Time Speech Enhancement,” Interspeech 2023. Built to WebAssembly from the upstream source; the model is unchanged.',
  },
  { name: 'Astro', use: 'The app', who: 'The Astro Technology Company and contributors', licence: 'MIT', href: 'https://astro.build' },
  { name: 'Tailwind CSS', use: 'Styling', who: 'Tailwind Labs', licence: 'MIT', href: 'https://tailwindcss.com' },
  { name: 'Geist and Geist Mono', use: 'Interface type', who: 'The Geist Project Authors', licence: 'SIL Open Font License 1.1', href: 'https://github.com/vercel/geist-font' },
  { name: 'Atkinson Hyperlegible', use: 'Prompter type', who: 'Braille Institute of America', licence: 'SIL Open Font License 1.1', href: 'https://www.brailleinstitute.org/freefont/' },
  { name: 'Fontsource', use: 'Self-hosted font packages', who: 'Fontsource contributors', licence: 'MIT', href: 'https://fontsource.org' },
];
---

<Section title="About & credits" description="Podstudio is free and self-hosted, and it's built on other people's open-source work." />
<div class="flex items-center justify-between border-b border-line py-2.5 text-[13px]">
  <span class="text-muted">Version</span>
  <span class="font-mono">{server.version}</span>
</div>

<div class="flex flex-col gap-2.5">
  <h2 class="eyebrow">Open source in Podstudio</h2>
  <ul class="flex flex-col">
    {
      credits.map((c) => (
        <li class="flex flex-col gap-1 border-b border-line py-3.5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <a href={c.href} target="_blank" rel="noopener" class="text-[14px] text-fg underline-offset-2 hover:underline">
              {c.name}
            </a>
            <span class="font-mono text-[11px] text-muted">{c.licence}</span>
          </div>
          <div class="text-[12px] text-muted">
            {c.use} · {c.who}
          </div>
          {c.note && <p class="text-[12px] leading-normal text-subtle">{c.note}</p>}
          {c.files && (
            <div class="flex gap-4 text-[12px]">
              {c.files.map(([label, href]) => (
                <a href={href} target="_blank" class="text-muted underline-offset-2 hover:text-fg hover:underline">
                  {label}
                </a>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ul>
</div>

<p class="text-[12px] leading-normal text-subtle">
  The noise suppression works the way Waves NS1 does, with one adaptive fader. Waves and NS1 are trademarks of Waves Audio
  Ltd. Podstudio isn't affiliated with or endorsed by Waves.
</p>
