---
import Section from './Section.astro';
import Card from '@/components/ui/Card.astro';
import Row from '@/components/ui/Row.astro';
import { version } from '../../../package.json';

// Everything Podstudio ships that someone else made, with its licence.
const credits = [
  {
    name: 'DeepFilterNet3',
    use: 'Noise suppression in exports, previews and the mic check',
    who: 'Hendrik Schröter, Tobias Rosenkranz, Alberto N. Escalante-B. and Andreas Maier',
    licence: 'MIT or Apache-2.0',
    href: 'https://github.com/Rikorose/DeepFilterNet',
    files: [
      ['MIT licence', '/vendor/deepfilter/LICENSE-MIT'],
      ['Apache licence', '/vendor/deepfilter/LICENSE-APACHE'],
    ],
    note: 'Schröter et al., “DeepFilterNet: Perceptually Motivated Real-Time Speech Enhancement,” Interspeech 2023. Built to WebAssembly from the upstream source; the model is unchanged.',
  },
  {
    name: 'lamejs',
    use: 'MP3 of the ready-to-publish episode',
    who: 'Alex Zhukov, after LAME by the LAME project',
    licence: 'LGPL-3.0',
    href: 'https://github.com/zhuker/lamejs',
    files: [
      ['LGPL licence', '/vendor/lamejs/LICENSE-LGPL-3.0'],
      ['GPL licence', '/vendor/lamejs/LICENSE-GPL-3.0'],
      ['LAME project', 'https://lame.sourceforge.io'],
    ],
    note: 'LAME in JavaScript (@breezystack/lamejs), unchanged, in its own file that loads only when an MP3 is made.',
  },
  { name: 'Astro', use: 'The app', who: 'The Astro Technology Company and contributors', licence: 'MIT', href: 'https://astro.build' },
  { name: 'Tailwind CSS', use: 'Styling', who: 'Tailwind Labs', licence: 'MIT', href: 'https://tailwindcss.com' },
  { name: 'shadcn-svelte', use: 'Locally adapted interface components', who: 'Hunter Johnston, CokaKoala, shadcn and contributors', licence: 'MIT', href: 'https://shadcn-svelte.com', files: [['MIT licence', '/vendor/shadcn-svelte/LICENSE.md']] },
  { name: 'Bits UI', use: 'Accessible controls behind the interface components', who: 'Hunter Johnston and contributors', licence: 'MIT', href: 'https://www.bits-ui.com', files: [['MIT licence', '/vendor/bits-ui/LICENSE']] },
  { name: 'More Shadcn Svelte', use: 'Starting point for audio controls, FX knobs, status dots and step indicators', who: 'kevwpl and contributors', licence: 'MIT', href: 'https://github.com/kevwpl/more-shadcn-svelte', files: [['MIT licence', '/vendor/more-shadcn-svelte/LICENSE']], note: 'Locally adapted to Podstudio’s audio transport and visual design.' },
  { name: 'svelte-sonner', use: 'Top-of-screen save notifications', who: 'Robert Soriano and contributors', licence: 'MIT', href: 'https://github.com/wobsoriano/svelte-sonner', files: [['MIT licence', '/vendor/svelte-sonner/LICENSE']] },
  { name: 'Lucide', use: 'Interface icons', who: 'Lucide contributors; portions derived from Feather by Cole Bemis', licence: 'ISC and MIT', href: 'https://lucide.dev', files: [['ISC and MIT licences', '/vendor/lucide/LICENSE']] },
  { name: 'Atkinson Hyperlegible', use: 'Prompter type', who: 'Braille Institute of America', licence: 'SIL Open Font License 1.1', href: 'https://www.brailleinstitute.org/freefont/' },
  { name: 'Fontsource', use: 'Self-hosted prompter fonts', who: 'Fontsource contributors', licence: 'MIT', href: 'https://fontsource.org' },
];
---

<Section title="About & credits" description="Podstudio is free and self-hosted, and it's built on other people's open-source work." />
<Card rows>
  <Row title="Version"><span class="font-mono text-[13px] text-text" data-version>v{version}</span></Row>
  <Row title="Licence" hint="Free to use, change and share">
    <a href="https://github.com/thetylerwoodwardproject/podstudio/blob/main/LICENSE" target="_blank" rel="noopener" class="font-mono text-[13px] text-text underline-offset-2 hover:underline">MIT</a>
  </Row>
  <Row title="Made by" hint="tylerwoodward.me">
    <a href="https://tylerwoodward.me" target="_blank" rel="noopener" class="text-[14px] text-text underline-offset-2 hover:underline">Tyler Woodward</a>
  </Row>
  <Row title="Manual" hint="Recording, editing, export, and troubleshooting">
    <a href="/manual" class="text-[14px] text-text underline-offset-2 hover:underline">Open manual</a>
  </Row>
</Card>

<Card label="Open source in Podstudio" rows>
  <ul class="flex flex-col">
    {
      credits.map((c) => (
        <li class="mx-5 flex flex-col gap-1 border-t border-divider py-[18px] first:border-t-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <a href={c.href} target="_blank" rel="noopener" class="text-[14px] text-text underline-offset-2 hover:underline">
              {c.name}
            </a>
            <span class="font-mono text-[11px] font-medium tracking-[0.06em] text-text-3 uppercase">{c.licence}</span>
          </div>
          <div class="text-[13px] text-text-2">
            {c.use} · {c.who}
          </div>
          {c.note && <p class="text-[13px] leading-normal text-text-3">{c.note}</p>}
          {c.files && (
            <div class="flex gap-4 text-[13px]">
              {c.files.map(([label, href]) => (
                <a href={href} target="_blank" class="text-text-2 underline-offset-2 hover:text-text hover:underline">
                  {label}
                </a>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ul>
</Card>

<p class="help">
  The noise suppression works the way Waves NS1 does, with one adaptive fader. Waves and NS1 are trademarks of Waves Audio
  Ltd. Podstudio isn't affiliated with or endorsed by Waves.
</p>
