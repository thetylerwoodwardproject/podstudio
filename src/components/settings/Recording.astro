---
/*
 * Settings → Recording (Settings_Recording.dc.html): input, export defaults
 * (noise suppression, marker tones) and session behaviour, in framework cards.
 */
import Section from './Section.astro';
import ToggleRow from './ToggleRow.astro';
import Block from '@/components/ui/Block.astro';
import Card from '@/components/ui/Card.astro';
import Row from '@/components/ui/Row.astro';
import CheckChip from '@/components/ui/CheckChip.astro';
import Segmented from '@/components/ui/Segmented.astro';
import Select from '@/components/ui/Select.astro';
import Switch from '@/components/ui/Switch.astro';
import { mbPerMinute } from '@/lib/audio/format';

const label = 'text-[14px] text-text';
const kinds = [
  ['retake', 'Retake', '1 kHz'],
  ['cut', 'Cough', '600 Hz'],
  ['adlib', 'Ad-lib', '1.4 kHz'],
  ['pause', 'Pause', '800 Hz'],
  ['gap', 'Mic stopped', '400 Hz'],
];
const toneSliders = [
  ['level', 'Tone level', -30, -6, 1, 'dBFS'],
  ['duck', 'Duck under voice', 0, 24, 1, 'dB'],
  ['attackMs', 'Attack', 1, 100, 1, 'ms'],
  ['releaseMs', 'Release', 20, 1000, 10, 'ms'],
] as const;
---

<Section title="Recording" description="Defaults for new sessions. The host can change them per session from the studio." />

<Card label="Input" class="flex flex-col p-0!">
  <div class="flex flex-col gap-2 p-5" data-live-only>
    <label for="rec-mic" class={label}>Microphone</label>
    <Select id="rec-mic" options={['System default']} data-rec-mic />
    <p class="help">
      Used for recording and voice follow. System default follows your computer's sound settings. On a multi-input
      interface, mono lists each input; stereo records inputs 1 and 2 as left and right.
    </p>
  </div>
  <div class="mx-5 grid gap-4 border-t border-divider py-5 sm:grid-cols-3" data-format>
    <div class="flex flex-col gap-2">
      <div class={label}>Channels</div>
      <Segmented name="channels" label="Channels" value="1" options={[{ value: '1', label: 'Mono' }, { value: '2', label: 'Stereo' }]} />
    </div>
    <div class="flex flex-col gap-2">
      <div class={label}>Bit depth</div>
      <Segmented name="depth" label="Bit depth" value="24" options={[{ value: '16', label: '16-bit' }, { value: '24', label: '24-bit' }]} />
    </div>
    <div class="flex flex-col gap-2">
      <div class={label}>Sample rate</div>
      <Segmented name="rate" label="Sample rate" value="48" options={[{ value: '44.1', label: '44.1 kHz' }, { value: '48', label: '48 kHz' }]} />
    </div>
  </div>
  <div class="flex flex-col gap-1.5 border-t border-divider px-5 py-4">
    <div class="font-mono text-[13px] text-text">
      <span data-channels-label>Mono</span> WAV · <span data-depth-label>24-bit</span> · <span data-rate-label>48 kHz</span> ·
      <span data-size>{mbPerMinute(24, 48)}</span> MB/min per speaker
    </div>
    <p class="text-[13px] text-text-3">If the device runs at another rate, Podstudio uses it. Nothing is resampled.</p>
  </div>
</Card>

<section class="flex flex-col gap-3">
  <h2 class="section-label">Exports</h2>
  <div class="rounded-[14px] bg-surface p-5">
    <div class="flex items-center justify-between">
      <label for="rec-ns" class={label}>Noise suppression</label>
      <span class="font-mono text-[13px] text-text" data-ns-value>Off</span>
    </div>
    <input id="rec-ns" type="range" min="0" max="100" step="5" value="0" class="mt-4 w-full" data-ns />
    <div class="mt-2 flex justify-between font-mono text-[11px] text-text-3" aria-hidden="true">
      <span>Off</span><span>Light</span><span>Medium</span><span>Strong</span>
    </div>
    <p class="help mt-4">
      Starting point for the export fader. Higher removes more room sound. Exports include both the raw and cleaned
      versions, and the mic check suggests a value for your room. Powered by
      <a href="/settings/about" class="underline-offset-2 hover:text-text hover:underline">DeepFilterNet3</a>.
    </p>
  </div>

  <div class="rounded-[14px] bg-surface" data-tones>
    <div class="flex items-center justify-between gap-4 p-5">
      <div>
        <div class={label} id="tone-default-label">Marker tones on the full recording</div>
        <div class="mt-0.5 text-[13px] text-text-2">A short beep at each marker so edit points can be heard. The edit stays clean.</div>
      </div>
      <label
        class="relative inline-flex h-6 w-10 flex-none items-center rounded-full bg-track-off transition-colors has-checked:bg-text has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-text"
      >
        <input type="checkbox" role="switch" class="peer sr-only" aria-labelledby="tone-default-label" data-tone-default />
        <span class="absolute top-[3px] left-[3px] size-[18px] rounded-full bg-text-2 transition-all peer-checked:left-[19px] peer-checked:bg-page"></span>
      </label>
    </div>
    <!-- Dimmed while tones are off; they can still be set up -->
    <div class="mx-5 flex flex-col gap-5 border-t border-divider pt-5 pb-5 transition-opacity" data-tone-options>
      <div class="flex flex-col gap-3">
        <div class={label}>Markers that beep</div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Markers that beep">
          {kinds.map(([k, text, hz]) => <CheckChip label={text} detail={hz} data-tone-kind={k} />)}
        </div>
      </div>
      <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
        {
          toneSliders.map(([k, text, min, max, step, unit]) => (
            <label class="flex flex-col gap-3">
              <span class="flex justify-between text-[14px] text-text">
                {text}
                <span class="font-mono text-[13px]" data-tone-value={k} />
              </span>
              <input type="range" min={min} max={max} step={step} class="w-full" data-tone-range={k} data-unit={unit} />
            </label>
          ))
        }
      </div>
      <p class="help">Tones duck under your voice by the duck amount. Attack sets how fast they drop when you start talking; release sets how fast they return.</p>
    </div>
  </div>
</section>

<Card label="Ready to publish" rows data-publish>
  <Row title="Episode file" hint="Everyone mixed into one file, ready for your podcast host. The separate tracks are always in the export too.">
    <Switch name="publish-mix" label="Episode file" />
  </Row>
  <Block data-publish-options>
    <div class="flex items-center justify-between"><span class={label}>Loudness</span><span class="font-mono text-[13px] text-text" data-publish-target>−16 LUFS</span></div>
    <Segmented
      name="publish-loudness"
      label="Loudness"
      value="stereo"
      options={[
        { value: 'stereo', label: 'Stereo' },
        { value: 'mono', label: 'Mono' },
        { value: 'off', label: 'Off' },
      ]}
    />
    <p class="help">The usual podcast targets: stereo and mono sound equally loud at these. True peaks are kept under <span class="font-mono text-[12px] whitespace-nowrap">−1 dBTP</span> so MP3 encoding doesn't clip. Off only limits the peaks.</p>
    <p class="help" data-publish-mono-note hidden>Pads are stereo. Mono sums left and right into one channel, at the same balance you hear in stereo.</p>
  </Block>
  <Row title="Level each speaker" data-publish-options>
    <Fragment slot="hint">Evens out each voice, by up to <span class="font-mono text-[12px] whitespace-nowrap">12 dB</span>, so nobody's quieter than the rest. Makes levelled copies; the originals are kept.</Fragment>
    <Switch name="publish-level" label="Level each speaker" />
  </Row>
  <Row title="MP3 too" data-publish-options>
    <Fragment slot="hint"><span class="font-mono text-[12px] whitespace-nowrap">128 kbps</span> mono or <span class="font-mono text-[12px] whitespace-nowrap">192 kbps</span> stereo, beside the WAV</Fragment>
    <Switch name="publish-mp3" label="MP3 too" />
  </Row>
  <Row title="Loudness meter" hint="On the export page: the episode's loudness while you preview, and what the finished file measured" data-publish-options>
    <Switch name="publish-meter" label="Loudness meter" />
  </Row>
  <Row title="Tone" data-publish-options data-publish-voices>
    <Fragment slot="hint"><span data-voices-text>Set each person's EQ and compressor on the export page; it's remembered here by name.</span></Fragment>
    <button type="button" class="h-9 flex-none rounded-[10px] border border-border px-3 text-[14px] text-text hover:border-handle" data-voices-forget hidden>Forget</button>
  </Row>
</Card>

<Card label="Session" rows>
  <ToggleRow name="mic-check" checked title="Mic check before every session" hint="Level, clipping, room noise and voice follow" />
  <ToggleRow name="autosave" title="Save audio every 5 seconds" hint="Protects takes from crashes and closed tabs" locked="Always on" />
</Card>

<script>
  import { channelsLabel, mbPerMinute } from '@/lib/audio/format';
  import { loadSettings, saveSettings } from '@/lib/settings';
  import { toneActive, toneSummary } from '@/lib/audio/tone';
  import { inputChoices, inputFor } from '@/lib/audio/devices';

  // Marker tones.
  const tonesBox = document.querySelector<HTMLElement>('[data-tones]');
  if (tonesBox) {
    const t = loadSettings().recording.tones;
    const save = () => saveSettings('recording', { tones: t });
    const def = tonesBox.querySelector<HTMLInputElement>('[data-tone-default]')!;
    def.checked = t.inExports;
    const options = tonesBox.querySelector<HTMLElement>('[data-tone-options]')!;
    const dim = () => options.classList.toggle('opacity-40', !def.checked);
    dim();
    def.addEventListener('change', () => ((t.inExports = def.checked), dim(), save()));
    tonesBox.querySelectorAll<HTMLInputElement>('[data-tone-kind]').forEach((box) => {
      const k = box.dataset.toneKind as keyof typeof t.kinds;
      box.checked = t.kinds[k];
      box.addEventListener('change', () => ((t.kinds[k] = box.checked), save()));
    });
    tonesBox.querySelectorAll<HTMLInputElement>('[data-tone-range]').forEach((r) => {
      const k = r.dataset.toneRange as 'level' | 'duck' | 'attackMs' | 'releaseMs';
      const out = tonesBox.querySelector(`[data-tone-value="${k}"]`)!;
      const show = () => (out.textContent = `${r.value.replace('-', '−')} ${r.dataset.unit}`);
      r.value = String(t[k]);
      show();
      r.addEventListener('input', show);
      r.addEventListener('change', () => ((t[k] = Number(r.value)), save()));
    });
  }

  // Ready to publish.
  const pub = document.querySelector<HTMLElement>('[data-publish]');
  if (pub) {
    const p = loadSettings().recording.publish;
    const box = (n: string) => pub.querySelector<HTMLInputElement>(`[name="${n}"]`)!;
    box('publish-mix').checked = p.mix;
    box('publish-level').checked = p.level;
    box('publish-mp3').checked = p.mp3;
    box('publish-meter').checked = p.meter;
    // Remembered tones, by name
    const showVoices = () => {
      const voices = loadSettings().recording.publish.voices;
      const names = Object.keys(voices).filter((n) => toneActive(voices[n]));
      const cap = (n: string) => n.charAt(0) + n.slice(1).toLowerCase();
      pub.querySelector('[data-voices-text]')!.textContent = names.length
        ? `Remembered for ${names.map(cap).join(', ').replace(/, ([^,]*)$/, ' and $1')}: ${names.map((n) => toneSummary(voices[n])).join('; ')}. Change them on the export page.`
        : "Set each person's EQ and compressor on the export page; it's remembered here by name.";
      pub.querySelector<HTMLElement>('[data-voices-forget]')!.hidden = !names.length;
    };
    showVoices();
    pub.querySelector('[data-voices-forget]')!.addEventListener('click', () => {
      saveSettings('recording', { publish: { ...loadSettings().recording.publish, voices: {} } });
      showVoices();
    });
    pub.querySelector<HTMLInputElement>(`[name="publish-loudness"][value="${p.loudness}"]`)!.checked = true;
    const targets = { stereo: '−16 LUFS', mono: '−19 LUFS', off: 'Off' };
    const dim = () => {
      pub.querySelectorAll<HTMLElement>('[data-publish-options]').forEach((el) => {
        el.classList.toggle('opacity-40', !box('publish-mix').checked);
        el.inert = !box('publish-mix').checked;
      });
      pub.querySelector('[data-publish-target]')!.textContent = targets[pub.querySelector<HTMLInputElement>('[name="publish-loudness"]:checked')!.value as keyof typeof targets];
      pub.querySelector<HTMLElement>('[data-publish-mono-note]')!.hidden = pub.querySelector<HTMLInputElement>('[name="publish-loudness"]:checked')!.value !== 'mono';
    };
    dim();
    pub.addEventListener('change', () => {
      saveSettings('recording', {
        publish: {
          ...loadSettings().recording.publish,
          meter: box('publish-meter').checked,
          mix: box('publish-mix').checked,
          level: box('publish-level').checked,
          mp3: box('publish-mp3').checked,
          loudness: pub.querySelector<HTMLInputElement>('[name="publish-loudness"]:checked')!.value as 'stereo' | 'mono' | 'off',
        },
      });
      dim();
    });
  }

  // Noise suppression default.
  const ns = document.querySelector<HTMLInputElement>('[data-ns]');
  if (ns) {
    const show = () => (document.querySelector('[data-ns-value]')!.textContent = Number(ns.value) ? `${ns.value}%` : 'Off');
    ns.value = String(loadSettings().recording.noiseSuppression);
    show();
    ns.addEventListener('input', show);
    ns.addEventListener('change', () => saveSettings('recording', { noiseSuppression: Number(ns.value) }));
  }

  // Microphone: names show once the browser has been allowed to use the mic.
  const micSelect = document.querySelector<HTMLSelectElement>('[data-rec-mic]');
  if (micSelect) {
    const fill = async () => {
      const { deviceId, channels } = loadSettings().recording;
      const saved = inputFor(deviceId, channels);
      const choices = await inputChoices(channels);
      micSelect.replaceChildren(...choices.map((c) => new Option(c.label, c.value, false, c.value === saved)));
      if (saved && !choices.some((c) => c.value === saved)) {
        micSelect.prepend(new Option('Saved mic (not connected)', saved, false, true));
      }
    };
    fill();
    navigator.mediaDevices.addEventListener('devicechange', fill);
    // Stereo lists devices, mono lists each input: refill when it changes.
    document.addEventListener('podstudio:channels', fill);
    // Asking once reveals device names.
    micSelect.addEventListener('focus', () => navigator.mediaDevices.getUserMedia({ audio: true }).then((s) => (s.getTracks().forEach((t) => t.stop()), fill())).catch(() => {}), { once: true });
    micSelect.addEventListener('change', (e) => {
      e.stopPropagation();
      saveSettings('recording', { deviceId: micSelect.value });
    });
  }

  const form = document.querySelector<HTMLFormElement>('[data-settings]')!;
  const size = form.querySelector('[data-size]');
  if (size) {
    const demo = new URL(location.href).searchParams.has('demo');
    const refresh = () => {
      const data = new FormData(form);
      const channels = Number(data.get('channels') ?? 1);
      size.textContent = mbPerMinute(Number(data.get('depth')), Number(data.get('rate')), channels);
      form.querySelector('[data-channels-label]')!.textContent = channelsLabel(channels);
      form.querySelector('[data-depth-label]')!.textContent = `${data.get('depth')}-bit`;
      form.querySelector('[data-rate-label]')!.textContent = `${data.get('rate')} kHz`;
    };
    if (!demo) {
      const r = loadSettings().recording;
      const pick = (name: string, value: string) => {
        const el = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
        if (el) el.checked = true;
      };
      pick('depth', String(r.depth));
      pick('rate', String(r.rate));
      pick('channels', String(r.channels));
      form.querySelector<HTMLInputElement>('input[name=mic-check]')!.checked = r.micCheck;
      refresh();
      form.addEventListener('change', () => {
        const data = new FormData(form);
        const channels = Number(data.get('channels')) as 1 | 2;
        const changed = channels !== loadSettings().recording.channels;
        saveSettings('recording', {
          channels,
          depth: Number(data.get('depth')) as 16 | 24,
          rate: Number(data.get('rate')) as 44.1 | 48,
          micCheck: data.has('mic-check'),
        });
        if (changed) document.dispatchEvent(new Event('podstudio:channels'));
      });
    }
    form.addEventListener('change', refresh);
  }
</script>
