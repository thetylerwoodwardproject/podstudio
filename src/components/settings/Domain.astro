---
/*
 * Domain & HTTPS in three states: healthy (Caddy), needs attention (Nginx
 * certificate renewal failed), and local only. The server reports which
 * one applies; ?state=ok|warn|local previews them.
 */
import Section from './Section.astro';
import Callout from '@/components/ui/Callout.astro';
import Button from '@/components/ui/Button.astro';
import CodeBlock from '@/components/ui/CodeBlock.astro';
import StatusRow from '@/components/ui/StatusRow.astro';
import PreviewStates from '@/components/app/PreviewStates.astro';
import { server } from '@/data/mock';

const ok = 'var(--color-ok)';
const warn = 'var(--color-warn)';
const proxies = [
  { value: 'caddy', label: 'Caddy', hint: 'No Certbot needed. Caddy gets and renews certificates for you.' },
  { value: 'nginx', label: 'Nginx', hint: 'Nginx needs Certbot to get and renew certificates.' },
  { value: 'none', label: 'None (local only)', hint: 'Self-signed HTTPS on your local network: each device accepts a certificate warning once.' },
];
const states = [
  { value: 'ok', label: 'Healthy' },
  { value: 'warn', label: 'Needs attention' },
  { value: 'local', label: 'Local only' },
];
const address = `https://${server.address}`;
const caddyfile = `${server.address} {
    reverse_proxy localhost:4321
}`;
const segBtn =
  'flex h-8 items-center justify-center rounded-md text-[13px] text-muted hover:text-fg has-checked:bg-fg has-checked:text-ink has-focus-visible:outline-2 has-focus-visible:outline-fg';
---

<div id="domain" class="flex flex-col gap-5.5" data-states="ok,warn,local" data-state="ok">
  <Section
    title="Domain & HTTPS"
    description="Chrome only allows microphone access over HTTPS. Put Podstudio behind a reverse proxy on your own domain so any device can record."
  />

  <Callout data-when="ok" size="lg" title="Secure and reachable" color={ok}>
    Every signed-in device can record at {server.address}. Last checked 2 minutes ago.
    <Button slot="action" class="h-9 px-3.5 text-[13px]">Re-check</Button>
  </Callout>
  <Callout data-when="warn" size="lg" title="Certificate expires in 6 days" color={warn}>
    Certbot’s last automatic renewal failed. If the certificate expires, devices won’t be able to connect or record.
    <Button slot="action" href="#fix" class="h-9 px-3.5 text-[13px]">How to fix</Button>
  </Callout>
  <Callout data-when="local" size="lg" title="Local only" color="var(--color-muted)">
    Podstudio serves HTTPS with a self-signed certificate until a domain is set up, so phones, guests and your
    producer on this network can connect. Each device shows a certificate warning the first time: accept it once.
    Add a domain below to get a real certificate from Caddy or Nginx with Certbot.
  </Callout>

  <div class="flex flex-col gap-2" data-when="ok warn">
    <label for="public-address" class="text-[12px] text-muted">Public address</label>
    <div class="relative">
      <input id="public-address" class="min-h-[42px] w-full rounded-lg border border-edge bg-surface px-3 pr-14 font-mono text-[13px] focus:border-fg focus:outline-none" value={address} />
      <span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-[12px] text-muted">Edit</span>
    </div>
  </div>
  <div class="flex flex-col gap-2" data-when="local">
    <label for="your-domain" class="text-[12px] text-muted">Your domain</label>
    <div class="relative">
      <input id="your-domain" class="min-h-[42px] w-full rounded-lg border border-edge bg-surface px-3 pr-52 font-mono text-[13px] focus:border-fg focus:outline-none" value={server.address} />
      <span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-[12px] text-subtle">A record → 203.0.113.24 ✓</span>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <div class="text-[12px] text-muted">Reverse proxy</div>
    {
      [
        ['ok', 'caddy'],
        ['warn', 'nginx'],
        ['local', 'caddy'],
      ].map(([state, selected]) => (
        <div data-when={state} role="radiogroup" aria-label="Reverse proxy" class="grid grid-cols-3 gap-[3px] rounded-lg bg-raised p-[3px]" data-proxy>
          {proxies.map((p) => (
            <label class={segBtn}>
              <input type="radio" name={`proxy-${state}`} value={p.value} checked={p.value === selected} class="sr-only" />
              {p.label}
            </label>
          ))}
        </div>
      ))
    }
    <div class="text-[12px] text-subtle" data-when="ok warn" data-proxy-hint data-hints={JSON.stringify(Object.fromEntries(proxies.map((p) => [p.value, p.hint])))}></div>
  </div>

  <div id="fix" class="flex flex-col gap-2" data-when="warn">
    <div class="flex justify-between font-mono text-[11px] text-faint">
      <span>Run on your server, then re-check</span>
      <button type="button" class="font-sans text-[12px] text-muted hover:text-fg" data-copy-code>Copy</button>
    </div>
    <CodeBlock code={'sudo certbot renew --dry-run\nsudo systemctl reload nginx'} class="rounded-[10px] px-4 py-3.5" />
  </div>

  <div class="flex flex-col" data-when="ok">
    <StatusRow label="HTTPS" value="Active" color={ok} />
    <StatusRow label="Certificate" value="Let’s Encrypt · auto-renews · valid to Dec 18" color={ok} />
    <StatusRow label="WebSockets" value="Connected through proxy" color={ok} />
    <StatusRow label="Port 4321" value="Closed to the internet" color={ok} />
    <StatusRow label="Forwarded headers" value="X-Forwarded-Proto: https" color={ok} />
  </div>
  <div class="flex flex-col" data-when="warn">
    <StatusRow label="HTTPS" value="Active" color={ok} />
    <StatusRow label="Certificate" value="Let’s Encrypt via Certbot · expires Sep 30" color={warn} />
    <StatusRow label="WebSockets" value="Connected through proxy" color={ok} />
    <StatusRow label="Port 4321" value="Closed to the internet" color={ok} />
  </div>

  <ol class="flex flex-col gap-3.5" data-when="local">
    <li class="grid grid-cols-[24px_1fr] gap-3 text-[14px] leading-normal">
      <span class="font-mono text-[12px] font-medium text-faint">01</span>
      <div>Install Caddy<div class="meta mt-1 text-muted">sudo apt install caddy</div></div>
    </li>
    <li class="grid grid-cols-[24px_1fr] gap-3 text-[14px] leading-normal">
      <span class="font-mono text-[12px] font-medium text-faint">02</span>
      <div class="min-w-0">
        Add this to /etc/caddy/Caddyfile, then run <span class="font-mono text-[12px]">sudo systemctl reload caddy</span>
        <CodeBlock code={caddyfile} class="mt-2" />
      </div>
    </li>
    <li class="grid grid-cols-[24px_1fr] gap-3 text-[14px] leading-normal">
      <span class="font-mono text-[12px] font-medium text-faint">03</span>
      <div>Open ports 80 and 443 on your router or firewall. Keep 4321 closed.</div>
    </li>
  </ol>
  <div class="mt-auto flex gap-2.5" data-when="local">
    <Button variant="primary">Check connection</Button>
    <Button href="/settings/general">Skip for now</Button>
  </div>
</div>
<PreviewStates target="domain" states={states} />

<script>
  const root = document.getElementById('domain');
  if (root) {
    const hint = root.querySelector<HTMLElement>('[data-proxy-hint]')!;
    const hints = JSON.parse(hint.dataset.hints!) as Record<string, string>;
    const update = () => {
      const group = root.querySelector<HTMLElement>(`[data-proxy][data-when="${root.dataset.state}"]`);
      const picked = group?.querySelector<HTMLInputElement>('input:checked')?.value;
      if (picked) hint.textContent = hints[picked];
    };
    root.addEventListener('change', update);
    root.addEventListener('statechange', update);
    update();

    root.querySelector('[data-copy-code]')!.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLElement;
      await navigator.clipboard.writeText(root.querySelector('#fix pre')!.textContent!);
      btn.textContent = 'Copied';
      setTimeout(() => (btn.textContent = 'Copy'), 1500);
    });
  }
</script>
