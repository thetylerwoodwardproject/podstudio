---
import Section from './Section.astro';
import ToggleRow from './ToggleRow.astro';
import Callout from '@/components/ui/Callout.astro';
import Button from '@/components/ui/Button.astro';
import CodeBlock from '@/components/ui/CodeBlock.astro';
import StatusRow from '@/components/ui/StatusRow.astro';
import { server, storage } from '@/data/mock';
---

<Section title="Server" />
<Callout title={`Podstudio ${server.latest} is available`} color="var(--color-spk-teal)">
  You’re on {server.version}. New in this version: punch-in takes, faster Whisper uploads, and a Podcasting 2.0 chapters
  export.
  <Button slot="action">Changelog</Button>
</Callout>
<CodeBlock code="curl -fsSL https://podstudio.dev/install.sh | bash -s -- --upgrade" />
<div class="-mt-2.5 text-[12px] text-subtle">
  Docker: <span class="font-mono text-muted">docker pull podstudio/podstudio &amp;&amp; docker restart podstudio</span>
</div>
<div class="flex flex-col gap-2.5">
  <h2 class="eyebrow">Backups</h2>
  <ToggleRow name="backups" checked monoHint title="Nightly backup" hint="/data/backups · keeps the last 7 · last run 3:00 AM ✓" />
  <div class="flex flex-wrap gap-2.5">
    <Button>↓ Export everything (.tar.gz · 3.2 GB)</Button>
    <label class="inline-flex h-10 items-center rounded-lg border border-edge px-4 text-[14px] hover:bg-raised">
      Import a backup
      <input type="file" accept=".tar.gz,.tgz" class="sr-only" />
    </label>
  </div>
  <p class="text-[12px] text-subtle">
    Backups include scripts, takes, transcripts, users and settings. Your OpenAI key is included in encrypted form.
  </p>
</div>
<div class="flex flex-col">
  <StatusRow label="Version" value={server.version} />
  <StatusRow label="Storage" value={`${storage.usedGb} of ${storage.totalGb} GB`} color="var(--color-warn)" />
  <StatusRow label="Uptime" value="12 days" color="var(--color-ok)" />
</div>
