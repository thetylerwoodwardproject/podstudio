---
import { inputClass } from '@/lib/ui';
---

<div class="relative">
  <select data-ui-theme aria-label="Appearance" class={`${inputClass} appearance-none pr-9`}>
    <option value="system">System</option>
    <option value="light">Light</option>
    <option value="dark">Dark</option>
  </select>
  <svg aria-hidden="true" class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-text-2" viewBox="0 0 16 16" fill="none"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
</div>
