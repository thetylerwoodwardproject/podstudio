---
/*
 * Toggle (framework): 40 × 24 with an 18 px knob. On: the text track with a
 * page-colored knob. Off: the track-off grey with a text-2 knob.
 */
interface Props {
  name: string;
  checked?: boolean;
  /** Kept for older callers; there's one size */
  size?: 'sm' | 'md';
  label: string;
  disabled?: boolean;
}
const { name, checked = false, label, disabled = false } = Astro.props;
---

<label
  class="relative inline-flex h-6 w-10 flex-none items-center rounded-full bg-track-off transition-colors has-checked:bg-text has-disabled:opacity-40 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-text"
>
  <input type="checkbox" role="switch" class="peer sr-only" name={name} checked={checked} disabled={disabled} aria-label={label} />
  <span class="absolute top-[3px] left-[3px] size-[18px] rounded-full bg-text-2 transition-all peer-checked:left-[19px] peer-checked:bg-page"></span>
</label>
