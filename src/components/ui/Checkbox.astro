---
interface Props {
  name: string;
  checked?: boolean;
  /** Visible label text; omit and use the slot for richer labels */
  label?: string;
  size?: 14 | 16 | 18;
  class?: string;
}
const { name, checked = false, label, size = 16, class: cls } = Astro.props;
---

<label class:list={['flex items-start gap-2', cls]}>
  <input type="checkbox" class="peer sr-only" name={name} checked={checked} />
  <span
    aria-hidden="true"
    class:list={[
      'flex flex-none items-center justify-center border border-edge-strong leading-none font-bold text-transparent',
      'peer-checked:border-fg peer-checked:bg-fg peer-checked:text-ink peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-fg',
      { 14: 'mt-px size-3.5 rounded text-[9px]', 16: 'mt-px size-4 rounded text-[11px]', 18: 'size-4.5 rounded-[5px] text-[12px]' }[size],
    ]}>✓</span
  >
  {label ? <span>{label}</span> : <slot />}
</label>
