---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'secondary' | 'record';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  href?: string;
  class?: string;
} & Omit<HTMLAttributes<'button'>, 'class'> &
  Omit<HTMLAttributes<'a'>, 'class' | 'type'>;

const { variant = 'secondary', size = 'md', href, class: cls, type = 'button', ...rest } = Astro.props;

const classes = [
  'inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap transition-colors disabled:opacity-50',
  {
    primary: 'bg-fg font-medium text-ink hover:bg-white hover:text-ink',
    secondary: 'border border-edge text-fg hover:border-edge-strong hover:bg-raised hover:text-fg',
    record: 'bg-rec font-medium text-white hover:bg-[#ff5a50] hover:text-white',
  }[variant],
  {
    sm: 'h-8 rounded-lg px-3 text-[12px]',
    md: 'h-10 rounded-lg px-4 text-[14px]',
    lg: 'h-11 rounded-[10px] px-5.5 text-[14px]',
    xl: 'h-12 rounded-[10px] px-5 text-[15px]',
  }[size],
  cls,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
