---
import type { HTMLAttributes } from 'astro/types';
type Props = { color: string; size?: number; pulse?: boolean; class?: string } & Omit<HTMLAttributes<'span'>, 'style'>;
const { color, size = 6, pulse = false, class: cls, ...rest } = Astro.props;
---
<!-- Single-node Status Dot adapter keeps existing status scripts able to change its color. -->
<span data-status-dot aria-hidden="true" class:list={['inline-flex flex-none rounded-full', pulse && 'animate-pulse-rec', cls]}
  style={{ width: `${size}px`, height: `${size}px`, background: color }} {...rest}></span>
