---
/* Keep Astro forms server-rendered while Bits UI manages OTP input. */
import OtpCode from '@/components/app/OtpCode.svelte';
interface Props {
  name: string;
  length?: number;
  /** Characters already entered, for the mock state */
  value?: string;
  alphanumeric?: boolean;
  /** Fixed 44px boxes with a gap after the third (desktop setup) */
  split?: boolean;
  size?: 'md' | 'lg';
  label: string;
  queryCode?: boolean;
}
const { name, length = 6, value = '', alphanumeric = false, split = false, size = 'md', label, queryCode = false } = Astro.props;
---

<OtpCode {name} {length} {value} {alphanumeric} {split} {size} {label} {queryCode} client:load />
