---
/*
 * One-box-per-character code entry (2FA codes, session join codes).
 * Typing advances, Backspace steps back, and pasting fills every box.
 */
interface Props {
  name: string;
  length?: number;
  /** Characters already entered, for the mock state */
  value?: string;
  alphanumeric?: boolean;
  /** Fixed 44px boxes with a gap after the third (desktop setup) */
  split?: boolean;
  size?: 'md' | 'lg';
  label: string;
}
const { name, length = 6, value = '', alphanumeric = false, split = false, size = 'md', label } = Astro.props;
const chars = Array.from({ length }, (_, i) => value[i] ?? '');
const firstEmpty = chars.findIndex((c) => !c);
---

<div
  data-otp
  role="group"
  aria-label={label}
  class:list={[split ? 'flex gap-2' : 'grid grid-cols-6 gap-2']}
>
  {
    chars.map((c, i) => (
      <>
        {split && i === length / 2 && <span class="w-3" aria-hidden="true" />}
        <input
          name={`${name}-${i}`}
          value={c}
          maxlength={1}
          inputmode={alphanumeric ? 'text' : 'numeric'}
          autocomplete={i === 0 && !alphanumeric ? 'one-time-code' : 'off'}
          autocapitalize="characters"
          aria-label={`${label}, character ${i + 1}`}
          autofocus={i === firstEmpty}
          class:list={[
            'rounded-[10px] border border-transparent bg-raised text-center font-mono font-medium text-fg uppercase caret-transparent focus:border-fg focus:outline-none',
            split ? 'w-11' : 'w-full',
            size === 'lg' ? 'h-14 text-[22px]' : 'h-[52px] text-[20px]',
          ]}
        />
      </>
    ))
  }
</div>

<script>
  for (const group of document.querySelectorAll<HTMLElement>('[data-otp]')) {
    const boxes = [...group.querySelectorAll('input')];
    const pattern = boxes[0]?.inputMode === 'numeric' ? /[0-9]/ : /[0-9a-z]/i;
    boxes.forEach((box, i) => {
      box.addEventListener('input', () => {
        const ch = [...box.value].reverse().find((c) => pattern.test(c)) ?? '';
        box.value = ch.toUpperCase();
        if (ch) boxes[i + 1]?.focus();
      });
      box.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !box.value) boxes[i - 1]?.focus();
        if (e.key === 'ArrowLeft') boxes[i - 1]?.focus();
        if (e.key === 'ArrowRight') boxes[i + 1]?.focus();
      });
      box.addEventListener('paste', (e) => {
        e.preventDefault();
        const text = [...(e.clipboardData?.getData('text') ?? '')].filter((c) => pattern.test(c));
        text.slice(0, boxes.length - i).forEach((c, j) => (boxes[i + j].value = c.toUpperCase()));
        boxes[Math.min(i + text.length, boxes.length - 1)].focus();
      });
    });
  }
</script>
