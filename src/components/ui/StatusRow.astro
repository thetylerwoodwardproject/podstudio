---
import Dot from './Dot.astro';
interface Props {
  label: string;
  value: string;
  /** Status dot color; omit for plain values */
  color?: string;
  dense?: boolean;
}
const { label, value, color, dense = false } = Astro.props;
---

<div
  class:list={[
    'flex items-center justify-between gap-4 border-b border-line text-[13px]',
    dense ? 'py-[11px]' : 'py-3',
  ]}
>
  <span class="text-muted">{label}</span>
  <span class="meta flex items-center gap-2 text-right">
    {color && <Dot color={color} />}
    {value}
  </span>
</div>
