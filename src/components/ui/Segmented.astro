---
/*
 * Segmented control (framework): page-fill track, 1 px border, 3 px padding,
 * radius 10; the selected option is the text fill with page-colored text at
 * 500, the rest transparent in text-2. Native radios, so it works without
 * script and with the keyboard.
 */
interface Option {
  value: string;
  label: string;
}
interface Props {
  name: string;
  options: Option[];
  value: string;
  mono?: boolean;
  /** Accessible label for the group */
  label?: string;
  class?: string;
}
const { name, options, value, mono = false, label, class: cls } = Astro.props;
---

<div
  role="radiogroup"
  aria-label={label}
  class:list={['grid gap-[3px] rounded-[10px] border border-border bg-page p-[3px]', cls]}
  style={{ gridTemplateColumns: `repeat(${options.length}, minmax(0, 1fr))` }}
>
  {
    options.map((o) => (
      <label
        class:list={[
          'flex h-8 items-center justify-center rounded-[7px] px-2 text-center text-text-2 transition-colors hover:text-text',
          'has-checked:bg-text has-checked:font-medium has-checked:text-page has-focus-visible:outline-2 has-focus-visible:outline-text',
          mono ? 'font-mono text-[13px]' : 'text-[14px]',
        ]}
      >
        <input type="radio" class="sr-only" name={name} value={o.value} checked={o.value === value} />
        {o.label}
      </label>
    ))
  }
</div>
