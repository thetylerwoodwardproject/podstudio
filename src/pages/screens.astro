---
/*
 * Index of every screen, keyed by its id in the Claude Design handoff
 * (Single Host.dc.html). Handy for review; not linked from the app.
 */
import Base from '@/layouts/Base.astro';
import Logo from '@/components/ui/Logo.astro';

const e = '/episodes/142';
const live: [string, string][] = [
  ['Script: import or paste your own script (every screen uses it)', `${e}/script`],
  ['Studio: pick format and scrolling, then Start session', `${e}/studio`],
  ['Mic check: live level, test recording, read a line', `${e}/mic-check`],
  ['Recording: meter always on, hold C to cough, R retake, A ad-lib, M for More', `${e}/recording`],
  ['With a guest: set it up in the studio (Show → With a guest), then share the 6-digit codes', `${e}/studio`],
  ['Join with a code (guest or producer)', '/join'],
  ['Sessions: play, download, delete, open to export', `${e}/sessions`],
  ['Session export: raw WAV with markers, Audacity labels, assembled edit', `${e}/session`],
  ['Voice check: why voice follow isn’t hearing words, on-device voice download', '/voice'],
];

const groups: { title: string; items: [string, string, string][] }[] = [
  {
    title: 'Sign in & setup',
    items: [
      ['1a', 'Sign in', '/signin'],
      ['2b', '2FA at sign-in (phone)', '/signin/verify'],
      ['2a', 'Setup · turn on 2FA', '/setup/two-factor'],
      ['5j', 'Setup · Domain & HTTPS (optional)', '/setup/domain'],
      ['—', 'Unsupported browser', '/unsupported'],
    ],
  },
  {
    title: 'Library & script',
    items: [
      ['5a', 'Episode library', '/'],
      ['5b', 'Import a script (Import script button)', '/'],
      ['3a', 'Script editor', `${e}/script`],
    ],
  },
  {
    title: 'Recording',
    items: [
      ['1c', 'Studio control', `${e}/studio?demo`],
      ['6a', 'Mic check', `${e}/mic-check?demo`],
      ['5f', 'Recovered session', `${e}/recovered?demo`],
      ['1a', 'Recording · ready (doubles as the mic check)', `${e}/recording?demo&state=ready`],
      ['1b', 'Recording', `${e}/recording?demo&state=rec`],
      ['1c', 'Recording · holding Cough', `${e}/recording?demo&state=cough`],
      ['1d', 'Recording · retake just marked', `${e}/recording?demo&state=retake`],
      ['1e', 'Recording · ad-lib', `${e}/recording?demo&state=adlib`],
      ['1f', 'Recording · More (sheet on a phone, popover on a laptop)', `${e}/recording?demo&state=more`],
      ['1g', 'Recording · paused', `${e}/recording?demo&state=paused`],
      ['1h', 'Recording · warning (mic stopped)', `${e}/recording?demo&state=mic`],
      ['1i', 'Session saved', `${e}/saved?demo`],
      ['—', 'Join with a 6-digit code', '/join'],
      ['6a', 'Guest: green room, waiting, recording (after joining)', '/guest'],
      ['—', 'Producer: live script, session controls, guest (after joining)', '/producer'],
      ['—', 'Wrapping up: waiting for the guest’s track', `${e}/wrap`],
    ],
  },
  {
    title: 'After the recording',
    items: [
      ['2d', 'Transcribing', `${e}/transcribing`],
      ['2e', 'Transcript + episode package', `${e}/package`],
      ['8b', 'After a session · export options', `${e}/session?demo`],
    ],
  },
  {
    title: 'Settings (7a)',
    items: [
      ['7a', 'General', '/settings/general'],
      ['7a', 'Recording', '/settings/recording'],
      ['7a', 'Prompter', '/settings/prompter'],
      ['7a', 'Controls', '/settings/controls'],
      ['7a', 'Transcription & AI', '/settings/ai'],
      ['7a', 'Security', '/settings/security'],
      ['7a', 'Domain & HTTPS · healthy', '/settings/domain?state=ok'],
      ['7a', 'Domain & HTTPS · needs attention', '/settings/domain?state=warn'],
      ['7a', 'Domain & HTTPS · local only', '/settings/domain?state=local'],
      ['7a', 'Server', '/settings/server'],
      ['—', 'About & credits', '/settings/about'],
    ],
  },
];
---

<Base title="Screens">
  <main class="mx-auto flex max-w-3xl flex-col gap-10 px-6 py-12">
    <div class="flex flex-col gap-3">
      <Logo />
      <h1 class="page-title">Screens</h1>
      <p class="text-[13px] text-muted">
        Every screen from the design handoff, by its id. Links marked ?demo show the design’s example content.
      </p>
    </div>
    <section class="flex flex-col gap-2">
      <h2 class="eyebrow">Try it live</h2>
      <p class="text-[13px] leading-normal text-muted">
        Recording, voice follow and exports work in this browser now. Sign-in, transcripts and opening a session from
        another device need the server.
      </p>
      <ul class="flex flex-col border-t border-line">
        {live.map(([label, href]) => (
          <li>
            <a href={href} class="flex items-center gap-4 border-b border-line py-3 text-[14px] text-fg hover:bg-surface">
              <span class="w-8 font-mono text-[11px] text-ok">LIVE</span>
              <span class="flex-1">{label}</span>
              <span class="meta text-faint">{href}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    {
      groups.map((g) => (
        <section class="flex flex-col gap-2">
          <h2 class="eyebrow">{g.title}</h2>
          <ul class="flex flex-col border-t border-line">
            {g.items.map(([id, label, href]) => (
              <li>
                <a href={href} class="flex items-center gap-4 border-b border-line py-3 text-[14px] text-fg hover:bg-surface">
                  <span class="w-8 font-mono text-[11px] text-subtle">{id}</span>
                  <span class="flex-1">{label}</span>
                  <span class="meta text-faint">{href}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Base>
