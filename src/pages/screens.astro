---
/*
 * Index of every screen, keyed by its id in the Claude Design handoff
 * (project/Teleprompter.dc.html). Handy for review; not linked from the app.
 */
import Base from '@/layouts/Base.astro';
import Logo from '@/components/ui/Logo.astro';

const e = '/episodes/142';
const groups: { title: string; items: [string, string, string][] }[] = [
  {
    title: 'Sign in & setup',
    items: [
      ['1a', 'Sign in', '/signin'],
      ['2b', '2FA at sign-in (phone)', '/signin/verify'],
      ['2a', 'Setup · turn on 2FA', '/setup/two-factor'],
      ['5j', 'Setup · Domain & HTTPS (optional)', '/setup/domain'],
      ['1h', 'Unsupported browser', '/unsupported'],
    ],
  },
  {
    title: 'Library & script',
    items: [
      ['5a', 'Episode library', '/'],
      ['5b', 'Import a script (Import script button)', '/'],
      ['3a', 'Script editor + cast colors', `${e}/script`],
    ],
  },
  {
    title: 'Recording',
    items: [
      ['1b', 'Join a session (phone)', '/join'],
      ['1c', 'Studio control', `${e}/studio`],
      ['7c', 'Mic check · host', `${e}/mic-check`],
      ['7c', 'Mic check · remote guest', '/invite/8f2k-q7mz'],
      ['6b', 'Host view while recording', `${e}/recording`],
      ['7d', 'Phone prompter · reading', `${e}/prompter`],
      ['7d', 'Phone prompter · lost place', `${e}/prompter?state=lost`],
      ['7d', 'Phone prompter · reconnecting', `${e}/prompter?state=off`],
      ['7d', 'Phone prompter · guest upload', `${e}/prompter?state=up`],
      ['1e', 'External monitor (M toggles mirror)', `${e}/monitor`],
      ['5i', 'Producer remote (phone)', `${e}/remote`],
      ['5d', 'Retake from a line', `${e}/takes`],
      ['5f', 'Recovered take', `${e}/recovered`],
    ],
  },
  {
    title: 'After the recording',
    items: [
      ['2d', 'Transcribing', `${e}/transcribing`],
      ['2e', 'Transcript + episode package', `${e}/package`],
      ['3c', 'Transcript speakers', `${e}/transcript`],
      ['7b', 'Export', `${e}/export`],
    ],
  },
  {
    title: 'Settings (7a)',
    items: [
      ['7a', 'General', '/settings/general'],
      ['7a', 'Recording', '/settings/recording'],
      ['7a', 'Prompter', '/settings/prompter'],
      ['7a', 'Controls', '/settings/controls'],
      ['7a', 'Transcription & AI', '/settings/ai'],
      ['7a', 'Security', '/settings/security'],
      ['7a', 'Domain & HTTPS · healthy', '/settings/domain?state=ok'],
      ['7a', 'Domain & HTTPS · needs attention', '/settings/domain?state=warn'],
      ['7a', 'Domain & HTTPS · local only', '/settings/domain?state=local'],
      ['7a', 'Users', '/settings/users'],
      ['7a', 'Server', '/settings/server'],
    ],
  },
];
---

<Base title="Screens">
  <main class="mx-auto flex max-w-3xl flex-col gap-10 px-6 py-12">
    <div class="flex flex-col gap-3">
      <Logo />
      <h1 class="text-[26px] tracking-[-0.02em]">Screens</h1>
      <p class="text-[13px] text-muted">Every screen from the design handoff, by its id. Data is mocked.</p>
    </div>
    {
      groups.map((g) => (
        <section class="flex flex-col gap-2">
          <h2 class="eyebrow">{g.title}</h2>
          <ul class="flex flex-col border-t border-line">
            {g.items.map(([id, label, href]) => (
              <li>
                <a href={href} class="flex items-center gap-4 border-b border-line py-3 text-[14px] text-fg hover:bg-surface">
                  <span class="w-8 font-mono text-[11px] text-subtle">{id}</span>
                  <span class="flex-1">{label}</span>
                  <span class="meta text-faint">{href}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Base>
