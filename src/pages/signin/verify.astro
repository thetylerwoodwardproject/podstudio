---
// 2b · 2FA at sign-in (phone)
import Phone from '@/layouts/Phone.astro';
import Logo from '@/components/ui/Logo.astro';
import OtpInput from '@/components/ui/OtpInput.astro';
import Checkbox from '@/components/ui/Checkbox.astro';
import Button from '@/components/ui/Button.astro';
---

<Phone title="Enter your code">
  <form class="flex flex-1 flex-col gap-7 p-6" data-verify>
    <Logo />
    <div>
      <h1 class="text-[26px] font-medium tracking-[-0.02em]">Enter your code</h1>
      <p class="mt-1.5 text-[13px] leading-normal text-muted">
        Open your authenticator app to get the code for <span data-username>your account</span> on Podstudio.
      </p>
    </div>
    <div data-app-code><OtpInput name="code" size="lg" label="Authentication code" /></div>
    <input
      name="recovery"
      class="h-14 rounded-[10px] bg-raised px-4 font-mono text-[20px] tracking-[0.12em] focus:outline-none"
      placeholder="xxxx-xxxx"
      autocomplete="off"
      autocapitalize="off"
      aria-label="Recovery code"
      data-recovery
      hidden
    />
    <p class="text-[13px] text-rec" role="alert" data-error hidden></p>
    <Checkbox name="trust" checked size={18} class="items-center gap-2.5 text-[13px] text-fg-soft" label="Trust this device for 30 days" />
    <Button type="submit" variant="primary" class="h-[50px] w-full rounded-xl text-[15px]">Verify</Button>
    <p class="mt-auto pb-7 text-center text-[13px] text-muted">
      <span data-toggle-text>Lost your phone?</span> <button type="button" class="text-fg" data-toggle>Use a recovery code</button>
    </p>
  </form>
</Phone>

<script>
  import { api, nextPath, otpValue, showError } from '@/lib/api';

  const form = document.querySelector<HTMLFormElement>('[data-verify]')!;
  const recovery = form.querySelector<HTMLInputElement>('[data-recovery]')!;
  const appCode = form.querySelector<HTMLElement>('[data-app-code]')!;
  api<{ user: { username: string } | null }>('auth/state').then((s) => s.user && (form.querySelector('[data-username]')!.textContent = s.user.username));
  let useRecovery = false;
  form.querySelector('[data-toggle]')!.addEventListener('click', (e) => {
    useRecovery = !useRecovery;
    recovery.hidden = !useRecovery;
    appCode.hidden = useRecovery;
    (e.currentTarget as HTMLElement).textContent = useRecovery ? 'Use the app' : 'Use a recovery code';
    form.querySelector('[data-toggle-text]')!.textContent = useRecovery ? 'Found it?' : 'Lost your phone?';
    (useRecovery ? recovery : appCode.querySelector('input'))?.focus();
  });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('[type=submit]')!;
    btn.disabled = true;
    showError(form, null);
    try {
      await api('auth/verify', { body: { code: useRecovery ? recovery.value : otpValue(appCode), trust: new FormData(form).has('trust') } });
      location.href = nextPath();
    } catch (err) {
      showError(form, (err as Error).message);
      btn.disabled = false;
    }
  });
  // All six digits typed: go.
  appCode.addEventListener('input', () => otpValue(appCode).length === 6 && form.requestSubmit());
</script>
