---
// 3a · Script editor: one host reading, in sections.
import EpisodeData from '@/components/app/EpisodeData.astro';
import { episodePage } from '@/lib/episode-page';
import AppShell from '@/layouts/AppShell.astro';
import Button from '@/components/ui/Button.astro';
import ImportDialog from '@/components/app/ImportDialog.astro';
import { episode as mockEpisode, scriptLines } from '@/data/mock';

export const prerender = false;
const data = episodePage(Astro.params.id);
if (!data) return new Response('No such episode', { status: 404 });
const episode = { ...mockEpisode, ...data.episode };
---

<AppShell
  title="Script"
  avatar={false}
  crumbs={[{ label: 'Episodes', href: '/' }, { label: episode.fullTitle }]}
>
  <EpisodeData data={data} />
  <Fragment slot="topbar">
    <Button href={`/episodes/${episode.id}/studio`} variant="record" size="md" class="gap-2.5 px-5">
      <span class="size-2 rounded-full bg-white"></span>
      Go to studio
    </Button>
  </Fragment>

  <div class="flex lg:h-full">
    <section class="flex min-h-0 flex-1 flex-col">
      <div class="flex items-center justify-between border-b border-line px-7 py-3.5 text-[13px] text-muted">
        <div class="flex gap-4.5" role="tablist">
          <button type="button" role="tab" aria-selected="true" class="text-muted aria-selected:text-fg" data-tab="script">Script</button>
          <button type="button" role="tab" aria-selected="false" class="text-muted aria-selected:text-fg" data-tab="points">Talking points</button>
        </div>
        <div class="flex items-center gap-4">
          <span class="meta max-sm:hidden">## Heading starts a section</span>
          <button type="button" class="text-[13px] text-fg hover:text-primary" data-live-only data-open-import>Import or paste</button>
          <button type="button" class="text-[13px] text-muted hover:text-fg" data-live-only data-reset hidden>Use example script</button>
        </div>
      </div>
      <p class="border-b border-line px-7 py-2.5 text-[12px] text-subtle" data-live-only data-script-note>
        This is the example episode. Import or paste your own script to rehearse with it; every screen uses it.
      </p>
      <p class="border-b border-line px-7 py-2.5 text-[12px] text-muted" data-mode-note hidden></p>
      <!-- Talking points: bullets instead of a word-for-word script -->
      <div class="mx-auto flex min-h-0 w-full max-w-[860px] flex-1 flex-col gap-3 overflow-auto px-6 py-8 sm:px-14" data-points hidden>
        <label for="points" class="text-[13px] text-muted">One talking point per line. Everyone in the session sees them; tap one to mark it current.</label>
        <textarea
          id="points"
          rows="14"
          class="w-full flex-1 rounded-xl border border-edge bg-surface p-4 text-[17px] leading-[1.7] focus:border-fg focus:outline-none"
          placeholder={'The crate arrives\nPower and cooling\nFirst key-up'}
          data-points-text></textarea>
      </div>
      <div class="mx-auto flex min-h-0 w-full max-w-[860px] flex-1 flex-col gap-5.5 overflow-auto px-6 py-8 sm:px-14" data-script-lines data-episode={episode.id}>
        {
          scriptLines.map((l) => (
            <div
              contenteditable="plaintext-only"
              spellcheck="true"
              class="rounded text-[19px] leading-[1.65] text-pretty text-fg-soft focus:text-fg focus:outline-none"
            >{l.text}</div>
          ))
        }
      </div>
    </section>
  </div>
  <ImportDialog episodeId={episode.id} label={episode.label} />
  <template id="script-section"><div class="eyebrow pt-2"></div></template>
</AppShell>

<script>
  import { loadScript, resetScript, saveScriptText, scriptToText } from '@/lib/script-store';
  import { GUEST, loadShow, modeInfo, saveShow } from '@/lib/show';

  // Live: show and edit this episode's script (saved in this browser).
  const list = document.querySelector<HTMLElement>('[data-script-lines]')!;
  const episodeId = list.dataset.episode!;
  // Script or talking points, and what the show's mode means for the script.
  const show = loadShow(episodeId);
  const tabs = [...document.querySelectorAll<HTMLElement>('[data-tab]')];
  const showTab = (name: string) => {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === name)));
    list.hidden = name !== 'script';
    document.querySelector<HTMLElement>('[data-points]')!.hidden = name !== 'points';
  };
  tabs.forEach((t) => t.addEventListener('click', () => showTab(t.dataset.tab!)));
  const pointsText = document.querySelector<HTMLTextAreaElement>('[data-points-text]')!;
  pointsText.value = show.points.join('\n');
  pointsText.addEventListener('input', () => saveShow(episodeId, { points: pointsText.value.split('\n').map((p) => p.trim()).filter(Boolean) }));
  const withGuest = show.format === 'guest';
  const speakerLines = withGuest && show.mode === 'lines';
  if (withGuest) {
    const modeNote = document.querySelector<HTMLElement>('[data-mode-note]')!;
    modeNote.hidden = false;
    modeNote.textContent = `With a guest · ${modeInfo[show.mode].label}: ${
      {
        lines: 'tap Host or Guest on a line to say who reads it.',
        host: 'the script is yours; the guest just talks.',
        points: 'the talking points are what everyone sees.',
        adlib: 'no script is shown. You can still keep one here.',
      }[show.mode]
    }`;
    if (show.mode === 'points') showTab('points');
  }

  if (!new URL(location.href).searchParams.has('demo')) {
    const script = loadScript(episodeId);
    const lines = script.lines.map((l) => ({ ...l }));
    const model = list.querySelector<HTMLElement>(':scope > div')!;
    const sectionTpl = (document.getElementById('script-section') as HTMLTemplateElement).content.firstElementChild!;
    const note = document.querySelector<HTMLElement>('[data-script-note]')!;
    const reset = document.querySelector<HTMLButtonElement>('[data-reset]')!;
    if (script.custom) {
      note.textContent = `Your script · ${script.lines.length} lines · ${script.words.length.toLocaleString()} words. Edits save as you type.`;
      reset.hidden = false;
    }
    reset.addEventListener('click', () => {
      if (!confirm('Replace your script with the example episode?')) return;
      resetScript(episodeId);
      location.reload();
    });

    let timer: number | undefined;
    const save = () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        saveScriptText(episodeId, scriptToText(lines));
        note.textContent = `Your script · ${lines.length} lines. Saved.`;
        reset.hidden = false;
      }, 400);
    };

    const nodes: Node[] = [];
    let section: string | null = null;
    lines.forEach((l, i) => {
      if (l.section && l.section !== section) {
        section = l.section;
        const h = sectionTpl.cloneNode() as HTMLElement;
        h.textContent = section;
        nodes.push(h);
      }
      const text = model.cloneNode(true) as HTMLElement;
      text.textContent = l.text;
      text.addEventListener('input', () => {
        lines[i].text = text.textContent!.trim();
        save();
      });
      if (!speakerLines) {
        nodes.push(text);
        return;
      }
      // Speaker lines: who reads this one.
      const row = document.createElement('div');
      row.className = 'grid grid-cols-[64px_1fr] items-start gap-4';
      const who = document.createElement('button');
      who.type = 'button';
      who.className = 'mt-1.5 rounded-md border px-2 py-1 font-mono text-[11px] font-medium tracking-[0.06em]';
      const paint = () => {
        const guest = lines[i].who === GUEST;
        who.textContent = guest ? 'GUEST' : 'HOST';
        who.style.color = guest ? 'var(--spk-sam)' : 'var(--spk-tyler)';
        who.style.borderColor = 'currentColor';
        who.setAttribute('aria-label', `Read by the ${guest ? 'guest' : 'host'}; tap to change`);
      };
      paint();
      who.addEventListener('click', () => {
        lines[i].who = lines[i].who === GUEST ? '' : GUEST;
        paint();
        save();
      });
      row.append(who, text);
      nodes.push(row);
    });
    list.replaceChildren(...nodes);
  }
</script>
