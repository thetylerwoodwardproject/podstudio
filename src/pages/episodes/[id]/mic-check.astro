---
import { episodePage } from '@/lib/episode-page';
import MicCheck from '@/components/app/MicCheck.astro';

export const prerender = false;
const data = episodePage(Astro.params.id);
if (!data) return new Response('No such episode', { status: 404 });
const episode = data.episode;
---

<MicCheck episode={episode} data={data} />
