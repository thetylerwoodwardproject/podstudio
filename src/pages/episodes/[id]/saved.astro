---
import EpisodeData from '@/components/app/EpisodeData.astro';
import { episodePage } from '@/lib/episode-page';
import AppShell from '@/layouts/AppShell.astro';
export const prerender = false;
const data = episodePage(Astro.params.id);
if (!data) return new Response('No such episode', { status: 404 });
const episode = data.episode;
---
<AppShell title="Recording review" crumbs={[{ label: episode.label, href: `/episodes/${episode.id}/sessions` }, { label: 'Review' }]}>
  <EpisodeData data={data} />
  <main class="h-full overflow-y-auto" id="saved" data-episode={episode.id}>
    <div class="mx-auto flex max-w-[760px] flex-col gap-5 px-5 py-7 pb-[max(2rem,env(safe-area-inset-bottom))]">
      <h1 class="page-title">Session saved</h1>
      <p class="help" data-summary role="status">Opening recording…</p>
      <p class="help">Full editing and finished-mix export are available on desktop. Your original recordings remain available below.</p>
      <div data-review-mount></div>
      <div class="flex flex-wrap gap-3">
        <a class="inline-flex h-11 items-center rounded-[10px] border border-border px-4 text-[14px]" href={`/episodes/${episode.id}/sessions`}>Back to sessions</a>
        <a class="inline-flex h-11 items-center rounded-[10px] border border-border px-4 text-[14px]" data-again href={`/episodes/${episode.id}/studio`}>Record another</a>
        <a class="inline-flex h-11 items-center rounded-[10px] bg-primary px-4 text-[14px] text-primary-fg" data-desktop-editor data-export hidden>Open editor</a>
      </div>
    </div>
  </main>
</AppShell>
<script>
  import { openRecordingReview } from '@/lib/recording-review';
  import { formatDuration } from '@/lib/audio/takes';
  import { markerCounts } from '@/lib/markers';
  import { resumeUploads } from '@/lib/take-upload';
  import { isMobile } from '@/lib/mobile';
  import { sessionUrl } from '@/lib/flow';
  const root = document.getElementById('saved')!;
  const episode = root.dataset.episode!;
  const summary = root.querySelector<HTMLElement>('[data-summary]')!;
  root.querySelector<HTMLAnchorElement>('[data-again]')!.href = sessionUrl(episode);
  async function run() {
    const legacy = new URL(location.href).searchParams.has('legacy');
    const review = await openRecordingReview(episode, new URL(location.href).searchParams.get('take'));
    const id = review.host.id;
    history.replaceState(null, '', `/episodes/${episode}/saved?take=${encodeURIComponent(id)}${legacy ? '&legacy=1' : ''}`);
    summary.textContent = `${formatDuration(review.duration)} recorded${markerCounts(review.host.markers ?? []) ? ` · ${markerCounts(review.host.markers ?? [])}` : ''} · ${review.host.sampleRate / 1000} kHz · ${review.host.bitDepth}-bit`;
    const sync = async () => {
      if (!navigator.onLine) return 'Waiting for connection';
      if (review.local) await resumeUploads(episode);
      const response = await fetch(`/api/takes/${encodeURIComponent(id)}`);
      if (!response.ok) return 'Waiting for connection';
      const copy = await response.json();
      if (review.missingGuest) {
        const refreshed = await openRecordingReview(episode, id);
        if (!refreshed.missingGuest) location.reload();
      }
      return copy.done && copy.segments >= review.host.segments ? 'Saved on server' : `${copy.segments} of ${review.host.segments} pieces saved · retry when connected`;
    };
    const [{ mount }, { default: RecordingReview }] = await Promise.all([import('svelte'), import('@/components/app/RecordingReview.svelte')]);
    mount(RecordingReview, { target: root.querySelector('[data-review-mount]')!, props: { ...review, sync, initialStatus: navigator.onLine ? 'Checking server copy…' : 'Waiting for connection', recoveryHref: `/episodes/${episode}/wrap?take=${encodeURIComponent(id)}` } });
    const editor = root.querySelector<HTMLAnchorElement>('[data-desktop-editor]')!;
    editor.href = `/episodes/${episode}/${new URL(location.href).searchParams.has('legacy') ? 'export-legacy' : 'editor'}?take=${encodeURIComponent(id)}`; editor.hidden = isMobile();
  }
  void run().catch((error) => {
    summary.textContent = `${error.message} `;
    const retry = document.createElement('button'); retry.textContent = 'Retry'; retry.className = 'underline'; retry.onclick = () => location.reload(); summary.append(retry);
  });
</script>

<style is:global>
  @media (max-width: 700px), (pointer: coarse) and (max-width: 900px) { [data-desktop-editor] { display: none !important; } }
</style>
