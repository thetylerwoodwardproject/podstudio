---
import EpisodeData from '@/components/app/EpisodeData.astro';
import { episodePage } from '@/lib/episode-page';
import AppShell from '@/layouts/AppShell.astro';
import { episode as mockEpisode } from '@/data/mock';

export const prerender = false;
const data = episodePage(Astro.params.id);
if (!data) return new Response('No such episode', { status: 404 });
const episode = { ...mockEpisode, ...data.episode };
---

<AppShell noTranslate title="Editor" avatar={false} crumbs={[{ label: episode.label, href: `/episodes/${episode.id}/studio` }, { label: 'Editor' }]}>
  <EpisodeData data={data} />
  <div class="h-full" translate="no" id="editor-root" data-episode={episode.id} data-label={`Ep${episode.number}`} data-title={episode.label}>
    <div class="flex h-full items-center justify-center text-[13px] text-text-2" data-loading>Preparing editor…</div>
    <div class="h-full" data-editor-mount></div>
  </div>
</AppShell>

<script>
  import { onAudio, type Range } from '@/lib/audio/assemble';
  import { renderPads, hasPads, stereoOf } from '@/lib/audio/pads-export';
  import { lineUp } from '@/lib/audio/line-up';
  import { cleanEditorProject, projectDuration, masterOptions, createEditorProject, detectPauses, defaultFx, type EditorProjectV1, type EditorTrack, type EditorSource } from '@/lib/editor-project';
  import { blobSink } from '@/lib/audio/blob-sink';
  import { prepareEpisodeAudio } from '@/lib/prepared-audio';
  import { createRenderState, finishedProject, renderEditorWindow, renderProjectWav, type EditorSources } from '@/lib/audio/editor-render';
  import { joinMeterWindows, outputMeterWindow, trackMeterWindow, type EditorMeterWindows, type TrackMeterWindow } from '@/lib/audio/editor-meter';
  import { mergeEditorTakes, editorSessions, remoteSource, type RemoteTake } from '@/lib/editor-sessions';
  import { listTakes, rangesWav, saveRemoteTake, type TakeMeta } from '@/lib/audio/takes';
  import { reconcileDeletedRecordings } from '@/lib/recording-deletion';
  import { isMobile } from '@/lib/mobile';
  import { rawRecordingWav } from '@/lib/audio/raw-export';
  import { WavReader, renderMaster } from '@/lib/audio/master';
  import { encodeMp3 } from '@/lib/audio/mp3';
  import { mediaSource } from '@/lib/audio/media-source';
  import { sourcePeaks } from '@/lib/audio/editor-peaks';
  import { decodeToLibraryRate, listLibrary, libraryWav, readLibraryFile, saveLibraryFile } from '@/lib/pads';
  import { encodeWav, pcmBytes, wavHeader } from '@/lib/audio/wav';
  import { download, zip, type ZipEntry } from '@/lib/zip';
  import { loadSettings } from '@/lib/settings';
  import { type ToneSettings } from '@/lib/audio/tones';
  import type { EditorConflict, EditorExportResult, EditorPreview, EditorSaveResult, EditorTrackView } from '@/components/app/EditorFlow.svelte';

  const root = document.getElementById('editor-root')!;
  const episodeId = root.dataset.episode!;
  const label = root.dataset.label!;
  const title = root.dataset.title!;
  const query = new URL(location.href).searchParams;
  const phone = isMobile();
  if (phone) location.replace(`/episodes/${episodeId}/saved${query.toString() ? `?${query}` : ''}`);
  else void live().catch((error) => {
    const loading = root.querySelector('[data-loading]') ?? root.appendChild(document.createElement('div'));
    loading.textContent = `Couldn’t open editor: ${error.message} `;
    const retry = document.createElement('button'); retry.textContent = 'Retry'; retry.className = 'ml-3 underline'; retry.onclick = () => location.reload(); loading.append(retry);
    const sessions = document.createElement('a'); sessions.href = `/episodes/${episodeId}/sessions`; sessions.textContent = ' Recorded sessions'; sessions.className = 'ml-3 underline'; loading.append(sessions);
  });

  async function floats(wav: Blob) {
    const reader = await WavReader.open(wav);
    return reader.read(reader.frames);
  }

  async function live() {
    const requested = query.get('take');
    await reconcileDeletedRecordings(episodeId).catch(() => {});
    const localTakes = await listTakes(episodeId);
    const localIds = new Set(localTakes.filter((t) => t.status === 'done').map((t) => t.id));
    let remote: RemoteTake[] = [];
    try {
      const response = await fetch(`/api/takes?episode=${encodeURIComponent(episodeId)}`, { credentials: 'same-origin' });
      if (!response.ok) throw new Error(`Server recordings unavailable (${response.status})`);
      remote = (await response.json()).takes;
    } catch (error) { if (!localTakes.length) throw error; }
    let all = mergeEditorTakes(localTakes, remote);
    const sessions = editorSessions(all);
    const take = requested ? all.find((t) => t.id === requested) : sessions[0];
    if (!take || take.episodeId !== episodeId) throw new Error(requested ? 'This recorded session is unavailable. Choose another session or retry.' : 'No completed session is available yet.');
    history.replaceState(null, '', `/episodes/${episodeId}/editor?take=${encodeURIComponent(take.id)}`);
    // Guest segments can finish moments after the host. Stay on the editor and
    // prepare them here instead of sending the user through another workflow.
    if (take.guest && !all.some((t) => t.id !== take.id && t.group === take.group && t.status === 'done')) {
      root.querySelector('[data-loading]')!.textContent = `Preparing editor · waiting for ${take.guest.name}’s track…`;
      for (let attempt = 0; attempt < 15; attempt++) {
        const remote = await fetch(`/api/takes?episode=${encodeURIComponent(episodeId)}`, { credentials: 'same-origin' }).then((r) => r.ok ? r.json() : { takes: [] }).catch(() => ({ takes: [] })) as { takes: { id: string; meta: TakeMeta; segments: number; done: boolean }[] };
        const match = remote.takes.find((r) => r.id !== take.id && r.meta.group === take.group && r.done && r.segments > 0);
        if (match) {
          root.querySelector('[data-loading]')!.textContent = `Preparing editor · downloading ${take.guest.name}’s track…`;
          all = mergeEditorTakes(localTakes, remote.takes);
          break;
        }
        await new Promise((resolve) => setTimeout(resolve, 1000));
      }
    }
    if (take.guest && !all.some((t) => t.id !== take.id && t.group === take.group && t.status === 'done')) {
      const loading = root.querySelector('[data-loading]')!;
      loading.textContent = 'Guest audio is still missing. ';
      const recover = document.createElement('a'); recover.href = `/episodes/${episodeId}/wrap?take=${encodeURIComponent(take.id)}`; recover.textContent = 'Add guest file'; recover.className = 'underline'; loading.append(recover);
      return;
    }
    const duration = take.samples / take.sampleRate;
    const tracks = [take, ...all.filter((t) => t.id !== take.id && t.group && t.group === take.group && t.status === 'done')];
    const lu = lineUp(take);
    const audioMarkers = onAudio(take.markers ?? [], take.lineLog ?? []);
    const settings = loadSettings();
    const sources: EditorSources = new Map();
    const sourceInfo: EditorSource[] = [];
    const views: EditorTrackView[] = [];
    const colors = ['var(--color-spk-yellow)', 'var(--color-spk-teal)', 'var(--color-spk-purple)', 'var(--color-spk-green)'];

    for (const [index, track] of tracks.entries()) {
      let reader: ReturnType<typeof remoteSource> | undefined;
      if (!localIds.has(track.id)) {
        const response = await fetch(`/api/takes/${encodeURIComponent(track.id)}`, { credentials: 'same-origin' });
        if (!response.ok) throw new Error(`Recording unavailable (${response.status})`);
        const detail = await response.json();
        if (!detail.segmentBytes?.length || detail.segmentBytes.some((n: number) => n <= 0) || detail.segmentBytes.reduce((n: number, size: number) => n + size, 0) < track.samples * (track.channels ?? 1) * track.bitDepth / 8) throw new Error('Recording segments are still missing. Retry after uploads finish.');
        reader = remoteSource(track, detail.segmentBytes);
      }
      sourceInfo.push({ id: track.id, kind: 'voice', role: index ? 'guest' : 'host', name: index ? track.speaker || `Guest ${index}` : track.speaker || 'Host', duration, channels: track.channels ?? 1, sampleRate: track.sampleRate });
      views.push({ id: `track-${track.id}`, peaks: [], color: colors[index % colors.length] });
      sources.set(track.id, {
        channels: track.channels ?? 1,
        sampleRate: track.sampleRate,
        read: async (from, seconds) => {
          const ranges = track === take ? [[from, from + seconds] as [number, number]] : lu.ranges(track, [[from, from + seconds]]);
          if (!reader) return floats(await rangesWav(track, ranges, [], undefined, [], null));
          const parts = await Promise.all(ranges.map(([a, b]) => reader!.read(a, b - a)));
          const joined = new Float32Array(parts.reduce((n, x) => n + x.length, 0)); let offset = 0;
          for (const part of parts) { joined.set(part, offset); offset += part.length; } return joined;
        },
      });
    }

    if (hasPads(take)) {
      if (!localIds.has(take.id)) {
        await saveRemoteTake(take, async (n) => { const r = await fetch(`/api/takes/${encodeURIComponent(take.id)}/segments/${n}`, { credentials: 'same-origin' }); if (!r.ok) throw new Error('Audio needed for pad ducking is unavailable. Retry.'); return r.arrayBuffer(); }, (n) => root.querySelector('[data-loading]')!.textContent = `Preparing pads · audio ${n} of ${take.segments}…`);
        localIds.add(take.id);
      }
      await renderPads(take);
      const id = `pads-${take.id}`;
      sourceInfo.push({ id, kind: 'pads', name: 'Pads', duration, channels: 2, sampleRate: take.sampleRate });
      views.push({ id: `track-${id}`, peaks: [], color: 'var(--color-spk-green)' });
      sources.set(id, { channels: 2, sampleRate: take.sampleRate, read: async (from, seconds) => floats(await rangesWav(stereoOf(take), [[from, from + seconds]], [], 'pads', [], null)) });
    }

    const server = await fetch(`/api/editor-projects/${encodeURIComponent(take.id)}`, { credentials: 'same-origin' }).then(async (r) => r.ok ? r.json() as Promise<{ project: unknown; revision: number }> : { project: null, revision: 0 }).catch(() => ({ project: null, revision: 0 }));
    const local = cleanEditorProject(JSON.parse(localStorage.getItem(`podstudio-editor-${take.id}`) ?? 'null'));
    const created = createEditorProject({ takeId: take.id, episodeId, name: title, sources: sourceInfo, markers: audioMarkers.markers, lineLog: audioMarkers.lineLog, loudness: settings.recording.publish.loudness, noise: settings.recording.noiseSuppression, level: settings.recording.publish.level, tones: settings.recording.publish.voices });
    let project = local ?? cleanEditorProject(server.project) ?? created;
    for (const track of project.tracks) for (const clip of track.clips) clip.sourceDuration = Math.max(clip.sourceDuration ?? 0, sourceInfo.find((s) => s.id === clip.sourceId)?.duration ?? clip.sourceEnd);
    const revision = server.revision;

    // Rehydrate imported media referenced by a saved project.
    const referencedTracks = [...project.tracks, ...(project.removedTracks ?? [])];
    const importedMedia = referencedTracks.some((t) => t.kind === 'import') ? await listLibrary() : [];
    for (const track of referencedTracks.filter((t) => t.kind === 'import')) {
      if (sources.has(track.sourceId)) continue;
      const id = track.sourceId.replace(/^media:/, '');
      const originalDuration = importedMedia.find((file) => file.id === id)?.seconds;
      for (const clip of track.clips) clip.sourceDuration = Math.max(clip.sourceDuration ?? clip.sourceEnd, originalDuration ?? 0);
      sources.set(track.sourceId, mediaSource(() => libraryWav(id)));
      if (!views.some((view) => view.id === track.id)) views.push({ id: track.id, peaks: [], color: 'var(--color-adlib)' });
    }

    // Quiet stretches shared by all voice tracks become suggestions only.
    if (!project.pauses.some((p) => p.source === 'detected')) {
      const voicePeaks = tracks.map((t) => t.peaks ?? []);
      const known = project.pauses;
      project.pauses = [...known, ...detectPauses(voicePeaks).filter((p) => !known.some((x) => Math.max(x.start, p.start) < Math.min(x.end, p.end)))];
    }

    let renderState = createRenderState(); let previewKey = ''; let previewEnd = -1;
    let masterCache: { key: string; wav: Blob; result: Awaited<ReturnType<typeof renderMaster>>; meters: EditorMeterWindows } | null = null;
    const audioKey = (value: EditorProjectV1) => JSON.stringify({ tracks: value.tracks, markers: value.markers, sourceMarkers: value.sourceMarkers, retakes: value.retakes, pauses: value.pauses, master: masterOptions(value.master), crossfades: value.crossfades });
    const master = async (value: EditorProjectV1, progress: (s: string) => void, signal?: AbortSignal) => {
      const key = audioKey(value);
      if (masterCache?.key === key) return masterCache;
      const meterChunks = new Map<string, TrackMeterWindow[]>();
      const wav = await renderProjectWav(value, sources, (done) => progress(`Rendering mix… ${Math.round(done * 100)}%`), { signal, onTrack: (track, audio, from, rate) => {
        const chunks = meterChunks.get(track.id) ?? [];
        chunks.push(trackMeterWindow(audio, track.channels, rate, from));
        meterChunks.set(track.id, chunks);
      } });
      const sink = await blobSink(); const options = masterOptions(value.master);
      await sink.write(wavHeader(0, {sampleRate:48000, channels:options.channels, bitDepth:24}));
      const result = await renderMaster([{ wav, level: false }], { ...options, signal }, async (chunk) => { signal?.throwIfAborted(); await sink.write(pcmBytes(chunk, 24)); }, (_, done) => progress(`Measuring and mastering… ${Math.round(done * 100)}%`));
      signal?.throwIfAborted();
      const meters: EditorMeterWindows = {};
      for (const [id, chunks] of meterChunks) { const joined = joinMeterWindows(chunks); if (joined) meters[id] = joined; }
      masterCache = { key, result, meters, wav: await sink.finish(wavHeader(result.frames, {sampleRate:48000, channels:options.channels, bitDepth:24})) };
      return masterCache;
    };
    const onprepare = async (value: EditorProjectV1, revision: number, progress: (s:string) => void, signal:AbortSignal) => {
      const rendered = await master(value, progress, signal);
      await prepareEpisodeAudio(value, revision, rendered.wav, progress, signal);
    };
    const onanalyze = async (value: EditorProjectV1, progress: (s: string) => void, signal: AbortSignal) => (await master(value, progress, signal)).result;
    const onpreview = async (value: EditorProjectV1, from: number, seconds: number, solo: string[], mastered = false): Promise<EditorPreview> => {
      const ready = finishedProject(value);
      const length = Math.min(seconds, Math.max(0, projectDuration(ready) - from));
      if (mastered && !solo.length) {
        const rendered = await master(value, () => {}); const reader = await WavReader.open(rendered.wav);
        reader.seek(Math.round(from * 48000));
        const samples = await reader.read(Math.round(length * 48000));
        const channels = reader.info.channels as 1 | 2;
        const wav = encodeWav([samples], { sampleRate: 48000, bitDepth: 16, channels });
        return { url: URL.createObjectURL(wav), duration: length, meters: rendered.meters, masterMeter: outputMeterWindow(samples, channels, 48000, from), pcm: samples, channels };
      }
      const key = audioKey(value) + JSON.stringify(solo);
      if (key !== previewKey || Math.abs(from - previewEnd) > 1 / 48000) renderState = createRenderState();
      previewKey = key; previewEnd = from + length;
      const meters: EditorMeterWindows = {};
      const audio = await renderEditorWindow(ready, sources, from, length, solo, 48000, undefined, renderState, (track, samples, start, rate) => {
        meters[track.id] = trackMeterWindow(samples, track.channels, rate, start);
      });
      const wav = encodeWav([audio], { sampleRate: 48000, bitDepth: 16, channels: 2 });
      return { url: URL.createObjectURL(wav), duration: length, meters, masterMeter: outputMeterWindow(audio, 2, 48000, from), pcm: audio, channels: 2 };
    };
    const onsave = async (value: EditorProjectV1, baseRevision: number, force = false): Promise<EditorSaveResult> => {
      const response = await fetch(`/api/editor-projects/${encodeURIComponent(take.id)}`, { method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ project: value, baseRevision, force }) });
      const result = await response.json();
      if (response.status === 409) return { revision: result.revision, conflict: { project: result.project, revision: result.revision } as EditorConflict };
      if (!response.ok) throw new Error(result.error ?? `Save failed (${response.status})`);
      return { revision: result.revision };
    };
    const importIds = new WeakMap<File, string>();
    const onimport = async (file: File, at: number, progress: (message: string) => void) => {
      progress('Reading audio…'); await new Promise((r) => setTimeout(r, 0));
      const bytes = await file.arrayBuffer(); progress('Converting audio…'); await new Promise((r) => setTimeout(r, 0));
      let stereo: Float32Array;
      try { stereo = await decodeToLibraryRate(bytes); } catch { throw new Error('This audio could not be decoded. Try a WAV, MP3, M4A, or FLAC file supported by this browser.'); }
      let id = importIds.get(file); if (!id) { id = `f${crypto.randomUUID().replaceAll('-', '')}`; importIds.set(file, id); }
      progress('Uploading… 0%');
      const media = await saveLibraryFile(stereo, { id, name: file.name, source: 'Editor import', onProgress: (percent) => progress(percent === 100 ? 'Upload sent · waiting for server…' : `Uploading… ${percent}%`) });
      progress('Adding track…');
      const sourceId = `media:${media.id}`;
      sources.set(sourceId, mediaSource(() => libraryWav(media.id)));
      const track: EditorTrack = { id: `track-${sourceId}`, sourceId, kind: 'import', name: file.name, channels: 2, sampleRate: 48000, gainDb: 0, muted: false, fx: defaultFx(false), clips: [{ id: `clip-${media.id}`, sourceId, sourceStart: 0, sourceEnd: media.seconds, sourceDuration: media.seconds, timelineStart: at, linked: false, fadeInMs: 0, fadeOutMs: 0 }] };
      return { track, peaks: [] };
    };
    const onexport = async (value: EditorProjectV1, progress: (s: string) => void): Promise<EditorExportResult> => {
      if (!value.tracks.some((track) => !track.muted)) throw new Error('Unmute at least one track before exporting.');
      const finished = (await master(value, progress)).wav;
      const entries: ZipEntry[] = [{ name: `${label}_Finished.wav`, data: finished }];
      if (value.master.mp3) { progress('Encoding MP3…'); entries.push({ name: `${label}_Finished.mp3`, data: await encodeMp3(finished, title, (d) => progress(`Encoding MP3… ${Math.round(d * 100)}%`)) }); }
      if (value.master.rawTracks) {
        for (const track of tracks) if (!localIds.has(track.id)) {
          await saveRemoteTake(track, async (n) => { const r = await fetch(`/api/takes/${encodeURIComponent(track.id)}/segments/${n}`, { credentials: 'same-origin' }); if (!r.ok) throw new Error('Raw audio unavailable. Retry the export.'); return r.arrayBuffer(); }, (n) => progress(`Downloading raw audio… ${n} of ${track.segments}`));
          localIds.add(track.id);
        }
        const toneSettings = settings.recording.tones;
        for (const [index, track] of tracks.entries()) {
          progress(`Adding raw ${track.speaker || `track ${index + 1}`}…`);
          const raw = await rawRecordingWav(take, track, toneSettings);
          entries.push({ name: `${label}_${index === 0 ? 'Host' : track.speaker || `Guest${index}`}_raw.wav`, data: raw });
        }
        if (hasPads(take)) entries.push({ name: `${label}_Pads_raw.wav`, data: await rawRecordingWav(take, stereoOf(take), toneSettings, 'pads') });
        for (const track of value.tracks.filter((t) => t.kind === 'import')) {
          const source = sources.get(track.sourceId)!;
          // Raw exports retain the complete imported source even after all clips are deleted.
          const audio = await readLibraryFile(track.sourceId.replace(/^media:/, ''));
          entries.push({ name: `${label}_${track.name.replace(/[^A-Za-z0-9_-]/g, '_')}_raw.wav`, data: encodeWav([audio], { sampleRate: source.sampleRate, channels: source.channels, bitDepth: 24 }) });
        }
      }
      progress('Packaging download…');
      const archive = await zip(entries);
      const filename = `${label}_Podstudio.zip`;
      download(archive, filename);
      return { filename, downloadAgain: () => download(archive, filename) };
    };

    const [{ mount }, { default: EditorFlow }] = await Promise.all([import('svelte'), import('@/components/app/EditorFlow.svelte')]);
    const onpeaks = (track: EditorTrack, from: number, to: number, onChunk: (chunk: { start: number; peaks: number[] }) => void) => {
      const reader = sources.get(track.sourceId);
      if (!reader) throw new Error('Source audio is unavailable. Retry after it has synchronized.');
      const length = Math.max(...track.clips.map((clip) => clip.sourceDuration ?? clip.sourceEnd), 0);
      return sourcePeaks(track.sourceId, reader, length, from, to, onChunk);
    };
    mount(EditorFlow, { target: root.querySelector('[data-editor-mount]')!, props: { sessionsHref: `/episodes/${episodeId}/sessions`, initial: project, revision, views, sessions: sessions.map((t) => ({ id: t.id, name: new Date(t.startedAt).toLocaleString() })), onpreview, onanalyze, onsave, onimport, onexport, onprepare, onpeaks } });
    root.querySelector('[data-loading]')?.remove();
  }
</script>
