---
// This episode's recorded sessions: play, open to export, download, delete
import EpisodeData from '@/components/app/EpisodeData.astro';
import { episodePage } from '@/lib/episode-page';
import AppShell from '@/layouts/AppShell.astro';
import Button from '@/components/ui/Button.astro';
import { episode as mockEpisode } from '@/data/mock';

export const prerender = false;
const data = episodePage(Astro.params.id);
if (!data) return new Response('No such episode', { status: 404 });
const episode = { ...mockEpisode, ...data.episode };

const base = `/episodes/${episode.id}`;
---

<AppShell title="Sessions" crumbs={[{ label: episode.label, href: `${base}/studio` }, { label: 'Sessions' }]}>
  <EpisodeData data={data} />
  <div class="mx-auto flex w-full max-w-[720px] flex-col gap-10 px-4 pt-10 pb-12 sm:px-6" id="sessions" data-episode={episode.id}>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="page-title">Sessions</h1>
        <p class="mt-1.5 text-[15px] leading-normal text-text-2">
          Every session is one WAV, with retakes, coughs, pauses and ad-libs as markers. Open one in the editor.
        </p>
      </div>
      <Button href={`${base}/mic-check`} variant="record" size="lg" class="gap-2.5" data-new-session>
        <span class="size-2 rounded-full bg-white"></span>
        New session
      </Button>
    </div>
    <div class="flex flex-col gap-3.5" data-list>
      <p class="rounded-[14px] border border-dashed border-track-off px-5 py-[18px] text-[14px] text-text-2" data-empty>
        No sessions yet. Start one from the studio.
      </p>
    </div>
    <section class="flex flex-col gap-3" data-server-list hidden>
      <h2 class="section-label">On the server, not in this browser</h2>
      <div class="rounded-[14px] bg-surface py-0.5" data-server-rows></div>
    </section>
    <p class="help" data-upload-note>
      Sessions are saved in this browser as you record and sent to the server, so they're safe if this browser's data is
      cleared, and you can export them from another computer.
    </p>
  </div>

  <template id="session-card">
    <div class="flex flex-col gap-3 rounded-[14px] bg-surface p-5 data-[selected]:shadow-[inset_0_0_0_1px_var(--color-text)]">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <span class="text-[15px] text-text" data-name></span>
        <span class="font-mono text-[13px] text-text-2" data-when></span>
      </div>
      <div class="font-mono text-[13px] text-text-3" data-summary></div>
      <audio controls preload="none" class="h-8 w-full [color-scheme:dark]" data-audio></audio>
      <div data-ns-slot></div>
      <div class="flex flex-wrap items-center gap-4 text-[13px]">
        <a class="inline-flex h-9 items-center rounded-[10px] bg-text px-3.5 text-[14px] font-medium text-page hover:text-page" data-open>Open editor</a>
        <button type="button" class="inline-flex h-9 items-center rounded-[10px] border border-border px-3.5 text-[14px] text-text hover:border-handle" data-download>↓ Raw WAV</button>
        <button type="button" class="ml-auto inline-flex h-9 items-center rounded-[10px] border border-rec/70 px-3.5 text-[14px] text-rec hover:border-rec" data-delete>Delete</button>
      </div>
    </div>
  </template>
</AppShell>

<script>
  import { isMobile, recordingLink } from '@/lib/mobile';
  import { deleteTake, formatBytes, formatDuration, listTakes, saveRemoteTake, takeBytes, takeFileName, takeSeconds, takeWav, type TakeMeta } from '@/lib/audio/takes';
  import { fetchTakeSegment, resumeUploads, serverTakes } from '@/lib/take-upload';
  import { sessionUrl } from '@/lib/flow';
  import { offerRecovery } from '@/lib/recovery';
  import { download } from '@/lib/zip';
  import { markerCounts } from '@/lib/markers';
  import { noiseToggle, noiseToggleHtml } from '@/lib/player';

  const root = document.getElementById('sessions')!;
  const episodeId = root.dataset.episode!;
  root.querySelector<HTMLAnchorElement>('[data-new-session]')!.href = sessionUrl(episodeId);
  render().then(async () => {
    // Anything that didn't finish going up (closed early, or offline) goes now.
    const note = root.querySelector<HTMLElement>('[data-upload-note]')!;
    const was = note.textContent;
    await resumeUploads(episodeId, (t) => (note.textContent = `Sent ${t.name} to the server.`));
    setTimeout(() => (note.textContent = was), 4000);
    renderServerOnly();
  });

  /** Sessions on the server that this browser doesn't have: bring one in to play or export it. */
  async function renderServerOnly() {
    const local = new Set((await listTakes(episodeId)).map((t) => t.id));
    const box = root.querySelector<HTMLElement>('[data-server-list]')!;
    const rows = box.querySelector<HTMLElement>('[data-server-rows]')!;
    rows.replaceChildren();
    const missing = (await serverTakes(episodeId)).filter((t) => !local.has(t.id) && t.done && t.segments);
    box.hidden = !missing.length;
    for (const t of missing) {
      const m = t.meta;
      const row = document.createElement('div');
      row.dataset.serverTake = t.id;
      row.className = 'mx-5 flex flex-wrap items-center gap-3 border-t border-divider py-[14px] text-[14px] first:border-t-0';
      row.innerHTML = `<span class="min-w-0 flex-1"><span class="text-text" data-t></span><span class="ml-2 font-mono text-[13px] text-text-2" data-m></span></span><button type="button" class="inline-flex h-9 items-center rounded-[10px] bg-control px-3.5 text-[14px] text-text hover:bg-nav">Bring into this browser</button>`;
      row.querySelector('[data-t]')!.textContent = new Date(m.startedAt).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
      row.querySelector('[data-m]')!.textContent = `${formatDuration(m.samples / m.sampleRate)} · ${formatBytes(m.samples * (m.bitDepth / 8) * (m.channels ?? 1))}`;
      const btn = row.querySelector('button')!;
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try {
          await saveRemoteTake({ ...m, segments: t.segments, status: 'recording', remote: true }, (n) => fetchTakeSegment(t.id, n), (n) => (btn.textContent = `Bringing it in · ${n} of ${t.segments}`));
          location.href = `/episodes/${episodeId}/sessions?take=${encodeURIComponent(t.id)}`;
        } catch (err) {
          btn.textContent = `Couldn’t: ${(err as Error).message}. Try again`;
          btn.disabled = false;
        }
      });
      if (t.done) {
        const open = document.createElement('a'); open.textContent = 'Open editor'; recordingLink(open, episodeId, t.id);
        open.className = 'inline-flex h-9 items-center rounded-[10px] bg-text px-3.5 text-[14px] text-page';
        row.insertBefore(open, btn);
      }
      rows.append(row);
    }
  }

  async function render() {
    await offerRecovery(episodeId);
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const tpl = (document.getElementById('session-card') as HTMLTemplateElement).content.firstElementChild!;
    const selected = new URL(location.href).searchParams.get('take');
    const all = (await listTakes(episodeId)).filter((t) => t.status === 'done');
    // One card per session. Recordings made before
    // sessions (separate takes) have no group and show on their own.
    const groups = new Map<string, TakeMeta[]>();
    for (const t of all) {
      const key = t.group ?? t.id;
      groups.set(key, [...(groups.get(key) ?? []), t]);
    }
    list.querySelector<HTMLElement>('[data-empty]')!.hidden = groups.size > 0;
    list.querySelectorAll('[data-card]').forEach((c) => c.remove());

    // Newest first.
    const ordered = [...groups.values()].sort((a, b) => b[0].startedAt - a[0].startedAt);
    for (const [i, tracks] of ordered.entries()) {
      const t = tracks[0];
      const card = tpl.cloneNode(true) as HTMLElement;
      card.dataset.card = t.id;
      card.toggleAttribute('data-selected', tracks.some((x) => x.id === selected));
      const q = <T extends HTMLElement = HTMLElement>(s: string) => card.querySelector<T>(s)!;
      const session = t.kind === 'session';
      q('[data-name]').textContent = session ? `Session ${ordered.length - i}` : `${t.name} (older take)`;
      q('[data-when]').textContent = new Date(t.startedAt).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
      const bytes = tracks.reduce((n, x) => n + takeBytes(x), 0);
      q('[data-summary]').textContent = [
        formatDuration(takeSeconds(t)),
        session ? markerCounts(t.markers ?? []) || 'No markers' : '',
        `${t.bitDepth}-bit · ${t.sampleRate / 1000} kHz · ${t.channels === 2 ? 'stereo' : 'mono'}`,
        formatBytes(bytes),
      ]
        .filter(Boolean)
        .join(' · ');

      const open = q<HTMLAnchorElement>('[data-open]');
      // A guest's track still to come: open the wrap-up, which waits for it, instead of Export.
      const waitingFor = t.guest && tracks.length === 1 ? t.guest.name : null;
      recordingLink(open, episodeId, t.id);
      if (waitingFor) {
        if (!isMobile()) open.textContent = `Get ${waitingFor}'s track →`;
        q('[data-summary]').textContent += ` · waiting for ${waitingFor}'s track`;
      }
      // WAVs are disk-backed Blobs, so a URL per session costs nothing up front.
      const audio = q<HTMLAudioElement>('[data-audio]');
      const originalUrl = URL.createObjectURL(await takeWav(t));
      audio.src = originalUrl;
      // Noise suppression on the player (the whole session, cleaned once and kept).
      const slot = q('[data-ns-slot]');
      slot.innerHTML = noiseToggleHtml(`ns-${t.id}`);
      noiseToggle(audio, slot.querySelector<HTMLInputElement>('[data-ns-toggle]')!, slot.querySelector<HTMLElement>('[data-ns-status]')!, t, async () => originalUrl);
      q('[data-download]').addEventListener('click', async () => {
        for (const x of tracks) download(await takeWav(x), takeFileName(x));
      });
      q('[data-delete]').addEventListener('click', async () => {
        const what = tracks.length > 1 ? `this session and its ${tracks.length} tracks` : 'this recording';
        if (!confirm(`Delete ${what}, here and on the server? This can’t be undone.`)) return;
        for (const x of tracks) {
          await deleteTake(x.id);
          await fetch(`/api/takes/${encodeURIComponent(x.id)}`, { method: 'DELETE', credentials: 'same-origin' }).catch(() => {});
        }
        render();
      });
      list.append(card);
    }
    if (selected) list.querySelector('[data-selected]')?.scrollIntoView({ block: 'nearest' });
  }
</script>
