---
// 6b · Host view during a recording (Takes mode), and 8a · Continuous mode
import AppShell from '@/layouts/AppShell.astro';
import Callout from '@/components/ui/Callout.astro';
import Dot from '@/components/ui/Dot.astro';
import StatusRow from '@/components/ui/StatusRow.astro';
import Waveform from '@/components/ui/Waveform.astro';
import Button from '@/components/ui/Button.astro';
import { devices, episode, episodePaths, lineStarts, scriptLines, scriptWords, speakerByKey, spk, storage, tracks } from '@/data/mock';
import { waveforms } from '@/data/waveforms';

export const getStaticPaths = episodePaths;

/** The speaker on this computer's mic (the host, per the script editor's Screens list). */
const local = 'TYLER';
const BARS = 90;
const lines = scriptLines.map((l) => ({ who: l.who, text: l.text }));

// 8a example content (shown with ?demo&mode=continuous).
const demoMarkers = [
  { t: '24:02', kind: 'Retake', text: 'Line 3 · “Four. I counted.”' },
  { t: '15:21', kind: 'Retake', text: 'Line 41 · attempt 3' },
  { t: '14:48', kind: 'Retake', text: 'Line 41 · attempt 2' },
  { t: '09:14', kind: 'Pause', text: '1:26 · before Line 28' },
  { t: '03:10', kind: 'Retake', text: 'Line 9' },
];
const demoTimeline = { retakes: [13, 61, 63, 98.8], pauses: [[38, 6]] };
const modeOption =
  'flex h-7 items-center rounded-md px-3.5 text-[13px] text-muted hover:text-fg has-checked:bg-fg has-checked:font-medium has-checked:text-ink has-disabled:cursor-default has-disabled:opacity-60 has-focus-visible:outline-2 has-focus-visible:outline-fg';
---

<AppShell title="Recording" avatar={false} crumbs={[{ label: episode.label, href: `/episodes/${episode.id}/studio` }, { label: 'Recording' }]}>
  <div
    slot="topbar-center"
    role="radiogroup"
    aria-label="Recording mode"
    class="flex gap-[3px] rounded-lg border border-line bg-surface p-[3px] max-sm:hidden"
  >
    <label class={modeOption}><input type="radio" name="rec-mode" value="takes" checked class="sr-only" data-mode-radio />Takes</label>
    <label class={modeOption}><input type="radio" name="rec-mode" value="continuous" class="sr-only" data-mode-radio />Continuous</label>
  </div>
  <div slot="topbar" class="flex items-center gap-2 font-mono text-[13px] font-medium" data-rec>
    <Dot color="var(--color-rec)" size={8} pulse data-rec-dot />
    <span data-rec-label>REC <span data-clock>24:10</span></span>
  </div>

  <div
    class="group/rec lg:h-full"
    id="recording"
    data-mode="takes"
    data-episode={episode.id}
    data-local={local}
    data-words={JSON.stringify(scriptWords)}
    data-lines={JSON.stringify(lines)}
    data-line-starts={JSON.stringify(lineStarts)}
    data-devices={JSON.stringify(Object.fromEntries(devices.map((d) => [d.id, d.name])))}
  >
  <div class="grid lg:h-full lg:grid-cols-[1fr_360px] group-data-[mode=continuous]/rec:hidden">
    <section class="flex min-w-0 flex-col gap-4.5 border-line px-6 py-7 lg:border-r lg:px-9">
      <Callout title="Podstudio records. It doesn’t connect calls." color="var(--color-muted)">
        Talk to remote guests over Zoom, Slack, Teams, Discord or any call app. Podstudio records each person’s own mic
        on their own device, never the call audio.
      </Callout>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-[14px] font-medium">Tracks</h2>
        <div class="meta text-subtle" data-demo-only>24-bit · 48 kHz · mono · shared session clock</div>
        <div class="meta text-subtle" data-live-only data-format></div>
      </div>

      <div class="flex flex-col border-t border-line" data-demo-only>
        {
          tracks.map((t) => (
            <div class="grid grid-cols-[170px_minmax(0,1fr)_190px] items-center gap-5 border-b border-line py-4.5 max-md:grid-cols-[1fr_1fr]">
              <div class="flex flex-col gap-1">
                <div class="flex items-center gap-2 text-[15px]">
                  <Dot color={spk(t.who)} size={8} />
                  {speakerByKey(t.who).name}
                </div>
                <div class="font-mono text-[11px] text-subtle">{t.device}</div>
              </div>
              <Waveform bars={waveforms[t.who]} color={spk(t.who)} class="max-md:order-last max-md:col-span-2" />
              <div class="flex flex-col gap-1 font-mono text-[11px] text-muted">
                <span class="flex items-center gap-1.5">
                  <Dot color={t.statusColor} />
                  {t.status}
                </span>
                <span class="text-faint">{t.offset}</span>
              </div>
            </div>
          ))
        }
      </div>

      <div class="flex flex-col border-t border-line" data-live-only>
        <div class="grid grid-cols-[170px_minmax(0,1fr)_190px] items-center gap-5 border-b border-line py-4.5 max-md:grid-cols-[1fr_1fr]">
          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2 text-[15px]">
              <Dot color={spk(local)} size={8} />
              {speakerByKey(local).name}
            </div>
            <div class="truncate font-mono text-[11px] text-subtle" data-device>This computer</div>
          </div>
          <div class="flex h-10 w-full items-center gap-0.5 max-md:order-last max-md:col-span-2" aria-hidden="true" data-live-wave>
            {Array.from({ length: BARS }, () => <span class="h-[4%] flex-1 rounded-[1px] opacity-25" style={{ background: spk(local) }} />)}
          </div>
          <div class="flex flex-col gap-1 font-mono text-[11px] text-muted">
            <span class="flex items-center gap-1.5"><span class="inline-block size-1.5 rounded-full bg-faint" data-save-dot></span><span data-save>Ready</span></span>
            <span class="text-faint" data-peak>Peak —</span>
          </div>
        </div>
        <div class="border-b border-line py-4 text-[13px] text-subtle">
          Remote guests show up here, one track each, once they join from an invite link. That needs the Podstudio server.
        </div>
      </div>

      <p class="text-[12px] leading-normal text-subtle">
        Each track records on the speaker’s own device. If someone’s connection drops, their device keeps recording and
        uploads the rest when it reconnects.
      </p>
    </section>

    <aside class="flex flex-col gap-3.5 p-6">
      <h2 class="text-[14px] font-medium">Now reading</h2>
      <div class="flex flex-col gap-1.5 rounded-[10px] bg-surface p-3.5" aria-live="polite">
        <div class="font-mono text-[11px] font-medium tracking-[0.06em]" style={{ color: spk('DANA') }} data-now-who>DANA</div>
        <div class="text-[15px] leading-normal" data-now-text>And whether the floor could hold it, which nobody checked until I asked.</div>
      </div>
      <div class="mt-1.5 flex flex-col" data-demo-only>
        <StatusRow label="Remote guests" value="2 connected" color="var(--color-ok)" dense />
        <StatusRow label="Upload queue" value="2 chunks · 10 s" color="var(--color-warn)" dense />
        <StatusRow label="Server space" value={`${storage.free} free`} dense />
      </div>
      <div class="mt-1.5 flex flex-col" data-live-only>
        <div class="flex items-center justify-between gap-4 border-b border-line py-[11px] text-[13px]">
          <span class="text-muted">Saved in this browser</span>
          <span class="meta" data-saved>—</span>
        </div>
        <div class="flex items-center justify-between gap-4 border-b border-line py-[11px] text-[13px]">
          <span class="text-muted">Voice follow</span>
          <span class="meta flex items-center gap-2"><span class="inline-block size-1.5 rounded-full bg-faint" data-voice-dot></span><span data-voice>Starts with the take</span></span>
        </div>
        <div class="flex items-center justify-between gap-4 border-b border-line py-[11px] text-[13px]">
          <span class="text-muted">Free space</span>
          <span class="meta" data-free>—</span>
        </div>
      </div>
      <div class="mt-auto flex flex-col gap-2.5 pt-6">
        <Button href={`/episodes/${episode.id}/transcribing?demo`} variant="record" size="xl" class="gap-2.5" data-demo-only>
          <span class="size-3 rounded-[2px] bg-white"></span>
          Stop take
        </Button>
        <Button variant="record" size="xl" class="gap-2.5" data-live-only data-toggle disabled>
          <span class="size-3 rounded-full bg-white" data-toggle-icon></span>
          <span data-toggle-label>Start take</span>
        </Button>
        <p class="text-center text-[12px] text-subtle" data-demo-only>Stopping waits for every guest’s upload to finish</p>
        <p class="text-center text-[12px] text-subtle" data-live-only data-hint>
          Audio is saved to this browser every 5 seconds as you record.
        </p>
      </div>
    </aside>
  </div>

  <!-- 8a · Continuous mode: one file per track, retakes and pauses as markers -->
  <div class="hidden lg:h-full lg:grid-cols-[1fr_360px] lg:grid-rows-[minmax(0,1fr)] group-data-[mode=continuous]/rec:grid">
    <section class="flex min-h-0 min-w-0 flex-col gap-3 border-line px-6 py-6 max-lg:h-[80dvh] lg:border-r lg:px-12">
      <div class="flex flex-col gap-3" data-demo-only>
        <div class="grid grid-cols-[90px_1fr] gap-4.5 px-3.5 py-3 opacity-45" data-c-line="prev">
          <span class="pt-1.5 font-mono text-[11px] font-medium tracking-[0.06em]" style={{ color: spk('SAM') }} data-who>SAM</span>
          <span class="text-[18px] leading-[1.6] text-fg-soft" data-text>Four pallets? I heard it was five, and one of them was just foam.</span>
        </div>
        <div class="grid grid-cols-[90px_1fr] gap-4.5 rounded-[10px] bg-surface px-3.5 py-3 shadow-[inset_0_0_0_1px_var(--color-edge)]" data-c-line="cur">
          <span class="pt-1.5 font-mono text-[11px] font-medium tracking-[0.06em]" style={{ color: spk('TYLER') }} data-who>TYLER</span>
          <div class="flex flex-col gap-2.5">
            <span class="text-[22px] leading-[1.55]" data-text>Four. I counted. So this episode is about what happens after the crate is open.</span>
            <span class="font-mono text-[11px] font-medium tracking-[0.06em] text-warn" data-attempt>ATTEMPT 2 · RETAKE MARKED AT 24:02</span>
          </div>
        </div>
        <div class="grid grid-cols-[90px_1fr] gap-4.5 px-3.5 py-3" data-c-line="next">
          <span class="pt-1.5 font-mono text-[11px] font-medium tracking-[0.06em]" style={{ color: spk('SAM') }} data-who>SAM</span>
          <span class="text-[18px] leading-[1.6] text-fg-soft" data-text>Which is when the real trouble starts.</span>
        </div>
      </div>

      <!-- Live: the whole script, scrolling with the reader -->
      <div class="relative -mx-3.5 min-h-[200px] flex-1 overflow-hidden" data-live-only data-c-viewport>
        <div class="pointer-events-none absolute inset-x-0 top-0 z-[1] h-12 bg-linear-to-b from-ink to-transparent" aria-hidden="true"></div>
        <div class="flex flex-col gap-2 pt-4 transition-transform duration-500 ease-in-out" data-c-track></div>
      </div>
      <div class="flex flex-col gap-2" data-live-only>
        <div class="flex h-10 w-full items-center gap-0.5" aria-hidden="true" data-live-wave data-solo-wave>
          {Array.from({ length: BARS }, () => <span class="h-[4%] flex-1 rounded-[1px] opacity-25" style={{ background: spk(local) }} />)}
        </div>
        <!-- Multi-speaker: one continuously recorded track per speaker -->
        <div class="flex flex-col border-t border-line" data-c-tracks hidden></div>
        <div class="flex items-center justify-between gap-4 font-mono text-[11px] text-subtle">
          <span class="min-w-0 truncate" data-heard>Heard: —</span>
          <span class="flex flex-none items-center gap-1.5"><span class="inline-block size-1.5 rounded-full bg-faint" data-c-voice-dot></span><span data-c-voice>Voice follow starts with the session</span></span>
        </div>
      </div>

      <div class="flex flex-col gap-2.5 pt-2 [html[data-demo]_&]:mt-auto">
        <div class="flex justify-between font-mono text-[11px] text-subtle">
          <span>00:00</span><span data-c-files>One file · Tyler, Sam</span><span data-c-length>24:18</span>
        </div>
        <div class="relative h-11 overflow-hidden rounded-lg bg-surface" data-timeline aria-hidden="true">
          <div class="absolute inset-0 bg-[repeating-linear-gradient(90deg,var(--color-edge)_0_2px,transparent_2px_5px)] opacity-70"></div>
          <div data-demo-only>
            {demoTimeline.pauses.map(([left, width]) => (
              <div class="absolute inset-y-0 border-x border-dashed border-edge-strong bg-ink" style={{ left: `${left}%`, width: `${width}%` }} />
            ))}
            {demoTimeline.retakes.map((left) => <div class="absolute inset-y-0 w-0.5 bg-warn" style={{ left: `${left}%` }} />)}
          </div>
          <div data-live-only data-timeline-live></div>
          <div class="absolute inset-y-0 right-0 w-0.5 bg-rec"></div>
        </div>
        <div class="flex gap-4.5 text-[12px] text-muted">
          <span class="flex items-center gap-1.5"><span class="inline-block size-2 rounded-[2px] bg-warn"></span>Retake</span>
          <span class="flex items-center gap-1.5"><span class="inline-block size-2 rounded-[2px] border border-dashed border-subtle"></span>Pause</span>
        </div>
      </div>
    </section>

    <aside class="flex min-h-0 flex-col gap-3.5 p-6">
      <div class="grid grid-cols-2 gap-2.5">
        <button
          type="button"
          class="flex h-16 flex-col items-center justify-center gap-0.5 rounded-xl bg-warn text-ink disabled:opacity-40"
          data-retake
        >
          <span class="text-[15px] font-semibold">Retake line</span>
          <span class="font-mono text-[11px] font-medium">R</span>
        </button>
        <button
          type="button"
          class="flex h-16 flex-col items-center justify-center gap-0.5 rounded-xl bg-raised aria-pressed:bg-fg aria-pressed:text-ink disabled:opacity-40"
          aria-pressed="false"
          data-pause
        >
          <span class="text-[15px] font-medium" data-pause-label>Pause</span>
          <span class="font-mono text-[11px] font-medium text-muted" data-pause-key>P</span>
        </button>
      </div>
      <p class="text-[12px] leading-normal text-subtle">
        Retake keeps recording, plays a short tone, drops a marker and rolls the prompter back to the start of the line.
      </p>
      <h2 class="mt-1.5 text-[13px] font-medium">Markers</h2>
      <div class="flex min-h-0 flex-col overflow-auto" data-demo-only>
        {demoMarkers.map((m) => (
          <div class="grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]">
            <span class="font-mono text-muted">{m.t}</span>
            <span><span class={m.kind === 'Retake' ? 'text-warn' : 'text-fg-soft'}>{m.kind}</span> · {m.text}</span>
          </div>
        ))}
      </div>
      <div class="flex min-h-0 flex-col overflow-auto" data-live-only data-marker-list>
        <p class="py-2.5 text-[13px] text-subtle" data-marker-empty>No markers yet. Press R to retake a line, P to pause.</p>
      </div>
      <div class="mt-auto flex flex-col gap-2.5 pt-4">
        <div class="flex items-center justify-between text-[13px]">
          <span class="text-muted" id="retake-tone-label">Retake tone</span>
          <label class="relative inline-flex h-5 w-[34px] flex-none items-center rounded-full bg-edge has-checked:bg-ok has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-fg">
            <input type="checkbox" role="switch" checked class="peer sr-only" aria-labelledby="retake-tone-label" data-retake-tone />
            <span class="absolute top-0.5 left-0.5 size-4 rounded-full bg-subtle transition-all peer-checked:left-4 peer-checked:bg-white"></span>
          </label>
        </div>
        <button type="button" class="flex h-11 items-center justify-center rounded-[10px] border border-edge text-[14px] hover:bg-raised" data-demo-only>
          Stop session
        </button>
        <button
          type="button"
          class="flex h-11 items-center justify-center gap-2 rounded-[10px] bg-rec text-[14px] font-medium text-white disabled:opacity-50 data-[running]:border data-[running]:border-edge data-[running]:bg-transparent data-[running]:font-normal data-[running]:text-fg"
          data-live-only
          data-session-toggle
          disabled
        >
          <span class="size-2 rounded-full bg-white" data-session-icon></span>
          <span data-session-label>Start session</span>
        </button>
        <p class="text-center text-[12px] text-subtle" data-live-only data-session-hint>
          One file for the whole session, saved to this browser every 5 seconds.
        </p>
      </div>
    </aside>
  </div>
  </div>
</AppShell>

<script>
  import { MicCapture } from '@/lib/audio/capture';
  import { TakeWriter, formatBytes, listTakes, storageLeft } from '@/lib/audio/takes';
  import { startClock } from '@/lib/prompter';
  import { offerRecovery } from '@/lib/recovery';
  import { Session } from '@/lib/session';
  import { hz, loadSettings, saveSettings } from '@/lib/settings';
  import type { SessionMarker } from '@/lib/audio/assemble';
  import { Prompter } from '@/lib/prompter';
  import { loadScript, speakerColor, speakerName } from '@/lib/script-store';
  import { VoiceFollow, voiceErrorText, voiceFollowSupported } from '@/lib/voice/follow';

  const root = document.getElementById('recording')!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const demo = new URL(location.href).searchParams.has('demo');

  // Takes or Continuous (8a). A punch-in link always records a take.
  const params0 = new URL(location.href).searchParams;
  const radios = [...document.querySelectorAll<HTMLInputElement>('[data-mode-radio]')];
  const setMode = (m: string) => {
    root.dataset.mode = m === 'continuous' ? 'continuous' : 'takes';
    radios.forEach((r) => (r.checked = r.value === root.dataset.mode));
  };
  setMode(params0.get('mode') ?? (demo || params0.has('from') ? 'takes' : loadSettings().recording.mode));
  radios.forEach((r) =>
    r.addEventListener('change', () => {
      setMode(r.value);
      if (!demo) saveSettings('recording', { mode: r.value as 'takes' | 'continuous' });
    }),
  );

  if (demo) {
    startClock([...document.querySelectorAll<HTMLElement>('[data-clock]')], root.dataset.mode === 'continuous' ? 24 * 60 + 18 : 24 * 60 + 10);
  } else {
    live();
  }

  async function live() {
    const episodeId = root.dataset.episode!;
    // The episode's script: the user's own if they pasted or imported one, else the example.
    const script = loadScript(episodeId);
    const words = script.words;
    const lines = script.lines;
    const starts = script.lineStarts;
    const prompterSettings = loadSettings().prompter;
    // Solo reads have one track and no speakers to show. With several speakers, every
    // speaker records their own track for the whole session, on one shared clock.
    const solo = script.speakers.length <= 1;
    const host = script.speakers.includes(root.dataset.local!) ? root.dataset.local! : (script.speakers[0] ?? root.dataset.local!);
    const trackSpeakers = solo ? [host] : script.speakers;
    const INPUTS_KEY = 'podstudio:track-inputs';
    // Per speaker: a mic on this computer ('default' = the Recording settings mic), 'remote', or 'off'.
    let inputs: Record<string, string> = {};
    try {
      inputs = JSON.parse(localStorage.getItem(INPUTS_KEY) || '{}');
    } catch {}
    for (const k of trackSpeakers) inputs[k] ??= k === host ? 'default' : 'remote';
    const saveInputs = () => {
      try {
        localStorage.setItem(INPUTS_KEY, JSON.stringify(inputs));
      } catch {}
    };
    const settings = loadSettings().recording;
    const params = new URL(location.href).searchParams;
    const fromLine = Math.max(0, Math.min(lines.length - 1, Number(params.get('from') ?? 0) || 0));
    const punchIn = params.has('from');

    await offerRecovery(episodeId);

    const toggle = $<HTMLButtonElement>('[data-toggle]');
    const sessionToggle = $<HTMLButtonElement>('[data-session-toggle]');
    const continuous = () => root.dataset.mode === 'continuous';
    const recLabel = $('[data-rec-label]');
    const recDot = $('[data-rec-dot]');
    const setRecIndicator = (on: boolean, text: string) => {
      recLabel.textContent = text;
      recDot.style.background = on ? '' : 'var(--color-faint)';
      recDot.style.animation = on ? '' : 'none';
    };
    setRecIndicator(false, 'READY');

    const takes = await listTakes(episodeId);
    const nextNumber = takes.reduce((n, t) => Math.max(n, t.number), 0) + 1;
    $('[data-toggle-label]').textContent = `Start take ${nextNumber}`;
    $('[data-format]').textContent =
      `${settings.depth}-bit · ${settings.rate} kHz · mono${punchIn ? ` · punch-in from line ${fromLine + 1}` : ''}`;
    toggle.disabled = false;
    sessionToggle.disabled = false;

    const free = async () => {
      const { free, hours } = await storageLeft(hz(settings.rate), settings.depth);
      $('[data-free]').textContent = `${formatBytes(free)} · about ${hours >= 10 ? Math.round(hours) : hours.toFixed(1)} h`;
    };
    free();

    // Now reading: the line voice follow says is being read.
    const lineOf = (i: number) => starts.reduce((line, s, n) => (i >= s ? n : line), 0);
    const fmt = (sec: number) => {
      const t = Math.floor(sec);
      return `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;
    };
    // Continuous mode: retake attempts per line, and when the last retake was marked.
    const attempts = new Map<number, { n: number; at: number }>();
    const fillLine = (slot: string, n: number) => {
      const el = root.querySelector<HTMLElement>(`[data-c-line="${slot}"]`)!;
      el.style.visibility = lines[n] ? '' : 'hidden';
      if (!lines[n]) return;
      const who = el.querySelector<HTMLElement>('[data-who]')!;
      who.textContent = lines[n].who;
      who.style.color = speakerColor(lines[n].who);
      el.querySelector('[data-text]')!.textContent = lines[n].text;
    };
    // Continuous view: the whole script as a prompter that scrolls with the reader.
    const track = $('[data-c-track]');
    track.replaceChildren(
      ...lines.map((l, n) => {
        const row = document.createElement('div');
        row.dataset.line = String(n);
        row.dataset.who = l.who;
        row.className = `group grid cursor-pointer ${solo ? 'grid-cols-1' : 'grid-cols-[90px_1fr]'} gap-4.5 rounded-[10px] px-3.5 py-3 transition-[opacity,background-color] hover:bg-surface/60 data-[l=now]:bg-surface data-[l=now]:shadow-[inset_0_0_0_1px_var(--color-edge)] data-[l=past]:opacity-45 data-[theirs]:data-[l=next]:opacity-50`;
        const who = document.createElement('span');
        who.className = 'pt-1.5 font-mono text-[11px] font-medium tracking-[0.06em] uppercase';
        who.style.color = speakerColor(l.who);
        who.textContent = l.who || '—';
        who.hidden = solo;
        const body = document.createElement('div');
        body.className = 'flex flex-col gap-2.5';
        const text = document.createElement('div');
        text.className =
          'flex flex-wrap gap-x-[0.25em] text-[18px] leading-[1.6] text-fg-soft transition-[font-size] group-data-[l=now]:text-[22px] group-data-[l=now]:leading-[1.55] group-data-[l=now]:text-fg';
        for (const w of l.text.split(/\s+/).filter(Boolean)) {
          const span = document.createElement('span');
          span.dataset.word = '';
          span.className =
            'group-data-[l=now]:data-[w=past]:text-muted group-data-[l=now]:data-[w=now]:shadow-[inset_0_-3px_0_var(--color-rec)]';
          span.textContent = w;
          // A real space keeps copy and screen readers right; flex layout ignores it.
          text.append(span, ' ');
        }
        const attempt = document.createElement('span');
        attempt.className = 'font-mono text-[11px] font-medium tracking-[0.06em] text-warn';
        attempt.dataset.lineAttempt = '';
        attempt.hidden = true;
        body.append(text, attempt);
        row.append(who, body);
        // Click a line to put the reader there (handy when voice follow can't hear you).
        row.addEventListener('click', () => setWord(starts[n]));
        return row;
      }),
    );
    const cPrompter = new Prompter($('[data-c-viewport]'), track, { line: 0.3 });

    // Tracks (multi-speaker continuous sessions): one row per speaker.
    const tracksEl = $('[data-c-tracks]');
    const rowFor = new Map<string, HTMLElement>();
    const barsFor = new Map<string, HTMLElement[]>();
    if (!solo) {
      $('[data-solo-wave]').hidden = true;
      tracksEl.hidden = false;
      for (const k of trackSpeakers) {
        const row = document.createElement('div');
        row.className =
          'grid grid-cols-[120px_minmax(0,1fr)_170px] items-center gap-4 border-b border-line py-2 data-[talking]:bg-surface data-[talking]:shadow-[inset_2px_0_0_var(--c)]';
        row.style.setProperty('--c', speakerColor(k));
        row.innerHTML = `
          <div class="flex min-w-0 flex-col gap-0.5 pl-2">
            <span class="flex items-center gap-2 text-[14px]"><span class="inline-block size-2 flex-none rounded-full" style="background:var(--c)"></span><span data-name></span></span>
            <span class="font-mono text-[10px] tracking-[0.06em] text-(--c)" data-talking-label hidden>TALKING NOW</span>
          </div>
          <div class="flex h-8 w-full items-center gap-0.5" aria-hidden="true" data-bars></div>
          <div class="min-w-0 pr-2">
            <select class="w-full truncate rounded-md border border-edge bg-surface px-2 py-1 text-[12px] focus:border-fg focus:outline-none" aria-label="Input for this speaker" data-input></select>
            <span class="block truncate font-mono text-[11px] text-muted" data-status hidden></span>
          </div>`;
        row.querySelector('[data-name]')!.textContent = speakerName(k);
        const bars = row.querySelector<HTMLElement>('[data-bars]')!;
        const list: HTMLElement[] = [];
        for (let i = 0; i < 60; i++) {
          const b = document.createElement('span');
          b.className = 'h-[6%] flex-1 rounded-[1px] opacity-25';
          b.style.background = 'var(--c)';
          bars.append(b);
          list.push(b);
        }
        barsFor.set(k, list);
        const select = row.querySelector<HTMLSelectElement>('[data-input]')!;
        select.addEventListener('change', () => {
          inputs[k] = select.value;
          saveInputs();
        });
        rowFor.set(k, row);
        tracksEl.append(row);
      }
      // Mic names are available once microphone access has been granted.
      MicCapture.inputs().then((devices) => {
        for (const [k, row] of rowFor) {
          const select = row.querySelector<HTMLSelectElement>('[data-input]')!;
          select.replaceChildren(
            new Option('This computer’s mic', 'default'),
            ...devices.filter((d) => d.deviceId && d.deviceId !== 'default').map((d, i) => new Option(d.label || `Microphone ${i + 1}`, d.deviceId)),
            new Option('Remote · own device', 'remote'),
            new Option('Not recorded', 'off'),
          );
          select.value = [...select.options].some((o) => o.value === inputs[k]) ? inputs[k] : 'remote';
        }
      });
    }
    const filesLabel = () =>
      solo ? 'One file' : `${trackSpeakers.length} tracks · ${trackSpeakers.map(speakerName).join(', ')} · one clock`;

    const showLine = (n: number) => {
      const who = $('[data-now-who]');
      who.textContent = lines[n].who;
      who.style.color = speakerColor(lines[n].who);
      $('[data-now-text]').textContent = lines[n].text;
      fillLine('prev', n - 1);
      fillLine('cur', n);
      fillLine('next', n + 1);
      const a = attempts.get(n);
      const label = $('[data-attempt]');
      label.hidden = !a;
      if (a) label.textContent = `ATTEMPT ${a.n} · RETAKE MARKED AT ${fmt(a.at)}`;
      // Same label on the live prompter's line.
      const live = track.querySelector<HTMLElement>(`[data-line="${n}"] [data-line-attempt]`);
      if (live) {
        live.hidden = !a;
        if (a) live.textContent = `ATTEMPT ${a.n} · RETAKE MARKED AT ${fmt(a.at)}`;
      }
      // Whose turn it is: their track is the one talking.
      for (const [k, row] of rowFor) {
        const on = k === lines[n].who;
        row.toggleAttribute('data-talking', on);
        row.querySelector<HTMLElement>('[data-talking-label]')!.hidden = !on;
      }
    };

    const session = new Session(episodeId);
    const capture = new MicCapture();
    let writer: TakeWriter | null = null;
    let voice: VoiceFollow | null = null;
    let startedAt = 0;
    // Punch-ins roll the prompter back two lines for a run-up.
    let word = starts[Math.max(0, fromLine - (punchIn ? 2 : 0))];
    let currentLine = lineOf(word);
    showLine(currentLine);
    $('[data-c-length]').textContent = '00:00';
    $('[data-c-files]').textContent = filesLabel();
    if (!solo) $('[data-session-hint]').textContent = 'Every speaker’s track records the whole session, saved to this browser every 5 seconds.';
    let paused: SessionMarker | null = null;
    cPrompter.setWord(word);

    /** Move to a script word; in a continuous session, log when a new line starts. */
    const setWord = (i: number, broadcast = true) => {
      word = i;
      const line = lineOf(i);
      if (line !== currentLine && writer && continuous()) writer.meta.lineLog?.push({ t: writer.seconds, line });
      currentLine = line;
      showLine(line);
      cPrompter.setWord(i);
      voice?.setWord(i);
      // Saved with the next segment, so a recovered take knows where it stopped.
      if (writer) writer.meta.lastLine = line;
      if (broadcast) session.send({ type: 'word', index: i, device: device() });
    };
    let clock: number | undefined;
    // Other screens show "Following <this computer>"; the mic's own name goes on the track.
    const computer = (JSON.parse(root.dataset.devices!) as Record<string, string>)[settings.recorder] ?? 'This computer';
    const device = () => computer;
    const recMsg = () => ({ type: 'rec' as const, recording: !!writer, startedAt, device: device(), take: writer?.meta.id });

    session.on('hello', () => writer && session.send(recMsg()));
    session.on('control', (m) => {
      if (m.action === 'goto' && m.word != null) setWord(m.word, false);
      if (m.action === 'next') setWord(starts[Math.min(currentLine + 1, starts.length - 1)], false);
      if (m.action === 'prev') setWord(starts[Math.max(currentLine - 1, 0)], false);
      // The producer's pause becomes a pause marker in a continuous session.
      if (continuous() && writer && ((m.action === 'pause' && !paused) || (m.action === 'resume' && paused))) togglePause(false);
    });

    // Live waveform: one bar per quarter second, newest on the right.
    // Both views have a live waveform; they show the same bars.
    const waves = [...document.querySelectorAll<HTMLElement>('[data-live-wave]')].map((w) => [...w.querySelectorAll<HTMLElement>('span')]);
    const heights: number[] = waves[0].map(() => 0);
    let windowPeak = 0;
    let clipAt = 0;
    capture.addEventListener('level', (e) => {
      const { peak } = (e as CustomEvent<{ peak: number }>).detail;
      windowPeak = Math.max(windowPeak, peak);
      if (peak > -0.5) clipAt = Date.now();
    });
    // Multi-speaker rows: the level of each speaker's mic, newest bar on the right.
    const rowPeaks = new Map<string, number>();
    const rowHeights = new Map<string, number[]>([...barsFor.keys()].map((k) => [k, Array(60).fill(0)]));
    setInterval(() => {
      if (!writer || solo) return;
      for (const [k, bars] of barsFor) {
        const peak = rowPeaks.get(k) ?? -Infinity;
        const h = rowHeights.get(k)!;
        h.push(Number.isFinite(peak) ? Math.max(6, Math.min(100, ((peak + 60) / 60) * 100)) : 0);
        h.shift();
        bars.forEach((b, i) => {
          b.style.height = `${h[i] || 6}%`;
          b.style.opacity = h[i] ? '0.85' : '0.25';
        });
        if (rowPeaks.has(k)) rowPeaks.set(k, -Infinity);
      }
    }, 250);

    setInterval(() => {
      if (!writer) return;
      // -60..0 dBFS → 4..100 %
      const pct = Number.isFinite(windowPeak) ? Math.max(4, Math.min(100, ((windowPeak + 60) / 60) * 100)) : 4;
      heights.push(pct);
      heights.shift();
      for (const bars of waves) {
        bars.forEach((b, i) => {
          b.style.height = `${heights[i] || 4}%`;
          b.style.opacity = heights[i] ? '0.85' : '0.25';
        });
      }
      $('[data-peak]').textContent = Number.isFinite(windowPeak) ? `Peak ${Math.round(Math.min(0, windowPeak)) || 0} dBFS${Date.now() - clipAt < 3000 ? ' · CLIP' : ''}` : 'Peak —';
      $('[data-peak]').style.color = Date.now() - clipAt < 3000 ? 'var(--color-rec)' : '';
      windowPeak = -Infinity;
    }, 250);

    // Saved-state line, refreshed every second.
    setInterval(() => {
      if (!writer) return;
      const ago = Math.round((Date.now() - writer.meta.updatedAt) / 1000);
      $('[data-saved]').textContent = writer.meta.segments ? `${ago} s ago` : 'first save at 5 s';
      $('[data-save]').textContent = 'Local · saving every 5 s';
      $('[data-save-dot]').style.background = 'var(--color-ok)';
    }, 1000);

    let manualTimer: number | undefined;
    const startVoice = () => {
      // Manual speed (Studio → Scrolling): advance at a steady pace instead of listening.
      if (prompterSettings.mode === 'manual') {
        const text = `Manual · ${prompterSettings.wpm} wpm`;
        $('[data-voice]').textContent = text;
        $('[data-c-voice]').textContent = `${text} · P pauses`;
        manualTimer = window.setInterval(() => {
          if (writer && !paused && word < words.length - 1) setWord(word + 1);
        }, 60000 / prompterSettings.wpm);
        return;
      }
      if (!voiceFollowSupported()) {
        $('[data-voice]').textContent = 'Needs Chrome';
        $('[data-c-voice]').textContent = 'Voice follow needs Chrome';
        return;
      }
      voice = new VoiceFollow(words);
      voice.setWord(word);
      voice.addEventListener('word', (e) => {
        // Talk during a pause isn't part of the script.
        if (!paused) setWord((e as CustomEvent<number>).detail);
      });
      voice.addEventListener('lost', () => session.send({ type: 'follow', state: 'lost' }));
      voice.addEventListener('found', () => session.send({ type: 'follow', state: 'read' }));
      const voiceState = (text: string, color: string) => {
        $('[data-voice]').textContent = text;
        $('[data-voice-dot]').style.background = color;
        $('[data-c-voice]').textContent = text === 'Listening' ? 'Voice follow listening' : text;
        $('[data-c-voice-dot]').style.background = color;
      };
      voice.addEventListener('status', (e) => {
        const on = (e as CustomEvent<string>).detail === 'listening';
        voiceState(on ? 'Listening' : 'Off', on ? 'var(--color-ok)' : 'var(--color-faint)');
      });
      voice.addEventListener('error', (e) => voiceState(voiceErrorText((e as CustomEvent<string>).detail), 'var(--color-warn)'));
      voice.addEventListener('heard', (e) => ($('[data-heard]').textContent = `Heard: “${(e as CustomEvent<string>).detail.split(/\s+/).slice(-12).join(' ')}”`));
      voice.addEventListener('lost', () => ($('[data-c-voice]').textContent = 'Off script · keep reading or click a line'));
      voice.addEventListener('found', () => ($('[data-c-voice]').textContent = 'Voice follow listening'));
      voice.start();
    };

    // Extra mics (same-room sessions) and every speaker's writer, besides the main ones.
    const extraCaptures: MicCapture[] = [];
    const trackWriters: TakeWriter[] = [];

    async function start() {
      toggle.disabled = true;
      sessionToggle.disabled = true;
      const multi = continuous() && !solo;
      // Which mic each locally recorded speaker uses; a mic shared by two speakers records once.
      const deviceOf = (k: string) => (inputs[k] === 'default' ? settings.deviceId : inputs[k]);
      const localSpeakers = multi ? trackSpeakers.filter((k) => inputs[k] !== 'remote' && inputs[k] !== 'off') : [host];
      if (!localSpeakers.length) {
        toggle.disabled = sessionToggle.disabled = false;
        $('[data-session-hint]').textContent = 'Pick a mic on this computer for at least one speaker.';
        return;
      }
      const firstDevice = deviceOf(localSpeakers[0]);
      try {
        await capture.open({ deviceId: firstDevice, sampleRate: hz(settings.rate) });
      } catch (err) {
        sessionToggle.disabled = false;
        toggle.disabled = false;
        $('[data-hint]').textContent =
          (err as Error).name === 'NotAllowedError'
            ? 'Podstudio needs microphone access. Allow it in the address bar, then try again.'
            : `Couldn’t open the microphone: ${(err as Error).message}`;
        return;
      }
      $('[data-device]').textContent = `${capture.label || computer} · studio`;
      const isSession = continuous();
      // Tracks in one session share the same marker list and line log.
      const shared = isSession ? { markers: [] as SessionMarker[], lineLog: [{ t: 0, line: currentLine }], group: `${episodeId}-g${Date.now().toString(36)}` } : {};
      const byDevice = new Map<string, { cap: MicCapture; speaker: string }>([[firstDevice, { cap: capture, speaker: localSpeakers[0] }]]);
      for (const k of localSpeakers.slice(1)) {
        const dev = deviceOf(k);
        const status = rowFor.get(k)?.querySelector<HTMLElement>('[data-status]');
        if (byDevice.has(dev)) {
          if (status) status.textContent = `Same mic as ${speakerName(byDevice.get(dev)!.speaker)}`;
          continue;
        }
        const cap = new MicCapture();
        try {
          await cap.open({ deviceId: dev, sampleRate: hz(settings.rate) });
        } catch {
          if (status) status.textContent = 'Mic unavailable';
          continue;
        }
        extraCaptures.push(cap);
        byDevice.set(dev, { cap, speaker: k });
      }
      for (const { cap, speaker } of byDevice.values()) {
        const w = await TakeWriter.start({
          episodeId,
          kind: isSession ? 'session' : punchIn ? 'punch-in' : 'full',
          ...shared,
          startLine: fromLine,
          startText: lines[fromLine].text,
          speaker,
          device: cap.label || computer,
          sampleRate: cap.sampleRate,
          bitDepth: settings.depth,
        });
        trackWriters.push(w);
        cap.addEventListener('chunk', (e) => w.push((e as CustomEvent<Float32Array>).detail));
        cap.addEventListener('level', (e) => rowPeaks.set(speaker, Math.max(rowPeaks.get(speaker) ?? -Infinity, (e as CustomEvent<{ peak: number }>).detail.peak)));
        const status = rowFor.get(speaker)?.querySelector<HTMLElement>('[data-status]');
        if (status) status.textContent = `● ${cap.label || 'This computer'}`;
      }
      writer = trackWriters[0];
      // Start every track together so they line up.
      for (const { cap } of byDevice.values()) cap.record();
      for (const [k, row] of rowFor) {
        row.querySelector<HTMLElement>('[data-input]')!.hidden = true;
        const status = row.querySelector<HTMLElement>('[data-status]')!;
        status.hidden = false;
        if (inputs[k] === 'remote') status.textContent = 'Remote · needs the server';
        else if (inputs[k] === 'off') status.textContent = 'Not recorded';
      }
      startedAt = Date.now();
      session.send(recMsg());
      session.send({ type: 'word', index: word, device: device() });
      startVoice();

      const tick = () => {
        const s = Math.floor((Date.now() - startedAt) / 1000);
        setRecIndicator(true, `REC ${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`);
      };
      tick();
      clock = window.setInterval(tick, 1000);
      $('[data-toggle-label]').textContent = 'Stop take';
      $('[data-toggle-icon]').classList.replace('rounded-full', 'rounded-[2px]');
      $('[data-hint]').textContent = 'Audio is saved to this browser every 5 seconds as you record.';
      toggle.disabled = false;
      sessionToggle.dataset.running = '';
      $('[data-session-icon]').hidden = true;
      $('[data-session-label]').textContent = 'Stop session';
      sessionToggle.disabled = false;
      radios.forEach((r) => (r.disabled = true));
      retakeBtn.disabled = pauseBtn.disabled = !isSession;
    }

    // Continuous mode controls (8a).
    const retakeBtn = $<HTMLButtonElement>('[data-retake]');
    const pauseBtn = $<HTMLButtonElement>('[data-pause]');
    retakeBtn.disabled = pauseBtn.disabled = true;
    const toneSwitch = $<HTMLInputElement>('[data-retake-tone]');
    toneSwitch.checked = settings.retakeTone;
    toneSwitch.addEventListener('change', () => saveSettings('recording', { retakeTone: toneSwitch.checked }));

    // A short beep for the reader; it is not written into the recording.
    const beep = () => {
      const ctx = capture.ctx;
      if (!toneSwitch.checked || !ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.frequency.value = 1000;
      gain.gain.setValueAtTime(0.0001, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.2, ctx.currentTime + 0.01);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.2);
      osc.connect(gain).connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.22);
    };

    function retake() {
      if (!writer || !continuous()) return;
      const t = writer.seconds;
      const n = (attempts.get(currentLine)?.n ?? 1) + 1;
      attempts.set(currentLine, { n, at: t });
      writer.meta.markers!.push({ t, kind: 'retake', line: currentLine, attempt: n });
      writer.meta.lineLog!.push({ t, line: currentLine });
      beep();
      setWord(starts[currentLine]);
      renderSession();
    }

    function togglePause(broadcast = true) {
      if (!writer || !continuous()) return;
      const t = writer.seconds;
      if (paused) {
        paused.end = t;
        paused = null;
        if (broadcast) session.send({ type: 'control', action: 'resume' });
      } else {
        paused = { t, kind: 'pause', line: currentLine };
        writer.meta.markers!.push(paused);
        if (broadcast) session.send({ type: 'control', action: 'pause' });
      }
      pauseBtn.setAttribute('aria-pressed', String(!!paused));
      $('[data-pause-label]').textContent = paused ? 'Resume' : 'Pause';
      renderSession();
    }

    retakeBtn.addEventListener('click', retake);
    pauseBtn.addEventListener('click', () => togglePause());

    // Timeline and marker list, newest marker first.
    const markerTpl = document.createElement('div');
    markerTpl.className = 'grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]';
    function renderSession() {
      if (!writer?.meta.markers) return;
      const now = writer.seconds;
      const markers = writer.meta.markers;
      $('[data-c-length]').textContent = fmt(now);
      const timeline = $('[data-timeline-live]');
      timeline.replaceChildren(
        ...markers.map((m) => {
          const el = document.createElement('div');
          const left = (m.t / Math.max(now, 1)) * 100;
          if (m.kind === 'pause') {
            const width = (((m.end ?? now) - m.t) / Math.max(now, 1)) * 100;
            el.className = 'absolute inset-y-0 border-x border-dashed border-edge-strong bg-ink';
            el.style.cssText = `left:${left}%;width:${Math.max(width, 0.4)}%`;
          } else {
            el.className = 'absolute inset-y-0 w-0.5 bg-warn';
            el.style.left = `${Math.min(left, 99.6)}%`;
          }
          return el;
        }),
      );
      const list = $('[data-marker-list]');
      $('[data-marker-empty]').hidden = markers.length > 0;
      list.querySelectorAll('[data-marker]').forEach((el) => el.remove());
      for (const m of [...markers].reverse()) {
        const row = markerTpl.cloneNode() as HTMLElement;
        row.dataset.marker = '';
        const time = document.createElement('span');
        time.className = 'font-mono text-muted';
        time.textContent = fmt(m.t);
        const text = document.createElement('span');
        const kind = document.createElement('span');
        kind.className = m.kind === 'retake' ? 'text-warn' : 'text-fg-soft';
        kind.textContent = m.kind === 'retake' ? 'Retake' : 'Pause';
        const words = lines[m.line].text.split(/\s+/).slice(0, 3).join(' ');
        const detail =
          m.kind === 'retake'
            ? m.attempt === 2 ? `Line ${m.line + 1} · “${words}”` : `Line ${m.line + 1} · attempt ${m.attempt}`
            : m.end == null
              ? `running · Line ${m.line + 1}`
              : `${fmt(m.end - m.t).replace(/^0/, '')} · before Line ${(writer.meta.lineLog?.find((l) => l.t >= m.end!)?.line ?? currentLine) + 1}`;
        text.append(kind, ` · ${detail}`);
        row.append(time, text);
        list.append(row);
      }
    }
    setInterval(() => writer && continuous() && renderSession(), 1000);

    addEventListener('keydown', (e) => {
      if (!writer || e.metaKey || e.ctrlKey || e.altKey || (e.target as HTMLElement).matches('input, textarea, select, [contenteditable]')) return;
      const key = e.key.toLowerCase();
      if (key === 'r' && continuous()) retake();
      else if (key === 'p' && continuous()) togglePause();
      else if (e.key === 'ArrowRight') setWord(starts[Math.min(currentLine + 1, starts.length - 1)]);
      else if (e.key === 'ArrowLeft') setWord(starts[Math.max(currentLine - 1, 0)]);
    });

    async function stop() {
      if (!writer) return;
      toggle.disabled = sessionToggle.disabled = true;
      $('[data-toggle-label]').textContent = 'Saving…';
      $('[data-session-label]').textContent = 'Saving…';
      if (paused) paused.end = writer.seconds;
      clearInterval(clock);
      clearInterval(manualTimer);
      voice?.stop();
      await Promise.all([capture, ...extraCaptures].map((c) => c.stop()));
      const metas = await Promise.all(trackWriters.map((w) => w.finish()));
      const meta = metas[0];
      writer = null;
      await Promise.all([capture, ...extraCaptures].map((c) => c.close()));
      session.send({ type: 'rec', recording: false, startedAt, device: device(), take: meta.id });
      location.href =
        meta.kind === 'session'
          ? `/episodes/${episodeId}/session?take=${encodeURIComponent(meta.id)}`
          : `/episodes/${episodeId}/takes?take=${encodeURIComponent(meta.id)}`;
    }

    toggle.addEventListener('click', () => (writer ? stop() : start()));
    sessionToggle.addEventListener('click', () => (writer ? stop() : start()));
    addEventListener('beforeunload', (e) => {
      if (writer) e.preventDefault();
    });
  }
</script>
