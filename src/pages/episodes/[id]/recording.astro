---
/*
 * 1a–1g, 2a–2b · Recording: one person, one track, on a laptop or a phone.
 * The script gets the whole width. The control bar is the same everywhere: a
 * level meter that's always on, then Cough (hold), Retake, Ad-lib and More.
 * Pause, text size, sections, mic and End session live under More.
 *
 * ?demo&state=ready|rec|cough|retake|adlib|more|paused|mic shows the design's
 * example states without a mic.
 */
import Base from '@/layouts/Base.astro';
import Logo from '@/components/ui/Logo.astro';
import { episode, episodePaths, user } from '@/data/mock';

export const getStaticPaths = episodePaths;

// Phone: a 4-column grid of 52 px buttons with a mono sub-label. Laptop: pills with a key badge.
const btn =
  'flex h-[52px] min-w-0 flex-col items-center justify-center gap-0.5 rounded-[14px] text-[15px] font-medium transition-[opacity,background-color] select-none disabled:opacity-35 lg:h-12 lg:flex-row lg:gap-2.5 lg:rounded-xl lg:px-5';
const sub = 'font-mono text-[10px] font-medium tracking-[0.06em] opacity-75 lg:hidden';
const kbd = 'hidden rounded-[4px] border border-current/35 px-1.5 py-[3px] font-mono text-[10px] leading-none font-medium opacity-80 lg:inline';
const dim = 'group-data-[coughing]/r:opacity-35 group-data-[coughing]/r:pointer-events-none';
const zones = [
  ['0', '37.5%', 'var(--color-ok)'],
  ['37.5%', '37.5%', 'var(--color-warn)'],
  ['75%', '25%', 'var(--color-rec)'],
];
---

<Base title="Recording" bodyClass="bg-void!">
  <div
    id="recording"
    class="group/r relative flex h-dvh flex-col overflow-hidden bg-void text-fg"
    style="--p-device:1;--rule:var(--color-edge-strong)"
    data-episode={episode.id}
    data-label={episode.label}
    data-host={user.name}
    data-state="ready"
  >
    <!-- Red edge while recording, grey while paused -->
    <div class="absolute inset-x-0 top-0 z-20 h-[3px] bg-rec group-data-[state=paused]/r:bg-edge-strong group-data-[state=ready]/r:hidden" aria-hidden="true"></div>

    <header class="relative flex h-12 flex-none items-center justify-between gap-4 px-5 lg:h-14 lg:border-b lg:border-line">
      <div class="flex min-w-0 items-center gap-5 max-lg:hidden">
        <Logo />
        <nav aria-label="Breadcrumb" class="truncate text-[14px] whitespace-nowrap text-muted">
          <a href={`/episodes/${episode.id}/studio`} class="hover:text-fg">{episode.label}</a>
          <span class="mx-1.5 text-edge-strong">/</span>
          <span class="text-fg" aria-current="page">Recording</span>
        </nav>
      </div>
      <div
        class="flex flex-none items-center gap-2 font-mono text-[13px] font-medium tracking-[0.04em] text-muted group-data-[state=rec]/r:text-fg lg:absolute lg:left-1/2 lg:-translate-x-1/2 lg:rounded-full lg:px-4 lg:py-1.5 lg:group-data-[state=rec]/r:bg-rec/15 lg:group-data-[state=rec]/r:text-rec"
        role="status"
      >
        <span class="size-2 rounded-full bg-faint group-data-[state=rec]/r:bg-rec"></span>
        <span data-rec-label>READY</span>
        <!-- Voice follow: a ring, so it doesn't read as the REC light -->
        <span class="ml-1 size-2 rounded-full border-[1.5px] border-faint" role="img" aria-label="Voice follow off" title="Voice follow off" data-voice-dot></span>
      </div>
      <div class="flex min-w-0 items-center justify-end">
        <span class="flex min-w-0 items-center gap-1.5 truncate text-[13px] text-muted" data-saved-wrap>
          <span class="size-1.5 flex-none rounded-full bg-ok group-data-[state=ready]/r:hidden" data-saved-dot></span>
          <span class="truncate" data-saved></span>
        </span>
        <span class="flex-none rounded-full px-3 py-1 font-mono text-[12px] font-medium tracking-[0.06em] text-ink" data-pill hidden></span>
      </div>
    </header>

    <!-- Notices above the script: paused, and the warnings (one at a time) -->
    <div class="flex-none px-4 empty:hidden lg:mx-auto lg:w-full lg:max-w-[820px] lg:px-6" data-notices>
      <div class="mt-2 rounded-2xl bg-raised px-4 py-3.5" data-paused-card hidden>
        <div class="text-[15px]">Paused · still recording</div>
        <p class="mt-1 text-[13px] leading-normal text-muted">This stretch is marked as a pause and left out of the edit. Have a drink.</p>
      </div>
      <div class="mt-2 rounded-2xl bg-raised px-4 py-3.5 data-[strong]:shadow-[inset_0_0_0_1px_var(--color-warn)]" role="alert" data-warning hidden>
        <div class="flex items-start gap-3">
          <span class="mt-[7px] size-2 flex-none rounded-full" data-warning-dot></span>
          <div class="min-w-0 flex-1">
            <div class="text-[15px]" data-warning-title></div>
            <p class="mt-0.5 text-[13px] leading-normal text-muted" data-warning-body></p>
          </div>
        </div>
        <button type="button" class="mt-3 flex h-12 w-full items-center justify-center rounded-xl bg-rec text-[15px] font-medium text-white lg:h-10 lg:text-[14px]" data-warning-action hidden></button>
      </div>
    </div>

    <!-- The script, scrolling with the reader. Tap a line to jump; double-tap to retake. -->
    <main class="relative min-h-0 flex-1 overflow-hidden" style={`font-family:var(--p-font, var(--font-sans))`} data-viewport>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-16 bg-linear-to-t from-void to-transparent" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 z-[1] h-10 bg-linear-to-b from-void to-transparent" aria-hidden="true"></div>
      <div class="mx-auto flex max-w-[820px] flex-col px-6 transition-transform duration-500 ease-in-out lg:px-10" data-track></div>
    </main>

    <!-- Laptop: markers on a thin timeline (amber retakes, grey cuts, blue ad-libs, red gaps) -->
    <div
      class="relative mx-8 mb-3 hidden h-[18px] flex-none overflow-hidden rounded-[4px] bg-[repeating-linear-gradient(90deg,var(--color-edge)_0_2px,transparent_2px_5px)] group-data-[state=ready]/r:invisible lg:block"
      data-timeline
      aria-hidden="true"
    >
      <div data-timeline-marks></div>
      <div class="absolute inset-y-0 right-0 w-0.5 bg-rec"></div>
    </div>

    <footer class="relative z-10 flex-none border-t border-line bg-void px-4 pt-3 pb-[max(12px,env(safe-area-inset-bottom))] lg:flex lg:items-center lg:gap-8 lg:px-8 lg:py-4">
      <!-- Undo, for 4 s after a retake, cough or ad-lib -->
      <div
        class="absolute inset-x-4 bottom-full mb-2 flex items-center justify-between gap-4 rounded-xl bg-raised px-4 py-3 text-[14px] shadow-[0_0_0_1px_var(--color-edge)] lg:inset-x-auto lg:left-1/2 lg:w-[440px] lg:-translate-x-1/2"
        role="status"
        data-toast
        hidden
      >
        <span class="min-w-0 truncate" data-toast-text></span>
        <button type="button" class="flex flex-none items-center gap-2 text-muted hover:text-fg" data-undo>
          Undo <span class={kbd}>U</span>
        </button>
      </div>

      <!-- Level details (click the meter): the mic check's numbers -->
      <div
        class="absolute bottom-full left-4 mb-2 w-[min(320px,calc(100vw-32px))] rounded-2xl border border-edge bg-panel p-4 text-[13px] lg:left-8"
        data-level-details
        hidden
      >
        <h2 class="eyebrow text-muted!">Level</h2>
        <dl class="mt-2 flex flex-col font-mono text-[12px]" data-level-rows></dl>
      </div>

      <button type="button" class="flex w-full items-center gap-3 text-left lg:max-w-[640px] lg:min-w-0 lg:flex-1" aria-label="Level details" aria-expanded="false" data-level>
        <span class="relative h-1.5 min-w-0 flex-1 overflow-hidden rounded-full bg-line" data-level-track>
          {zones.map(([left, width, color]) => (
            <span class="absolute inset-y-0" style={{ left, width, background: `color-mix(in oklab, ${color} 18%, transparent)` }} />
          ))}
          <span class="absolute inset-y-0 left-0 w-0 rounded-full" data-level-fill></span>
        </span>
        <span class="max-w-[55%] flex-none truncate font-mono text-[11px] text-muted lg:text-[12px]" data-level-text>— dB</span>
      </button>

      <div class="mt-3 grid grid-cols-4 gap-2 lg:mt-0 lg:flex lg:flex-none lg:gap-2.5">
        <button type="button" class:list={[btn, 'col-span-3 hidden flex-row! gap-2.5! bg-rec text-[16px] text-white group-data-[state=ready]/r:flex lg:px-8']} data-start disabled>
          <span class="size-2 rounded-full bg-white"></span>Start recording
        </button>
        <button type="button" class:list={[btn, 'col-span-3 hidden flex-row! gap-3! bg-fg text-[16px] text-ink group-data-[state=paused]/r:flex lg:px-8']} data-resume>
          <svg viewBox="0 0 12 14" class="size-3.5 fill-current" aria-hidden="true"><path d="M0 0l12 7-12 7z" /></svg>Resume · 3-2-1
          <span class={kbd}>P</span>
        </button>
        <button
          type="button"
          class:list={[btn, 'hidden bg-raised group-data-[state=rec]/r:flex data-[holding]:bg-fg data-[holding]:text-ink']}
          style="touch-action:none;-webkit-touch-callout:none"
          data-cough
        >
          Cough <span class={sub} data-cough-sub>HOLD</span><span class={kbd}>HOLD C</span>
        </button>
        <button type="button" class:list={[btn, dim, 'hidden bg-warn font-semibold text-ink group-data-[state=rec]/r:flex']} data-retake>
          Retake <span class={sub}>DOUBLE-TAP</span><span class={kbd}>R</span>
        </button>
        <button
          type="button"
          class:list={[btn, dim, 'hidden bg-raised group-data-[state=rec]/r:flex aria-pressed:bg-adlib aria-pressed:font-semibold aria-pressed:text-ink']}
          aria-pressed="false"
          data-adlib-btn
        >
          <span data-adlib-label>Ad-lib</span><span class={sub} data-adlib-sub>AUTO</span><span class={kbd}>A</span>
        </button>
        <button
          type="button"
          class:list={[btn, dim, 'bg-raised text-[20px] tracking-[0.1em] aria-expanded:bg-fg aria-expanded:text-ink']}
          aria-expanded="false"
          aria-label="More"
          data-more-btn
        >
          ··· <span class={kbd}>M</span>
        </button>
      </div>
      <p class="mt-2.5 hidden text-center font-mono text-[11px] leading-normal text-subtle group-data-[state=ready]/r:block lg:hidden!" data-format-line></p>
    </footer>

    <!-- More: a bottom sheet on a phone (1f), a popover above the bar on a laptop (2b) -->
    <div class="fixed inset-0 z-30 bg-black/55 lg:hidden" data-more-scrim hidden></div>
    <div
      class="fixed inset-x-0 bottom-0 z-40 max-h-[88dvh] overflow-auto overscroll-contain rounded-t-[22px] bg-panel px-4 pt-2.5 pb-[max(16px,env(safe-area-inset-bottom))] lg:absolute lg:inset-x-auto lg:right-8 lg:bottom-[84px] lg:max-h-[calc(100dvh-150px)] lg:w-[372px] lg:rounded-2xl lg:border lg:border-edge lg:p-3"
      role="dialog"
      aria-label="More"
      data-more
      hidden
    >
      <div class="mx-auto mb-3 h-1 w-9 cursor-grab rounded-full bg-edge-strong lg:hidden" data-more-handle></div>
      <div class="mb-3 flex items-center gap-3 lg:hidden">
        <span class="relative h-1.5 min-w-0 flex-1 overflow-hidden rounded-full bg-line">
          <span class="absolute inset-y-0 left-0 w-0 rounded-full" data-level-fill></span>
        </span>
        <span class="flex-none font-mono text-[11px] text-muted" data-level-db>—</span>
      </div>
      <div class="flex flex-col gap-2.5 lg:gap-2">
        <button
          type="button"
          class="flex h-14 w-full items-center justify-center gap-3 rounded-2xl bg-fg text-[17px] text-ink group-data-[state=ready]/r:hidden lg:h-11 lg:justify-between lg:rounded-xl lg:px-3.5 lg:text-[14px]"
          data-more-pause
        >
          <span class="flex items-center gap-3"><span class="font-semibold tracking-[-0.1em]" aria-hidden="true" data-pause-icon>❚❚</span><span data-pause-text>Pause</span></span>
          <span class={kbd}>P</span>
        </button>

        <div class="rounded-xl bg-raised px-3.5 py-3 lg:py-2.5">
          <div class="flex items-center justify-between text-[15px] lg:text-[13px]">
            <label for="text-size">Text size</label>
            <span class="font-mono text-[13px] text-muted lg:text-[12px]"><span data-size-value>100%</span><span class="max-lg:hidden"> · ⌘+ ⌘−</span></span>
          </div>
          <input id="text-size" type="range" min="80" max="160" step="10" value="100" class="mt-3 w-full accent-fg lg:mt-2" data-size />
        </div>

        <div class="rounded-xl bg-raised py-1.5" data-sections-wrap>
          <h2 class="px-3.5 pt-1.5 pb-1 font-mono text-[11px] font-medium tracking-[0.08em] text-subtle">JUMP TO SECTION</h2>
          <div class="flex flex-col" data-sections></div>
        </div>

        <dl class="flex flex-col text-[14px] lg:text-[13px]">
          <div class="flex items-center justify-between gap-4 border-b border-line py-3 lg:py-2">
            <dt class="flex-none text-muted">Mic</dt>
            <dd class="min-w-0 text-right">
              <select
                class="max-w-full truncate rounded-md border border-edge bg-surface px-2 py-1 text-[13px] focus:border-fg focus:outline-none disabled:border-transparent disabled:bg-transparent disabled:px-0 disabled:text-fg disabled:opacity-100 disabled:appearance-none"
                aria-label="Microphone"
                data-mic
              ></select>
              <span class="block text-[12px] text-subtle" data-mic-note hidden>Can’t change while recording</span>
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-line py-3 lg:py-2">
            <dt class="flex-none text-muted">Saved</dt>
            <dd class="flex min-w-0 items-center gap-2 truncate"><span class="size-2 flex-none rounded-full bg-ok" data-store-dot></span><span data-store>In this browser</span></dd>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-line py-3 lg:py-2">
            <dt class="flex-none text-muted">Markers</dt>
            <dd class="min-w-0 truncate" data-counts>None yet</dd>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-line py-3 lg:py-2">
            <dt class="flex-none text-muted">Voice follow</dt>
            <dd class="flex min-w-0 items-center gap-3">
              <span class="truncate" data-voice-state>Off</span>
              <button type="button" class="flex-none text-[12px] text-muted underline-offset-2 hover:text-fg hover:underline" data-copy-diag>Copy diagnostics</button>
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-line py-3 lg:py-2">
            <dt class="text-muted" id="retake-tone-label">Retake tone</dt>
            <dd>
              <label class="relative inline-flex h-6 w-10 flex-none items-center rounded-full bg-edge has-checked:bg-ok has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-fg">
                <input type="checkbox" role="switch" class="peer sr-only" aria-labelledby="retake-tone-label" data-retake-tone />
                <span class="absolute top-0.5 left-0.5 size-5 rounded-full bg-subtle transition-all peer-checked:left-[18px] peer-checked:bg-white"></span>
              </label>
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-line py-3 lg:py-2" data-ios-voice-row hidden>
            <dt class="min-w-0">
              <span id="ios-voice-label">Voice follow (experimental)</span>
              <span class="block text-[12px] text-subtle" data-ios-voice-note>Needs Siri turned on in iOS Settings</span>
            </dt>
            <dd>
              <label class="relative inline-flex h-6 w-10 flex-none items-center rounded-full bg-edge has-checked:bg-ok has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-fg">
                <input type="checkbox" role="switch" class="peer sr-only" aria-labelledby="ios-voice-label" data-ios-voice />
                <span class="absolute top-0.5 left-0.5 size-5 rounded-full bg-subtle transition-all peer-checked:left-[18px] peer-checked:bg-white"></span>
              </label>
            </dd>
          </div>
        </dl>

        <button
          type="button"
          class="mt-1 flex h-13 w-full items-center justify-center rounded-2xl border border-rec text-[15px] text-rec hover:bg-rec/10 group-data-[state=ready]/r:hidden lg:h-11 lg:rounded-xl lg:text-[14px]"
          data-end
        >
          End session
        </button>
      </div>
    </div>

    <!-- Resume counts down so you're ready when the pause ends -->
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/70" data-countdown hidden>
      <span class="font-mono text-[120px] leading-none font-medium" data-countdown-n>3</span>
    </div>

    <dialog
      class="m-auto w-[min(360px,calc(100vw-32px))] rounded-2xl border border-edge bg-panel p-5 text-fg backdrop:bg-black/60"
      aria-labelledby="end-title"
      data-end-dialog
    >
      <h2 id="end-title" class="text-[18px]">End the session?</h2>
      <p class="mt-2 text-[14px] leading-normal text-muted">Recording stops and the session is saved. You can export it next.</p>
      <form method="dialog" class="mt-5 flex justify-end gap-2.5">
        <button value="cancel" class="h-10 rounded-[10px] border border-edge px-4 text-[14px] hover:bg-raised">Keep recording</button>
        <button value="end" class="h-10 rounded-[10px] bg-rec px-4 text-[14px] font-medium text-white">End session</button>
      </form>
    </dialog>
  </div>
</Base>

<script>
  import { CUT_PADDING, type SessionMarker } from '@/lib/audio/assemble';
  import { MicCapture, type Level } from '@/lib/audio/capture';
  import { availableInput, describeInput, inputChoices, inputFor } from '@/lib/audio/devices';
  import { toFraction, zone } from '@/lib/audio/meter';
  import { TakeWriter, formatBytes, storageLeft, takeBytes } from '@/lib/audio/takes';
  import { markerCounts, markerName } from '@/lib/markers';
  import { isIOS } from '@/lib/platform';
  import { Prompter, enableHandScroll } from '@/lib/prompter';
  import { offerRecovery } from '@/lib/recovery';
  import { loadScript } from '@/lib/script-store';
  import { hz, loadSettings, saveSettings } from '@/lib/settings';
  import { VoiceFollow, voiceErrorText, voiceFollowSupported } from '@/lib/voice/follow';

  type State = 'ready' | 'rec' | 'paused';

  const root = document.getElementById('recording')!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const $$ = <T extends HTMLElement = HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];
  const params = new URL(location.href).searchParams;
  const demo = params.has('demo');
  const episodeId = root.dataset.episode!;
  const script = loadScript(episodeId);
  const { words, lines, lineStarts: starts, sections } = script;
  const settings = loadSettings().recording;
  const prompterSettings = loadSettings().prompter;
  root.style.setProperty('--p-font', prompterSettings.font);
  const fromLine = Math.max(0, Math.min(lines.length - 1, Number(params.get('from') ?? 0) || 0));
  const lineOf = (i: number) => starts.reduce((line, s, n) => (i >= s ? n : line), 0);
  /** 4:31, or 1:04:31 past an hour */
  const clock = (sec: number) => {
    const t = Math.max(0, Math.floor(sec));
    const h = Math.floor(t / 3600);
    const m = Math.floor((t % 3600) / 60);
    const s = String(t % 60).padStart(2, '0');
    return h ? `${h}:${String(m).padStart(2, '0')}:${s}` : `${m}:${s}`;
  };
  const recClock = (sec: number) => clock(sec).padStart(5, '0');

  // ── The script ─────────────────────────────────────────────────────────────
  const viewport = $('[data-viewport]');
  const track = $('[data-track]');
  track.replaceChildren(
    ...lines.map((l, n) => {
      const row = document.createElement('div');
      row.dataset.line = String(n);
      row.className =
        'group/l cursor-pointer py-[0.42em] text-[length:calc(26px*var(--p-device))] lg:text-[length:calc(34px*var(--p-device))]';
      const body = document.createElement('div');
      body.className =
        '-ml-4 border-l-2 border-transparent pl-3.5 text-[0.74em] leading-[1.32] text-subtle transition-[font-size,color] group-data-[l=now]/l:border-(--rule) group-data-[l=now]/l:text-[1em] group-data-[l=now]/l:text-fg group-data-[l=past]/l:text-ghost';
      const text = document.createElement('div');
      for (const w of l.text.split(/\s+/).filter(Boolean)) {
        const span = document.createElement('span');
        span.dataset.word = '';
        span.className =
          'decoration-rec decoration-2 underline-offset-[0.2em] group-data-[l=now]/l:data-[w=past]:text-muted group-data-[l=now]/l:data-[w=now]:underline group-data-[adlib]/r:decoration-adlib group-data-[state=ready]/r:no-underline!';
        span.textContent = w;
        text.append(span, ' ');
      }
      body.append(text);
      row.append(body);
      return row;
    }),
  );
  // One label under the current line: the retake attempt, or "holding your place" during an ad-lib.
  const tag = document.createElement('div');
  tag.className = 'mt-2 font-mono text-[11px] font-medium tracking-[0.08em] text-(--rule) uppercase';
  tag.hidden = true;
  const prompter = new Prompter(viewport, track, { line: 0.3 });
  enableHandScroll(prompter, viewport);

  // ── Text size, on this device only (80–160 %) ──────────────────────────────
  const SIZE_KEY = 'podstudio:text-size';
  const sizeInput = $<HTMLInputElement>('[data-size]');
  let textSize = 100;
  try {
    textSize = Number(localStorage.getItem(SIZE_KEY)) || 100;
  } catch {}
  const setSize = (pct: number) => {
    textSize = Math.max(80, Math.min(160, Math.round(pct / 10) * 10));
    root.style.setProperty('--p-device', String(textSize / 100));
    sizeInput.value = String(textSize);
    $('[data-size-value]').textContent = `${textSize}%`;
    try {
      localStorage.setItem(SIZE_KEY, String(textSize));
    } catch {}
    // Line heights changed: keep the current word on the reading line.
    requestAnimationFrame(() => prompter.setWord(prompter.index));
  };
  setSize(textSize);
  sizeInput.addEventListener('input', () => setSize(Number(sizeInput.value)));

  // ── State ──────────────────────────────────────────────────────────────────
  let state: State = 'ready';
  let word = starts[fromLine];
  let currentLine = lineOf(word);
  const capture = new MicCapture();
  let writer: TakeWriter | null = null;
  let voice: VoiceFollow | null = null;
  const markers = (): SessionMarker[] => writer?.meta.markers ?? demoMarkers;
  let demoMarkers: SessionMarker[] = [];
  // The session's wall clock: markers and line starts use it. If the mic stops, the audio
  // falls behind it, and a gap marker says by how much (see onAudio() in assemble.ts).
  let sessionStart = 0;
  const now = () => (demo ? demoNow : sessionStart ? (performance.now() - sessionStart) / 1000 : 0);
  let demoNow = 0;
  let paused: SessionMarker | null = null;
  let adlib: SessionMarker | null = null;
  let cough: { t: number } | null = null;
  /** Retake attempt shown on the current line, until the reader moves on */
  let attemptShown: { line: number; n: number } | null = null;
  const attempts = new Map<number, number>();

  const setRule = () => {
    const rule = adlib
      ? 'var(--color-adlib)'
      : attemptShown?.line === currentLine
        ? 'var(--color-warn)'
        : state === 'rec'
          ? 'var(--color-rec)'
          : 'var(--color-edge-strong)';
    root.style.setProperty('--rule', rule);
    const row = track.querySelector<HTMLElement>(`[data-line="${currentLine}"] > div`);
    const text = adlib
      ? 'Holding your place · picks up when you’re back'
      : attemptShown?.line === currentLine
        ? `Attempt ${attemptShown.n} · from the top of the line`
        : '';
    tag.textContent = text;
    tag.hidden = !text;
    if (row && tag.parentElement !== row) row.append(tag);
  };

  const setState = (s: State) => {
    state = s;
    root.dataset.state = s;
    $('[data-paused-card]').hidden = s !== 'paused';
    setRule();
    tick();
    renderMore();
  };

  /** Move to a script word; while recording, log when a new line starts. */
  const setWord = (i: number) => {
    word = Math.max(0, Math.min(i, words.length - 1));
    const line = lineOf(word);
    if (line !== currentLine) {
      if (writer) writer.meta.lineLog?.push({ t: now(), line });
      if (attemptShown && attemptShown.line !== line) attemptShown = null;
    }
    currentLine = line;
    prompter.setWord(word);
    voice?.setWord(word);
    // Saved with the next segment, so a recovered session knows where it stopped.
    if (writer) writer.meta.lastLine = line;
    setRule();
    renderSections();
  };

  // ── Header: REC clock, saved, and the ad-lib / cut pill ─────────────────────
  const recLabel = $('[data-rec-label]');
  const saved = $('[data-saved]');
  const savedWrap = $('[data-saved-wrap]');
  const pill = $('[data-pill]');
  const sectionOf = (line: number) => [...sections].reverse().find((s) => s.line <= line);
  const phone = matchMedia('(max-width: 1023px)');
  function tick() {
    const t = now();
    recLabel.textContent =
      state === 'ready' ? 'READY' : state === 'paused' ? `PAUSED ${clock(t - (paused?.t ?? t))}` : `REC ${recClock(t)}`;
    if (state === 'ready') {
      saved.textContent = `${root.dataset.label}${sectionOf(currentLine) ? ` · ${sectionOf(currentLine)!.title}` : ''}`;
    } else if (writer || demo) {
      const ago = writer ? Math.round((Date.now() - writer.meta.updatedAt) / 1000) : 3;
      const first = writer && !writer.meta.segments;
      saved.textContent = first ? 'First save at 5 s' : phone.matches ? `Saved ${ago} s ago` : `Saved in this browser ${ago} s ago`;
      $('[data-saved-dot]').style.background = ago > 30 && !first ? 'var(--color-warn)' : '';
    }
    // Cough and ad-lib show a live pill in place of "Saved".
    const pillText = cough ? `CUT · ${clock(t - cough.t)}` : adlib ? `AD-LIB · ${clock(t - adlib.t)}` : '';
    pill.hidden = !pillText;
    pill.textContent = pillText;
    pill.style.background = cough ? 'var(--color-fg)' : 'var(--color-adlib)';
    savedWrap.hidden = !!pillText;
    if (writer || demo) renderTimeline();
  }
  setInterval(tick, 250);

  // ── Level meter: always on, same zones and numbers as the mic check ────────
  const fills = $$('[data-level-fill]');
  const levelText = $('[data-level-text]');
  const levelDb = $('[data-level-db]');
  let micLabel = '';
  let shown = 0;
  let windowPeak = -Infinity;
  let clipAt = 0;
  const held: number[] = [];
  let last: Level | null = null;
  const onLevel = (l: Level) => {
    last = l;
    windowPeak = Math.max(windowPeak, l.peak);
    if (l.hot > -0.5) clipAt = Date.now();
    // Fast attack, slow release, like a hardware meter.
    const target = toFraction(l.peak);
    shown = target > shown ? target : Math.max(target, shown - 0.015);
    const clipping = Date.now() - clipAt < 1500;
    for (const f of fills) {
      f.style.width = `${shown * 100}%`;
      f.style.background = cough
        ? 'repeating-linear-gradient(90deg,var(--color-subtle) 0 3px,transparent 3px 5px)'
        : clipping
          ? 'var(--color-rec)'
          : zone(l.peak);
    }
    if (detailsOpen) renderDetails();
  };
  capture.addEventListener('level', (e) => onLevel((e as CustomEvent<Level>).detail));
  // The number holds the highest peak of the last 1.5 s, so it can be read while talking.
  setInterval(() => {
    held.push(windowPeak);
    if (held.length > 6) held.shift();
    windowPeak = -Infinity;
    const hold = Math.max(...held);
    const db = Number.isFinite(hold) ? `${String(Math.round(Math.min(0, hold)) || 0).replace('-', '−')} dB` : '— dB';
    const clipping = Date.now() - clipAt < 3000;
    levelText.textContent = cough ? 'Cut · still recording' : clipping ? `Clipping · ${micLabel}` : `${db}${micLabel ? ` · ${micLabel}` : ''}`;
    levelText.style.color = clipping && !cough ? 'var(--color-rec)' : '';
    levelDb.textContent = db;
  }, 250);

  // Click the meter: peak, RMS and each input, as on the mic check.
  const details = $('[data-level-details]');
  const levelBtn = $('[data-level]');
  let detailsOpen = false;
  const dbText = (v: number) => (Number.isFinite(v) ? `${v.toFixed(1).replace('-', '−')} dBFS` : '—');
  function renderDetails() {
    const rows: [string, string][] = [
      ['Peak', last ? dbText(last.peak) : '—'],
      ['RMS', last ? dbText(last.rms) : '—'],
      ...((last?.inputs.length ?? 0) > 1 ? last!.inputs.map((v, i): [string, string] => [`Input ${i + 1}`, dbText(v)]) : []),
      ['Clipping', Date.now() - clipAt < 3000 ? 'Yes' : clipAt ? 'Earlier' : 'None'],
      ['Mic', micLabel || '—'],
      ['Format', formatText()],
    ];
    $('[data-level-rows]').replaceChildren(
      ...rows.map(([k, v]) => {
        const row = document.createElement('div');
        row.className = 'flex justify-between gap-4 border-b border-line py-1.5 last:border-0';
        const dt = Object.assign(document.createElement('dt'), { className: 'text-muted', textContent: k });
        const dd = Object.assign(document.createElement('dd'), { className: 'truncate text-right', textContent: v });
        row.append(dt, dd);
        return row;
      }),
    );
  }
  const toggleDetails = (open = !detailsOpen) => {
    detailsOpen = open;
    details.hidden = !open;
    levelBtn.setAttribute('aria-expanded', String(open));
    if (open) renderDetails();
  };
  levelBtn.addEventListener('click', () => toggleDetails());

  const formatText = () => {
    const rate = (capture.sampleRate || hz(settings.rate)) / 1000;
    return `${rate} kHz · ${settings.depth}-bit${settings.channels === 2 ? ' · stereo' : ''}`;
  };
  $('[data-format-line]').textContent = `${formatText()} · saved in this browser as you go`;

  // ── Timeline (laptop) ───────────────────────────────────────────────────────
  const marks = $('[data-timeline-marks]');
  function renderTimeline() {
    const end = Math.max(now(), 1);
    const pct = (t: number) => `${Math.min(99.6, (t / end) * 100)}%`;
    marks.replaceChildren(
      ...markers().map((m) => {
        const el = document.createElement('div');
        el.title = `${markerName[m.kind]} · ${clock(m.t)} · Line ${m.line + 1}: ${lines[m.line]?.text ?? ''}`;
        el.style.left = pct(m.t);
        if (m.kind === 'retake') el.className = 'absolute inset-y-0 w-0.5 bg-warn';
        else {
          el.className = {
            cut: 'absolute inset-y-0 bg-edge-strong',
            adlib: 'absolute inset-y-[3px] rounded-[2px] bg-adlib/70',
            pause: 'absolute inset-y-0 border-x border-dashed border-edge-strong bg-ink',
            gap: 'absolute inset-y-0 bg-[repeating-linear-gradient(135deg,var(--color-rec)_0_2px,transparent_2px_5px)]',
          }[m.kind];
          el.style.width = `max(3px, ${(((m.end ?? now()) - m.t) / end) * 100}%)`;
        }
        return el;
      }),
    );
  }

  // ── Undo toast (Retake, Cough, Ad-lib) ─────────────────────────────────────
  const toast = $('[data-toast]');
  let undoable: { marker: SessionMarker; undo: () => void } | null = null;
  let toastTimer: number | undefined;
  function offerUndo(text: string, marker: SessionMarker, undo: () => void = () => {}) {
    undoable = { marker, undo };
    $('[data-toast-text]').textContent = text;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.hidden = true;
      undoable = null;
    }, 4000);
  }
  function undo() {
    if (!undoable) return;
    const list = markers();
    const i = list.indexOf(undoable.marker);
    if (i >= 0) list.splice(i, 1);
    undoable.undo();
    undoable = null;
    toast.hidden = true;
    clearTimeout(toastTimer);
    renderMore();
    tick();
  }
  $('[data-undo]').addEventListener('click', undo);

  // ── Retake ─────────────────────────────────────────────────────────────────
  const toneSwitch = $<HTMLInputElement>('[data-retake-tone]');
  toneSwitch.checked = settings.retakeTone;
  toneSwitch.addEventListener('change', () => saveSettings('recording', { retakeTone: toneSwitch.checked }));
  // A short beep for the reader; it is not written into the recording.
  const beep = () => {
    const ctx = capture.ctx;
    if (!toneSwitch.checked || !ctx) return;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.frequency.value = 1000;
    gain.gain.setValueAtTime(0.0001, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.2, ctx.currentTime + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.2);
    osc.connect(gain).connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + 0.22);
  };

  function retake() {
    if (state !== 'rec' || cough) return;
    endAdlib();
    const t = now();
    const line = currentLine;
    const before = { word, shown: attemptShown, n: attempts.get(line) };
    const n = (attempts.get(line) ?? 1) + 1;
    attempts.set(line, n);
    const marker: SessionMarker = { t, kind: 'retake', line, attempt: n };
    const logEntry = { t, line };
    markers().push(marker);
    writer?.meta.lineLog?.push(logEntry);
    beep();
    attemptShown = { line, n };
    setWord(starts[line]);
    offerUndo(`Retake marked · Line ${line + 1}`, marker, () => {
      const log = writer?.meta.lineLog;
      if (log && log.includes(logEntry)) log.splice(log.indexOf(logEntry), 1);
      if (before.n == null) attempts.delete(line);
      else attempts.set(line, before.n);
      attemptShown = before.shown;
      setWord(before.word);
    });
    renderMore();
  }

  // ── Cough: hold to mark a cut; recording carries on ────────────────────────
  const coughBtn = $('[data-cough]');
  function coughDown() {
    if (state !== 'rec' || cough) return;
    cough = { t: now() };
    root.dataset.coughing = '';
    coughBtn.dataset.holding = '';
    $('[data-cough-sub]').textContent = 'RELEASE';
    voice?.mute(true);
    navigator.vibrate?.(15);
    tick();
  }
  function coughUp() {
    if (!cough) return;
    const end = now();
    const marker: SessionMarker = { t: Math.max(0, cough.t - CUT_PADDING), kind: 'cut', line: currentLine, end: end + CUT_PADDING };
    const held = end - cough.t;
    cough = null;
    delete root.dataset.coughing;
    delete coughBtn.dataset.holding;
    $('[data-cough-sub]').textContent = 'HOLD';
    voice?.mute(false);
    markers().push(marker);
    offerUndo(`Cough cut · ${clock(held + 2 * CUT_PADDING)}`, marker);
    tick();
    renderMore();
  }
  coughBtn.addEventListener('pointerdown', (e) => {
    coughBtn.setPointerCapture(e.pointerId);
    coughDown();
  });
  for (const ev of ['pointerup', 'pointercancel', 'lostpointercapture']) coughBtn.addEventListener(ev, coughUp);
  coughBtn.addEventListener('contextmenu', (e) => e.preventDefault());
  addEventListener('blur', coughUp);

  // ── Ad-lib: marked, not cut; the script holds your place ───────────────────
  const adlibBtn = $('[data-adlib-btn]');
  function startAdlib(since = Date.now()) {
    if (state !== 'rec' || adlib) return;
    // Backdate to the first off-script word voice follow heard.
    const t = Math.max(0, now() - (Date.now() - since) / 1000);
    adlib = { t, kind: 'adlib', line: currentLine };
    markers().push(adlib);
    root.dataset.adlib = '';
    adlibBtn.setAttribute('aria-pressed', 'true');
    $('[data-adlib-sub]').textContent = 'TAP TO END';
    $('[data-adlib-label]').textContent = phone.matches ? 'Ad-lib' : 'Ad-lib · end';
    setRule();
    tick();
  }
  /** `lead`: seconds of script already heard when voice follow noticed it resumed. */
  function endAdlib(lead = 0) {
    if (!adlib) return;
    const m = adlib;
    m.end = Math.max(m.t, now() - lead);
    adlib = null;
    delete root.dataset.adlib;
    adlibBtn.setAttribute('aria-pressed', 'false');
    $('[data-adlib-sub]').textContent = 'AUTO';
    $('[data-adlib-label]').textContent = 'Ad-lib';
    offerUndo(`Ad-lib · ${clock(m.end - m.t)}`, m);
    setRule();
    tick();
    renderMore();
  }
  function toggleAdlib() {
    if (state !== 'rec' || cough) return;
    if (adlib) {
      endAdlib();
      voice?.release();
    } else if (voice) voice.holdAdlib();
    else startAdlib();
  }

  // ── Pause and Resume (3-2-1) ───────────────────────────────────────────────
  let counting = false;
  function pause() {
    if (state !== 'rec') return;
    coughUp();
    endAdlib();
    paused = { t: now(), kind: 'pause', line: currentLine };
    markers().push(paused);
    setState('paused');
  }
  async function resume() {
    if (state !== 'paused' || counting) return;
    counting = true;
    closeMore();
    const overlay = $('[data-countdown]');
    overlay.hidden = false;
    for (const n of [3, 2, 1]) {
      $('[data-countdown-n]').textContent = String(n);
      await new Promise((r) => setTimeout(r, 1000));
    }
    overlay.hidden = true;
    counting = false;
    if (paused) paused.end = now();
    paused = null;
    setState('rec');
  }
  const togglePause = () => (state === 'rec' ? pause() : resume());

  // ── More ────────────────────────────────────────────────────────────────────
  const more = $('[data-more]');
  const moreBtn = $('[data-more-btn]');
  const scrim = $('[data-more-scrim]');
  const isMoreOpen = () => !more.hidden;
  function openMore() {
    toggleDetails(false);
    more.hidden = false;
    scrim.hidden = false;
    moreBtn.setAttribute('aria-expanded', 'true');
    renderMore();
  }
  function closeMore() {
    more.hidden = true;
    scrim.hidden = true;
    moreBtn.setAttribute('aria-expanded', 'false');
  }
  moreBtn.addEventListener('click', () => (isMoreOpen() ? closeMore() : openMore()));
  scrim.addEventListener('click', closeMore);
  // Swipe the sheet down to close it.
  {
    let startY: number | null = null;
    more.addEventListener('pointerdown', (e) => {
      if (more.scrollTop <= 0 && (e.target as HTMLElement).closest('[data-more-handle], h2') !== null) startY = e.clientY;
    });
    more.addEventListener('pointermove', (e) => {
      if (startY != null && e.clientY - startY > 60) {
        startY = null;
        closeMore();
      }
    });
    more.addEventListener('pointerup', () => (startY = null));
  }
  $('[data-more-pause]').addEventListener('click', () => {
    if (state === 'rec') closeMore();
    togglePause();
  });
  function renderMore() {
    $('[data-pause-text]').textContent = state === 'paused' ? 'Resume · 3-2-1' : 'Pause';
    $('[data-pause-icon]').textContent = state === 'paused' ? '▶' : '❚❚';
    $('[data-counts]').textContent = markerCounts(markers().filter((m) => m.kind !== 'pause')) || 'None yet';
    const recording = state !== 'ready';
    $<HTMLSelectElement>('[data-mic]').disabled = recording;
    $('[data-mic-note]').hidden = !recording;
    if (writer) {
      const behind = Math.round((Date.now() - writer.meta.updatedAt) / 1000);
      $('[data-store]').textContent = `In this browser · ${formatBytes(takeBytes(writer.meta))}${behind > 30 ? ` · ${behind} s behind` : ''}`;
      $('[data-store-dot]').style.background = behind > 30 ? 'var(--color-warn)' : '';
    }
    renderSections();
  }
  setInterval(() => isMoreOpen() && renderMore(), 1000);

  const sectionList = $('[data-sections]');
  $('[data-sections-wrap]').hidden = !sections.length;
  sectionList.replaceChildren(
    ...sections.map((s, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.section = String(i);
      b.className =
        'flex items-center justify-between gap-3 px-3.5 py-2.5 text-left text-[15px] hover:bg-surface aria-current:bg-fg aria-current:text-ink lg:py-1.5 lg:text-[13px]';
      const title = Object.assign(document.createElement('span'), { className: 'truncate', textContent: s.title });
      const hint = document.createElement('span');
      hint.className = 'flex-none font-mono text-[12px] opacity-50';
      hint.textContent = phone.matches || i > 8 ? `Line ${s.line + 1}` : String(i + 1);
      b.append(title, hint);
      b.addEventListener('click', () => jumpToSection(i));
      return b;
    }),
  );
  function renderSections() {
    const current = sectionOf(currentLine);
    sectionList.querySelectorAll<HTMLElement>('[data-section]').forEach((b) => {
      const s = sections[Number(b.dataset.section)];
      if (s === current) b.setAttribute('aria-current', 'true');
      else b.removeAttribute('aria-current');
    });
  }
  function jumpToSection(i: number) {
    const s = sections[i];
    if (!s || cough) return;
    endAdlib();
    setWord(starts[s.line]);
    renderSections();
  }

  // Mic: choose before you roll; read-only while recording.
  const micSelect = $<HTMLSelectElement>('[data-mic]');
  let wantedInput = '';
  micSelect.addEventListener('change', async () => {
    saveSettings('recording', { deviceId: micSelect.value });
    settings.deviceId = micSelect.value;
    await listenOn();
  });

  // ── Tap a line to jump; double-tap (or double-click) the script to retake ──
  // enableHandScroll sets touch-action: none, so dblclick isn't reliable on a phone:
  // two clicks within 300 ms are a double-tap, and the first click's jump waits for it.
  let tapTimer: number | undefined;
  viewport.addEventListener('click', (e) => {
    if (isMoreOpen()) return closeMore();
    toggleDetails(false);
    if (tapTimer) {
      clearTimeout(tapTimer);
      tapTimer = undefined;
      retake();
      return;
    }
    const line = (e.target as HTMLElement).closest<HTMLElement>('[data-line]');
    tapTimer = window.setTimeout(() => {
      tapTimer = undefined;
      if (!line || cough) return;
      const n = Number(line.dataset.line);
      if (n !== currentLine) {
        endAdlib();
        voice?.release();
      }
      setWord(starts[n]);
    }, 300);
  });

  // ── Keys ────────────────────────────────────────────────────────────────────
  addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).matches('input:not([type=range]), textarea, select, [contenteditable]')) return;
    const key = e.key.toLowerCase();
    const mod = e.metaKey || e.ctrlKey;
    if (mod && (key === '=' || key === '+')) {
      e.preventDefault();
      return setSize(textSize + 10);
    }
    if (mod && key === '-') {
      e.preventDefault();
      return setSize(textSize - 10);
    }
    if (mod && key === 'z') {
      e.preventDefault();
      return undo();
    }
    if (mod || e.altKey) return;
    if (key === 'escape') return (closeMore(), toggleDetails(false));
    if (e.repeat) return;
    if (key === 'c') coughDown();
    else if (key === 'r') retake();
    else if (key === 'a') toggleAdlib();
    else if (key === 'm') isMoreOpen() ? closeMore() : openMore();
    else if (key === 'p') togglePause();
    else if (key === 'u') undo();
    else if (isMoreOpen() && /^[1-9]$/.test(key)) jumpToSection(Number(key) - 1);
    // Page turners send PageDown / PageUp.
    else if ((e.key === 'ArrowRight' || e.key === 'PageDown') && !cough) setWord(starts[Math.min(currentLine + 1, starts.length - 1)]);
    else if ((e.key === 'ArrowLeft' || e.key === 'PageUp') && !cough) setWord(starts[Math.max(currentLine - 1, 0)]);
    else return;
    e.preventDefault();
  });
  addEventListener('keyup', (e) => e.key.toLowerCase() === 'c' && coughUp());

  $('[data-retake]').addEventListener('click', retake);
  adlibBtn.addEventListener('click', toggleAdlib);
  $('[data-resume]').addEventListener('click', resume);

  const endDialog = $<HTMLDialogElement>('[data-end-dialog]');
  $('[data-end]').addEventListener('click', () => endDialog.showModal());
  endDialog.addEventListener('close', () => endDialog.returnValue === 'end' && stop());

  // ── The mic, voice follow, and the recording itself ────────────────────────
  let openedInput: string | null = null;
  // The mic open in progress, so Start waits for it instead of racing it.
  let opening: Promise<void> = Promise.resolve();
  const listenOn = () => (opening = opening.then(openListening));
  async function openListening() {
    if (writer) return;
    const wanted = await availableInput(settings.deviceId, settings.channels);
    wantedInput = wanted;
    try {
      if (openedInput !== wanted || !capture.ctx) {
        await capture.open({ deviceId: wanted, sampleRate: hz(settings.rate), channels: settings.channels });
        openedInput = wanted;
      }
      micLabel = (await describeInput(wanted, settings.channels)).label;
      warn('error', null);
      checkBluetooth();
      $('[data-format-line]').textContent = `${formatText()} · saved in this browser as you go`;
      capture.ctx?.resume().catch(() => {});
    } catch (err) {
      micLabel = '';
      showWarning(
        (err as Error).name === 'NotAllowedError' ? 'Microphone blocked' : 'Couldn’t open the microphone',
        (err as Error).name === 'NotAllowedError' ? 'Allow the microphone for this site, then reload.' : (err as Error).message,
      );
    }
    voice?.setTrack(capture.voiceTrack());
    const choices = await inputChoices(settings.channels);
    micSelect.replaceChildren(...choices.map((c) => new Option(c.label, c.value)));
    micSelect.value = inputFor(wantedInput, settings.channels);
    if (micSelect.selectedIndex < 0) micSelect.selectedIndex = 0;
  }

  let manualTimer: number | undefined;
  function startVoice() {
    if (voice || manualTimer) return;
    // Manual speed (Studio → Scrolling): advance at a steady pace instead of listening.
    if (prompterSettings.mode === 'manual') {
      manualTimer = window.setInterval(() => {
        if (state === 'rec' && !adlib && !cough && word < words.length - 1) setWord(word + 1);
      }, 60000 / prompterSettings.wpm);
      setVoiceState('manual');
      return;
    }
    // iPhone and iPad: manual scroll unless Siri voice follow is switched on in More.
    if (isIOS() && !iosVoiceOn()) return;
    if (!voiceFollowSupported()) return;
    voice = new VoiceFollow(words);
    voice.engine = prompterSettings.voiceEngine;
    voice.track = capture.voiceTrack();
    voice.setWord(word);
    voice.addEventListener('word', (e) => {
      // Talk during a pause isn't part of the script.
      if (state !== 'paused') setWord((e as CustomEvent<number>).detail);
    });
    voice.addEventListener('lost', (e) => startAdlib((e as CustomEvent<{ since: number }>).detail.since));
    // The words that brought the reader back were script, so end a moment before them.
    voice.addEventListener('found', () => endAdlib(1));
    voice.addEventListener('error', (e) => {
      const code = (e as CustomEvent<string>).detail;
      logVoice('error', code);
      voiceReason = voiceErrorText(code);
      if (isIOS()) iosFailure();
    });
    voice.addEventListener('status', (e) => {
      const st = (e as CustomEvent<string>).detail as 'listening' | 'reconnecting' | 'stopped';
      logVoice(st);
      setVoiceState(st);
      if (isIOS() && st === 'stopped') iosFailure();
    });
    voice.addEventListener('diag', (e) => {
      const d = (e as CustomEvent<string>).detail;
      // The per-utterance signals are noise in a log; restarts and failures aren't.
      // (Watchdog and hand restarts are logged where they happen.)
      if (!['audiostart', 'soundstart', 'speechstart', 'watchdog', 'restart by hand'].includes(d)) logVoice(d);
    });
    voice.start();
  }
  function stopVoice() {
    const v = voice;
    voice = null;
    v?.stop();
    setVoiceState(manualTimer ? 'manual' : 'off');
  }

  // ── Voice follow health: visible state, a watchdog, and a log for diagnosing ──
  type VoiceState = 'off' | 'manual' | 'listening' | 'reconnecting' | 'stopped';
  let voiceState: VoiceState = 'off';
  let voiceReason = '';
  let voiceSince = Date.now();
  const voiceLog: { t: number; at: string; event: string; detail?: string }[] = [];
  function logVoice(event: string, detail?: string) {
    const entry = { t: Math.round(now() * 10) / 10, at: new Date().toISOString(), event, ...(detail ? { detail } : {}) };
    voiceLog.push(entry);
    if (voiceLog.length > 200) voiceLog.shift();
    if (writer) writer.meta.voiceLog = voiceLog.slice();
  }
  const voiceDot = $('[data-voice-dot]');
  function setVoiceState(st: VoiceState) {
    if (st !== voiceState) voiceSince = Date.now();
    voiceState = st;
    const text = {
      off: 'Off',
      manual: `Manual · ${prompterSettings.wpm} wpm`,
      listening: `Listening${voice?.restarts ? ` · ${voice.restarts} restart${voice.restarts === 1 ? '' : 's'}` : ''}`,
      reconnecting: 'Reconnecting…',
      stopped: `Stopped${voiceReason ? ` · ${voiceReason}` : ''}`,
    }[st];
    $('[data-voice-state]').textContent = text;
    voiceDot.style.borderColor = { off: '', manual: '', listening: 'var(--color-ok)', reconnecting: 'var(--color-warn)', stopped: 'var(--color-rec)' }[st];
    voiceDot.setAttribute('aria-label', `Voice follow: ${text}`);
    voiceDot.title = `Voice follow: ${text}`;
    if (st === 'listening' || st === 'off' || st === 'manual') warn('voice-follow', null);
  }
  // Warn when it stays down; Restart starts a fresh session in place.
  setInterval(() => {
    if (!voice) return;
    setVoiceState(voiceState); // keeps the restart count current
    const down = voiceState === 'stopped' || (voiceState === 'reconnecting' && Date.now() - voiceSince > 20000);
    warn(
      'voice-follow',
      down
        ? {
            level: 1,
            title: voiceState === 'stopped' ? 'Voice follow stopped' : 'Voice follow can’t reach the speech service',
            body: `${voiceReason ? voiceReason.replace(/[.!…]?$/, '.') : 'It stopped hearing words.'} The script won’t move on its own until it’s back; tap a line to move it.`,
            action: ['Restart voice follow', () => {
              logVoice('restart', 'by hand');
              voice?.kick('restart by hand');
              warn('voice-follow', null);
            }],
          }
        : null,
    );
  }, 1000);
  // Watchdog: speech on the meter for a while but no words back from recognition means it
  // has quietly stalled (Chrome sometimes keeps "listening" and returns nothing).
  const speaking: number[] = [];
  capture.addEventListener('level', (e) => {
    if ((e as CustomEvent<Level>).detail.peak > -40) speaking.push(Date.now());
  });
  setInterval(() => {
    const t = Date.now();
    while (speaking.length && t - speaking[0] > 10000) speaking.shift();
    if (!voice || state !== 'rec' || cough || voiceState !== 'listening') return;
    // About 30 level readings a second: 6 s of speech in the last 10 s.
    const speechSeconds = speaking.length / 30;
    if (speechSeconds >= 6 && t - Math.max(voice.lastResultAt, voiceSince) > 10000) {
      logVoice('watchdog', `${speechSeconds.toFixed(0)} s of speech, no words for ${Math.round((t - voice.lastResultAt) / 1000)} s`);
      voice.kick('watchdog');
      voiceSince = t;
    }
  }, 1000);
  $('[data-copy-diag]').addEventListener('click', async (e) => {
    const report = {
      page: location.href,
      browser: navigator.userAgent,
      recording: MicCapture.pcmRecording ? 'MediaRecorder PCM' : 'AudioWorklet',
      mic: micLabel,
      rate: capture.sampleRate,
      state,
      clock: Math.round(now()),
      voice: { state: voiceState, reason: voiceReason, restarts: voice?.restarts ?? 0, lastWordsAgo: voice?.lastResultAt ? Math.round((Date.now() - voice.lastResultAt) / 1000) : null },
      log: voiceLog,
    };
    const text = JSON.stringify(report, null, 2);
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = Object.assign(document.createElement('textarea'), { value: text });
      document.body.append(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
    (e.target as HTMLElement).textContent = 'Copied';
    setTimeout(() => ((e.target as HTMLElement).textContent = 'Copy diagnostics'), 1500);
  });

  // iOS: Siri voice follow is an experiment, off by default and saved per device. If it
  // errors or stops more than 3 times in a minute, it turns itself off.
  const IOS_VOICE_KEY = 'podstudio:ios-voice';
  const iosVoiceOn = () => {
    try {
      return localStorage.getItem(IOS_VOICE_KEY) === '1';
    } catch {
      return false;
    }
  };
  const iosSwitch = $<HTMLInputElement>('[data-ios-voice]');
  const setIosVoice = (on: boolean) => {
    try {
      localStorage.setItem(IOS_VOICE_KEY, on ? '1' : '0');
    } catch {}
    iosSwitch.checked = on;
  };
  let iosFailures: number[] = [];
  function iosFailure() {
    if (!voice) return;
    const t = Date.now();
    iosFailures = [...iosFailures.filter((x) => t - x < 60000), t];
    if (iosFailures.length <= 3) return;
    iosFailures = [];
    stopVoice();
    setIosVoice(false);
    warn('voice', { level: 1, title: 'Voice follow turned off', body: 'Siri kept stopping, so the script is back to manual scroll. Drag it, or tap a line.' });
    setTimeout(() => warn('voice', null), 8000);
  }
  if (isIOS()) {
    $('[data-ios-voice-row]').hidden = false;
    iosSwitch.checked = iosVoiceOn();
    iosSwitch.addEventListener('change', () => {
      setIosVoice(iosSwitch.checked);
      if (iosSwitch.checked) startVoice();
      else stopVoice();
    });
  }

  // ── Warnings (1h): one at a time, the most serious, then the newest ────────
  interface Warning {
    level: 1 | 2;
    title: string;
    body: string;
    action?: [label: string, run: () => void];
    at: number;
  }
  const warnings = new Map<string, Warning>();
  function warn(key: string, w: Omit<Warning, 'at'> | null) {
    if (!w) warnings.delete(key);
    else warnings.set(key, { ...w, at: warnings.get(key)?.at ?? Date.now() });
    renderWarning();
  }
  const warningEl = $('[data-warning]');
  const warningAction = $<HTMLButtonElement>('[data-warning-action]');
  let runAction: (() => void) | null = null;
  warningAction.addEventListener('click', () => runAction?.());
  function renderWarning() {
    const top = [...warnings.values()].sort((a, b) => b.level - a.level || b.at - a.at)[0];
    warningEl.hidden = !top;
    if (!top) return;
    $('[data-warning-dot]').style.background = top.level === 2 ? 'var(--color-rec)' : 'var(--color-warn)';
    warningEl.toggleAttribute('data-strong', !!top.action && top.level === 2);
    $('[data-warning-title]').textContent = top.title;
    $('[data-warning-body]').textContent = top.body;
    warningAction.hidden = !top.action;
    warningAction.textContent = top.action?.[0] ?? '';
    runAction = top.action?.[1] ?? null;
  }
  const showWarning = (title: string, body: string) => warn('error', { level: 2, title, body });

  // Clipping, from the meter.
  setInterval(() => {
    const clipping = state !== 'ready' && Date.now() - clipAt < 3000;
    warn(
      'clip',
      clipping
        ? { level: 2, title: 'Too loud · clipping', body: phone.matches ? 'Move the phone a little further from your mouth.' : 'Turn the gain down or move back from the mic.' }
        : null,
    );
  }, 500);

  // A Bluetooth mic records at call quality.
  const BLUETOOTH = /bluetooth|airpods|buds|hands-?free|headset/i;
  async function checkBluetooth() {
    if (!BLUETOOTH.test(micLabel)) return warn('bluetooth', null);
    const builtIn = (await inputChoices(settings.channels)).find((c) => !BLUETOOTH.test(c.label));
    const name = phone.matches ? 'the phone mic' : 'the built-in mic';
    warn('bluetooth', {
      level: 1,
      title: 'Bluetooth mic · call quality',
      body: state === 'ready' && builtIn ? `${micLabel} is the mic. Tap to use ${name} instead.` : `${micLabel} is the mic. Recording carries on at call quality.`,
      action:
        state === 'ready' && builtIn
          ? [`Use ${name}`, () => {
              saveSettings('recording', { deviceId: builtIn.value });
              settings.deviceId = builtIn.value;
              listenOn();
            }]
          : undefined,
    });
  }

  // Battery (Android and other Chromium browsers that report it).
  type Battery = EventTarget & { level: number; charging: boolean; dischargingTime: number };
  (navigator as Navigator & { getBattery?: () => Promise<Battery> }).getBattery?.().then((b) => {
    const check = () => {
      const pct = Math.round(b.level * 100);
      const mins = Number.isFinite(b.dischargingTime) ? Math.round(b.dischargingTime / 60) : null;
      warn(
        'battery',
        !b.charging && pct <= 20
          ? { level: pct <= 10 ? 2 : 1, title: `Battery ${pct}%${mins ? ` · about ${mins} min` : ''}`, body: 'Plug in if you can. Recording carries on.' }
          : null,
      );
    };
    check();
    b.addEventListener('levelchange', check);
    b.addEventListener('chargingchange', check);
  });

  // Space in this browser, checked every 30 s.
  async function checkSpace() {
    if (demo) return;
    const { hours } = await storageLeft(capture.sampleRate || hz(settings.rate), settings.depth, settings.channels);
    const mins = Math.floor(hours * 60);
    warn(
      'space',
      mins < 30
        ? { level: mins < 5 ? 2 : 1, title: `Space for about ${mins} min`, body: 'Free up space on this device, or export and delete older sessions.' }
        : null,
    );
  }
  setInterval(checkSpace, 30000);

  // Keep the screen awake while recording.
  let wakeLock: { release(): Promise<void> } | null = null;
  const keepAwake = async () => {
    try {
      wakeLock = (await (navigator as Navigator & { wakeLock?: { request(t: 'screen'): Promise<{ release(): Promise<void> }> } }).wakeLock?.request('screen')) ?? null;
    } catch {}
  };
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && writer) keepAwake();
  });

  // Mic stopped: audio stops arriving while the clock runs on (the page left the screen on an
  // iPhone, the mic was taken away). The gap is marked, not filled: the audio falls behind the
  // clock by exactly the missing stretch, measured from the samples that did arrive.
  let received = 0;
  let lastChunk = 0;
  let baseLag = Infinity;
  function onAudioChunk(frames: number, rate: number) {
    const t = now();
    received += frames;
    const lag = t - received / rate;
    if (lag - baseLag > 1 && writer) {
      // Samples went missing since the last chunk.
      const lost = lag - baseLag;
      const gap: SessionMarker = { t: lastChunk, kind: 'gap', line: currentLine, end: lastChunk + lost };
      writer.meta.markers!.push(gap);
      baseLag = lag;
      renderMore();
    } else baseLag = Math.min(baseLag, lag);
    lastChunk = t;
    if (warnings.has('mic')) warn('mic', null);
  }
  setInterval(() => {
    if (!writer || demo || !lastChunk) return;
    const quiet = now() - lastChunk;
    if (quiet < 2) return;
    warn('mic', {
      level: 2,
      title: `Mic stopped for ${clock(quiet)}`,
      body:
        document.visibilityState === 'visible'
          ? 'The gap is marked, not filled, and markers after it stay lined up. Keep this screen open while recording.'
          : 'Podstudio left the screen. The gap is marked, not filled, and markers after it stay lined up.',
      action: ['Resume recording', resumeMic],
    });
  }, 500);
  async function resumeMic() {
    try {
      const live = capture.stream?.getAudioTracks()[0]?.readyState === 'live';
      if (live && capture.ctx) await capture.ctx.resume();
      else {
        // The mic was closed: open it again and carry on into the same file.
        await capture.open({ deviceId: wantedInput, sampleRate: hz(settings.rate), channels: settings.channels });
        await capture.ctx!.resume();
        capture.record();
        voice?.setTrack(capture.voiceTrack());
      }
    } catch (err) {
      showWarning('Couldn’t restart the microphone', (err as Error).message);
    }
  }

  const startBtn = $<HTMLButtonElement>('[data-start]');
  async function start() {
    if (writer || demo) return;
    startBtn.disabled = true;
    await opening;
    try {
      if (!capture.ctx) await capture.open({ deviceId: wantedInput, sampleRate: hz(settings.rate), channels: settings.channels });
      await capture.ctx!.resume();
    } catch (err) {
      startBtn.disabled = false;
      showWarning('Couldn’t open the microphone', (err as Error).message);
      return;
    }
    const w = await TakeWriter.start({
      episodeId,
      kind: 'session',
      markers: [],
      lineLog: [{ t: 0, line: currentLine }],
      group: `${episodeId}-g${Date.now().toString(36)}`,
      startLine: currentLine,
      startText: lines[currentLine].text,
      speaker: root.dataset.host!.toUpperCase(),
      device: capture.label || 'This device',
      sampleRate: capture.sampleRate,
      bitDepth: settings.depth,
      channels: capture.channels,
    });
    capture.addEventListener('chunk', (e) => {
      const samples = (e as CustomEvent<Float32Array>).detail;
      w.push(samples);
      onAudioChunk(samples.length / (capture.channels || 1), w.meta.sampleRate);
    });
    // The recording's own rate, if the device reported a different one up front.
    capture.addEventListener('format', (e) => (w.meta.sampleRate = (e as CustomEvent<number>).detail));
    capture.addEventListener('error', (e) => showWarning('Recording problem', (e as CustomEvent<string>).detail));
    writer = w;
    w.meta.voiceLog = voiceLog.slice();
    logVoice('recording started');
    capture.record();
    sessionStart = performance.now();
    startBtn.disabled = false;
    warn('error', null);
    keepAwake();
    setState('rec');
    checkBluetooth();
  }
  startBtn.addEventListener('click', start);

  async function stop() {
    if (!writer) return;
    coughUp();
    endAdlib();
    if (paused) paused.end = now();
    clearInterval(manualTimer);
    voice?.stop();
    await capture.stop();
    const meta = await writer.finish();
    writer = null;
    wakeLock?.release().catch(() => {});
    await capture.close();
    location.href = `/episodes/${episodeId}/saved?take=${encodeURIComponent(meta.id)}`;
  }

  addEventListener('beforeunload', (e) => {
    if (writer) e.preventDefault();
  });
  // Chrome keeps audio paused until the first click or key press on the page.
  for (const ev of ['pointerdown', 'keydown']) addEventListener(ev, () => capture.ctx?.resume(), { once: true });

  setWord(word);
  if (demo) runDemo();
  else live();

  async function live() {
    await offerRecovery(episodeId);
    checkSpace();
    // Open the chosen mic now: the meter works before you start, so this screen doubles as
    // the mic check, and voice follow listens to exactly the input that will be recorded.
    listenOn();
    startBtn.disabled = false;
    await opening;
    startVoice();
  }

  /** The design's example states, without a mic (?demo&state=…). */
  function runDemo() {
    const s = params.get('state') ?? 'rec';
    micLabel = phone.matches ? 'Phone mic' : 'Shure MV7+';
    micSelect.replaceChildren(new Option(micLabel, ''));
    const levels: Record<string, number> = { ready: -20, rec: -12, cough: -30, retake: -42, adlib: -14, more: -15, paused: -34 };
    const base = levels[s] ?? -12;
    setInterval(() => {
      const peak = base + Math.sin(Date.now() / 300) * 2;
      onLevel({ peak, hot: peak, rms: peak - 9, inputs: [peak] });
    }, 33);
    startBtn.disabled = false;
    if (s === 'ready') return;
    demoNow = { rec: 271, cough: 302, retake: 340, adlib: 435, more: 482, paused: 530 }[s] ?? 271;
    demoMarkers = [
      { t: 30, kind: 'retake', line: 1, attempt: 2 },
      { t: 95, kind: 'cut', line: 3, end: 98 },
      { t: 160, kind: 'adlib', line: 4, end: 185 },
      { t: 208, kind: 'retake', line: 6, attempt: 2 },
    ];
    setInterval(() => (demoNow += state === 'rec' ? 0.25 : 0), 250);
    const lineFor: Record<string, number> = { rec: 1, cough: 2, retake: 2, adlib: 3, more: 4, paused: 4 };
    setWord(starts[lineFor[s] ?? 1] + (s === 'retake' ? 0 : 4));
    setState('rec');
    if (s === 'cough') {
      cough = { t: demoNow - 2 };
      root.dataset.coughing = '';
      coughBtn.dataset.holding = '';
      $('[data-cough-sub]').textContent = 'RELEASE';
    }
    if (s === 'retake') {
      attemptShown = { line: currentLine, n: 2 };
      setRule();
      offerUndo(`Retake marked · Line ${currentLine + 1}`, demoMarkers[3]);
      clearTimeout(toastTimer);
    }
    if (s === 'adlib') {
      startAdlib(Date.now() - 14000);
      adlib!.t = demoNow - 14;
    }
    if (s === 'more') openMore();
    if (s === 'mic') {
      warn('mic', {
        level: 2,
        title: 'Mic stopped for 0:06',
        body: 'Podstudio left the screen. The gap is marked, not filled, and markers after it stay lined up. Keep this screen open while recording.',
        action: ['Resume recording', () => warn('mic', null)],
      });
    }
    if (s === 'paused') {
      pause();
      paused!.t = demoNow - 48;
    }
    tick();
  }
</script>
