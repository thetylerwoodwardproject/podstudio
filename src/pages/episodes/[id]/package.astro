---
import EpisodeData from '@/components/app/EpisodeData.astro';
import EpisodePreparation from '@/components/app/EpisodePreparation.svelte';
import { episodePage } from '@/lib/episode-page';
import AppShell from '@/layouts/AppShell.astro';
export const prerender = false;
const data = episodePage(Astro.params.id);
if (!data) return new Response('No such episode', { status: 404 });
const episode=data.episode;
---
<AppShell title="Prepare episode" avatar={false} crumbs={[{label:'Episodes',href:'/'},{label:episode.fullTitle,href:`/episodes/${episode.id}/sessions`},{label:'Prepare episode'}]}>
  <EpisodeData data={data}/><div class="h-full overflow-auto"><EpisodePreparation episodeId={episode.id} title={episode.title} client:load /></div>
</AppShell>
