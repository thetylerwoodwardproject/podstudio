---
// 2e · Transcript + episode package (titles, description, social, chapters, soundbites)
import AppShell from '@/layouts/AppShell.astro';
import Button from '@/components/ui/Button.astro';
import { episode, episodePaths, limits, pkg, transcript } from '@/data/mock';

export const getStaticPaths = episodePaths;

const base = `/episodes/${episode.id}`;
const tabs = [
  { id: 'titles', label: 'Titles' },
  { id: 'desc', label: 'Description' },
  { id: 'social', label: 'Social' },
  { id: 'chapters', label: 'Chapters' },
  { id: 'bites', label: 'Soundbites' },
];
const initial: string = 'chapters';
const topBtn = 'h-[34px] rounded-lg px-3.5 text-[13px]';
const counter = 'meta text-right text-subtle data-[over]:text-rec';
---

<AppShell title="Episode package" avatar={false} crumbs={[{ label: 'Episodes', href: '/' }, { label: episode.fullTitle }]}>
  <Fragment slot="topbar">
    <Button class:list={[topBtn, 'max-lg:hidden']}>↓ WAV</Button>
    <Button class:list={[topBtn, 'max-lg:hidden']}>↓ Transcript (.txt · .srt · .vtt)</Button>
    <Button href={`${base}/sessions`} variant="primary" class={topBtn}>Export package</Button>
  </Fragment>

  <div class="grid lg:h-full lg:grid-cols-[520px_1fr]">
    <section class="flex min-h-0 flex-col border-line max-lg:border-b lg:border-r">
      <div class="flex justify-between border-b border-line px-6 py-3.5 text-[13px]">
        <div class="flex gap-4.5">
          <span>Transcript</span>
          <a href={`${base}/transcript`} class="text-muted hover:text-fg">Speakers</a>
        </div>
        <span class="meta text-subtle">whisper-1 · 4,912 words</span>
      </div>
      <div class="flex flex-1 flex-col overflow-auto px-6 py-2">
        {
          transcript.map((g) => (
            <div class="grid grid-cols-[56px_1fr] gap-3 border-b border-line-soft py-3">
              <div class="meta pt-[3px] text-subtle">{g.t}</div>
              <div class="text-[14px] leading-[1.6] text-pretty text-fg-soft">{g.text}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="flex min-h-0 flex-col" data-package>
      <div class="flex flex-wrap items-center justify-between gap-x-6 border-b border-line px-8">
        <div class="flex gap-6.5" role="tablist" aria-label="Episode package">
          {
            tabs.map((t) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected={t.id === initial ? 'true' : 'false'}
                tabindex={t.id === initial ? 0 : -1}
                class="pt-4 pb-3.5 text-[14px] text-subtle hover:text-fg-soft aria-selected:text-fg aria-selected:shadow-[inset_0_-2px_0_var(--color-fg)]"
              >
                {t.label}
              </button>
            ))
          }
        </div>
        <div class="flex gap-2 py-2">
          <Button size="sm" data-regenerate>↻ Regenerate</Button>
          <Button size="sm" data-copy-all>Copy all</Button>
        </div>
      </div>

      <div class="flex-1 overflow-auto px-8 py-7">
        <div role="tabpanel" id="panel-titles" aria-labelledby="tab-titles" hidden={initial !== 'titles'} class="flex flex-col gap-2.5">
          <p class="mb-1.5 text-[13px] text-muted">Choose one to use as the episode title.</p>
          {
            pkg.titles.map((t, i) => (
              <label class="flex items-center gap-3.5 rounded-[10px] border border-line p-4 hover:border-edge has-checked:border-fg">
                <input type="radio" name="title" class="peer sr-only" checked={i === 0} />
                <span class="flex size-4 flex-none items-center justify-center rounded-full border border-faint peer-checked:[&>span]:bg-fg">
                  <span class="size-2 rounded-full" />
                </span>
                <span class="flex-1 text-[17px] tracking-[-0.01em]" data-copy>{t}</span>
                <span class="font-mono text-[11px] text-subtle">{t.length} ch</span>
              </label>
            ))
          }
        </div>

        <div role="tabpanel" id="panel-desc" aria-labelledby="tab-desc" hidden={initial !== 'desc'} class="flex max-w-[720px] flex-col gap-4.5">
          <div
            contenteditable="plaintext-only"
            data-copy
            data-count-target="desc-count"
            class="rounded-[10px] border border-edge p-5 text-[15px] leading-[1.7] text-pretty text-fg-soft focus:border-fg focus:outline-none"
          >{pkg.description}</div>
          <div class="meta flex justify-between text-subtle">
            <span>Short version for podcast apps also available</span>
            <span><span id="desc-count">{pkg.description.length}</span> chars</span>
          </div>
        </div>

        <div role="tabpanel" id="panel-social" aria-labelledby="tab-social" hidden={initial !== 'social'} class="grid gap-4 md:grid-cols-3">
          {
            pkg.posts.map((text, i) => (
              <div class="flex min-h-65 flex-col gap-3.5 rounded-[10px] border border-edge p-4.5">
                <div class="eyebrow">Post {i + 1}</div>
                <div class="flex-1 text-[15px] leading-[1.6] text-pretty text-fg-soft" data-copy>{text}</div>
                <div class="flex items-center justify-between font-mono text-[11px] text-subtle">
                  <span>{text.length} chars</span>
                  <button type="button" class="font-sans text-[12px] text-fg hover:text-white" data-copy-one>
                    Copy
                  </button>
                </div>
              </div>
            ))
          }
        </div>

        <div role="tabpanel" id="panel-chapters" aria-labelledby="tab-chapters" hidden={initial !== 'chapters'} class="flex flex-col">
          <div class="eyebrow grid grid-cols-[90px_90px_1fr_70px] gap-4 border-b border-line pb-2.5">
            <span>Start</span><span>End</span><span>Title</span><span class="text-right">/ {limits.chapterTitle}</span>
          </div>
          {
            pkg.chapters.map((c) => (
              <div class="grid grid-cols-[90px_90px_1fr_70px] items-center gap-4 border-b border-line py-3.5">
                <span class="font-mono text-[13px]">{c.s}</span>
                <span class="font-mono text-[13px] text-muted">{c.e}</span>
                <span
                  contenteditable="plaintext-only"
                  data-copy
                  data-limit={limits.chapterTitle}
                  class="rounded text-[15px] focus:outline-none"
                >{c.title}</span>
                <span class={counter} data-counter data-over={c.title.length > limits.chapterTitle ? '' : undefined}>
                  {c.title.length}
                </span>
              </div>
            ))
          }
        </div>

        <div role="tabpanel" id="panel-bites" aria-labelledby="tab-bites" hidden={initial !== 'bites'} class="flex flex-col">
          <div class="eyebrow grid grid-cols-[90px_90px_1fr_70px_60px] gap-4 border-b border-line pb-2.5">
            <span>Start</span><span>End</span><span>Title</span><span class="text-right">/ {limits.soundbiteTitle}</span><span></span>
          </div>
          {
            pkg.soundbites.map((c) => (
              <div class="grid grid-cols-[90px_90px_1fr_70px_60px] items-center gap-4 border-b border-line py-4">
                <span class="font-mono text-[13px]">{c.s}</span>
                <span class="font-mono text-[13px] text-muted">{c.e}</span>
                <span
                  contenteditable="plaintext-only"
                  data-copy
                  data-limit={limits.soundbiteTitle}
                  class="rounded text-[15px] leading-normal text-pretty focus:outline-none"
                >{c.title}</span>
                <span class={counter} data-counter data-over={c.title.length > limits.soundbiteTitle ? '' : undefined}>
                  {c.title.length}
                </span>
                <button
                  type="button"
                  aria-label={`Play soundbite at ${c.s}`}
                  class="flex size-8 items-center justify-center justify-self-end rounded-full bg-raised text-[11px] hover:bg-line"
                >
                  ▶
                </button>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</AppShell>

<script>
  const root = document.querySelector<HTMLElement>('[data-package]')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];

  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const next = tabs[(i + d + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });

  // Live character counters on editable chapter and soundbite titles.
  for (const el of root.querySelectorAll<HTMLElement>('[data-limit]')) {
    const counter = el.parentElement!.querySelector<HTMLElement>('[data-counter]')!;
    el.addEventListener('input', () => {
      const n = el.textContent!.trim().length;
      counter.textContent = String(n);
      counter.toggleAttribute('data-over', n > Number(el.dataset.limit));
    });
  }
  for (const el of root.querySelectorAll<HTMLElement>('[data-count-target]')) {
    el.addEventListener('input', () => (document.getElementById(el.dataset.countTarget!)!.textContent = String(el.textContent!.trim().length)));
  }

  const flash = (btn: HTMLElement, text: string) => {
    const was = btn.textContent;
    btn.textContent = text;
    setTimeout(() => (btn.textContent = was), 1200);
  };

  const copyAll = root.querySelector<HTMLButtonElement>('[data-copy-all]')!;
  copyAll.addEventListener('click', async () => {
    const panel = root.querySelector<HTMLElement>('[role=tabpanel]:not([hidden])')!;
    const rows = [...panel.querySelectorAll<HTMLElement>('[data-copy]')].map((el) => {
      const row = el.parentElement!;
      const times = [...row.querySelectorAll('.font-mono')].slice(0, 2).map((t) => t.textContent!.trim());
      const text = el.textContent!.trim();
      return times.length === 2 && /\d:\d/.test(times[0]) ? `${times[0]}–${times[1]} ${text}` : text;
    });
    await navigator.clipboard.writeText(rows.join('\n\n'));
    flash(copyAll, 'Copied');
  });

  for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-copy-one]')) {
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.closest('div.flex-col')!.querySelector('[data-copy]')!.textContent!.trim());
      flash(btn, 'Copied');
    });
  }

  root.querySelector('[data-regenerate]')!.addEventListener('click', (e) => flash(e.currentTarget as HTMLElement, 'Regenerating…'));
</script>
