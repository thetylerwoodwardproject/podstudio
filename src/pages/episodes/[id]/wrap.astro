---
// After Stop session: every speaker's track has to be in before the export.
import AppShell from '@/layouts/AppShell.astro';
import Button from '@/components/ui/Button.astro';
import { episode, episodePaths } from '@/data/mock';

export const getStaticPaths = episodePaths;
---

<AppShell title="Wrapping up" avatar={false} crumbs={[{ label: episode.label, href: `/episodes/${episode.id}/studio` }, { label: 'Wrapping up' }]}>
  <div class="mx-auto flex w-full max-w-[760px] flex-col gap-6 px-6 py-8" id="wrap" data-episode={episode.id}>
    <div>
      <h1 class="text-[22px] tracking-[-0.02em]">Collecting everyone’s tracks</h1>
      <p class="mt-1.5 text-[13px] text-muted" data-intro>
        The session is saved. Each person’s own recording has to be here before you export.
      </p>
    </div>

    <p class="rounded-xl bg-surface px-5 py-4 text-[13px] text-subtle" data-missing hidden>
      This session wasn’t found. It may have been deleted. <a href={`/episodes/${episode.id}/sessions`} class="text-fg underline-offset-2 hover:underline">See all sessions</a>
    </p>

    <div class="flex flex-col border-t border-line" data-rows></div>

    <div class="flex flex-wrap items-center gap-3 border-t border-line pt-5">
      <span class="meta mr-auto text-muted" data-summary></span>
      <button type="button" class="text-[13px] text-muted hover:text-fg" data-skip hidden>Export without waiting</button>
      <Button variant="primary" size="lg" data-continue disabled>Continue to export →</Button>
    </div>
  </div>

  <template id="wrap-row">
    <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1 border-b border-line py-4">
      <div class="flex min-w-0 items-center gap-2.5 text-[15px]">
        <span class="inline-block size-2 flex-none rounded-full" data-dot></span>
        <span data-name></span>
      </div>
      <div class="flex items-center gap-2 font-mono text-[12px]">
        <span class="inline-block size-1.5 rounded-full" data-state-dot></span>
        <span data-state></span>
      </div>
      <div class="col-span-2 flex flex-wrap items-center justify-between gap-3 text-[12px] text-subtle">
        <span data-detail></span>
        <label class="inline-flex h-8 cursor-pointer items-center rounded-lg border border-edge px-3 text-[13px] text-fg hover:bg-raised" data-add hidden>
          <span data-add-label>Add their file…</span>
          <input type="file" accept=".wav,audio/*" class="sr-only" data-file />
        </label>
      </div>
    </div>
  </template>
</AppShell>

<script>
  import { formatBytes, formatDuration, getTake, listTakes, takeBytes, takeSeconds, type RosterEntry, type TakeMeta } from '@/lib/audio/takes';
  import { importTrack } from '@/lib/audio/import';
  import { speakerColor, speakerName } from '@/lib/script-store';

  const root = document.getElementById('wrap')!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const episodeId = root.dataset.episode!;
  const id = new URL(location.href).searchParams.get('take');
  const ok = 'var(--color-ok)';
  const warn = 'var(--color-warn)';
  const bad = 'var(--color-rec)';
  const faint = 'var(--color-faint)';

  render();

  async function render() {
    const take = id ? await getTake(id) : null;
    if (!take) {
      $('[data-missing]').hidden = false;
      $('[data-intro]').hidden = true;
      return;
    }
    const tracks = take.group ? (await listTakes(episodeId)).filter((t) => t.group === take.group && t.status === 'done') : [take];
    // Sessions from before the roster: every track that exists is all there is.
    const roster: RosterEntry[] = take.roster ?? tracks.map((t) => ({ speaker: t.speaker, source: 'local' }));
    const trackOf = (k: string) => tracks.find((t) => t.speaker === k);
    const exportUrl = `/episodes/${episodeId}/session?take=${encodeURIComponent(take.id)}`;

    const tpl = (document.getElementById('wrap-row') as HTMLTemplateElement).content.firstElementChild!;
    const rows = roster.map((r) => {
      const row = tpl.cloneNode(true) as HTMLElement;
      const q = <T extends HTMLElement = HTMLElement>(s: string) => row.querySelector<T>(s)!;
      row.dataset.speaker = r.speaker;
      q('[data-dot]').style.background = speakerColor(r.speaker);
      q('[data-name]').textContent = speakerName(r.speaker);
      const state = (text: string, color: string, detail: string) => {
        q('[data-state]').textContent = text;
        q('[data-state]').style.color = color === faint ? '' : color;
        q('[data-state-dot]').style.background = color;
        q('[data-detail]').textContent = detail;
      };
      const t = trackOf(r.speaker);
      const about = (x: TakeMeta) => `${formatDuration(takeSeconds(x))} · ${formatBytes(takeBytes(x))}`;
      if (t) {
        row.dataset.state = 'in';
        state('Saved', ok, t.imported ? `Added from ${t.imported} · ${about(t)}` : `Recorded on this computer · ${t.device} · ${about(t)}`);
      } else if (r.source === 'shared') {
        row.dataset.state = 'in';
        state('On one track', ok, `Same mic as ${speakerName(r.with ?? '')}, so they’re on that track`);
      } else if (r.source === 'off') {
        row.dataset.state = 'skip';
        state('Not recorded', faint, 'Set to “Not recorded” for this session');
      } else if (r.source === 'failed') {
        row.dataset.state = 'skip';
        state('No recording', bad, 'Their mic didn’t open, so nothing was recorded');
      } else {
        row.dataset.state = 'waiting';
        state('Waiting for upload', warn, 'Their device uploads it once the Podstudio server is running. Until then, ask them to send their file.');
        const add = q('[data-add]');
        add.hidden = false;
        q<HTMLInputElement>('[data-file]').addEventListener('change', async (e) => {
          const file = (e.target as HTMLInputElement).files?.[0];
          if (!file) return;
          add.hidden = true;
          state('Adding…', warn, file.name);
          try {
            await importTrack(file, take, r.speaker, (f) => state(`Adding ${Math.round(f * 100)}%`, warn, file.name));
            render();
          } catch (err) {
            add.hidden = false;
            state('Waiting for upload', warn, `Couldn’t read ${file.name}: ${(err as Error).message}`);
          }
        });
      }
      return row;
    });
    $('[data-rows]').replaceChildren(...rows);

    const waiting = rows.filter((r) => r.dataset.state === 'waiting').map((r) => speakerName(r.dataset.speaker!));
    const done = rows.filter((r) => r.dataset.state === 'in').length;
    $('[data-summary]').textContent = waiting.length
      ? `${done} of ${done + waiting.length} tracks in · waiting for ${waiting.join(', ')}`
      : `All ${done} track${done === 1 ? '' : 's'} in`;
    const cont = $<HTMLButtonElement>('[data-continue]');
    cont.disabled = waiting.length > 0;
    cont.onclick = () => (location.href = exportUrl);
    const skip = $<HTMLButtonElement>('[data-skip]');
    skip.hidden = !waiting.length;
    skip.onclick = () => {
      if (confirm(`Export without ${waiting.join(' and ')}? You can come back and add their track later.`)) location.href = exportUrl;
    };
  }
</script>
