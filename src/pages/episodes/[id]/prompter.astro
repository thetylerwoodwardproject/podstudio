---
// 7d · Phone prompter: reading, lost place, reconnecting, guest upload
import Phone from '@/layouts/Phone.astro';
import Dot from '@/components/ui/Dot.astro';
import PreviewStates from '@/components/app/PreviewStates.astro';
import { episode, episodePaths, lineStarts, scriptLines, scriptWords, speakerByKey, speakers, spk } from '@/data/mock';
import { splitWords } from '@/lib/prompter';

export const getStaticPaths = episodePaths;

/** Default speaker for this screen; each device can pick its own (saved per browser). */
const me = 'SAM';
const states = [
  { value: 'read', label: 'Reading' },
  { value: 'lost', label: 'Lost place' },
  { value: 'off', label: 'Reconnecting' },
  { value: 'up', label: 'Guest upload' },
];
const foot = {
  lost: ['Ad-lib for 0:14', 'var(--color-warn)'],
  off: ['Offline · recording locally', 'var(--color-warn)'],
  up: ['Take ended', 'var(--color-muted)'],
};
---

<Phone title="Prompter" black>
  <div
    id="prompter"
    class="group/p flex min-h-0 flex-1 flex-col bg-(--p-bg,#000) [font-family:var(--p-font,inherit)]"
    data-states={states.map((s) => s.value).join(',')}
    data-state="read"
    data-foot={JSON.stringify(foot)}
    data-me={me}
    data-episode={episode.id}
    data-words={JSON.stringify(scriptWords)}
    data-line-starts={JSON.stringify(lineStarts)}
  >
    <div class="flex items-center justify-between px-5 pt-1.5 pb-3 font-sans">
      <div class="flex items-center gap-2 font-mono text-[13px] font-medium" data-rec>
        <Dot color="var(--color-rec)" size={8} pulse data-rec-dot />
        <span data-clock>12:48</span>
      </div>
      <label class="relative flex h-6.5 items-center gap-[7px] rounded-[13px] bg-raised px-2.5 text-[12px] focus-within:outline-2 focus-within:outline-fg">
        <Dot color={spk(me)} data-me-dot />
        You’re <span data-me-name>{speakerByKey(me).name}</span>
        <select class="absolute inset-0 cursor-pointer opacity-0" aria-label="Whose lines are highlighted on this screen" data-me-select>
          {speakers.map((s) => <option value={s.key} selected={s.key === me}>{s.name}</option>)}
        </select>
      </label>
    </div>

    <div data-when="lost" hidden class="mx-3.5 flex flex-col gap-2.5 rounded-2xl bg-raised px-4 py-3.5 font-sans">
      <div class="flex items-center gap-2 text-[14px]"><Dot color="var(--color-warn)" size={8} />Lost your place, listening…</div>
      <div class="text-[12px] leading-normal text-muted">Keep talking, or tap where you are:</div>
      <button type="button" data-suggest class="rounded-[10px] bg-void px-3 py-[11px] text-left text-[14px]"></button>
      <button type="button" data-suggest class="rounded-[10px] bg-void px-3 py-[11px] text-left text-[14px]"></button>
    </div>
    <div data-when="off" hidden class="mx-3.5 flex flex-col gap-1.5 rounded-2xl bg-raised px-4 py-3.5 font-sans">
      <div class="flex items-center gap-2 text-[14px]"><Dot color="var(--color-warn)" size={8} />Reconnecting…</div>
      <div class="text-[12px] leading-normal text-muted">
        Your mic is still recording on this phone. Scrolling follows your voice until the connection comes back.
      </div>
    </div>
    <div data-when="up" hidden class="mx-3.5 flex flex-col gap-2.5 rounded-2xl bg-raised px-4 py-3.5 font-sans">
      <div class="flex items-center gap-2 text-[14px]"><Dot color="var(--color-warn)" size={8} />Sending your audio to Tyler</div>
      <div class="h-1 rounded-sm bg-edge"><div class="h-1 w-[78%] rounded-sm bg-fg"></div></div>
      <div class="meta flex justify-between text-muted"><span>78% · 22 of 28 MB</span><span>~20 s</span></div>
      <div class="text-[12px] text-fg-soft">Keep this tab open. You can leave the call now.</div>
    </div>

    <div
      data-prompter-viewport
      class="relative flex-1 overflow-hidden px-6.5 transition-opacity group-data-[state=lost]/p:opacity-50 group-data-[state=off]/p:opacity-50 group-data-[state=up]/p:opacity-25"
    >
      <div
        data-reading-line
        class="absolute inset-x-0 top-[30%] h-px bg-[linear-gradient(90deg,var(--color-rec)_0_14px,rgb(255_255_255/0.07)_14px)]"
        aria-hidden="true"
      >
      </div>
      <div data-prompter-track class="flex flex-col gap-6 pt-6 transition-transform duration-500 ease-in-out">
        {
          scriptLines.map((l) => (
            <div
              data-line
              data-who={speakerByKey(l.who).name}
              data-key={l.who}
              data-mine={l.who === me ? '' : undefined}
              class="group flex flex-col gap-1.5 transition-[padding] data-[l=now]:pl-3.5 data-[l=now]:shadow-[inset_2px_0_0_var(--c)]"
              style={{ '--c': spk(l.who) }}
            >
              <div class="font-mono text-[11px] font-medium tracking-[0.08em] text-(--c)">
                {l.who}
                <span class="hidden group-data-[l=now]:inline"> · NOW</span>
              </div>
              <div
                class:list={[
                  'flex flex-wrap gap-x-[0.25em] text-[calc(26px*var(--p-scale,1))] leading-(--p-lh,1.4) transition-[font-size,color]',
                  'group-data-[l=now]:text-[calc(30px*var(--p-scale,1))] group-data-[l=past]:text-(--p-past,#3A3B3F) group-data-[l=next]:text-(--p-dim,#6A6C71)',
                  'group-data-[mine]:group-data-[l=next]:text-(--p-soft,#C9CBCF)',
                ]}
              >
                {splitWords(l.text).map((w) => (
                  <span
                    data-word
                    class="group-data-[l=now]:data-[w=next]:text-(--p-fg,#EDEDEA) group-data-[l=now]:data-[w=now]:text-(--p-fg,#EDEDEA) group-data-[l=now]:data-[w=now]:shadow-[inset_0_-3px_0_var(--color-rec)] group-data-[l=now]:data-[w=past]:text-(--p-now-past,#5A5C61)"
                  >
                    {w}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <footer class="flex items-center justify-between border-t border-line-soft px-5 pt-3.5 pb-[max(34px,env(safe-area-inset-bottom))] font-sans text-[12px] text-muted">
      <button type="button" class="flex items-center gap-2 text-left" data-foot>
        <span class="inline-block size-1.5 flex-none rounded-full" data-foot-dot></span><span data-foot-text></span>
      </button>
      <span class="flex-none text-subtle">Next: <span data-next-who></span></span>
    </footer>
  </div>
  <PreviewStates target="prompter" states={states} />
</Phone>

<script>
  import { Prompter, startClock } from '@/lib/prompter';
  import { runPrompter, type LiveStatus } from '@/lib/prompter-live';
  import { applyState } from '@/lib/states';
  import { applyPrompterLook, loadSettings } from '@/lib/settings';

  const root = document.getElementById('prompter')!;
  const viewport = root.querySelector<HTMLElement>('[data-prompter-viewport]')!;
  const track = root.querySelector<HTMLElement>('[data-prompter-track]')!;
  const demo = new URL(location.href).searchParams.has('demo');
  const foot = JSON.parse(root.dataset.foot!) as Record<string, [string, string]>;
  const state = () => root.dataset.state!;

  // Look: theme, font, size, spacing and reading line from Prompter settings.
  const applyLook = () => {
    const s = loadSettings().prompter;
    applyPrompterLook(root, s);
    root.querySelector<HTMLElement>('[data-reading-line]')!.style.top = `${demo ? 30 : s.line}%`;
    return s;
  };
  const look = applyLook();
  const p = new Prompter(viewport, track, { line: demo ? 0.3 : look.line / 100 });
  document.addEventListener('prompter-settings', () => {
    applyLook();
    p.setWord(p.index);
  });

  // Whose lines are highlighted on this screen.
  const ME_KEY = 'podstudio:prompter-speaker';
  const select = root.querySelector<HTMLSelectElement>('[data-me-select]')!;
  const setMe = (key: string) => {
    root.dataset.me = key;
    select.value = key;
    root.querySelector('[data-me-name]')!.textContent = select.selectedOptions[0].textContent;
    root.querySelector<HTMLElement>('[data-me-dot]')!.style.background = `var(--spk-${key.toLowerCase()})`;
    p.lines.forEach((l) => l.toggleAttribute('data-mine', l.dataset.key === key));
  };
  try {
    setMe(new URL(location.href).searchParams.get('as')?.toUpperCase() || localStorage.getItem(ME_KEY) || root.dataset.me!);
  } catch {}
  select.addEventListener('change', () => {
    setMe(select.value);
    try {
      localStorage.setItem(ME_KEY, select.value);
    } catch {}
  });

  const currentLine = () => p.lines.findIndex((l) => l.dataset.l === 'now');
  viewport.addEventListener('word', () => {
    const i = currentLine();
    const next = p.lines.slice(i + 1).find((l) => l.dataset.who !== p.lines[i]?.dataset.who);
    root.querySelector('[data-next-who]')!.textContent = next?.dataset.who ?? '—';
  });

  // Footer: the state banner text, or what's driving the scroll.
  let live: LiveStatus = { kind: 'demo' };
  let lostAt = 0;
  const liveFoot = (): [string, string] => {
    switch (live.kind) {
      case 'demo':
      case 'voice':
        return ['Following voice', 'var(--color-ok)'];
      case 'following':
        return [`Following ${live.device}`, 'var(--color-ok)'];
      case 'voice-off':
        return [live.reason, 'var(--color-warn)'];
      case 'manual':
        return [live.paused ? 'Paused · Space to resume' : `Manual · ${live.wpm} wpm`, live.paused ? 'var(--color-muted)' : 'var(--color-ok)'];
    }
  };
  const renderFoot = () => {
    let [text, color] = state() === 'read' ? liveFoot() : foot[state()];
    if (state() === 'lost' && lostAt) {
      const s = Math.floor((Date.now() - lostAt) / 1000);
      text = `Ad-lib for ${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    }
    root.querySelector('[data-foot-text]')!.textContent = text;
    root.querySelector<HTMLElement>('[data-foot-dot]')!.style.background = color;
  };

  // "Lost your place": offer the next two lines as tap targets.
  let jump = (i: number) => p.setWord(i);
  const suggest = [...root.querySelectorAll<HTMLButtonElement>('[data-suggest]')];
  const fillSuggestions = () => {
    const from = Math.max(currentLine(), 0) + 1;
    suggest.forEach((btn, k) => {
      const line = p.lines[from + k];
      btn.hidden = !line;
      if (!line) return;
      const words = [...line.querySelectorAll('[data-word]')].map((w) => w.textContent!.trim());
      btn.textContent = `“${words.slice(0, 6).join(' ')}…”`;
      btn.onclick = () => {
        jump(p.lineStart(line));
        applyState(root, 'read');
      };
    });
  };

  root.addEventListener('statechange', () => {
    lostAt = state() === 'lost' ? Date.now() : 0;
    renderFoot();
    if (state() === 'lost') fillSuggestions();
  });
  setInterval(() => state() === 'lost' && renderFoot(), 1000);

  const clock = [...root.querySelectorAll<HTMLElement>('[data-clock]')];
  if (demo) {
    // Start partway into the second line, like the design.
    p.setWord(p.lineStart(p.lines[1]) + 3);
    startClock(clock, 768, () => state() === 'up');
  } else {
    p.setWord(0);
    clock.forEach((c) => (c.textContent = 'Standby'));
    root.querySelector<HTMLElement>('[data-rec-dot]')!.style.cssText += ';background:var(--color-faint);animation:none';
  }
  renderFoot();
  if (state() === 'lost') fillSuggestions();

  const controls = runPrompter(p, {
    episodeId: root.dataset.episode!,
    words: JSON.parse(root.dataset.words!),
    lineStarts: JSON.parse(root.dataset.lineStarts!),
    onStatus: (s) => {
      live = s;
      renderFoot();
    },
    onFollow: (s) => applyState(root, s),
  });
  if (controls) {
    jump = controls.jump;
    root.querySelector('[data-foot]')!.addEventListener('click', () => live.kind === 'voice-off' && controls.retry());
    // Show the recorder's clock while a take is running in this browser.
    let timer: number | undefined;
    controls.session.on('rec', (m) => {
      clearInterval(timer);
      const dot = root.querySelector<HTMLElement>('[data-rec-dot]')!;
      if (!m.recording) {
        clock.forEach((c) => (c.textContent = 'Standby'));
        dot.style.background = 'var(--color-faint)';
        dot.style.animation = 'none';
        return;
      }
      dot.style.background = '';
      dot.style.animation = '';
      const tick = () => {
        const s = Math.max(0, Math.floor((Date.now() - m.startedAt) / 1000));
        clock.forEach((c) => (c.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`));
      };
      tick();
      timer = window.setInterval(tick, 1000);
    });
  }

  // Keep the phone awake while it's a prompter (released automatically when hidden).
  const keepAwake = () => navigator.wakeLock?.request('screen').catch(() => {});
  keepAwake();
  document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && keepAwake());
</script>
