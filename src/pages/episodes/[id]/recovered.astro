---
// 5f · Recovered session after a crash
import Base from '@/layouts/Base.astro';
import Dot from '@/components/ui/Dot.astro';
import Button from '@/components/ui/Button.astro';
import { episode, episodePaths } from '@/data/mock';

export const getStaticPaths = episodePaths;

const base = `/episodes/${episode.id}`;
const rows = [
  { k: 'Episode', v: episode.fullTitle, key: 'episode' },
  { k: 'Session', v: '12:48 recovered', ok: true, key: 'take' },
  { k: 'Stopped at', v: '9:04 PM · line 18', key: 'stopped' },
  { k: 'Format', v: '24-bit · 48 kHz · 110.6 MB', key: 'format' },
];
---

<Base title="We saved your session">
  <dialog
    open
    aria-labelledby="recovered-title"
    class="fixed inset-0 z-10 m-auto flex w-[min(540px,calc(100vw-32px))] flex-col gap-5 rounded-2xl border border-edge bg-panel p-7 text-fg"
    id="recovered"
    data-episode={episode.id}
    data-title={episode.fullTitle}
  >
    <h1 id="recovered-title" class="flex items-center gap-2.5 text-[20px] tracking-[-0.02em]">
      <Dot color="var(--color-ok)" size={9} />
      We saved your session
    </h1>
    <p class="text-[14px] leading-[1.6] text-muted" data-summary>
      The tab closed while the session was recording. Audio is saved every 5 seconds, so you lost less than 5 seconds.
    </p>
    <dl class="flex flex-col">
      {
        rows.map((r) => (
          <div class="flex items-center justify-between gap-4 border-b border-line py-3 text-[13px]" data-row={r.key}>
            <dt class="text-muted">{r.k}</dt>
            <dd class="meta flex items-center gap-2">
              {r.ok && <Dot color="var(--color-ok)" />}
              <span>{r.v}</span>
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="flex flex-wrap justify-end gap-2.5">
      <Button href={`${base}/studio`} data-discard>Discard</Button>
      <Button data-download>Download</Button>
      <Button href={`${base}/prompter`} variant="primary" data-keep>Keep and continue from line <span data-line>18</span></Button>
    </div>
  </dialog>
  <div class="fixed inset-0 bg-black/55" aria-hidden="true"></div>
</Base>

<script>
  import { deleteTake, formatBytes, formatDuration, getTake, listTakes, markDone, takeBytes, takeFileName, takeSeconds, takeWav } from '@/lib/audio/takes';
  import { sessionUrl } from '@/lib/flow';
  import { download } from '@/lib/zip';

  const root = document.getElementById('recovered')!;
  const id = new URL(location.href).searchParams.get('take');
  const episodeId = root.dataset.episode!;

  if (id) {
    getTake(id).then(async (take) => {
      if (!take) return;
      // Every speaker track of the session was cut off together.
      const tracks = take.group ? (await listTakes(episodeId)).filter((t) => t.group === take.group) : [take];
      const set = (row: string, k: string | null, v: string) => {
        const el = root.querySelector(`[data-row="${row}"]`)!;
        if (k) el.querySelector('dt')!.textContent = k;
        el.querySelector('dd span:last-child')!.textContent = v;
      };
      const stopped = new Date(take.updatedAt).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
      root.querySelector('[data-summary]')!.textContent =
        `The tab closed while the session was recording${tracks.length > 1 ? ` (${tracks.length} tracks)` : ''}. Audio is saved every 5 seconds, so you lost less than 5 seconds.`;
      set('episode', null, root.dataset.title!);
      set('take', 'Session', `${formatDuration(takeSeconds(take))} recovered`);
      set('stopped', null, `${stopped} · line ${(take.lastLine ?? take.startLine) + 1}`);
      set('format', null, `${take.bitDepth}-bit · ${take.sampleRate / 1000} kHz · ${take.channels === 2 ? 'stereo' : 'mono'} · ${formatBytes(tracks.reduce((n, t) => n + takeBytes(t), 0))}`);
      // Carry on with a new session from the last line voice follow saw.
      const line = take.lastLine ?? take.startLine;
      root.querySelector('[data-line]')!.textContent = String(line + 1);

      root.querySelector<HTMLAnchorElement>('[data-discard]')!.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!confirm('Discard this session? The saved audio will be deleted.')) return;
        for (const t of tracks) await deleteTake(t.id);
        location.href = `/episodes/${episodeId}/studio`;
      });
      root.querySelector('[data-download]')!.addEventListener('click', async () => {
        for (const t of tracks) download(await takeWav(t), takeFileName(t));
      });
      root.querySelector<HTMLAnchorElement>('[data-keep]')!.addEventListener('click', async (e) => {
        e.preventDefault();
        for (const t of tracks) await markDone(t);
        location.href = sessionUrl(episodeId, line);
      });
    });
  }
</script>
