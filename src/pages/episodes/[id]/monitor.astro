---
// 1e · External monitor: a follower screen, optionally mirrored for beam-splitter glass
import Base from '@/layouts/Base.astro';
import Dot from '@/components/ui/Dot.astro';
import { episode, episodePaths, lineStarts, monitorScript, scriptWords } from '@/data/mock';
import { splitWords } from '@/lib/prompter';

export const getStaticPaths = episodePaths;

// The design's demo shows its own narration; live screens show the episode script.
const demoWords = splitWords(monitorScript);
const word =
  'text-(--p-soft,#C9CBCF) transition-colors duration-200 data-[w=now]:text-(--p-now,#fff) data-[w=now]:shadow-[inset_0_-3px_0_var(--color-rec)] data-[w=past]:text-(--p-mon-past,#4A4C51)';
---

<Base title="Monitor" bodyClass="bg-void! overflow-hidden">
  <div
    id="monitor"
    class="relative flex h-dvh flex-col bg-(--p-bg,#000) text-fg"
    data-episode={episode.id}
    data-words={JSON.stringify(scriptWords)}
    data-line-starts={JSON.stringify(lineStarts)}
  >
    <header class="z-[2] flex items-center justify-between px-7 py-4 font-mono text-[12px] text-ghost uppercase">
      <span>MONITOR 2 · <span data-source>FOLLOWING MACBOOK</span> <span data-mirror-label class="ml-2"></span></span>
      <span class="flex items-center gap-2 text-muted">
        <Dot color="var(--color-rec)" size={7} pulse data-rec-dot />
        <span data-rec-label>REC <span data-clock>12:48</span></span>
      </span>
    </header>
    <div class="relative flex-1 overflow-hidden" data-prompter-viewport>
      <div class="absolute inset-x-0 top-[34%] h-px bg-white/8" aria-hidden="true" data-reading-line></div>
      <div class="absolute inset-x-0 top-0 z-[1] h-20 bg-linear-to-b from-(--p-bg,#000) to-transparent" aria-hidden="true"></div>
      <div
        data-prompter-track
        class="flex flex-wrap gap-x-[0.28em] px-[clamp(24px,8vw,90px)] text-[calc(clamp(34px,5.3vw,58px)*var(--p-scale,1))] leading-(--p-lh,1.36) tracking-[-0.02em] transition-transform duration-500 ease-in-out [font-family:var(--p-font,inherit)]"
      >
        {demoWords.map((w) => <span data-word class={word}>{w}</span>)}
      </div>
    </div>
  </div>
  <template id="monitor-word"><span data-word class={word}></span></template>
</Base>

<script>
  import { Prompter, startClock } from '@/lib/prompter';
  import { runPrompter } from '@/lib/prompter-live';
  import { applyPrompterLook, loadSettings, saveSettings } from '@/lib/settings';
  import { loadScript } from '@/lib/script-store';

  const root = document.getElementById('monitor')!;
  const viewport = root.querySelector<HTMLElement>('[data-prompter-viewport]')!;
  const track = root.querySelector<HTMLElement>('[data-prompter-track]')!;
  const label = root.querySelector<HTMLElement>('[data-mirror-label]')!;
  const source = root.querySelector<HTMLElement>('[data-source]')!;
  const clock = [...root.querySelectorAll<HTMLElement>('[data-clock]')];
  const demo = new URL(location.href).searchParams.has('demo');
  const script = loadScript(root.dataset.episode!);

  // Live: replace the design's narration with the episode script.
  if (!demo) {
    const tpl = (document.getElementById('monitor-word') as HTMLTemplateElement).content.firstElementChild!;
    const words = script.words;
    track.replaceChildren(
      ...words.flatMap((w) => {
        const el = tpl.cloneNode() as HTMLElement;
        el.textContent = w;
        return [el, ' '];
      }),
    );
  }

  const applyLook = () => {
    const s = loadSettings().prompter;
    applyPrompterLook(root, s);
    if (!demo) root.querySelector<HTMLElement>('[data-reading-line]')!.style.top = `${s.line}%`;
    return s;
  };
  const look = applyLook();
  const p = new Prompter(viewport, track, { line: demo ? 0.34 : look.line / 100, mirror: look.mirror });
  document.addEventListener('prompter-settings', () => {
    applyLook();
    p.setWord(p.index);
  });

  const showMirror = () => (label.textContent = p.mirror ? '· MIRRORED' : '');
  showMirror();

  const setRec = (on: boolean) => {
    const dot = root.querySelector<HTMLElement>('[data-rec-dot]')!;
    dot.style.background = on ? '' : 'var(--color-faint)';
    dot.style.animation = on ? '' : 'none';
    if (!on) root.querySelector('[data-rec-label]')!.textContent = 'STANDBY';
  };

  if (demo) {
    startClock(clock, 768);
  } else {
    setRec(false);
  }

  const controls = runPrompter(p, {
    episodeId: root.dataset.episode!,
    words: script.words,
    lineStarts: script.lineStarts,
    onStatus: (s) => {
      source.textContent =
        s.kind === 'demo' ? 'FOLLOWING MACBOOK'
        : s.kind === 'following' ? `FOLLOWING ${s.device}`
        : s.kind === 'voice' ? 'VOICE FOLLOW'
        : s.kind === 'manual' ? (s.paused ? 'PAUSED' : `MANUAL · ${s.wpm} WPM`)
        : s.reason;
    },
    onFollow: () => {},
    onKey: (e) => {
      // M toggles mirroring (see Settings → Controls).
      if (e.key.toLowerCase() !== 'm') return;
      p.setMirror(!p.mirror);
      saveSettings('prompter', { mirror: p.mirror });
      showMirror();
    },
  });

  if (!controls) {
    addEventListener('keydown', (e) => {
      if (e.key.toLowerCase() !== 'm' || e.metaKey || e.ctrlKey) return;
      p.setMirror(!p.mirror);
      showMirror();
    });
  } else {
    let timer: number | undefined;
    controls.session.on('rec', (m) => {
      clearInterval(timer);
      setRec(m.recording);
      if (!m.recording) return;
      const recLabel = root.querySelector('[data-rec-label]')!;
      const tick = () => {
        const s = Math.max(0, Math.floor((Date.now() - m.startedAt) / 1000));
        recLabel.textContent = `REC ${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
      };
      tick();
      timer = window.setInterval(tick, 1000);
    });
  }
</script>
