---
// 1c · Studio: the script, the recording format and how it scrolls, then Start.
import EpisodeData from '@/components/app/EpisodeData.astro';
import { episodePage } from '@/lib/episode-page';
import AppShell from '@/layouts/AppShell.astro';
import Segmented from '@/components/ui/Segmented.astro';
import Button from '@/components/ui/Button.astro';
import { episode as mockEpisode, studioScript } from '@/data/mock';
import { mbPerMinute } from '@/lib/audio/format';
import { modeInfo } from '@/lib/show';

export const prerender = false;
const data = episodePage(Astro.params.id);
if (!data) return new Response('No such episode', { status: 404 });
const episode = { ...mockEpisode, ...data.episode };
const inviteRow = 'flex flex-col gap-1.5';

const base = `/episodes/${episode.id}`;
const modeHelp = {
  voice: 'Scrolls as the host speaks. Pauses on ad-libs, re-syncs when a scripted phrase is heard.',
  manual: 'Fixed scroll at 150 wpm. Space to pause, ↑ ↓ to nudge speed.',
};
const menu = [
  { label: 'Edit script', href: `${base}/script` },
  { label: 'Recorded sessions', href: `${base}/sessions` },
];
---

<AppShell title="Studio" crumbs={[{ label: 'Episodes', href: '/' }, { label: episode.fullTitle }]}>
  <EpisodeData data={data} />
  <form
    class="grid lg:h-full lg:grid-cols-[1fr_380px]"
    data-studio
    data-episode={episode.id}
    data-next={`${base}/mic-check`}
    data-mode-help={JSON.stringify(modeHelp)}
  >
    <section class="flex min-h-0 flex-col border-line lg:border-r">
      <div class="flex items-center justify-between border-b border-line px-7 py-3.5 text-[13px] text-muted">
        <div class="flex gap-4.5">
          <a href={`${base}/script`} class="text-fg">Script</a>
          <span>Notes</span>
        </div>
        <div class="meta">{episode.words} words · ~2:45 at 150 wpm</div>
      </div>
      <div class="flex w-full flex-1 flex-col gap-5.5 overflow-auto px-6 py-9 text-[19px] leading-[1.7] text-fg-soft sm:px-18">
        {
          studioScript.map((b) =>
            b.kind === 'section' ? (
              <div class="eyebrow">{b.text}</div>
            ) : (
              <p class:list={[b.kind === 'cue' && 'text-faint']}>
                {b.text}
                {b.kind === 'p' && b.caret && (
                  <span class="ml-px inline-block h-5.5 w-0.5 bg-fg align-[-4px]" aria-hidden="true" />
                )}
              </p>
            ),
          )
        }
      </div>
    </section>

    <aside class="flex flex-col lg:overflow-auto">
      <!-- The show: solo, or one guest (each records on their own device) and maybe a producer -->
      <div class="flex flex-col gap-4 border-b border-line p-5" data-show>
        <h2 class="text-[13px] font-medium">Show</h2>
        <Segmented name="format" label="Format" value="solo" options={[{ value: 'solo', label: 'Solo' }, { value: 'guest', label: 'With a guest' }]} />
        <div class="flex flex-col gap-4" data-guest-only hidden>
          <p class="text-[12px] leading-normal text-muted">
            Talk over Zoom, Teams or any call. Podstudio records each of you on your own device and keeps the script in step.
          </p>
          <div class="flex flex-col gap-[7px]">
            <div class="text-[12px] text-muted">Script</div>
            <div class="flex flex-col gap-1.5" role="radiogroup" aria-label="Script">
              {
                (Object.entries(modeInfo) as [string, (typeof modeInfo)['lines']][]).map(([value, m]) => (
                  <label class="flex cursor-pointer flex-col gap-0.5 rounded-[10px] border border-border px-3 py-2.5 hover:border-handle has-checked:border-handle has-checked:bg-control has-focus-visible:outline-2 has-focus-visible:outline-fg">
                    <input type="radio" name="showMode" value={value} class="sr-only" />
                    <span class="text-[13px]">{m.label}</span>
                    <span class="text-[12px] leading-snug text-muted">{m.short}</span>
                  </label>
                ))
              }
            </div>
            <p class="text-[12px] text-subtle">The guest sees: <span class="text-fg-soft" data-guest-sees></span></p>
          </div>
          <label class="flex items-center justify-between gap-4 text-[13px]">
            <span>Producer<span class="block text-[12px] text-muted">Follows and edits the script, marks retakes, runs the session. Never records.</span></span>
            <input type="checkbox" name="producer" class="size-4 flex-none accent-fg" />
          </label>

          <!-- Invite codes: six digits, entered at /join -->
          <div class="flex flex-col gap-4 rounded-[14px] bg-surface p-5" data-invite>
            <p class="text-[12px] leading-normal text-warn" data-invite-offline hidden>
              Guests and producers connect through the Podstudio server, which isn't running here. For testing, run
              <span class="font-mono">npm run dev</span> or <span class="font-mono">npm run preview</span>.
            </p>
            {
              [
                ['guest', 'Guest code'],
                ['producer', 'Producer code'],
              ].map(([role, label]) => (
                <div class={inviteRow} data-code-row={role} hidden={role === 'producer'}>
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="text-[12px] text-muted">{label}</span>
                    <span class="text-[12px] text-subtle" data-code-status>Not joined</span>
                  </div>
                  <div class="font-mono text-[28px] leading-none tracking-[0.08em]" data-code>— — —</div>
                  <div class="flex flex-wrap gap-x-4 gap-y-1 text-[12px]">
                    <button type="button" class="text-fg underline-offset-2 hover:underline" data-copy-code>Copy link</button>
                    <button type="button" class="text-muted underline-offset-2 hover:text-fg hover:underline" data-new-code>New code</button>
                    <button type="button" class="text-muted underline-offset-2 hover:text-rec hover:underline" data-revoke-code>Revoke</button>
                  </div>
                </div>
              ))
            }
            <p class="text-[12px] text-subtle">They open <span class="font-mono text-fg-soft" data-join-url>/join</span> and type the code.</p>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-4 border-b border-line p-5">
        <h2 class="text-[13px] font-medium">Recording</h2>
        <div class="flex flex-col gap-[7px]">
          <div class="text-[12px] text-muted">Bit depth</div>
          <Segmented name="depth" label="Bit depth" mono value="24" options={[{ value: '16', label: '16-bit' }, { value: '24', label: '24-bit' }]} />
        </div>
        <div class="flex flex-col gap-[7px]">
          <div class="text-[12px] text-muted">Sample rate</div>
          <Segmented name="rate" label="Sample rate" mono value="48" options={[{ value: '44.1', label: '44.1 kHz' }, { value: '48', label: '48 kHz' }]} />
        </div>
        <div class="flex flex-col gap-[7px]">
          <div class="text-[12px] text-muted">Channels</div>
          <Segmented name="channels" label="Channels" value="1" options={[{ value: '1', label: 'Mono' }, { value: '2', label: 'Stereo' }]} />
        </div>
        <div class="meta flex justify-between text-subtle">
          <span>Input: <span data-recorder-mic>—</span></span>
          <span><span data-size>{mbPerMinute(24, 48)}</span> MB/min</span>
        </div>
      </div>

      <div class="flex flex-col gap-3.5 border-b border-line p-5">
        <h2 class="text-[13px] font-medium">Scrolling</h2>
        <Segmented name="mode" label="Scrolling" value="voice" options={[{ value: 'voice', label: 'Voice follow' }, { value: 'manual', label: 'Manual speed' }]} />
        <p class="text-[12px] leading-normal text-muted" data-mode-text>{modeHelp.voice}</p>
      </div>

      <div class="mt-auto flex flex-col gap-2.5 p-5">
        <Button href={`${base}/editor`} data-editor-entry hidden>Open editor</Button>
        <Button type="submit" variant="record" size="xl" class="flex-1 gap-2.5">
          <span class="size-2.5 rounded-full bg-white"></span>
          <span>Start session</span>
        </Button>
        <button
          type="button"
          popovertarget="studio-menu"
          aria-label="More"
          class="flex size-12 flex-none items-center justify-center rounded-[10px] border border-edge text-[18px] text-muted [anchor-name:--studio-more] hover:bg-raised hover:text-fg"
        >
          ⋯
        </button>
        <div
          id="studio-menu"
          popover
          class="m-0 min-w-52 rounded-[10px] border border-edge bg-panel p-1 text-fg shadow-2xl [position-anchor:--studio-more] [position-area:top_span-left] mb-2"
        >
          {
            menu.map((m) => (
              <a href={m.href} class="block rounded-md px-3 py-2 text-[13px] text-fg hover:bg-raised hover:text-fg">
                {m.label}
              </a>
            ))
          }
        </div>
      </div>
    </aside>
  </form>
</AppShell>

<script>
  import { listTakes as recordedTakes } from '@/lib/audio/takes';
  import { serverTakes as recordedServerTakes } from '@/lib/take-upload';
  const editorEntry = document.querySelector<HTMLAnchorElement>('[data-editor-entry]');
  if (editorEntry) {
    const episode = location.pathname.split('/')[2];
    void Promise.all([recordedTakes(episode), recordedServerTakes(episode)]).then(([local, remote]) => { editorEntry.hidden = !local.some((t) => t.status === 'done') && !remote.some((t) => t.done); });
  }

  import { mbPerMinute } from '@/lib/audio/format';
  import { describeInput } from '@/lib/audio/devices';
  import { sessionUrl } from '@/lib/flow';
  import { offerRecovery } from '@/lib/recovery';
  import { loadSettings, saveSettings } from '@/lib/settings';
  import { formatCode, loadShow, modeInfo, saveShow } from '@/lib/show';
  import { waitingRoom } from '@/lib/waiting-room';
  import {
    Room,
    createSession,
    hostMembership,
    newCode,
    revokeCode,
    saveHostMembership,
    serverAvailable,
    sessionInfo,
    type Codes,
    type ScriptMode,
  } from '@/lib/room';

  const form = document.querySelector<HTMLFormElement>('[data-studio]')!;
  const help = JSON.parse(form.dataset.modeHelp!) as Record<string, string>;
  const q = <T extends Element = HTMLElement>(s: string) => form.querySelector<T>(s)!;
  const episodeId = form.dataset.episode!;
  const demo = new URL(location.href).searchParams.has('demo');

  const update = () => {
    const data = new FormData(form);
    q('[data-size]').textContent = mbPerMinute(Number(data.get('depth')), Number(data.get('rate')), Number(data.get('channels') ?? 1));
    q('[data-mode-text]').textContent = help[String(data.get('mode'))];
  };

  // Load the saved choices into the form, then save every change.
  if (!demo) {
    const { recording: r, prompter: p } = loadSettings();
    const pick = (name: string, value: string) => {
      const input = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
      if (input && !input.disabled) input.checked = true;
    };
    pick('depth', String(r.depth));
    pick('rate', String(r.rate));
    pick('channels', String(r.channels));
    pick('mode', p.mode);
    update();

    form.addEventListener('change', () => {
      const data = new FormData(form);
      saveSettings('recording', {
        depth: Number(data.get('depth')) as 16 | 24,
        rate: Number(data.get('rate')) as 44.1 | 48,
        channels: Number(data.get('channels')) as 1 | 2,
      });
      saveSettings('prompter', { mode: data.get('mode') as 'voice' | 'manual' });
      showInput();
    });

    offerRecovery(episodeId);
    // The input that will actually be recorded (and that voice follow listens to).
    const showInput = () => {
      const { deviceId, channels } = loadSettings().recording;
      describeInput(deviceId, channels).then(({ label, missing }) => {
        q('[data-recorder-mic]').textContent = missing ? `${label} (saved mic not connected)` : label;
      });
    };
    showInput();
    form.dataset.next = sessionUrl(episodeId);
    showSetup();
  }

  // ── Show setup and invite codes ─────────────────────────────────────────────
  function showSetup() {
    const show = loadShow(episodeId);
    const setRadio = (name: string, value: string) => {
      const input = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
      if (input) input.checked = true;
    };
    setRadio('format', show.format);
    setRadio('showMode', show.mode);
    q<HTMLInputElement>('[name=producer]').checked = show.producer;
    q('[data-join-url]').textContent = `${location.host}/join`;

    let codes: Codes = { guest: null, producer: null };
    let polling: number | undefined;
    const render = (connected: string[] = []) => {
      const s = loadShow(episodeId);
      const guest = s.format === 'guest';
      q('[data-guest-only]').hidden = !guest;
      q('[data-guest-sees]').textContent = modeInfo[s.mode].guestSees;
      form.querySelectorAll<HTMLElement>('[data-code-row]').forEach((row) => {
        const role = row.dataset.codeRow as 'guest' | 'producer';
        row.hidden = role === 'producer' && !s.producer;
        row.querySelector('[data-code]')!.textContent = formatCode(codes[role]);
        const on = connected.includes(role);
        const status = row.querySelector<HTMLElement>('[data-code-status]')!;
        status.textContent = on ? 'Connected' : codes[role] ? 'Not joined' : 'Revoked';
        status.style.color = on ? 'var(--color-ok)' : '';
      });
    };

    const session = async () => {
      if (!(await serverAvailable())) {
        q('[data-invite-offline]').hidden = false;
        form.querySelectorAll<HTMLElement>('[data-code-row]').forEach((r) => (r.hidden = true));
        return null;
      }
      let m = hostMembership(episodeId);
      if (m) {
        try {
          const info = await sessionInfo(m);
          if (!info.ended) {
            codes = info.codes ?? m.codes;
            render(info.connected);
            return m;
          }
        } catch {
          // The server restarted or forgot the session: make a new one.
        }
      }
      const s = await createSession(episodeId);
      m = { sessionId: s.sessionId, token: s.hostToken, role: 'host', episodeId, codes: s.codes };
      saveHostMembership(episodeId, m);
      codes = s.codes;
      render();
      return m;
    };

    // The waiting room: the host lets people in from here too, before recording.
    let room: Room | null = null;
    const start = async () => {
      render();
      if (loadShow(episodeId).format !== 'guest') return clearInterval(polling);
      const m = await session();
      if (!m) return;
      if (!room || room.m.sessionId !== m.sessionId) {
        room?.close();
        room = new Room(m);
        waitingRoom(room);
        room.connect();
      }
      clearInterval(polling);
      polling = window.setInterval(async () => {
        try {
          const info = await sessionInfo(m);
          codes = info.codes ?? codes;
          render(info.connected);
        } catch {}
      }, 3000);
    };

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'format') saveShow(episodeId, { format: t.value as 'solo' | 'guest' });
      else if (t.name === 'showMode') saveShow(episodeId, { mode: t.value as ScriptMode });
      else if (t.name === 'producer') saveShow(episodeId, { producer: t.checked });
      else return;
      start();
    });

    form.querySelectorAll<HTMLElement>('[data-code-row]').forEach((row) => {
      const role = row.dataset.codeRow as 'guest' | 'producer';
      const copyBtn = row.querySelector<HTMLButtonElement>('[data-copy-code]')!;
      copyBtn.addEventListener('click', async () => {
        if (!codes[role]) return;
        const link = `${location.origin}/join?code=${codes[role]}`;
        try {
          await navigator.clipboard.writeText(link);
          copyBtn.textContent = 'Copied';
        } catch {
          prompt('Copy this link', link);
        }
        setTimeout(() => (copyBtn.textContent = 'Copy link'), 1500);
      });
      row.querySelector('[data-new-code]')!.addEventListener('click', async () => {
        const m = hostMembership(episodeId);
        if (!m) return;
        codes = (await newCode(m, role)).codes;
        saveHostMembership(episodeId, { ...m, codes });
        render();
      });
      row.querySelector('[data-revoke-code]')!.addEventListener('click', async () => {
        const m = hostMembership(episodeId);
        if (!m || !confirm(`Revoke the ${role} code? Anyone who joined with it is signed out.`)) return;
        codes = (await revokeCode(m, role)).codes;
        saveHostMembership(episodeId, { ...m, codes });
        render();
      });
    });
    start();
  }
  form.addEventListener('change', update);
</script>
