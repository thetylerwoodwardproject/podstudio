---
// 8b · After a continuous session: export options
import AppShell from '@/layouts/AppShell.astro';
import Button from '@/components/ui/Button.astro';
import { episode, episodePaths, scriptLines } from '@/data/mock';

export const getStaticPaths = episodePaths;

const pauseModes = [
  { value: 'cut', title: 'Cut', body: 'Remove the paused stretch.' },
  { value: 'keep', title: 'Keep', body: 'Leave it in, marked.' },
  { value: 'split', title: 'Split', body: 'One file per segment between pauses.' },
];
const greenSwitch =
  'relative inline-flex h-5 w-[34px] flex-none items-center rounded-full bg-edge has-checked:bg-ok has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-fg';
---

<AppShell title="Session export" avatar={false} crumbs={[{ label: episode.label, href: `/episodes/${episode.id}/studio` }, { label: 'Export' }]}>
  <form
    class="group/s flex min-h-full flex-col gap-6 px-6 py-8 lg:px-11"
    id="session"
    data-episode={episode.id}
    data-label={`Ep${episode.number}`}
    data-lines={JSON.stringify(scriptLines.map((l) => l.text))}
  >
    <div>
      <h1 class="text-[22px] tracking-[-0.02em]">Session · <span data-length><span data-demo-only>41:07</span></span></h1>
      <p class="mt-1.5 text-[13px] text-muted" data-counts><span data-demo-only>18:42 · 14 retakes · 3 pauses</span></p>
    </div>

    <p class="text-[13px] text-subtle" data-empty hidden>
      No session recorded yet. Start one from the studio.
    </p>

    <section class="flex flex-col gap-2.5">
      <h2 class="eyebrow text-muted!">Always included</h2>
      <div class="flex items-center gap-3.5 rounded-[10px] bg-surface px-4 py-3.5">
        <div class="flex-1">
          <div class="text-[14px]">Raw WAV with markers</div>
          <div class="mt-1 text-[12px] text-muted">
            The whole recording, untouched. Markers are embedded in the file and also saved as Audacity labels and a CSV.
          </div>
        </div>
        <span class="rounded bg-raised px-1.5 py-[3px] font-mono text-[10px] font-medium text-ok">ON</span>
      </div>
    </section>

    <section class="flex flex-col gap-2.5">
      <h2 class="eyebrow text-muted!">Optional</h2>
      <label class="flex items-center gap-3.5 rounded-[10px] border border-line px-4 py-3.5 has-checked:border-fg">
        <div class="flex-1">
          <div class="text-[14px]">Assembled edit</div>
          <div class="mt-1 text-[12px] text-muted">
            Keeps the last attempt of each line and cuts the rest. Saved as a separate file, so the raw WAV stays as it
            is. <span data-removes><span data-demo-only>Removes 6:52.</span></span>
          </div>
        </div>
        <span class={greenSwitch}>
          <input type="checkbox" role="switch" name="assembled" checked class="peer sr-only" aria-label="Assembled edit" />
          <span class="absolute top-0.5 left-0.5 size-4 rounded-full bg-subtle transition-all peer-checked:left-4 peer-checked:bg-white"></span>
        </span>
      </label>
    </section>

    <section class="flex flex-col gap-2.5 transition-opacity group-has-[[name=assembled]:not(:checked)]/s:pointer-events-none group-has-[[name=assembled]:not(:checked)]/s:opacity-40">
      <h2 class="eyebrow text-muted!">Pauses in the assembled edit</h2>
      <div class="grid gap-2.5 sm:grid-cols-3" role="radiogroup" aria-label="Pauses in the assembled edit">
        {
          pauseModes.map((m, i) => (
            <label class="flex flex-col gap-1.5 rounded-[10px] border border-line p-3.5 hover:border-edge has-checked:border-fg has-focus-visible:outline-2 has-focus-visible:outline-fg">
              <input type="radio" name="pauses" value={m.value} checked={i === 0} class="sr-only" />
              <span class="text-[14px]">{m.title}</span>
              <span class="text-[12px] leading-[1.45] text-muted">{m.body}</span>
            </label>
          ))
        }
      </div>
      <p class="text-[12px] text-subtle">While paused, recording keeps running, so the markers stay lined up with the audio.</p>
    </section>

    <section class="flex flex-col gap-2.5" data-ns>
      <h2 class="eyebrow text-muted!">Noise suppression</h2>
      <div class="rounded-[10px] border border-line px-4 py-4">
        <div class="flex items-center gap-4">
          <label for="ns-amount" class="flex-none text-[14px]">Suppression</label>
          <input id="ns-amount" name="ns" type="range" min="0" max="100" step="5" value="0" class="min-w-0 flex-1 accent-fg" data-ns-amount />
          <span class="w-11 flex-none text-right font-mono text-[13px]" data-ns-value>Off</span>
        </div>
        <p class="mt-2 text-[12px] leading-normal text-muted">
          Adaptive, like Waves NS1: it learns the room as it goes and leaves your voice alone. Higher takes away more of
          the background. Used for the assembled edit and the cleaned copy; the raw WAV is never changed.
        </p>
        <div class="mt-3.5 flex flex-wrap items-center gap-2.5">
          <Button type="button" data-ns-preview>Preview 30 s</Button>
          <div class="flex overflow-hidden rounded-[10px] border border-edge text-[13px]" role="group" aria-label="Listen to" data-ns-ab hidden>
            <button type="button" class="px-3.5 py-2 aria-pressed:bg-fg aria-pressed:text-ink" aria-pressed="false" data-ns-play="before">Original</button>
            <button type="button" class="px-3.5 py-2 aria-pressed:bg-fg aria-pressed:text-ink" aria-pressed="false" data-ns-play="after">Cleaned</button>
          </div>
          <!-- Attenuation meter: how far the background came down -->
          <span class="flex items-center gap-2.5" data-ns-meter hidden>
            <span class="relative h-1.5 w-28 overflow-hidden rounded-full bg-line"><span class="absolute inset-y-0 left-0 rounded-full bg-ok" data-ns-meter-fill></span></span>
            <span class="meta text-muted" data-ns-meter-text></span>
          </span>
          <span class="meta text-muted" data-ns-status></span>
        </div>
        <audio data-ns-player hidden></audio>
        <label class="mt-3.5 flex items-center gap-3 text-[13px] has-disabled:opacity-40">
          <span class={greenSwitch}>
            <input type="checkbox" role="switch" name="nsCopy" class="peer sr-only" aria-label="Also a cleaned copy of the whole recording" />
            <span class="absolute top-0.5 left-0.5 size-4 rounded-full bg-subtle transition-all peer-checked:left-4 peer-checked:bg-white"></span>
          </span>
          Also a cleaned copy of the whole recording
        </label>
      </div>
    </section>

    <div class="mt-auto flex flex-wrap items-center justify-end gap-2.5">
      <span class="meta mr-auto text-muted" data-summary></span>
      <Button data-open-markers>Open markers</Button>
      <Button variant="primary" data-export><span data-export-label>Export</span></Button>
    </div>
  </form>

  <dialog
    id="markers-dialog"
    aria-labelledby="markers-title"
    class="m-auto w-[min(560px,calc(100vw-32px))] rounded-2xl border border-edge bg-panel p-0 text-fg backdrop:bg-black/60"
  >
    <div class="flex max-h-[80vh] flex-col gap-4 p-7">
      <div class="flex items-baseline justify-between">
        <h2 id="markers-title" class="text-[20px] tracking-[-0.02em]">Markers</h2>
        <form method="dialog"><button class="text-[13px] text-muted hover:text-fg">Close</button></form>
      </div>
      <div class="flex min-h-0 flex-col overflow-auto" data-marker-rows>
        <div class="grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]"><span class="font-mono text-muted">24:02</span><span><span class="text-warn">Retake</span> · Line 3 · “Four. I counted.”</span></div>
        <div class="grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]"><span class="font-mono text-muted">15:21</span><span><span class="text-warn">Retake</span> · Line 41 · attempt 3</span></div>
        <div class="grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]"><span class="font-mono text-muted">09:14</span><span><span class="text-fg-soft">Pause</span> · 1:26 · before Line 28</span></div>
      </div>
    </div>
  </dialog>
</AppShell>

<script>
  import { assemble, audacityLabels, mapTime, onAudio, type PauseMode, type SessionMarker } from '@/lib/audio/assemble';
  import { markerCounts, markerName } from '@/lib/markers';
  import { formatBytes, getTake, listTakes, rangesWav, takeBytes, takeWav, type TakeMeta } from '@/lib/audio/takes';
  import { denoiseTake, previewTake } from '@/lib/audio/denoise';
  import { loadSettings, saveSettings } from '@/lib/settings';
  import { download, zip, type ZipEntry } from '@/lib/zip';
  import { loadScript } from '@/lib/script-store';

  const form = document.getElementById('session') as HTMLFormElement;
  const dialog = document.getElementById('markers-dialog') as HTMLDialogElement;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => form.querySelector<T>(s)!;
  const demo = new URL(location.href).searchParams.has('demo');

  $('[data-open-markers]').addEventListener('click', () => dialog.showModal());
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

  const clock = (sec: number) => {
    const s = Math.round(sec);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    return `${h ? `${h}:${String(m).padStart(2, '0')}` : m}:${String(s % 60).padStart(2, '0')}`;
  };
  const mmss = (sec: number) => {
    const s = Math.floor(sec);
    return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
  };

  if (!demo) live();

  async function live() {
    const episodeId = form.dataset.episode!;
    const label = form.dataset.label!;
    const lines = loadScript(episodeId).lines.map((l) => l.text);
    const id = new URL(location.href).searchParams.get('take');
    const take: TakeMeta | null =
      (id ? await getTake(id) : null) ??
      (await listTakes(episodeId)).filter((t) => t.kind === 'session' && t.status === 'done').at(-1) ??
      null;

    const exportBtn = $<HTMLButtonElement>('[data-export]');
    if (!take) {
      $('[data-empty]').hidden = false;
      $('[data-length]').textContent = '0:00';
      $('[data-counts]').textContent = 'Nothing recorded yet';
      exportBtn.disabled = true;
      $<HTMLButtonElement>('[data-open-markers]').disabled = true;
      return;
    }

    const tracks = [take];
    const duration = take.samples / take.sampleRate;
    // Recorded on the wall clock; assemble() converts these itself.
    const wallMarkers = take.markers ?? [];
    const lineLog = take.lineLog ?? [];
    // Everything shown or written into files is on the audio (gaps taken out).
    const { markers } = onAudio(wallMarkers, lineLog);
    $('[data-length]').textContent = clock(duration);
    $('[data-counts]').textContent = markerCounts(markers) || 'No markers';

    const words = (line: number) => lines[line]?.split(/\s+/).slice(0, 3).join(' ') ?? '';
    const describe = (m: SessionMarker) =>
      m.kind === 'retake'
        ? `Retake · Line ${m.line + 1} · attempt ${m.attempt ?? 2}`
        : m.kind === 'gap'
          ? `Mic stopped · ${clock(m.lost ?? 0)}`
          : `${markerName[m.kind]} · Line ${m.line + 1}${m.end != null ? ` · ${clock(m.end - m.t)}` : ''}`;

    // Markers dialog, newest first.
    const dialogRows = dialog.querySelector<HTMLElement>('[data-marker-rows]')!;
    dialogRows.replaceChildren(
      ...(markers.length
        ? [...markers].reverse().map((m) => {
            const row = document.createElement('div');
            row.className = 'grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]';
            const time = Object.assign(document.createElement('span'), { className: 'font-mono text-muted', textContent: mmss(m.t) });
            const kind = Object.assign(document.createElement('span'), {
              className: { retake: 'text-warn', pause: 'text-fg-soft', adlib: 'text-adlib', cut: 'text-muted', gap: 'text-rec' }[m.kind],
              textContent: markerName[m.kind],
            });
            const text = document.createElement('span');
            const detail =
              m.kind === 'retake'
                ? m.attempt === 2 ? `Line ${m.line + 1} · “${words(m.line)}”` : `Line ${m.line + 1} · attempt ${m.attempt}`
                : m.kind === 'gap'
                  ? `${clock(m.lost ?? 0)} not recorded · Line ${m.line + 1}`
                  : `${m.end != null ? clock(m.end - m.t) : 'to the end'} · Line ${m.line + 1}`;
            text.append(kind, ` · ${detail}`);
            row.append(time, text);
            return row;
          })
        : [Object.assign(document.createElement('p'), { className: 'py-2.5 text-[13px] text-subtle', textContent: 'No markers in this session.' })]),
    );

    // Noise suppression: one fader, remembered as the default for next time.
    const nsInput = $<HTMLInputElement>('[data-ns-amount]');
    nsInput.value = String(loadSettings().recording.noiseSuppression);
    const nsCopy = $<HTMLInputElement>('[name=nsCopy]');
    const showNs = () => {
      const v = Number(nsInput.value);
      $('[data-ns-value]').textContent = v ? `${v}%` : 'Off';
      nsCopy.disabled = !v;
      $<HTMLButtonElement>('[data-ns-preview]').disabled = !v;
    };
    showNs();
    let preview: { amount: number; before: string; after: string } | null = null;
    const player = $<HTMLAudioElement>('[data-ns-player]');
    nsInput.addEventListener('input', () => {
      showNs();
      if (preview && preview.amount !== Number(nsInput.value)) $('[data-ns-status]').textContent = 'Preview again to hear this setting';
    });
    nsInput.addEventListener('change', () => saveSettings('recording', { noiseSuppression: Number(nsInput.value) }));
    const play = (which: 'before' | 'after') => {
      if (!preview) return;
      const at = player.currentTime;
      player.src = preview[which];
      player.currentTime = at;
      player.play();
      form.querySelectorAll<HTMLElement>('[data-ns-play]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.nsPlay === which)));
    };
    form.querySelectorAll<HTMLElement>('[data-ns-play]').forEach((b) =>
      b.addEventListener('click', () => (b.getAttribute('aria-pressed') === 'true' ? player.pause() : play(b.dataset.nsPlay as 'before' | 'after'))),
    );
    player.addEventListener('pause', () => form.querySelectorAll('[data-ns-play]').forEach((b) => b.setAttribute('aria-pressed', 'false')));
    $('[data-ns-preview]').addEventListener('click', async () => {
      const amount = Number(nsInput.value);
      const btn = $<HTMLButtonElement>('[data-ns-preview]');
      btn.disabled = true;
      $('[data-ns-status]').textContent = preview ? 'Cleaning…' : 'Loading noise suppression (about 19 MB the first time)…';
      try {
        const p = await previewTake(take!, amount, 30);
        if (preview) {
          URL.revokeObjectURL(preview.before);
          URL.revokeObjectURL(preview.after);
        }
        preview = { amount, before: URL.createObjectURL(p.before), after: URL.createObjectURL(p.after) };
        $('[data-ns-ab]').hidden = false;
        $('[data-ns-meter]').hidden = false;
        $('[data-ns-meter-fill]').style.width = `${Math.min(100, (p.reduction / 30) * 100)}%`;
        $('[data-ns-meter-text]').textContent = `Background −${Math.round(p.reduction)} dB`;
        $('[data-ns-status]').textContent = '';
        player.currentTime = 0;
        play('after');
      } catch (err) {
        $('[data-ns-status]').textContent = `Couldn’t clean: ${(err as Error).message}`;
      } finally {
        btn.disabled = false;
      }
    });

    const options = () => {
      const data = new FormData(form);
      const ns = Number(data.get('ns') ?? 0);
      return { assembled: data.has('assembled'), pauses: String(data.get('pauses')) as PauseMode, ns, nsCopy: ns > 0 && data.has('nsCopy') };
    };
    const refresh = () => {
      const o = options();
      const a = assemble(duration, wallMarkers, lineLog, o.pauses);
      $('[data-removes]').textContent = a.removed ? `Removes ${clock(a.removed)}.` : 'Nothing to remove yet.';
      const raw = tracks.reduce((n, t) => n + takeBytes(t), 0);
      const editBytes = tracks.reduce((n, t) => n + (duration - a.removed) * t.sampleRate * (t.bitDepth / 8) * (t.channels ?? 1), 0);
      const files = tracks.length + 2 + (o.assembled ? a.files.length * tracks.length : 0) + (o.nsCopy ? tracks.length : 0);
      $('[data-summary]').textContent = `${files} files · ${formatBytes(raw * (o.nsCopy ? 2 : 1) + (o.assembled ? editBytes : 0))}`;
    };
    form.addEventListener('change', refresh);
    refresh();

    exportBtn.addEventListener('click', async () => {
      const o = options();
      exportBtn.disabled = true;
      $('[data-export-label]').textContent = 'Preparing…';
      try {
        const name = (t: TakeMeta) => `${label}_Session_${t.speaker.charAt(0)}${t.speaker.slice(1).toLowerCase()}`;
        const endLabel: Partial<Record<SessionMarker['kind'], string>> = { adlib: 'Script resumes', cut: 'Cut ends' };
        const cue = (m: SessionMarker, rate: number, at = m.t) => ({ at: Math.round(at * rate), label: describe(m) });
        const entries: ZipEntry[] = [];
        // Raw: untouched, with a cue at every retake and gap, and at both ends of each pause, cut and ad-lib.
        for (const t of tracks) {
          const len = t.samples / t.sampleRate;
          const cues = markers.flatMap((m) =>
            m.kind !== 'retake' && m.end != null
              ? [cue(m, t.sampleRate), { at: Math.round(m.end * t.sampleRate), label: endLabel[m.kind] ?? 'Resume' }]
              : [cue(m, t.sampleRate)],
          );
          entries.push({ name: `${name(t)}.wav`, data: cues.length ? await rangesWav(t, [[0, len]], cues) : await takeWav(t) });
        }
        entries.push({ name: `${label}_Session_markers.txt`, data: audacityLabels(markers, describe) });
        const csv = [
          'time,end,kind,line,attempt,first words',
          ...markers.map((m) =>
            [m.t.toFixed(3), m.end?.toFixed(3) ?? '', m.kind === 'gap' ? `gap ${m.lost?.toFixed(3)}` : m.kind, m.line + 1, m.attempt ?? '', `"${words(m.line).replace(/"/g, '""')}"`].join(','),
          ),
        ].join('\n');
        entries.push({ name: `${label}_Session_markers.csv`, data: csv + '\n' });

        // Noise suppression makes a cleaned copy of the recording (kept for next time); the edit
        // and the optional full copy are cut from it, so markers stay where they are.
        let variant: string | null = null;
        if (o.ns && (o.assembled || o.nsCopy)) {
          const began = Date.now();
          for (const t of tracks) {
            variant = await denoiseTake(t, o.ns, (done) => {
              const left = done > 0.02 ? ((Date.now() - began) / done) * (1 - done) : 0;
              $('[data-export-label]').textContent =
                `Cleaning… ${Math.round(done * 100)}%${left > 60000 ? ` · about ${Math.round(left / 60000)} min left` : ''}`;
            });
          }
          $('[data-export-label]').textContent = 'Preparing…';
        }
        if (o.nsCopy && variant) {
          for (const t of tracks) {
            const len = t.samples / t.sampleRate;
            entries.push({ name: `${name(t)}_clean.wav`, data: await rangesWav(t, [[0, len]], markers.map((m) => cue(m, t.sampleRate)), variant) });
          }
        }

        if (o.assembled) {
          const a = assemble(duration, wallMarkers, lineLog, o.pauses);
          for (const t of tracks) {
            for (const [i, ranges] of a.files.entries()) {
              // Ad-libs stay in the edit, so their cues do too (and kept pauses').
              const kept = markers
                .filter((m) => m.kind === 'adlib' || (m.kind === 'pause' && o.pauses === 'keep'))
                .map((m) => ({ m, at: mapTime(m.t, ranges) }))
                .filter((x): x is { m: SessionMarker; at: number } => x.at != null)
                .map((x) => cue(x.m, t.sampleRate, x.at));
              const file = a.files.length > 1 ? `${name(t)}_edit_part${i + 1}.wav` : `${name(t)}_edit.wav`;
              entries.push({ name: file, data: await rangesWav(t, ranges, kept, variant ?? undefined) });
            }
          }
        }
        download(await zip(entries), `${label}_Session.zip`);
      } catch (err) {
        alert((err as Error).message);
      } finally {
        exportBtn.disabled = false;
        $('[data-export-label]').textContent = 'Export';
      }
    });
  }
</script>
