---
// 8b · After a continuous session: export, as a step flow (components/app/ExportFlow.svelte)
import EpisodeData from '@/components/app/EpisodeData.astro';
import { episodePage } from '@/lib/episode-page';
import AppShell from '@/layouts/AppShell.astro';
import { episode as mockEpisode, scriptLines } from '@/data/mock';

export const prerender = false;
const data = episodePage(Astro.params.id);
if (!data) return new Response('No such episode', { status: 404 });
const episode = { ...mockEpisode, ...data.episode };
---

<AppShell title="Session export" avatar={false} crumbs={[{ label: episode.label, href: `/episodes/${episode.id}/studio` }, { label: 'Export' }]}>
  <span slot="topbar" class="font-mono text-[13px] text-text-2" data-length></span>
  <EpisodeData data={data} />
  <div
    class="h-full"
    id="session"
    data-episode={episode.id}
    data-label={`Ep${episode.number}`}
    data-title={episode.label}
    data-lines={JSON.stringify(scriptLines.map((l) => l.text))}
  >
    <div class="mx-auto flex max-w-[760px] flex-col gap-1.5 px-5 pt-7" data-empty hidden>
      <h1 class="page-title">Export</h1>
      <p class="text-[14px] text-text-2">No session recorded yet. Start one from the studio.</p>
    </div>
    <div class="h-full" data-flow-mount></div>
  </div>

  <dialog
    id="markers-dialog"
    aria-labelledby="markers-title"
    class="m-auto w-[min(560px,calc(100vw-32px))] rounded-[14px] border border-edge bg-panel p-0 text-fg backdrop:bg-black/60"
  >
    <div class="flex max-h-[80vh] flex-col gap-4 p-7">
      <div class="flex items-baseline justify-between">
        <h2 id="markers-title" class="text-[20px] tracking-[-0.02em]">Markers</h2>
        <form method="dialog"><button class="text-[13px] text-muted hover:text-fg">Close</button></form>
      </div>
      <div class="flex min-h-0 flex-col overflow-auto" data-marker-rows>
        <div class="grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]"><span class="font-mono text-muted">24:02</span><span><span class="text-warn">Retake</span> · Line 3 · “Four. I counted.”</span></div>
        <div class="grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]"><span class="font-mono text-muted">15:21</span><span><span class="text-warn">Retake</span> · Line 41 · attempt 3</span></div>
        <div class="grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]"><span class="font-mono text-muted">09:14</span><span><span class="text-fg-soft">Pause</span> · 1:26 · before Line 28</span></div>
      </div>
    </div>
  </dialog>
</AppShell>

<script>
  import { assemble, audacityLabels, mapTime, mutes, onAudio, type SessionMarker } from '@/lib/audio/assemble';
  import { markerCounts, markerName, padLabel } from '@/lib/markers';
  import { hasPads, renderPads, renderRoughMix, stereoOf } from '@/lib/audio/pads-export';
  import { bextFor, formatBytes, getTake, listTakes, rangesWav, readFrames, takeBytes, takeWav, tonedWav, trackStart, type TakeMeta } from '@/lib/audio/takes';
  import { lineUp } from '@/lib/audio/line-up';
  import { timecode } from '@/lib/audio/sync';
  import { renderMaster, TARGETS, type MasterTrack } from '@/lib/audio/master';
  import { encodeMp3 } from '@/lib/audio/mp3';
  import { VariantWriter } from '@/lib/audio/takes';
  import type { PlacedTone, ToneKind } from '@/lib/audio/tones';
  import { denoiseSamples, denoiseTake } from '@/lib/audio/denoise';
  import { noiseFloor } from '@/lib/audio/denoise-core';
  import { loadSettings, saveSettings } from '@/lib/settings';
  import { cleanTone, toneActive, toneSummary } from '@/lib/audio/tone';
  import { longTermSpectrum } from '@/lib/audio/spectrum';
  import { ChainPreview, type ChainTrack } from '@/lib/audio/chain-preview';
  import { download, zip, type ZipEntry } from '@/lib/zip';
  import { loadScript } from '@/lib/script-store';
  import type { ExportSettings, FlowState, Measured } from '@/components/app/ExportFlow.svelte';

  const root = document.getElementById('session')!;
  const dialog = document.getElementById('markers-dialog') as HTMLDialogElement;
  const lengthEl = document.querySelector<HTMLElement>('[data-length]')!;
  const demo = new URL(location.href).searchParams.has('demo');
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

  const clock = (sec: number) => {
    const s = Math.round(sec);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    return `${h ? `${h}:${String(m).padStart(2, '0')}` : m}:${String(s % 60).padStart(2, '0')}`;
  };
  const mmss = (sec: number) => {
    const s = Math.floor(sec);
    return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
  };
  const cap = (n: string) => `${n.charAt(0)}${n.slice(1).toLowerCase()}`;
  const kindNames: Record<ToneKind, string> = { retake: 'retake', cut: 'cough', adlib: 'ad-lib', pause: 'pause', gap: 'mic stop' };

  // The flow (and Svelte) load just after the page, so the page itself opens fast.
  async function mountFlow(props: Record<string, unknown>) {
    const [{ mount }, { default: ExportFlow }] = await Promise.all([import('svelte'), import('@/components/app/ExportFlow.svelte')]);
    mount(ExportFlow, { target: root.querySelector('[data-flow-mount]')!, props: props as never });
  }

  if (demo) showDemo();
  else live();

  /** The design's example, for reviewing the screen (?demo): nothing plays or exports. */
  function showDemo() {
    lengthEl.textContent = '41:07';
    const settings: ExportSettings = { assembled: true, tones: false, pauses: 'cut', mix: false, ns: 0, voices: { TYLER: cleanTone(undefined) }, loudness: 'mono', level: false, episode: true, mp3: true };
    mountFlow({
      initial: { settings, step: 0, reached: 0 },
      info: { counts: '14 retakes · 3 pauses', tonesAvailable: true, toneKinds: 'retake', pads: null, sync: '', guestMissing: null, meter: true, demo: true },
      voices: [{ key: 'TYLER', name: 'Tyler', role: 'Host', color: 'var(--color-spk-yellow)' }],
      rate: 48000,
      removes: () => 'Removes 6:52.',
      files: (s: ExportSettings) => {
        const count = 3 + (s.assembled ? 1 : 0) + (s.ns ? 2 : 0) + (s.episode ? 1 : 0) + (s.episode && s.mp3 ? 1 : 0);
        return { count, text: `${count} files · 1.4 GB` };
      },
      spectrum: async () => [],
      floor: async () => -47,
      chain: () => {
        throw new Error('Nothing to play in the demo');
      },
      onchange: () => {},
      onexport: async () => null,
      onmarkers: () => dialog.showModal(),
    });
  }

  async function live() {
    const episodeId = root.dataset.episode!;
    const label = root.dataset.label!;
    const lines = loadScript(episodeId).lines.map((l) => l.text);
    const id = new URL(location.href).searchParams.get('take');
    const take: TakeMeta | null =
      (id ? await getTake(id) : null) ??
      (await listTakes(episodeId)).filter((t) => t.kind === 'session' && t.status === 'done').at(-1) ??
      null;

    if (!take) {
      root.querySelector<HTMLElement>('[data-empty]')!.hidden = false;
      lengthEl.textContent = '0:00';
      return;
    }

    // Every track in the session: yours, and the guest's (recorded on their device).
    const all = await listTakes(episodeId);
    const tracks = [take, ...all.filter((t) => t.id !== take.id && t.group && t.group === take.group && t.status === 'done')];
    // A guest recorded in this session but their track isn't here: the export waits until it is.
    const guestMissing = take.guest && tracks.length === 1 ? { name: take.guest.name, href: `/episodes/${episodeId}/wrap?take=${encodeURIComponent(take.id)}` } : null;
    const duration = take.samples / take.sampleRate;
    // A track from another device on the host's timeline: with sync points, drift and gaps
    // are corrected (lib/audio/sync.ts); older tracks are lined up by their start only.
    const hostStart = trackStart(take);
    const lu = lineUp(take);
    const aligned = (t: TakeMeta, ranges: [number, number][]) => lu.ranges(t, ranges);
    // Timecode: every file carries where it starts on the session clock, so editors line them up.
    const tc = (t: TakeMeta, at = 0) => bextFor(t, hostStart + at * 1000);
    /** What was done to line each track up, for the page and the zip. */
    const syncLines = () => tracks.filter((t) => t !== take).map((t) => `${cap(t.speaker)}: ${lu.describe(t)}.`);
    const syncReport = () =>
      [
        `Timecode (session clock, ${Intl.DateTimeFormat().resolvedOptions().timeZone}): ${timecode(hostStart)} at the start of every full-length file.`,
        'Edits start at the timecode of their first kept moment, the same on every track.',
        ...syncLines(),
        '',
      ].join('\n');
    // Recorded on the wall clock; assemble() converts these itself.
    const wallMarkers = take.markers ?? [];
    const lineLog = take.lineLog ?? [];
    // Everything shown or written into files is on the audio (gaps taken out).
    const { markers } = onAudio(wallMarkers, lineLog);
    lengthEl.textContent = clock(duration);
    const withPads = hasPads(take);
    const padsText = withPads
      ? `Your hotkey pads as their own stereo WAV, same length and clock as your mic, ducked as you heard them. ${take.pads!.presses.length} press${take.pads!.presses.length === 1 ? '' : 'es'}, each a marker named like “${padLabel(markers.find((m) => m.kind === 'pad')!)}”.`
      : null;

    const guestTrack = tracks.find((t) => t !== take);
    const whoName = (m: SessionMarker) => (m.who === 'guest' ? (guestTrack ? cap(guestTrack.speaker) : take.guest?.name ?? 'Guest') : cap(take.speaker));
    /** Each person's coughs, muted in their own edit (seconds of their own track). */
    const mutedFor = (t: TakeMeta): [number, number][] => lu.own(t, mutes(wallMarkers, t === take ? 'host' : 'guest', duration));
    const words = (line: number) => lines[line]?.split(/\s+/).slice(0, 3).join(' ') ?? '';
    const describe = (m: SessionMarker) =>
      m.kind === 'pad'
        ? padLabel(m)
        : m.kind === 'retake'
        ? `Retake · Line ${m.line + 1} · attempt ${m.attempt ?? 2}`
        : m.kind === 'gap'
          ? `Mic stopped · ${clock(m.lost ?? 0)}`
          : `${markerName[m.kind]}${m.kind === 'cut' ? ` · ${whoName(m)}` : ''} · Line ${m.line + 1}${m.end != null ? ` · ${clock(m.end - m.t)}` : ''}`;

    // Markers dialog, newest first.
    const dialogRows = dialog.querySelector<HTMLElement>('[data-marker-rows]')!;
    dialogRows.replaceChildren(
      ...(markers.length
        ? [...markers].reverse().map((m) => {
            const row = document.createElement('div');
            row.className = 'grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]';
            const time = Object.assign(document.createElement('span'), { className: 'font-mono text-muted', textContent: mmss(m.t) });
            const kind = Object.assign(document.createElement('span'), {
              className: { retake: 'text-warn', pause: 'text-fg-soft', adlib: 'text-adlib', cut: 'text-muted', gap: 'text-rec', pad: '' }[m.kind],
              textContent: m.kind === 'pad' ? padLabel(m) : markerName[m.kind],
            });
            if (m.kind === 'pad' && m.pad) kind.style.color = `var(--color-spk-${m.pad.color})`;
            const text = document.createElement('span');
            const detail =
              m.kind === 'pad'
                ? `${m.end != null ? clock(m.end - m.t) : 'to the end'}`
                : m.kind === 'retake'
                ? m.attempt === 2 ? `Line ${m.line + 1} · “${words(m.line)}”` : `Line ${m.line + 1} · attempt ${m.attempt}`
                : m.kind === 'gap'
                  ? `${clock(m.lost ?? 0)} not recorded · Line ${m.line + 1}`
                  : `${m.kind === 'cut' ? `${whoName(m)} · ` : ''}${m.end != null ? clock(m.end - m.t) : 'to the end'} · Line ${m.line + 1}`;
            text.append(kind, ` · ${detail}`);
            row.append(time, text);
            return row;
          })
        : [Object.assign(document.createElement('p'), { className: 'py-2.5 text-[13px] text-subtle', textContent: 'No markers in this session.' })]),
    );


    // Marker tones: which kinds, from settings.
    const rec = loadSettings().recording;
    const toneSettings = rec.tones;
    const toneKinds = (Object.keys(toneSettings.kinds) as ToneKind[]).filter((k) => toneSettings.kinds[k]);
    const placed = (t: TakeMeta): PlacedTone[] =>
      markers.filter((m) => toneKinds.includes(m.kind as ToneKind) && !(m.kind === 'cut' && m.who === 'guest')).map((m) => ({ at: Math.round(m.t * t.sampleRate), kind: m.kind as ToneKind }));

    // Tone: each person's EQ and compressor, remembered by name (Settings → Recording → Tone).
    const voiceKeys = new Map<TakeMeta, string>();
    for (const t of tracks) {
      let k = t.speaker || (t === take ? 'HOST' : 'GUEST');
      while ([...voiceKeys.values()].includes(k)) k += '+';
      voiceKeys.set(t, k);
    }
    const voiceKey = (t: TakeMeta) => voiceKeys.get(t)!;

    /** The export's settings as the zip code reads them. */
    const optionsOf = (s: ExportSettings) => ({
      assembled: s.assembled,
      pauses: s.pauses,
      ns: s.ns,
      tones: s.tones && toneKinds.length > 0,
      mix: withPads && s.mix,
      pub: { mix: s.episode, loudness: s.loudness, level: s.level, mp3: s.episode && s.mp3 },
    });
    type Options = ReturnType<typeof optionsOf>;
    /** A processed copy of someone's edit: levelled (and toned), or toned only. */
    const copyOf = (o: Options, tones: ExportSettings['voices'], t: TakeMeta) => (o.pub.level ? 'levelled' : toneActive(tones[voiceKey(t)]) ? 'toned' : null);
    // The ranges each episode file (and levelled copy) is made from: the edit's, or the whole session.
    const pubParts = (o: Options) => (o.assembled ? assemble(duration, wallMarkers, lineLog, o.pauses).files : [[[0, duration]] as [number, number][]]);

    /** How many files the zip will have, and roughly how big it is. */
    const files = (s: ExportSettings) => {
      const o = optionsOf(s);
      const a = assemble(duration, wallMarkers, lineLog, o.pauses);
      const raw = tracks.reduce((n, t) => n + takeBytes(t), 0);
      const editBytes = tracks.reduce((n, t) => n + (duration - a.removed) * t.sampleRate * (t.bitDepth / 8) * (t.channels ?? 1), 0);
      // Noise suppression on: every audio file comes twice, unprocessed and cleaned.
      const copies = o.ns ? 2 : 1;
      const padTracks = withPads ? 1 : 0;
      // The episode: a file per part (and its MP3), and a levelled or toned copy of each person's edit.
      const parts = o.pub.mix ? pubParts(o).length : 0;
      const pubLen = o.assembled ? duration - a.removed : duration;
      const pubCh = o.pub.loudness === 'mono' ? 1 : 2;
      const withCopy = o.pub.mix ? tracks.filter((t) => copyOf(o, s.voices, t)) : [];
      const pubFiles = parts * (1 + (o.pub.mp3 ? 1 : 0)) + parts * withCopy.length;
      const pubBytes = o.pub.mix
        ? pubLen * take.sampleRate * (take.bitDepth / 8) * pubCh +
          (o.pub.mp3 ? (pubLen * (pubCh === 2 ? 192 : 128) * 1000) / 8 : 0) +
          withCopy.reduce((n, t) => n + pubLen * t.sampleRate * (t.bitDepth / 8) * (t.channels ?? 1), 0)
        : 0;
      const count =
        (tracks.length + (o.assembled ? a.files.length * tracks.length : 0)) * copies + 3 + padTracks * (1 + (o.assembled ? a.files.length : 0)) + (o.mix ? 1 : 0) + (take.voiceLog?.length ? 1 : 0) + pubFiles;
      const padBytes = withPads ? duration * take.sampleRate * (take.bitDepth / 8) * 2 * (1 + (o.assembled ? 1 : 0) + (o.mix ? 1 : 0)) : 0;
      return { count, text: `${count} files · ${formatBytes((raw + (o.assembled ? editBytes : 0)) * copies + padBytes + pubBytes)}` };
    };

    // The preview's 30 s: from about a third of the way into the edit (or the session), for each edit setting.
    let padsReady = false;
    const chains = new Map<string, ChainPreview>();
    const chain = (s: ExportSettings) => {
      const key = `${s.assembled}|${s.pauses}`;
      if (!chains.has(key)) chains.set(key, new ChainPreview(() => stretch(optionsOf(s)), take.sampleRate, denoiseSamples));
      return chains.get(key)!;
    };
    async function stretch(o: Options): Promise<ChainTrack[]> {
      const ranges = pubParts(o)[0];
      const total = ranges.reduce((n, [a, b]) => n + b - a, 0);
      const len = Math.min(30, total);
      const s0 = total > 40 ? Math.min(total - 30, total * 0.3) : 0;
      // That stretch of the edit, as ranges of the session
      const sub: [number, number][] = [];
      let pos = 0;
      for (const [a, b] of ranges) {
        const from = Math.max(a, a + (s0 - pos));
        const to = Math.min(b, a + (s0 + len - pos));
        if (to > from) sub.push([from, to]);
        pos += b - a;
      }
      // Raw: the session from the same moment, uncut
      const r0 = Math.max(0, Math.min(duration - len, sub[0]?.[0] ?? 0));
      const raw: [number, number][] = [[r0, r0 + len]];
      const out: ChainTrack[] = [];
      for (const t of tracks)
        out.push({
          key: voiceKey(t),
          raw: await rangesWav(t, aligned(t, raw), [], undefined, [], null),
          edit: await rangesWav(t, aligned(t, sub), [], undefined, mutedFor(t), null),
        });
      if (withPads) {
        if (!padsReady) await renderPads(take!);
        padsReady = true;
        out.push({ key: null, raw: await rangesWav(stereoOf(take!), raw, [], 'pads', [], null), edit: await rangesWav(stereoOf(take!), sub, [], 'pads', [], null) });
      }
      return out;
    }

    /** The room's noise floor: the loudest of each person's, from three 20 s stretches of their take. */
    async function floor() {
      let worst = -Infinity;
      for (const t of tracks) {
        const ch = t.channels ?? 1;
        const n = Math.min(t.samples, 20 * t.sampleRate);
        const parts: Float32Array[] = [];
        for (const at of [0.15, 0.5, 0.85]) {
          const x = await readFrames(t, Math.max(0, Math.min(t.samples - n, Math.round(t.samples * at))), n);
          parts.push(ch === 1 ? x : x.filter((_, i) => i % ch === 0));
        }
        const joined = new Float32Array(parts.reduce((k, p) => k + p.length, 0));
        let o = 0;
        for (const p of parts) (joined.set(p, o), (o += p.length));
        worst = Math.max(worst, noiseFloor(joined, t.sampleRate));
      }
      return worst;
    }

    // Settings for this take, kept for the browser tab so Back and a reload never lose them; the defaults come from Settings.
    const storeKey = `podstudio:export:${take.id}`;
    const defaults: ExportSettings = {
      assembled: true,
      tones: toneSettings.inExports && toneKinds.length > 0,
      pauses: 'cut',
      mix: false,
      ns: rec.noiseSuppression,
      voices: Object.fromEntries(tracks.map((t) => [voiceKey(t), cleanTone(rec.publish.voices[voiceKey(t)])])),
      loudness: rec.publish.loudness,
      level: rec.publish.level,
      episode: rec.publish.mix,
      mp3: rec.publish.mp3,
    };
    let initial: FlowState = { settings: defaults, step: 0, reached: 0 };
    try {
      const saved = JSON.parse(sessionStorage.getItem(storeKey) ?? 'null') as FlowState | null;
      if (saved?.settings)
        initial = {
          step: Number(saved.step) || 0,
          reached: Number(saved.reached) || 0,
          settings: { ...defaults, ...saved.settings, voices: Object.fromEntries(Object.keys(defaults.voices).map((k) => [k, cleanTone(saved.settings.voices?.[k] ?? defaults.voices[k])])) },
        };
    } catch {
      // Nothing saved, or storage is off: start from the defaults.
    }
    // The noise amount and each voice's tone are remembered for next time too.
    let lastNs = initial.settings.ns;
    let lastVoices = JSON.stringify(initial.settings.voices);
    let saveTimer = 0;
    const onchange = (state: FlowState) => {
      try {
        sessionStorage.setItem(storeKey, JSON.stringify(state));
      } catch {
        // Storage full or off: the flow still works, it just won't survive a reload.
      }
      const s = state.settings;
      if (s.ns !== lastNs) saveSettings('recording', { noiseSuppression: (lastNs = s.ns) });
      const v = JSON.stringify(s.voices);
      if (v !== lastVoices) {
        lastVoices = v;
        clearTimeout(saveTimer);
        saveTimer = window.setTimeout(() => {
          const p = loadSettings().recording.publish;
          saveSettings('recording', { publish: { ...p, voices: { ...p.voices, ...s.voices } } });
        }, 300);
      }
    };

    const exportZip = async (s: ExportSettings, progress: (text: string) => void): Promise<Measured | null> => {
      const o = optionsOf(s);
      const tones = s.voices;
      {
        const name = (t: TakeMeta) => `${label}_Session_${t.speaker.charAt(0)}${t.speaker.slice(1).toLowerCase()}`;
        const endLabel: Partial<Record<SessionMarker['kind'], string>> = { adlib: 'Script resumes', cut: 'Cough ends' };
        const cue = (m: SessionMarker, rate: number, at = m.t) => ({ at: Math.round(at * rate), label: describe(m) });
        const entries: ZipEntry[] = [];
        // Raw: untouched, with a cue at every retake and gap, and at both ends of each pause, cut and ad-lib.
        for (const t of tracks) {
          const len = t.samples / t.sampleRate;
          const cues = markers.flatMap((m) =>
            m.kind !== 'retake' && m.end != null
              ? [cue(m, t.sampleRate), { at: Math.round(m.end * t.sampleRate), label: endLabel[m.kind] ?? 'Resume' }]
              : [cue(m, t.sampleRate)],
          );
          entries.push({
            name: `${name(t)}.wav`,
            data:
              t !== take
                ? await rangesWav(t, aligned(t, [[0, duration]]), cues, undefined, [], tc(t)) // lined up with yours, same length
                : o.tones
                  ? await tonedWav(t, placed(t), toneSettings, cues, undefined, tc(t))
                  : cues.length
                    ? await rangesWav(t, [[0, len]], cues, undefined, [], tc(t))
                    : await takeWav(t, undefined, tc(t)),
          });
        }
        // The Pads track: rebuilt from the press log on your mic's clock, and the optional rough mix.
        if (withPads) {
          await renderPads(take, (d) => progress(`Pads track… ${Math.round(d * 100)}%`));
          const cues = markers.filter((m) => m.kind === 'pad').map((m) => cue(m, take.sampleRate));
          entries.push({ name: `${label}_Session_Pads.wav`, data: await rangesWav(stereoOf(take), [[0, duration]], cues, 'pads', [], tc(take)) });
          if (o.mix) {
            await renderRoughMix(take, (d) => progress(`Rough mix… ${Math.round(d * 100)}%`));
            entries.push({ name: `${label}_Session_RoughMix.wav`, data: await rangesWav(stereoOf(take), [[0, duration]], cues, 'mix', [], tc(take)) });
          }
          progress('Preparing…');
        }
        entries.push({ name: `${label}_Session_markers.txt`, data: audacityLabels(markers, describe) });
        const csv = [
          'time,end,kind,line,attempt,first words or pad',
          ...markers.map((m) =>
            [
              m.t.toFixed(3),
              m.end?.toFixed(3) ?? '',
              m.kind === 'gap' ? `gap ${m.lost?.toFixed(3)}` : m.kind,
              m.line + 1,
              m.attempt ?? '',
              `"${(m.kind === 'pad' ? padLabel(m) : m.kind === 'cut' ? `Cough (muted) · ${whoName(m)}` : words(m.line)).replace(/"/g, '""')}"`,
            ].join(','),
          ),
        ].join('\n');
        entries.push({ name: `${label}_Session_markers.csv`, data: csv + '\n' });
        // What voice follow did during the session, for tracking down a dropout.
        if (take.voiceLog?.length) {
          const log = take.voiceLog.map((v) => `${clock(v.t)}\t${v.at}\t${v.event}${v.detail ? `\t${v.detail}` : ''}`).join('\n');
          entries.push({ name: `${label}_Session_voice-log.txt`, data: `session time\twall clock\tevent\tdetail\n${log}\n` });
        }

        // Noise suppression makes a cleaned copy of the recording (kept for next time). The zip
        // gets both versions: the unprocessed files, and _clean copies cut the same way from the
        // cleaned audio, so markers line up in both.
        let variant: string | null = null;
        if (o.ns) {
          const began = Date.now();
          for (const t of tracks) {
            variant = await denoiseTake(t, o.ns, (done) => {
              const left = done > 0.02 ? ((Date.now() - began) / done) * (1 - done) : 0;
              progress(`Cleaning… ${Math.round(done * 100)}%${left > 60000 ? ` · about ${Math.round(left / 60000)} min left` : ''}`);
            });
          }
          progress('Preparing…');
        }
        if (variant) {
          for (const t of tracks) {
            const len = t.samples / t.sampleRate;
            const cues = markers.map((m) => cue(m, t.sampleRate));
            entries.push({
              name: `${name(t)}_clean.wav`,
              data:
                t !== take
                  ? await rangesWav(t, aligned(t, [[0, duration]]), cues, variant, [], tc(t))
                  : o.tones
                    ? await tonedWav(t, placed(t), toneSettings, cues, variant, tc(t))
                    : await rangesWav(t, [[0, len]], cues, variant, [], tc(t)),
            });
          }
        }

        if (o.assembled) {
          const a = assemble(duration, wallMarkers, lineLog, o.pauses);
          for (const t of tracks) {
            for (const [i, ranges] of a.files.entries()) {
              // Ad-libs stay in the edit, so their cues do too (and kept pauses').
              const kept = markers
                .filter((m) => m.kind === 'adlib' || m.kind === 'cut' || m.kind === 'pad' || (m.kind === 'pause' && o.pauses === 'keep'))
                .map((m) => ({ m, at: mapTime(m.t, ranges) }))
                .filter((x): x is { m: SessionMarker; at: number } => x.at != null)
                .map((x) => cue(x.m, t.sampleRate, x.at));
              const file = a.files.length > 1 ? `${name(t)}_edit_part${i + 1}` : `${name(t)}_edit`;
              // Their own coughs are muted; nothing is cut for a cough, so every edit keeps the same length.
              // Every track's edit starts at the same moment, so they share a timecode.
              const at = tc(t, ranges[0]?.[0] ?? 0);
              entries.push({ name: `${file}.wav`, data: await rangesWav(t, aligned(t, ranges), kept, undefined, mutedFor(t), at) });
              if (variant) entries.push({ name: `${file}_clean.wav`, data: await rangesWav(t, aligned(t, ranges), kept, variant, mutedFor(t), at) });
            }
          }
          // The Pads edit: the same cuts as the mic edit; a cough never mutes the pads.
          if (withPads) {
            for (const [i, ranges] of a.files.entries()) {
              const kept = markers
                .filter((m) => m.kind === 'pad')
                .map((m) => ({ m, at: mapTime(m.t, ranges) }))
                .filter((x): x is { m: SessionMarker; at: number } => x.at != null)
                .map((x) => cue(x.m, take.sampleRate, x.at));
              const file = a.files.length > 1 ? `${label}_Session_Pads_edit_part${i + 1}` : `${label}_Session_Pads_edit`;
              entries.push({ name: `${file}.wav`, data: await rangesWav(stereoOf(take), ranges, kept, 'pads', [], tc(take, ranges[0]?.[0] ?? 0)) });
            }
          }
        }

        // Ready to publish: everyone mixed at the loudness target, peaks under −1 dBTP.
        const pubLines: string[] = [];
        const results: { r: Awaited<ReturnType<typeof renderMaster>>; seconds: number; parts: number }[] = [];
        if (o.pub.mix) {
          const target = o.pub.loudness === 'off' ? null : TARGETS[o.pub.loudness];
          const outCh: 1 | 2 = o.pub.loudness === 'mono' ? 1 : 2;
          const master = { ...take, channels: outCh };
          const parts = pubParts(o);
          const title = root.dataset.title ?? label;
          for (const [i, ranges] of parts.entries()) {
            const suffix = parts.length > 1 ? `_part${i + 1}` : '';
            const at = ranges[0]?.[0] ?? 0;
            const writers: VariantWriter[] = [];
            const inputs: MasterTrack[] = [];
            for (const t of tracks) {
              const wav = await rangesWav(t, aligned(t, ranges), [], variant ?? undefined, mutedFor(t), null);
              const tone = tones[voiceKey(t)];
              const input: MasterTrack = { wav, level: true, tone: toneActive(tone) ? tone : undefined };
              if (copyOf(o, tones, t)) {
                const w = await VariantWriter.open(t, `level-${i + 1}`);
                writers.push(w);
                input.levelled = (x) => w.write(x);
              }
              inputs.push(input);
            }
            if (withPads) inputs.push({ wav: await rangesWav(stereoOf(take), ranges, [], 'pads', [], null), level: false });
            const out = await VariantWriter.open(master, `master-${i + 1}`);
            const r = await renderMaster(inputs, { rate: take.sampleRate, channels: outCh, lufs: target?.lufs ?? null, levelling: o.pub.level }, (x) => out.write(x), (stage, d) => {
              progress(`${stage === 'level' ? (o.pub.level ? 'Levelling' : 'Measuring loudness') : 'Mastering'}${parts.length > 1 ? ` part ${i + 1}` : ''}… ${Math.round(d * 100)}%`);
            });
            await out.done();
            for (const w of writers) await w.done();
            const episodeWav = await takeWav(master, `master-${i + 1}`, tc(take, at));
            entries.push({ name: `${label}_Episode${suffix}.wav`, data: episodeWav });
            if (o.pub.mp3)
              entries.push({
                name: `${label}_Episode${suffix}.mp3`,
                data: await encodeMp3(episodeWav, `${title}${suffix ? ` (part ${i + 1})` : ''}`, (d) => progress(`MP3${suffix ? ` part ${i + 1}` : ''}… ${Math.round(d * 100)}%`)),
              });
            for (const t of tracks) {
              const copy = copyOf(o, tones, t);
              if (!copy) continue;
              const file = o.assembled ? `${name(t)}_edit${parts.length > 1 ? `_part${i + 1}` : ''}_${copy}` : `${name(t)}_${copy}`;
              entries.push({ name: `${file}.wav`, data: await takeWav(t, `level-${i + 1}`, tc(t, at)) });
            }
            const f = (x: number) => (Number.isFinite(x) ? x.toFixed(1).replace('-', '−') : '—');
            pubLines.push(
              `Episode${suffix ? ` part ${i + 1}` : ''}: ${target ? `${f(r.result)} LUFS integrated (${f(r.measured)} before, gain ${r.gain >= 0 ? '+' : '−'}${Math.abs(r.gain).toFixed(1)} dB)` : `loudness unchanged (${f(r.measured)} LUFS)`}, ${outCh === 2 ? 'stereo' : 'mono'}, true peak ${f(r.truePeak)} dBTP${r.range != null ? `, loudness range ${f(r.range)} LU` : ''}; levelling ${o.pub.level ? 'on' : 'off'}${variant ? ', from the noise-suppressed audio' : ''}; tone: ${tracks.map((t) => `${cap(t.speaker)} ${toneSummary(tones[voiceKey(t)])}`).join(', ')}.`,
            );
            if (i === 0) results.push({ r, seconds: r.frames / take.sampleRate, parts: parts.length });
          }
          progress('Preparing…');
        }
        entries.push({ name: `${label}_Session_export.txt`, data: syncReport() + (pubLines.length ? `\n${pubLines.join('\n')}\n` : '') });
        download(await zip(entries), `${label}_Session.zip`);
        // What the finished episode measured, for the Export step.
        const first = results[0];
        return first ? { integrated: first.r.result, range: first.r.range, peak: first.r.truePeak, history: first.r.history, seconds: first.seconds, parts: first.parts } : null;
      }
    };

    mountFlow({
      initial,
      info: {
        counts: markerCounts(markers) || 'No markers',
        tonesAvailable: toneKinds.length > 0,
        toneKinds: toneKinds.length ? toneKinds.map((k) => kindNames[k]).join(', ').replace(/, ([^,]*)$/, ' and $1') : 'marker (none are chosen in Settings)',
        pads: padsText,
        sync: [`Timecode ${timecode(hostStart)}.`, ...syncLines()].join(' '),
        guestMissing,
        meter: rec.publish.meter,
        demo: false,
      },
      voices: tracks.map((t) => ({ key: voiceKey(t), name: cap(t.speaker), role: t === take ? 'Host' : 'Guest', color: t === take ? 'var(--color-spk-yellow)' : 'var(--color-spk-teal)' })),
      rate: take.sampleRate,
      removes: (s: ExportSettings) => {
        const a = assemble(duration, wallMarkers, lineLog, s.pauses);
        return a.removed ? `Removes ${clock(a.removed)}.` : 'Nothing to remove yet.';
      },
      files,
      spectrum: async (k: string) => longTermSpectrum(await takeWav(tracks.find((t) => voiceKey(t) === k)!)),
      floor,
      chain,
      onchange,
      onexport: exportZip,
      onmarkers: () => dialog.showModal(),
    });
  }
</script>
