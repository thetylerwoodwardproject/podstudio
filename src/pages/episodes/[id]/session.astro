---
// 8b · After a continuous session: export options
import EpisodeData from '@/components/app/EpisodeData.astro';
import { episodePage } from '@/lib/episode-page';
import AppShell from '@/layouts/AppShell.astro';
import Button from '@/components/ui/Button.astro';
import { episode as mockEpisode, scriptLines } from '@/data/mock';

export const prerender = false;
const data = episodePage(Astro.params.id);
if (!data) return new Response('No such episode', { status: 404 });
const episode = { ...mockEpisode, ...data.episode };

const pauseModes = [
  { value: 'cut', title: 'Cut', body: 'Remove the paused stretch.' },
  { value: 'keep', title: 'Keep', body: 'Leave it in, marked.' },
  { value: 'split', title: 'Split', body: 'One file per segment between pauses.' },
];
const switchTrack = 'relative inline-flex h-6 w-10 flex-none items-center rounded-full bg-track-off transition-colors has-checked:bg-text has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-text';
---

<AppShell title="Session export" avatar={false} crumbs={[{ label: episode.label, href: `/episodes/${episode.id}/studio` }, { label: 'Export' }]}>
  <EpisodeData data={data} />
  <form
    class="group/s flex min-h-full flex-col gap-6 px-6 py-8 lg:px-11"
    id="session"
    data-episode={episode.id}
    data-label={`Ep${episode.number}`}
    data-lines={JSON.stringify(scriptLines.map((l) => l.text))}
  >
    <div>
      <h1 class="page-title">Session · <span data-length><span data-demo-only>41:07</span></span></h1>
      <p class="mt-1.5 text-[13px] text-muted" data-counts><span data-demo-only>18:42 · 14 retakes · 3 pauses</span></p>
    </div>

    <!-- A session with a guest exports only once their track is here, so both line up -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-[10px] border border-warn/60 bg-warn/8 px-4 py-3.5" role="alert" data-guest-missing hidden>
      <div class="min-w-0 flex-1">
        <div class="text-[14px]"><span data-guest-missing-name>The guest</span>'s track isn't here yet</div>
        <div class="mt-1 text-[12px] text-muted">Export waits for it, so both tracks come out lined up with the same cuts.</div>
      </div>
      <a class="inline-flex h-9 items-center rounded-[10px] bg-fg px-3.5 text-[13px] font-medium text-ink hover:bg-white hover:text-ink" data-guest-missing-link>Get their track</a>
      <button type="button" class="text-[13px] text-muted underline-offset-2 hover:text-fg hover:underline" data-guest-missing-skip>Export without them</button>
    </div>

    <p class="text-[13px] text-subtle" data-empty hidden>
      No session recorded yet. Start one from the studio.
    </p>

    <section class="flex flex-col gap-2.5">
      <h2 class="section-label">Always included</h2>
      <div class="flex items-center gap-3.5 rounded-[10px] bg-surface px-4 py-3.5">
        <div class="flex-1">
          <div class="text-[14px]">Raw WAV with markers</div>
          <div class="mt-1 text-[12px] text-muted">
            The whole recording, untouched. Markers are embedded in the file and also saved as Audacity labels and a CSV.
          </div>
        </div>
        <span class="rounded bg-raised px-1.5 py-[3px] font-mono text-[10px] font-medium text-ok">ON</span>
      </div>
      <div class="flex items-center gap-3.5 rounded-[10px] bg-surface px-4 py-3.5">
        <div class="flex-1">
          <div class="text-[14px]">Timecode and sync</div>
          <div class="mt-1 text-[12px] text-muted" data-sync-note>
            Every WAV carries its start as Broadcast WAV timecode, so editors can line the files up on their own.
          </div>
        </div>
        <span class="rounded bg-raised px-1.5 py-[3px] font-mono text-[10px] font-medium text-ok">ON</span>
      </div>
      <div class="flex items-center gap-3.5 rounded-[10px] bg-surface px-4 py-3.5" data-pads-row hidden>
        <div class="flex-1">
          <div class="text-[14px]">Pads track</div>
          <div class="mt-1 text-[12px] text-muted">
            Your hotkey pads as their own stereo WAV, same length and clock as your mic, ducked as you heard them.
            <span data-pads-count></span> Your mic track has none of it.
          </div>
        </div>
        <span class="rounded bg-raised px-1.5 py-[3px] font-mono text-[10px] font-medium text-ok">ON</span>
      </div>
    </section>

    <section class="flex flex-col gap-2.5">
      <h2 class="section-label">Optional</h2>
      <label class="flex items-center gap-3.5 rounded-[10px] border border-border px-4 py-3.5 has-checked:border-handle has-checked:bg-control">
        <div class="flex-1">
          <div class="text-[14px]">Assembled edit</div>
          <div class="mt-1 text-[12px] text-muted">
            Keeps the last attempt of each line and cuts the rest. Saved as a separate file, so the raw WAV stays as it
            is. <span data-removes><span data-demo-only>Removes 6:52.</span></span>
          </div>
        </div>
        <span class={switchTrack}>
          <input type="checkbox" role="switch" name="assembled" checked class="peer sr-only" aria-label="Assembled edit" />
          <span class="absolute top-[3px] left-[3px] size-[18px] rounded-full bg-text-2 transition-all peer-checked:left-[19px] peer-checked:bg-page"></span>
        </span>
      </label>
      <label class="flex items-center gap-3.5 rounded-[10px] border border-border px-4 py-3.5 has-checked:border-handle has-checked:bg-control">
        <div class="flex-1">
          <div class="text-[14px]">Marker tones in your full recording</div>
          <div class="mt-1 text-[12px] text-muted">
            A short beep at each <span data-tone-kinds>retake</span>, ducked under your voice, so the places to edit can be
            heard. Your full recording then isn't untouched; the edit and a guest's track stay clean. Tones, ducking, attack and release are in
            <a href="/settings/recording" class="underline underline-offset-2 hover:text-fg">Settings → Recording</a>.
          </div>
        </div>
        <span class={switchTrack}>
          <input type="checkbox" role="switch" name="tones" class="peer sr-only" aria-label="Marker tones in the full recording" />
          <span class="absolute top-[3px] left-[3px] size-[18px] rounded-full bg-text-2 transition-all peer-checked:left-[19px] peer-checked:bg-page"></span>
        </span>
      </label>
    </section>

    <label class="-mt-3.5 flex items-center gap-3.5 rounded-[10px] border border-border px-4 py-3.5 has-checked:border-handle has-checked:bg-control" data-mix-row hidden>
      <div class="flex-1">
        <div class="text-[14px]">Rough mix</div>
        <div class="mt-1 text-[12px] text-muted">Mic and pads in one file, limited to −1 dBFS, for a quick listen or an episode with no edit.</div>
      </div>
      <span class={switchTrack}>
        <input type="checkbox" role="switch" name="mix" class="peer sr-only" aria-label="Rough mix" />
        <span class="absolute top-[3px] left-[3px] size-[18px] rounded-full bg-text-2 transition-all peer-checked:left-[19px] peer-checked:bg-page"></span>
      </span>
    </label>

    <section class="flex flex-col gap-2.5 transition-opacity group-has-[[name=assembled]:not(:checked)]/s:pointer-events-none group-has-[[name=assembled]:not(:checked)]/s:opacity-40">
      <h2 class="section-label">Pauses in the assembled edit</h2>
      <div class="grid gap-2.5 sm:grid-cols-3" role="radiogroup" aria-label="Pauses in the assembled edit">
        {
          pauseModes.map((m, i) => (
            <label class="flex flex-col gap-1.5 rounded-[10px] border border-border p-3.5 hover:border-handle has-checked:border-handle has-checked:bg-control has-focus-visible:outline-2 has-focus-visible:outline-fg">
              <input type="radio" name="pauses" value={m.value} checked={i === 0} class="sr-only" />
              <span class="text-[14px]">{m.title}</span>
              <span class="text-[12px] leading-[1.45] text-muted">{m.body}</span>
            </label>
          ))
        }
      </div>
      <p class="text-[12px] text-subtle">While paused, recording keeps running, so the markers stay lined up with the audio.</p>
    </section>

    <section class="flex flex-col gap-2.5" data-ns>
      <h2 class="section-label">Noise suppression</h2>
      <div class="rounded-[14px] bg-surface p-5">
        <div class="flex items-center gap-4">
          <label for="ns-amount" class="flex-none text-[14px]">Suppression</label>
          <input id="ns-amount" name="ns" type="range" min="0" max="100" step="5" value="0" class="min-w-0 flex-1 accent-fg" data-ns-amount />
          <span class="w-11 flex-none text-right font-mono text-[13px]" data-ns-value>Off</span>
        </div>
        <p class="mt-2 text-[12px] leading-normal text-muted">
          Adaptive, like Waves NS1: it learns the room as it goes and leaves your voice alone. Higher takes away more of
          the background. With it on, you get both versions: the unprocessed files as always, plus cleaned copies
          ending in <span class="font-mono">_clean</span>.
        </p>
        <div class="mt-3.5 flex flex-wrap items-center gap-2.5">
          <Button type="button" data-ns-preview>Preview 30 s</Button>
          <div class="flex overflow-hidden rounded-[10px] border border-edge text-[13px]" role="group" aria-label="Listen to" data-ns-ab hidden>
            <button type="button" class="px-3.5 py-2 aria-pressed:bg-fg aria-pressed:text-ink" aria-pressed="false" data-ns-play="before">Original</button>
            <button type="button" class="px-3.5 py-2 aria-pressed:bg-fg aria-pressed:text-ink" aria-pressed="false" data-ns-play="after">Cleaned</button>
          </div>
          <!-- Attenuation meter: how far the background came down -->
          <span class="flex items-center gap-2.5" data-ns-meter hidden>
            <span class="relative h-1.5 w-28 overflow-hidden rounded-full bg-line"><span class="absolute inset-y-0 left-0 rounded-full bg-ok" data-ns-meter-fill></span></span>
            <span class="meta text-muted" data-ns-meter-text></span>
          </span>
          <span class="meta text-muted" data-ns-status></span>
        </div>
        <audio data-ns-player hidden></audio>
        <p class="mt-3.5 text-[12px] text-subtle" data-ns-files>Off: only the unprocessed files are exported.</p>
        <p class="mt-1 text-[11px] text-faint">
          Noise suppression by <a href="https://github.com/Rikorose/DeepFilterNet" target="_blank" rel="noopener" class="underline-offset-2 hover:text-fg hover:underline">DeepFilterNet3</a>
          · <a href="/settings/about" class="underline-offset-2 hover:text-fg hover:underline">Credits</a>
        </p>
      </div>
    </section>

    <div class="mt-auto flex flex-wrap items-center justify-end gap-2.5">
      <span class="meta mr-auto text-muted" data-summary></span>
      <Button data-open-markers>Open markers</Button>
      <Button variant="primary" data-export><span data-export-label>Export</span></Button>
    </div>
  </form>

  <dialog
    id="markers-dialog"
    aria-labelledby="markers-title"
    class="m-auto w-[min(560px,calc(100vw-32px))] rounded-[14px] border border-edge bg-panel p-0 text-fg backdrop:bg-black/60"
  >
    <div class="flex max-h-[80vh] flex-col gap-4 p-7">
      <div class="flex items-baseline justify-between">
        <h2 id="markers-title" class="text-[20px] tracking-[-0.02em]">Markers</h2>
        <form method="dialog"><button class="text-[13px] text-muted hover:text-fg">Close</button></form>
      </div>
      <div class="flex min-h-0 flex-col overflow-auto" data-marker-rows>
        <div class="grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]"><span class="font-mono text-muted">24:02</span><span><span class="text-warn">Retake</span> · Line 3 · “Four. I counted.”</span></div>
        <div class="grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]"><span class="font-mono text-muted">15:21</span><span><span class="text-warn">Retake</span> · Line 41 · attempt 3</span></div>
        <div class="grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]"><span class="font-mono text-muted">09:14</span><span><span class="text-fg-soft">Pause</span> · 1:26 · before Line 28</span></div>
      </div>
    </div>
  </dialog>
</AppShell>

<script>
  import { assemble, audacityLabels, mapTime, mutes, onAudio, type PauseMode, type SessionMarker } from '@/lib/audio/assemble';
  import { markerCounts, markerName, padLabel } from '@/lib/markers';
  import { hasPads, renderPads, renderRoughMix, stereoOf } from '@/lib/audio/pads-export';
  import { bextFor, formatBytes, getTake, listTakes, rangesWav, takeBytes, takeWav, tonedWav, trackShift, trackStart, trackSync, type TakeMeta } from '@/lib/audio/takes';
  import { guestRanges, guestTime, timecode, type SyncMap } from '@/lib/audio/sync';
  import { alignedRanges } from '@/lib/audio/align';
  import type { PlacedTone, ToneKind } from '@/lib/audio/tones';
  import { denoiseTake, previewTake } from '@/lib/audio/denoise';
  import { loadSettings, saveSettings } from '@/lib/settings';
  import { download, zip, type ZipEntry } from '@/lib/zip';
  import { loadScript } from '@/lib/script-store';

  const form = document.getElementById('session') as HTMLFormElement;
  const dialog = document.getElementById('markers-dialog') as HTMLDialogElement;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => form.querySelector<T>(s)!;
  const demo = new URL(location.href).searchParams.has('demo');

  $('[data-open-markers]').addEventListener('click', () => dialog.showModal());
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

  const clock = (sec: number) => {
    const s = Math.round(sec);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    return `${h ? `${h}:${String(m).padStart(2, '0')}` : m}:${String(s % 60).padStart(2, '0')}`;
  };
  const mmss = (sec: number) => {
    const s = Math.floor(sec);
    return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
  };

  if (!demo) live();

  async function live() {
    const episodeId = form.dataset.episode!;
    const label = form.dataset.label!;
    const lines = loadScript(episodeId).lines.map((l) => l.text);
    const id = new URL(location.href).searchParams.get('take');
    const take: TakeMeta | null =
      (id ? await getTake(id) : null) ??
      (await listTakes(episodeId)).filter((t) => t.kind === 'session' && t.status === 'done').at(-1) ??
      null;

    const exportBtn = $<HTMLButtonElement>('[data-export]');
    if (!take) {
      $('[data-empty]').hidden = false;
      $('[data-length]').textContent = '0:00';
      $('[data-counts]').textContent = 'Nothing recorded yet';
      exportBtn.disabled = true;
      $<HTMLButtonElement>('[data-open-markers]').disabled = true;
      return;
    }

    // Every track in the session: yours, and the guest's (recorded on their device).
    const all = await listTakes(episodeId);
    const tracks = [take, ...all.filter((t) => t.id !== take.id && t.group && t.group === take.group && t.status === 'done')];
    // A guest recorded in this session but their track isn't here: hold the export until it is.
    if (take.guest && tracks.length === 1) {
      const banner = $('[data-guest-missing]');
      banner.hidden = false;
      $('[data-guest-missing-name]').textContent = take.guest.name;
      $<HTMLAnchorElement>('[data-guest-missing-link]').href = `/episodes/${episodeId}/wrap?take=${encodeURIComponent(take.id)}`;
      exportBtn.disabled = true;
      $('[data-guest-missing-skip]').addEventListener('click', () => {
        if (!confirm(`Export without ${take.guest!.name}'s track? Their audio won't be in this zip.`)) return;
        banner.hidden = true;
        exportBtn.disabled = false;
      });
    }
    const duration = take.samples / take.sampleRate;
    // A track from another device on the host's timeline: with sync points, drift and gaps
    // are corrected (lib/audio/sync.ts); older tracks are lined up by their start only.
    const hostStart = trackStart(take);
    const syncs = new Map<TakeMeta, SyncMap | null>();
    const syncOf = (t: TakeMeta) => {
      if (!syncs.has(t)) syncs.set(t, t === take ? null : trackSync(t, take));
      return syncs.get(t)!;
    };
    const aligned = (t: TakeMeta, ranges: [number, number][]) => {
      const m = syncOf(t);
      return m ? guestRanges(m, ranges, take.sampleRate, t.sampleRate) : alignedRanges(ranges, trackShift(t, take));
    };
    // Timecode: every file carries where it starts on the session clock, so editors line them up.
    const tc = (t: TakeMeta, at = 0) => bextFor(t, hostStart + at * 1000);
    const secs = (x: number) => (x < 10 ? x.toFixed(1) : String(Math.round(x))).replace('-', '−');
    /** What was done to line each track up, for the page and the zip. */
    const syncLines = () =>
      tracks
        .filter((t) => t !== take)
        .map((t) => {
          const who = t.speaker.charAt(0) + t.speaker.slice(1).toLowerCase();
          const m = syncOf(t);
          if (!m) return `${who}: lined up by start time only (recorded before sync points existed).`;
          const parts = [
            m.driftMs >= 1
              ? `${Math.round(m.driftMs)} ms of drift corrected (${m.ppm > 0 ? '+' : '−'}${Math.abs(m.ppm).toFixed(0)} ppm)`
              : 'no measurable drift',
          ];
          if (m.gaps >= 0.05) parts.push(`${secs(m.gaps)} s of missing audio filled with silence`);
          if (m.dropped >= 0.05) parts.push(`${secs(m.dropped)} s left out while your mic was stopped`);
          return `${who}: ${parts.join(', ')}.`;
        });
    const syncReport = () =>
      [
        `Timecode (session clock, ${Intl.DateTimeFormat().resolvedOptions().timeZone}): ${timecode(hostStart)} at the start of every full-length file.`,
        'Edits start at the timecode of their first kept moment, the same on every track.',
        ...syncLines(),
        '',
      ].join('\n');
    {
      const lines = syncLines();
      $('[data-sync-note]').textContent =
        `Every WAV carries its start as Broadcast WAV timecode (${timecode(hostStart)}), so editors can line the files up on their own.` +
        (lines.length ? ` ${lines.join(' ')}` : '');
    }
    // Recorded on the wall clock; assemble() converts these itself.
    const wallMarkers = take.markers ?? [];
    const lineLog = take.lineLog ?? [];
    // Everything shown or written into files is on the audio (gaps taken out).
    const { markers } = onAudio(wallMarkers, lineLog);
    $('[data-length]').textContent = clock(duration);
    $('[data-counts]').textContent = markerCounts(markers) || 'No markers';
    const withPads = hasPads(take);
    $('[data-pads-row]').hidden = !withPads;
    $('[data-mix-row]').hidden = !withPads;
    if (withPads) {
      const n = take.pads!.presses.length;
      $('[data-pads-count]').textContent = `${n} press${n === 1 ? '' : 'es'}, each a marker named like “${padLabel(markers.find((m) => m.kind === 'pad')!)}”.`;
    }

    const guestTrack = tracks.find((t) => t !== take);
    const cap = (n: string) => `${n.charAt(0)}${n.slice(1).toLowerCase()}`;
    const whoName = (m: SessionMarker) => (m.who === 'guest' ? (guestTrack ? cap(guestTrack.speaker) : take.guest?.name ?? 'Guest') : cap(take.speaker));
    /** Each person's coughs, muted in their own edit (seconds of their own track). */
    const mutedFor = (t: TakeMeta): [number, number][] => {
      const own = mutes(wallMarkers, t === take ? 'host' : 'guest', duration);
      const m = syncOf(t);
      if (!m) return alignedRanges(own, trackShift(t, take));
      // Host-timeline mutes, moved onto the guest's own audio.
      return own.flatMap(([a, b]) => {
        const ga = guestTime(m, a, take.sampleRate, t.sampleRate);
        const gb = guestTime(m, b, take.sampleRate, t.sampleRate);
        return ga != null && gb != null ? [[ga, gb] as [number, number]] : [];
      });
    };
    const words = (line: number) => lines[line]?.split(/\s+/).slice(0, 3).join(' ') ?? '';
    const describe = (m: SessionMarker) =>
      m.kind === 'pad'
        ? padLabel(m)
        : m.kind === 'retake'
        ? `Retake · Line ${m.line + 1} · attempt ${m.attempt ?? 2}`
        : m.kind === 'gap'
          ? `Mic stopped · ${clock(m.lost ?? 0)}`
          : `${markerName[m.kind]}${m.kind === 'cut' ? ` · ${whoName(m)}` : ''} · Line ${m.line + 1}${m.end != null ? ` · ${clock(m.end - m.t)}` : ''}`;

    // Markers dialog, newest first.
    const dialogRows = dialog.querySelector<HTMLElement>('[data-marker-rows]')!;
    dialogRows.replaceChildren(
      ...(markers.length
        ? [...markers].reverse().map((m) => {
            const row = document.createElement('div');
            row.className = 'grid grid-cols-[64px_1fr] gap-3 border-b border-line py-2.5 text-[13px]';
            const time = Object.assign(document.createElement('span'), { className: 'font-mono text-muted', textContent: mmss(m.t) });
            const kind = Object.assign(document.createElement('span'), {
              className: { retake: 'text-warn', pause: 'text-fg-soft', adlib: 'text-adlib', cut: 'text-muted', gap: 'text-rec', pad: '' }[m.kind],
              textContent: m.kind === 'pad' ? padLabel(m) : markerName[m.kind],
            });
            if (m.kind === 'pad' && m.pad) kind.style.color = `var(--color-spk-${m.pad.color})`;
            const text = document.createElement('span');
            const detail =
              m.kind === 'pad'
                ? `${m.end != null ? clock(m.end - m.t) : 'to the end'}`
                : m.kind === 'retake'
                ? m.attempt === 2 ? `Line ${m.line + 1} · “${words(m.line)}”` : `Line ${m.line + 1} · attempt ${m.attempt}`
                : m.kind === 'gap'
                  ? `${clock(m.lost ?? 0)} not recorded · Line ${m.line + 1}`
                  : `${m.kind === 'cut' ? `${whoName(m)} · ` : ''}${m.end != null ? clock(m.end - m.t) : 'to the end'} · Line ${m.line + 1}`;
            text.append(kind, ` · ${detail}`);
            row.append(time, text);
            return row;
          })
        : [Object.assign(document.createElement('p'), { className: 'py-2.5 text-[13px] text-subtle', textContent: 'No markers in this session.' })]),
    );

    // Noise suppression: one fader, remembered as the default for next time.
    const nsInput = $<HTMLInputElement>('[data-ns-amount]');
    nsInput.value = String(loadSettings().recording.noiseSuppression);
    const showNs = () => {
      const v = Number(nsInput.value);
      $('[data-ns-value]').textContent = v ? `${v}%` : 'Off';
      $('[data-ns-files]').textContent = v
        ? 'Both versions: the unprocessed WAV and edit, plus cleaned copies (…_clean.wav, …_edit_clean.wav).'
        : 'Off: only the unprocessed files are exported.';
      $<HTMLButtonElement>('[data-ns-preview]').disabled = !v;
    };
    showNs();
    let preview: { amount: number; before: string; after: string } | null = null;
    const player = $<HTMLAudioElement>('[data-ns-player]');
    nsInput.addEventListener('input', () => {
      showNs();
      if (preview && preview.amount !== Number(nsInput.value)) $('[data-ns-status]').textContent = 'Preview again to hear this setting';
    });
    nsInput.addEventListener('change', () => saveSettings('recording', { noiseSuppression: Number(nsInput.value) }));
    const play = (which: 'before' | 'after') => {
      if (!preview) return;
      const at = player.currentTime;
      player.src = preview[which];
      player.currentTime = at;
      player.play();
      form.querySelectorAll<HTMLElement>('[data-ns-play]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.nsPlay === which)));
    };
    form.querySelectorAll<HTMLElement>('[data-ns-play]').forEach((b) =>
      b.addEventListener('click', () => (b.getAttribute('aria-pressed') === 'true' ? player.pause() : play(b.dataset.nsPlay as 'before' | 'after'))),
    );
    player.addEventListener('pause', () => form.querySelectorAll('[data-ns-play]').forEach((b) => b.setAttribute('aria-pressed', 'false')));
    $('[data-ns-preview]').addEventListener('click', async () => {
      const amount = Number(nsInput.value);
      const btn = $<HTMLButtonElement>('[data-ns-preview]');
      btn.disabled = true;
      $('[data-ns-status]').textContent = preview ? 'Cleaning…' : 'Loading noise suppression (about 19 MB the first time)…';
      try {
        const p = await previewTake(take!, amount, 30);
        if (preview) {
          URL.revokeObjectURL(preview.before);
          URL.revokeObjectURL(preview.after);
        }
        preview = { amount, before: URL.createObjectURL(p.before), after: URL.createObjectURL(p.after) };
        $('[data-ns-ab]').hidden = false;
        $('[data-ns-meter]').hidden = false;
        $('[data-ns-meter-fill]').style.width = `${Math.min(100, (p.reduction / 30) * 100)}%`;
        $('[data-ns-meter-text]').textContent = `Background −${Math.round(p.reduction)} dB`;
        $('[data-ns-status]').textContent = '';
        player.currentTime = 0;
        play('after');
      } catch (err) {
        $('[data-ns-status]').textContent = `Couldn’t clean: ${(err as Error).message}`;
      } finally {
        btn.disabled = false;
      }
    });

    // Marker tones: which kinds, from settings.
    const toneSettings = loadSettings().recording.tones;
    const toneKinds = (Object.keys(toneSettings.kinds) as ToneKind[]).filter((k) => toneSettings.kinds[k]);
    const toneSwitch = $<HTMLInputElement>('[name=tones]');
    toneSwitch.checked = toneSettings.inExports && toneKinds.length > 0;
    toneSwitch.disabled = !toneKinds.length;
    const kindNames: Record<ToneKind, string> = { retake: 'retake', cut: 'cough', adlib: 'ad-lib', pause: 'pause', gap: 'mic stop' };
    $('[data-tone-kinds]').textContent = toneKinds.length
      ? toneKinds.map((k) => kindNames[k]).join(', ').replace(/, ([^,]*)$/, ' and $1')
      : 'marker (none are chosen in Settings)';
    const placed = (t: TakeMeta): PlacedTone[] =>
      markers.filter((m) => toneKinds.includes(m.kind as ToneKind) && !(m.kind === 'cut' && m.who === 'guest')).map((m) => ({ at: Math.round(m.t * t.sampleRate), kind: m.kind as ToneKind }));

    const options = () => {
      const data = new FormData(form);
      const ns = Number(data.get('ns') ?? 0);
      return { assembled: data.has('assembled'), pauses: String(data.get('pauses')) as PauseMode, ns, tones: data.has('tones') && toneKinds.length > 0, mix: withPads && data.has('mix') };
    };
    const refresh = () => {
      const o = options();
      const a = assemble(duration, wallMarkers, lineLog, o.pauses);
      $('[data-removes]').textContent = a.removed ? `Removes ${clock(a.removed)}.` : 'Nothing to remove yet.';
      const raw = tracks.reduce((n, t) => n + takeBytes(t), 0);
      const editBytes = tracks.reduce((n, t) => n + (duration - a.removed) * t.sampleRate * (t.bitDepth / 8) * (t.channels ?? 1), 0);
      // Noise suppression on: every audio file comes twice, unprocessed and cleaned.
      const copies = o.ns ? 2 : 1;
      const padTracks = withPads ? 1 : 0;
      const files = (tracks.length + (o.assembled ? a.files.length * tracks.length : 0)) * copies + 3 + padTracks * (1 + (o.assembled ? a.files.length : 0)) + (o.mix ? 1 : 0);
      const padBytes = withPads ? duration * take.sampleRate * (take.bitDepth / 8) * 2 * (1 + (o.assembled ? 1 : 0) + (o.mix ? 1 : 0)) : 0;
      $('[data-summary]').textContent = `${files} files · ${formatBytes((raw + (o.assembled ? editBytes : 0)) * copies + padBytes)}`;
    };
    form.addEventListener('change', refresh);
    refresh();

    exportBtn.addEventListener('click', async () => {
      const o = options();
      exportBtn.disabled = true;
      $('[data-export-label]').textContent = 'Preparing…';
      try {
        const name = (t: TakeMeta) => `${label}_Session_${t.speaker.charAt(0)}${t.speaker.slice(1).toLowerCase()}`;
        const endLabel: Partial<Record<SessionMarker['kind'], string>> = { adlib: 'Script resumes', cut: 'Cough ends' };
        const cue = (m: SessionMarker, rate: number, at = m.t) => ({ at: Math.round(at * rate), label: describe(m) });
        const entries: ZipEntry[] = [];
        // Raw: untouched, with a cue at every retake and gap, and at both ends of each pause, cut and ad-lib.
        for (const t of tracks) {
          const len = t.samples / t.sampleRate;
          const cues = markers.flatMap((m) =>
            m.kind !== 'retake' && m.end != null
              ? [cue(m, t.sampleRate), { at: Math.round(m.end * t.sampleRate), label: endLabel[m.kind] ?? 'Resume' }]
              : [cue(m, t.sampleRate)],
          );
          entries.push({
            name: `${name(t)}.wav`,
            data:
              t !== take
                ? await rangesWav(t, aligned(t, [[0, duration]]), cues, undefined, [], tc(t)) // lined up with yours, same length
                : o.tones
                  ? await tonedWav(t, placed(t), toneSettings, cues, undefined, tc(t))
                  : cues.length
                    ? await rangesWav(t, [[0, len]], cues, undefined, [], tc(t))
                    : await takeWav(t, undefined, tc(t)),
          });
        }
        // The Pads track: rebuilt from the press log on your mic's clock, and the optional rough mix.
        if (withPads) {
          await renderPads(take, (d) => ($('[data-export-label]').textContent = `Pads track… ${Math.round(d * 100)}%`));
          const cues = markers.filter((m) => m.kind === 'pad').map((m) => cue(m, take.sampleRate));
          entries.push({ name: `${label}_Session_Pads.wav`, data: await rangesWav(stereoOf(take), [[0, duration]], cues, 'pads', [], tc(take)) });
          if (o.mix) {
            await renderRoughMix(take, (d) => ($('[data-export-label]').textContent = `Rough mix… ${Math.round(d * 100)}%`));
            entries.push({ name: `${label}_Session_RoughMix.wav`, data: await rangesWav(stereoOf(take), [[0, duration]], cues, 'mix', [], tc(take)) });
          }
          $('[data-export-label]').textContent = 'Preparing…';
        }
        entries.push({ name: `${label}_Session_markers.txt`, data: audacityLabels(markers, describe) });
        entries.push({ name: `${label}_Session_sync.txt`, data: syncReport() });
        const csv = [
          'time,end,kind,line,attempt,first words or pad',
          ...markers.map((m) =>
            [
              m.t.toFixed(3),
              m.end?.toFixed(3) ?? '',
              m.kind === 'gap' ? `gap ${m.lost?.toFixed(3)}` : m.kind,
              m.line + 1,
              m.attempt ?? '',
              `"${(m.kind === 'pad' ? padLabel(m) : m.kind === 'cut' ? `Cough (muted) · ${whoName(m)}` : words(m.line)).replace(/"/g, '""')}"`,
            ].join(','),
          ),
        ].join('\n');
        entries.push({ name: `${label}_Session_markers.csv`, data: csv + '\n' });
        // What voice follow did during the session, for tracking down a dropout.
        if (take.voiceLog?.length) {
          const log = take.voiceLog.map((v) => `${clock(v.t)}\t${v.at}\t${v.event}${v.detail ? `\t${v.detail}` : ''}`).join('\n');
          entries.push({ name: `${label}_Session_voice-log.txt`, data: `session time\twall clock\tevent\tdetail\n${log}\n` });
        }

        // Noise suppression makes a cleaned copy of the recording (kept for next time). The zip
        // gets both versions: the unprocessed files, and _clean copies cut the same way from the
        // cleaned audio, so markers line up in both.
        let variant: string | null = null;
        if (o.ns) {
          const began = Date.now();
          for (const t of tracks) {
            variant = await denoiseTake(t, o.ns, (done) => {
              const left = done > 0.02 ? ((Date.now() - began) / done) * (1 - done) : 0;
              $('[data-export-label]').textContent =
                `Cleaning… ${Math.round(done * 100)}%${left > 60000 ? ` · about ${Math.round(left / 60000)} min left` : ''}`;
            });
          }
          $('[data-export-label]').textContent = 'Preparing…';
        }
        if (variant) {
          for (const t of tracks) {
            const len = t.samples / t.sampleRate;
            const cues = markers.map((m) => cue(m, t.sampleRate));
            entries.push({
              name: `${name(t)}_clean.wav`,
              data:
                t !== take
                  ? await rangesWav(t, aligned(t, [[0, duration]]), cues, variant, [], tc(t))
                  : o.tones
                    ? await tonedWav(t, placed(t), toneSettings, cues, variant, tc(t))
                    : await rangesWav(t, [[0, len]], cues, variant, [], tc(t)),
            });
          }
        }

        if (o.assembled) {
          const a = assemble(duration, wallMarkers, lineLog, o.pauses);
          for (const t of tracks) {
            for (const [i, ranges] of a.files.entries()) {
              // Ad-libs stay in the edit, so their cues do too (and kept pauses').
              const kept = markers
                .filter((m) => m.kind === 'adlib' || m.kind === 'cut' || m.kind === 'pad' || (m.kind === 'pause' && o.pauses === 'keep'))
                .map((m) => ({ m, at: mapTime(m.t, ranges) }))
                .filter((x): x is { m: SessionMarker; at: number } => x.at != null)
                .map((x) => cue(x.m, t.sampleRate, x.at));
              const file = a.files.length > 1 ? `${name(t)}_edit_part${i + 1}` : `${name(t)}_edit`;
              // Their own coughs are muted; nothing is cut for a cough, so every edit keeps the same length.
              // Every track's edit starts at the same moment, so they share a timecode.
              const at = tc(t, ranges[0]?.[0] ?? 0);
              entries.push({ name: `${file}.wav`, data: await rangesWav(t, aligned(t, ranges), kept, undefined, mutedFor(t), at) });
              if (variant) entries.push({ name: `${file}_clean.wav`, data: await rangesWav(t, aligned(t, ranges), kept, variant, mutedFor(t), at) });
            }
          }
          // The Pads edit: the same cuts as the mic edit; a cough never mutes the pads.
          if (withPads) {
            for (const [i, ranges] of a.files.entries()) {
              const kept = markers
                .filter((m) => m.kind === 'pad')
                .map((m) => ({ m, at: mapTime(m.t, ranges) }))
                .filter((x): x is { m: SessionMarker; at: number } => x.at != null)
                .map((x) => cue(x.m, take.sampleRate, x.at));
              const file = a.files.length > 1 ? `${label}_Session_Pads_edit_part${i + 1}` : `${label}_Session_Pads_edit`;
              entries.push({ name: `${file}.wav`, data: await rangesWav(stereoOf(take), ranges, kept, 'pads', [], tc(take, ranges[0]?.[0] ?? 0)) });
            }
          }
        }
        download(await zip(entries), `${label}_Session.zip`);
      } catch (err) {
        alert((err as Error).message);
      } finally {
        exportBtn.disabled = false;
        $('[data-export-label]').textContent = 'Export';
      }
    });
  }
</script>
