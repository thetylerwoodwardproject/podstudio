---
// 1b · Join session (phone, after sign-in)
import Phone from '@/layouts/Phone.astro';
import Logo from '@/components/ui/Logo.astro';
import Avatar from '@/components/ui/Avatar.astro';
import Dot from '@/components/ui/Dot.astro';
import Button from '@/components/ui/Button.astro';
import OtpInput from '@/components/ui/OtpInput.astro';
import { episode, user } from '@/data/mock';
---

<Phone title="Join a session">
  <div class="flex flex-1 flex-col gap-6.5 px-6 py-4.5">
    <div class="flex items-center justify-between">
      <Logo />
      <Avatar initial={user.initial} />
    </div>
    <div>
      <h1 class="text-[26px] font-medium tracking-[-0.02em]">Join a session</h1>
      <p class="mt-1.5 text-[13px] text-muted">This phone becomes another screen.</p>
    </div>

    <section class="flex flex-col gap-2.5">
      <h2 class="eyebrow">Live now</h2>
      <div class="flex flex-col gap-3 rounded-[14px] border border-fg p-4">
        <div class="flex items-center justify-between">
          <div class="text-[16px] font-medium">{episode.fullTitle}</div>
          <Dot color="var(--color-ok)" size={7} />
        </div>
        <div class="meta text-muted">3 instances · MacBook is recording</div>
        <Button href={`/episodes/${episode.id}/prompter`} variant="primary" class="h-11 rounded-[10px] text-[15px]">Join</Button>
      </div>
    </section>

    <form class="flex flex-col gap-2.5" data-next={`/episodes/${episode.id}/prompter`}>
      <h2 class="eyebrow">Or enter code</h2>
      <OtpInput name="join" value="K74" alphanumeric label="Session code" />
    </form>

    <p class="mt-auto pb-7 text-center text-[12px] text-faint">Screen stays awake while joined</p>
  </div>
</Phone>
