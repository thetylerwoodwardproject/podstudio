---
// 2a · First-run setup, turn on 2FA (also where Settings → Security resets it)
import Setup from '@/layouts/Setup.astro';
import { setupSteps } from '@/data/mock';
import OtpInput from '@/components/ui/OtpInput.astro';
import Button from '@/components/ui/Button.astro';

const current = 2;
---

<Setup title="Protect your account" current={current}>
  <!-- Resetting from Settings: the current code first -->
  <form class="flex flex-1 flex-col gap-7" data-reset hidden>
    <div>
      <div class="eyebrow">Settings · Security</div>
      <h1 class="mt-2 text-[30px] tracking-[-0.03em]">Reset two-factor</h1>
      <p class="mt-2 max-w-[460px] text-[14px] leading-[1.55] text-muted">
        Enter a code from your current authenticator app (or a recovery code) to set up a new one.
      </p>
    </div>
    <input name="current" class="h-12 max-w-[280px] rounded-[10px] bg-raised px-3.5 font-mono text-[18px] tracking-[0.12em] focus:outline-none" autocomplete="one-time-code" aria-label="Current code" required />
    <p class="text-[13px] text-rec" role="alert" data-error hidden></p>
    <div class="mt-auto flex items-center justify-between">
      <a href="/settings/security" class="text-[13px] text-muted hover:text-fg">← Back</a>
      <Button type="submit" variant="primary" size="lg">Continue</Button>
    </div>
  </form>

  <form class="flex flex-1 flex-col gap-7" data-totp hidden>
    <div>
      <div class="eyebrow">Step {current + 1} of {setupSteps.length}</div>
      <h1 class="mt-2 text-[30px] tracking-[-0.03em]">Protect your account</h1>
      <p class="mt-2 max-w-[460px] text-[14px] leading-[1.55] text-muted">
        Scan this QR code with an authenticator app, such as 1Password, Authy or Google Authenticator, then enter the
        6-digit code it shows.
      </p>
    </div>

    <div class="flex flex-wrap items-start gap-10">
      <div class="size-42 flex-none overflow-hidden rounded-xl bg-white p-2 [&_svg]:size-full" role="img" aria-label="QR code for your authenticator app" data-qr></div>
      <div class="flex flex-col gap-4.5">
        <div class="flex flex-col gap-1.5">
          <div class="text-[12px] text-muted">Can't scan? Enter this key</div>
          <code class="rounded-lg bg-raised px-3 py-2.5 font-mono text-[14px] font-medium tracking-[0.08em] select-all" data-secret>…</code>
        </div>
        <div class="flex flex-col gap-2">
          <div class="text-[12px] text-muted">6-digit code</div>
          <OtpInput name="totp" split label="6-digit code" />
        </div>
        <p class="max-w-[300px] text-[13px] text-rec" role="alert" data-error hidden></p>
      </div>
    </div>

    <div class="mt-auto flex items-center justify-end">
      <Button type="submit" variant="primary" size="lg">Verify and continue</Button>
    </div>
  </form>

  <!-- Once it's on: the recovery codes, shown once -->
  <div class="flex flex-1 flex-col gap-7" data-codes hidden>
    <div>
      <div class="eyebrow">Two-factor is on</div>
      <h1 class="mt-2 text-[30px] tracking-[-0.03em]">Save your recovery codes</h1>
      <p class="mt-2 max-w-[480px] text-[14px] leading-[1.55] text-muted">
        If you lose your phone, each of these signs you in once instead of a code. Keep them somewhere safe, like your
        password manager. They won't be shown again.
      </p>
    </div>
    <ol class="grid max-w-[360px] grid-cols-2 gap-x-6 gap-y-2 rounded-xl bg-raised p-4 font-mono text-[15px]" data-code-list></ol>
    <div class="flex gap-2.5">
      <Button type="button" data-copy>Copy</Button>
      <Button type="button" data-download>Download</Button>
    </div>
    <div class="mt-auto flex items-center justify-end">
      <Button variant="primary" size="lg" data-continue>I've saved them · Continue</Button>
    </div>
  </div>
</Setup>

<script>
  import { api, otpValue, showError } from '@/lib/api';

  const totpForm = document.querySelector<HTMLFormElement>('[data-totp]')!;
  const resetForm = document.querySelector<HTMLFormElement>('[data-reset]')!;
  const codesView = document.querySelector<HTMLElement>('[data-codes]')!;
  let next = '/setup/domain';

  async function start(current?: string) {
    const r = await api<{ secret: string; svg: string }>('auth/totp/start', { body: current ? { code: current } : {} });
    totpForm.querySelector('[data-qr]')!.innerHTML = r.svg;
    totpForm.querySelector('[data-secret]')!.textContent = r.secret;
    resetForm.hidden = true;
    totpForm.hidden = false;
    totpForm.querySelector<HTMLInputElement>('[data-otp] input')?.focus();
  }

  const state = await api<{ user: { totp: boolean } | null }>('auth/state');
  if (state.user?.totp) {
    // Already on: this is a reset from Settings.
    next = '/settings/security';
    resetForm.hidden = false;
    resetForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        await start(String(new FormData(resetForm).get('current') ?? ''));
      } catch (err) {
        showError(resetForm, (err as Error).message);
      }
    });
  } else {
    await start();
  }

  totpForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = totpForm.querySelector<HTMLButtonElement>('[type=submit]')!;
    btn.disabled = true;
    try {
      const r = await api<{ recoveryCodes: string[] }>('auth/totp/confirm', { body: { code: otpValue(totpForm) } });
      showCodes(r.recoveryCodes);
    } catch (err) {
      showError(totpForm, (err as Error).message);
      btn.disabled = false;
    }
  });

  function showCodes(codes: string[]) {
    totpForm.hidden = true;
    codesView.hidden = false;
    codesView.querySelector('[data-code-list]')!.replaceChildren(...codes.map((c) => Object.assign(document.createElement('li'), { textContent: c })));
    const text = `Podstudio recovery codes (each works once)\n\n${codes.join('\n')}\n`;
    codesView.querySelector('[data-copy]')!.addEventListener('click', (e) => {
      navigator.clipboard?.writeText(text);
      (e.currentTarget as HTMLElement).textContent = 'Copied';
    });
    codesView.querySelector('[data-download]')!.addEventListener('click', () => {
      const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(new Blob([text], { type: 'text/plain' })), download: 'podstudio-recovery-codes.txt' });
      a.click();
    });
    codesView.querySelector('[data-continue]')!.addEventListener('click', () => (location.href = next));
  }
</script>
