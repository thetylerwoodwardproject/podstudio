---
// 1h · Unsupported browser (Firefox / Safari)
import Base from '@/layouts/Base.astro';
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
---

<Base title="Chrome required" anyBrowser>
  <div class="flex min-h-dvh items-center justify-center px-6">
    <div class="flex max-w-[400px] flex-col gap-3.5">
      <Logo />
      <h1 class="text-[26px] leading-[1.2] tracking-[-0.02em]">Podstudio runs in Chrome-based browsers only.</h1>
      <p class="text-[14px] leading-[1.6] text-muted">
        Voice follow and WAV recording rely on features Firefox and Safari don't ship. Open this link in Chrome, Edge,
        Brave, or Arc.
      </p>
      <div class="mt-1.5 flex gap-2.5">
        <Button variant="primary" data-copy-link>Copy link</Button>
        <Button href="https://www.google.com/chrome/" target="_blank" rel="noopener">Get Chrome</Button>
      </div>
    </div>
  </div>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-link]')!;
  btn.addEventListener('click', async () => {
    // Send people back to the page they tried to open, not this one.
    const from = new URL(location.href).searchParams.get('from');
    const target = from && new URL(from).origin === location.origin ? from : location.origin;
    await navigator.clipboard.writeText(target);
    btn.textContent = 'Copied';
    setTimeout(() => (btn.textContent = 'Copy link'), 1500);
  });
</script>
