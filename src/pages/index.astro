---
// 5a · Episode library + storage warning
import AppShell from '@/layouts/AppShell.astro';
import Button from '@/components/ui/Button.astro';
import Callout from '@/components/ui/Callout.astro';
import Dot from '@/components/ui/Dot.astro';
import Pagination from '@/components/ui/Pagination.astro';
import ImportDialog from '@/components/app/ImportDialog.astro';
import NewEpisode from '@/components/app/NewEpisode.svelte';
import PrimarySidebar from '@/components/app/PrimarySidebar.astro';
import { statusColor } from '@/data/mock';
import { statfsSync } from 'node:fs';
import { context } from '../../server/context.ts';

export const prerender = false;
const ctx = context();
const day = (t: number) => {
  const d = new Date(t);
  return d.toDateString() === new Date().toDateString() ? 'Today' : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
};
const library = ctx.library.list().map((e) => ({
  id: e.id,
  recorded: !!e.sessions,
  prepared: !!ctx.db.prepare("SELECT 1 FROM episode_packages p JOIN prepared_audio a ON a.id = json_extract(p.value, '$.source.audioId') WHERE p.episode_id = ? AND a.state = 'ready' LIMIT 1").get(e.id),
  title: e.fullTitle,
  status: (e.sessions ? 'Recorded' : 'Draft') as keyof typeof statusColor,
  words: e.words != null ? `${e.words.toLocaleString('en-US')} words` : e.id === '142' ? 'Example' : '—',
  sessions: e.sessions ? `${e.sessions} session${e.sessions === 1 ? '' : 's'}` : '—',
  length: '—',
  updated: day(e.updatedAt),
  href: `/episodes/${e.id}/${ctx.db.prepare("SELECT 1 FROM episode_packages p JOIN prepared_audio a ON a.id = json_extract(p.value, '$.source.audioId') WHERE p.episode_id = ? AND a.state = 'ready' LIMIT 1").get(e.id)?'package':e.sessions ? 'editor' : 'studio'}`,
}));
// The data folder's disk: warn when it's getting full (24-bit / 48 kHz mono is about 518 MB an hour).
let storage: { usedGb: number; totalGb: number; pct: number; hoursLeft: number } | null = null;
try {
  const fs = statfsSync(ctx.config.data);
  const total = fs.blocks * fs.bsize;
  const free = fs.bavail * fs.bsize;
  storage = { usedGb: Math.round((total - free) / 1e9), totalGb: Math.round(total / 1e9), pct: Math.round(((total - free) / total) * 100), hoursLeft: Math.floor(free / (48000 * 3 * 3600)) };
} catch {}

const filters = ['All', 'Drafts', 'Recorded', 'Published'];
const filterOf: Record<string, string> = { Draft: 'Drafts', Recorded: 'Recorded', Transcribed: 'Recorded', Published: 'Published' };
const cols = 'grid grid-cols-[minmax(220px,1fr)_140px_130px_100px_90px_90px] gap-4';
---

<AppShell title="Episodes" crumbs={[{ label: 'Episodes' }]}>
  <PrimarySidebar slot="sidebar" active="episodes" />
  <div class="flex flex-col gap-6 bg-page px-6 py-7 sm:px-9 lg:h-full lg:overflow-auto">
    {
      storage && storage.pct >= 80 && (
        <Callout title={`Server storage is ${storage.pct}% full`} color="var(--color-warn)">
          {storage.usedGb} GB of {storage.totalGb} GB used. That leaves about {storage.hoursLeft} hours of 24-bit / 48 kHz audio.
          Download and delete old sessions, or add space.
          <Button slot="action" href="/settings/server">Manage storage</Button>
        </Callout>
      )
    }

    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-divider pb-5">
      <div class="flex gap-5.5 text-[13px]" role="radiogroup" aria-label="Filter episodes">
        {
          filters.map((f, i) => (
          <label class="text-text-3 hover:text-text-2 has-checked:text-text">
              <input type="radio" name="filter" value={f} checked={i === 0} class="sr-only" />
              {f}
            </label>
          ))
        }
      </div>
      <div class="flex flex-wrap gap-2.5">
        <input
          type="search"
          data-search
          aria-label="Search episodes and scripts"
          placeholder="Search episodes and scripts"
          class="h-9 w-65 rounded-md border border-border bg-control px-3 font-mono text-[12px] placeholder:text-text-3 focus:border-accent focus:outline-none"
        />
        <Button data-open-import>Import script</Button>
        <NewEpisode client:load />
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[800px] border-t border-line">
        <thead>
          <tr class:list={[cols, 'border-b border-divider py-3 text-left']}>
            {['Episode', 'Status', 'Script', 'Sessions', 'Length', 'Updated'].map((h) => <th class="text-[11px] font-medium text-text-3">{h}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            library.map((ep) => (
              <tr
                class:list={[cols, 'items-center border-b border-divider py-4 text-[13px]', ep.href && 'hover:bg-surface']}
                data-row
                data-filter={filterOf[ep.status]}
                data-title={ep.title.toLowerCase()}
              >
                <td><a href={ep.href} class="font-medium text-text hover:text-accent">{ep.title}</a><div class="mt-2 flex gap-3 text-[12px]"><a hidden={!ep.prepared} class="text-accent hover:underline" href={`/episodes/${ep.id}/package`}>Prepare episode</a><a data-editor-entry data-prepared={ep.prepared ? "true" : "false"} data-episode={ep.id} hidden={!ep.recorded || ep.prepared} class="text-accent hover:underline" href={`/episodes/${ep.id}/editor`}>Open editor</a><a hidden={ep.recorded} class="text-accent hover:underline" href={`/episodes/${ep.id}/studio`}>Record</a><a class="text-text-3 hover:text-text-2" href={`/episodes/${ep.id}/studio`}>Record new session</a></div></td>
                <td class="flex items-center gap-2 text-[13px] text-text-2">
                  <Dot color={statusColor[ep.status]} />
                  {ep.status}
                </td>
                <td class="font-mono text-[12px] tabular-nums text-text-3">{ep.words}</td>
                <td class="font-mono text-[12px] tabular-nums text-text-3">{ep.sessions}</td>
                <td class="font-mono text-[12px] tabular-nums text-text-3">{ep.length}</td>
                <td class="font-mono text-[11px] text-text-3">{ep.updated}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <Pagination />
  </div>
  <ImportDialog />
</AppShell>

<script>
  import { recordingLink } from '@/lib/mobile';
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-editor-entry]')) recordingLink(link, link.dataset.episode!);
  import { listTakes } from '@/lib/audio/takes';
  import { api } from '@/lib/api';
  void listTakes().then((takes) => { for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-editor-entry]')) if (link.dataset.prepared !== 'true' && takes.some((t) => t.episodeId === link.dataset.episode && t.status === 'done')) link.hidden = false; });


  const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
  const search = document.querySelector<HTMLInputElement>('[data-search]')!;
  const pagination = document.querySelector<HTMLElement>('[data-pagination]')!;
  const pageNumbers = pagination.querySelector<HTMLElement>('[data-page-numbers]')!;
  const previous = pagination.querySelector<HTMLButtonElement>('[data-page-prev]')!;
  const next = pagination.querySelector<HTMLButtonElement>('[data-page-next]')!;
  let page = 1;
  const pageSize = 10;
  const update = () => {
    const filter = document.querySelector<HTMLInputElement>('input[name=filter]:checked')!.value;
    const q = search.value.trim().toLowerCase();
    const matches = rows.filter((row) => (filter === 'All' || row.dataset.filter === filter) && (!q || row.dataset.title!.includes(q)));
    const pages = Math.max(1, Math.ceil(matches.length / pageSize));
    page = Math.min(page, pages);
    for (const row of rows) row.hidden = !matches.includes(row) || matches.indexOf(row) < (page - 1) * pageSize || matches.indexOf(row) >= page * pageSize;
    pagination.hidden = pages <= 1;
    previous.disabled = page <= 1; next.disabled = page >= pages;
    pageNumbers.replaceChildren();
    for (let number = 1; number <= pages; number++) {
      const button = document.createElement('button');
      button.type = 'button'; button.textContent = String(number); button.dataset.slot = 'pagination-link'; button.setAttribute('aria-label', `Page ${number}`);
      button.className = 'size-9 rounded-lg border border-border text-[13px] hover:bg-control';
      if (number === page) { button.setAttribute('aria-current', 'page'); button.classList.add('bg-control'); }
      button.addEventListener('click', () => { page = number; update(); });
      pageNumbers.append(button);
    }
  };
  previous.addEventListener('click', () => { page--; update(); });
  next.addEventListener('click', () => { page++; update(); });
  document.querySelectorAll('input[name=filter]').forEach((r) => r.addEventListener('change', () => { page = 1; update(); }));
  search.addEventListener('input', () => { page = 1; update(); });
  document.querySelector<HTMLAnchorElement>('[data-open-new-episode]')?.addEventListener('click', (event) => {
    event.preventDefault();
    document.querySelector<HTMLElement>('[data-new-episode]')?.click();
  });
  document.querySelector<HTMLButtonElement>('[data-signout]')?.addEventListener('click', async () => {
    const r = await api<{ next: string }>('auth/signout', { body: {} });
    location.href = r.next;
  });
  update();
</script>
