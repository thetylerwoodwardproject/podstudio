---
// 7a · Settings: one shell, every section
import AppShell from '@/layouts/AppShell.astro';
import General from '@/components/settings/General.astro';
import Recording from '@/components/settings/Recording.astro';
import Pads from '@/components/settings/Pads.astro';
import Prompter from '@/components/settings/Prompter.astro';
import Controls from '@/components/settings/Controls.astro';
import Ai from '@/components/settings/Ai.astro';
import Security from '@/components/settings/Security.astro';
import Domain from '@/components/settings/Domain.astro';
import Server from '@/components/settings/Server.astro';
import About from '@/components/settings/About.astro';
import PrimarySidebar from '@/components/app/PrimarySidebar.astro';

const sections = [
  { key: 'general', label: 'General', view: General },
  { key: 'recording', label: 'Recording', view: Recording },
  { key: 'pads', label: 'Hotkey pads', view: Pads },
  { key: 'prompter', label: 'Prompter', view: Prompter },
  { key: 'controls', label: 'Controls', view: Controls },
  { key: 'ai', label: 'Transcription & AI', view: Ai },
  { key: 'security', label: 'Security', view: Security },
  { key: 'domain', label: 'Domain & HTTPS', view: Domain },
  { key: 'server', label: 'Server', view: Server },
  { key: 'about', label: 'About & credits', view: About },
];

export const getStaticPaths = () =>
  ['general', 'recording', 'pads', 'prompter', 'controls', 'ai', 'security', 'domain', 'server', 'about'].map((section) => ({
    params: { section },
  }));

const { section } = Astro.params;
const current = sections.find((s) => s.key === section)!;
const View = current.view;
---

<AppShell title={current.label} crumbs={[{ label: 'Settings' }]}>
  <PrimarySidebar slot="sidebar" active="settings" />
  <div class="flex min-h-full flex-col lg:flex-row">
    <nav data-settings-nav aria-label="Settings sections" class="flex gap-1 overflow-x-auto border-divider bg-nav/40 px-3 py-4 max-lg:border-b lg:sticky lg:top-0 lg:h-[calc(100dvh-56px)] lg:w-[180px] lg:flex-none lg:flex-col lg:overflow-y-auto lg:border-r">
      {
        sections.map((s) => (
          <a
            href={`/settings/${s.key}`}
            aria-current={s.key === section ? 'page' : undefined}
            class="flex h-9 flex-none items-center rounded-md px-3 text-[13px] whitespace-nowrap text-text-2 hover:bg-control hover:text-text aria-[current]:border aria-[current]:border-border aria-[current]:bg-control aria-[current]:text-text"
          >
            {s.label}
          </a>
        ))
      }
      <button type="button" class="flex h-9 flex-none items-center rounded-md px-3 text-left text-[13px] whitespace-nowrap text-text-2 hover:bg-control hover:text-text lg:hidden" data-signout>Sign out</button>
    </nav>
    <form class="min-w-0 flex-1 overflow-auto px-4 pt-10 pb-16 sm:px-6" data-settings>
      <div class="mx-auto flex w-full max-w-[720px] flex-col gap-10">
      <View />
      </div>
    </form>
    <div data-save-status-mount></div>
  </div>
</AppShell>

<script>
  import { isMobile } from '@/lib/mobile';
  if (isMobile()) document.querySelector<HTMLAnchorElement>('[data-settings-nav] a[href="/settings/pads"]')?.setAttribute('hidden', '');
  import { api } from '@/lib/api';

  const saveMount = document.querySelector<HTMLElement>('[data-save-status-mount]');
  if (saveMount)
    Promise.all([import('svelte'), import('@/components/settings/SaveStatus.svelte')]).then(([{ mount }, { default: SaveStatus }]) =>
      mount(SaveStatus, { target: saveMount }),
    );

  document.querySelectorAll<HTMLButtonElement>('[data-signout]').forEach((button) => button.addEventListener('click', async () => {
    const r = await api<{ next: string }>('auth/signout', { body: {} });
    location.href = r.next;
  }));

  // Settings save as they change (and go to the server); the button just confirms.
  const form = document.querySelector<HTMLFormElement>('[data-settings]')!;
  // The server's copy arrived and is newer than this browser's (another device changed
  // something): show it, unless you've already started changing things here.
  let touched = false;
  form.addEventListener('input', () => (touched = true));
  addEventListener('podstudio:settings', (event) => {
    if ((event as CustomEvent<{ source?: string }>).detail?.source === 'remote' && !touched) location.reload();
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = e.submitter;
    if (!btn || btn.textContent === 'Saved') return;
    const was = btn.textContent;
    btn.textContent = 'Saved';
    setTimeout(() => (btn.textContent = was), 1500);
  });
</script>
