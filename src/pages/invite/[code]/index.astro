---
// 6a · A guest opens their invite link on a laptop: how the session works, then a quick mic check.
import AppShell from '@/layouts/AppShell.astro';
import Button from '@/components/ui/Button.astro';
import Checkbox from '@/components/ui/Checkbox.astro';
import Select from '@/components/ui/Select.astro';
import StatusRow from '@/components/ui/StatusRow.astro';
import LevelMeter from '@/components/audio/LevelMeter.astro';
import { episode } from '@/data/mock';

export const getStaticPaths = () => [{ params: { code: '8f2k-q7mz' } }];

const guest = 'Dana';
const host = 'Tyler';
const steps = [
  ['Join the call', `Use the link ${host} sent for Zoom, Slack, Teams, Discord or whatever you normally use. Keep it running in another window.`],
  ['Put on headphones', 'Otherwise the call audio comes out of your speakers and gets recorded by your mic.'],
  ['Pick your mic here', 'Choose the same mic in both apps. Podstudio records it at full quality, separate from the call.'],
];
const apps = ['Zoom', 'Slack huddle', 'Teams', 'Discord', 'Google Meet', 'Phone call'];
const ok = 'var(--color-ok)';
// The design's finished state (shown with ?demo).
const checks = [
  ['Level', 'Good', ok, 'level'],
  ['Headphones', 'Confirmed', ok, 'headphones'],
  ['Call audio in mic', 'Not detected', ok, 'bleed'],
  ['Format', '24-bit · 48 kHz', undefined, 'format'],
  ['Connection to server', 'Good · 38 ms', ok, 'server'],
];
---

<AppShell title="Before you join" avatar={false} crumbs={[{ label: episode.fullTitle }]}>
  <span slot="topbar" class="text-[13px] text-muted">Invited by {host}</span>

  <form
    class="grid min-h-full lg:grid-cols-[1fr_380px]"
    id="guest-join"
    data-guest={guest}
    data-next={`/episodes/${episode.id}/prompter`}
    onsubmit="return false"
  >
    <section class="flex flex-col gap-6 border-line px-6 py-10 lg:border-r lg:px-14">
      <div>
        <div class="eyebrow">Guest · {guest}</div>
        <h1 class="mt-2 text-[28px] tracking-[-0.03em]">Before you join</h1>
        <p class="mt-2 max-w-[520px] text-[14px] leading-[1.55] text-muted">
          Podstudio records your mic on this computer and sends it to {host}’s server. You’ll talk to {host} and Sam over
          your usual call app.
        </p>
      </div>

      <ol class="flex flex-col gap-3.5">
        {
          steps.map(([title, body], i) => (
            <li class="grid grid-cols-[28px_1fr] gap-3.5">
              <span class="flex size-6.5 items-center justify-center rounded-full border border-edge-strong font-mono text-[11px] font-medium text-muted">
                {i + 1}
              </span>
              <div>
                <div class="text-[15px]">{title}</div>
                <p class="mt-1 text-[13px] leading-normal text-muted">{body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <ul class="flex flex-wrap gap-1.5" aria-label="Works with any call app">
        {apps.map((a) => <li class="flex h-6.5 items-center rounded-full bg-surface px-2.5 text-[12px] text-fg-soft">{a}</li>)}
      </ul>

      <div class="mt-auto flex items-center gap-4 rounded-xl bg-panel px-4.5 py-3.5 shadow-[inset_2px_0_0_var(--color-muted)]">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 text-[14px]">
            <span class="inline-block size-2 flex-none rounded-full bg-muted"></span>Podstudio records. It doesn’t connect calls.
          </div>
          <p class="mt-1 text-[13px] leading-normal text-muted">
            Talk to remote guests over Zoom, Slack, Teams, Discord or any call app. Podstudio records each person’s own mic
            on their own device, never the call audio.
          </p>
        </div>
      </div>
    </section>

    <aside class="flex flex-col gap-4 px-6 py-7">
      <h2 class="text-[14px] font-medium">Mic check</h2>

      <div class="flex flex-col gap-2">
        <label for="guest-mic" class="text-[12px] text-muted">Microphone</label>
        <Select id="guest-mic" options={['Rode NT-USB']} data-mic />
      </div>

      <LevelMeter segments={28} lit={19} compact />
      <div class="-mt-1 flex items-center gap-2 text-[13px]" data-live-only>
        <span class="inline-block size-2 flex-none rounded-full bg-faint" data-status-dot></span>
        <span data-status>Say something at your normal volume</span>
      </div>

      <div class="flex flex-col">
        {checks.map(([k, v, color, key]) => <StatusRow label={k!} value={v!} color={color} dense data-row={key} />)}
      </div>

      <div class="mt-auto flex flex-col gap-3 pt-2">
        <Checkbox name="ready" label="I’m on the call and wearing headphones" />
        <Button type="submit" variant="primary" size="lg" class="w-full" data-join>Join as {guest}</Button>
        <p class="text-center text-[12px] text-subtle" data-live-only data-join-hint>Tick the box above once you’re on the call.</p>
      </div>
    </aside>
  </form>
</AppShell>

<script>
  import { MicCapture, type Level } from '@/lib/audio/capture';
  import { inputChoices, sameInput } from '@/lib/audio/devices';
  import { segmentMeter, verdict } from '@/lib/audio/meter';
  import { loadSettings } from '@/lib/settings';

  const form = document.getElementById('guest-join') as HTMLFormElement;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => form.querySelector<T>(s)!;
  const demo = new URL(location.href).searchParams.has('demo');
  const warn = 'var(--color-warn)';
  const ok = 'var(--color-ok)';
  const faint = 'var(--color-faint)';

  const row = (key: string, value: string, color?: string) => {
    const el = $(`[data-row="${key}"]`);
    el.querySelector('[data-value]')!.textContent = value;
    const dot = el.querySelector<HTMLElement>('[data-dot]')!;
    dot.hidden = !color;
    if (color) dot.style.background = color;
  };

  // Headphones: the guest confirms, and that's what lets them join.
  const ready = $<HTMLInputElement>('input[name=ready]');
  const join = $<HTMLButtonElement>('[data-join]');
  const syncReady = () => {
    if (demo) return;
    join.disabled = !ready.checked;
    $('[data-join-hint]').hidden = ready.checked;
    row('headphones', ready.checked ? 'Confirmed' : 'Tick the box below', ready.checked ? ok : warn);
  };
  ready.addEventListener('change', syncReady);
  form.addEventListener('submit', () => {
    if (!ready.checked && !demo) return;
    capture?.close();
    location.href = form.dataset.next!;
  });

  let capture: MicCapture | null = null;
  if (!demo) live();

  async function live() {
    syncReady();
    // The recording format is the host's choice.
    const r = loadSettings().recording;
    row('format', `${r.depth}-bit · ${r.rate} kHz${r.channels === 2 ? ' · stereo' : ''}`);
    // Bleed from the call can only be checked against the call audio while recording.
    row('bleed', 'Checked while recording', faint);
    row('server', 'Not connected · needs the Podstudio server', warn);
    row('level', 'Say something', warn);

    // The guest's own mic choice, kept apart from the host's settings on a shared computer.
    const KEY = 'podstudio:guest-mic';
    let saved = '';
    try {
      saved = localStorage.getItem(KEY) ?? '';
    } catch {}
    capture = new MicCapture();
    const cap = capture;
    const showLevel = segmentMeter([...form.querySelectorAll<HTMLElement>('[data-seg]')]);
    const peaks: { t: number; db: number }[] = [];
    cap.addEventListener('level', (e) => {
      const { peak } = (e as CustomEvent<Level>).detail;
      showLevel(peak);
      const now = Date.now();
      peaks.push({ t: now, db: peak });
      while (peaks.length && now - peaks[0].t > 3000) peaks.shift();
    });
    setInterval(() => {
      const max = Math.min(0, Math.max(...peaks.map((p) => p.db)));
      const [text, color, grade] = !Number.isFinite(max) || max < -45 ? ['Say something at your normal volume', faint, warn] : verdict(max);
      $('[data-status]').textContent = text;
      $('[data-status-dot]').style.background = color;
      row('level', text === 'Say something at your normal volume' ? 'Say something' : text.split(' · ')[0], grade);
    }, 500);

    const select = $<HTMLSelectElement>('[data-mic]');
    async function open(value: string) {
      try {
        await cap.open({ deviceId: value, sampleRate: 48000 });
      } catch (err) {
        const denied = (err as Error).name === 'NotAllowedError';
        $('[data-status]').textContent = denied ? 'Allow the microphone in the address bar, then reload' : 'No microphone found';
        row('level', denied ? 'Microphone blocked' : 'No microphone', 'var(--color-rec)');
        return;
      }
      if (cap.ctx?.state === 'suspended') addEventListener('pointerdown', () => cap.ctx?.resume(), { once: true });
      // Names show once the browser may use the mic; each input of an interface is listed.
      const choices = await inputChoices();
      const current = choices.find((c) => sameInput(c.value, value))?.value ?? '';
      select.replaceChildren(...choices.map((c) => new Option(c.label, c.value, false, c.value === current)));
      select.value = current;
    }
    select.addEventListener('change', () => {
      try {
        localStorage.setItem(KEY, select.value);
      } catch {}
      open(select.value);
    });
    await open(saved);
  }
</script>
