---
/* First-run setup wizard: step list on the left, the current step on the right. */
import Base from './Base.astro';
import Logo from '@/components/ui/Logo.astro';
import Dot from '@/components/ui/Dot.astro';
import { server, setupSteps } from '@/data/mock';
import { version } from '../../package.json';

interface Props {
  title: string;
  /** Zero-based index of the current step */
  current: number;
}
const { title, current } = Astro.props;
---

<Base title={title}>
  <div class="grid min-h-dvh lg:grid-cols-[280px_1fr]">
    <aside class="flex flex-col gap-7 border-line px-7 py-8 max-lg:border-b lg:border-r">
      <Logo />
      <ol class="flex flex-col gap-1 max-lg:hidden">
        {
          setupSteps.map((s, i) => {
            const done = i < current;
            const on = i === current;
            return (
              <li
                class:list={['flex items-center gap-3 py-2.5 text-[14px]', on ? 'text-fg' : done ? 'text-muted' : 'text-faint']}
                aria-current={on ? 'step' : undefined}
              >
                <span
                  class:list={[
                    'flex size-5.5 flex-none items-center justify-center rounded-full border font-mono text-[11px] font-medium',
                    on ? 'border-fg text-fg' : done ? 'border-edge-strong bg-line text-muted' : 'border-edge text-subtle',
                  ]}
                >
                  {done ? '✓' : i + 1}
                </span>
                {s.label}
                {s.optional && <span class="text-[11px] text-subtle">optional</span>}
              </li>
            );
          })
        }
      </ol>
      <div class="mt-auto flex items-center gap-2 font-mono text-[11px] text-subtle max-lg:hidden">
        <Dot color="var(--color-ok)" />
        {server.localAddress} · v{version}
      </div>
    </aside>
    <main class="flex flex-col gap-7 px-6 py-10 lg:px-18 lg:py-14">
      <slot />
    </main>
  </div>
</Base>
