---
import '@/styles/global.css';
import { gateReason, readEnv } from '@/lib/gate';

interface Props {
  title: string;
  noTranslate?: boolean;
  /** Skip the Chrome-only redirect (used by the unsupported-browser page). */
  anyBrowser?: boolean;
  bodyClass?: string;
}

const { noTranslate = false, title, anyBrowser = false, bodyClass = '' } = Astro.props;
// The gate runs before the page renders, so it's inlined (see lib/gate.ts).
const gate = `(function () {
  var r = (${gateReason.toString()})((${readEnv.toString()})());
  if (r.reason !== null) location.replace('/unsupported?reason=' + r.reason + '&from=' + encodeURIComponent(location.href));
})();`;
---

<!doctype html>
<html lang="en" translate={noTranslate ? "no" : undefined}>
  <head>
    <meta charset="utf-8" />
    {noTranslate && <meta name="google" content="notranslate" />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'Podstudio' ? title : `${title} · Podstudio`}</title>
    <script is:inline>
      // ?demo shows the design's example content instead of live data (see [data-demo-only]).
      if (new URLSearchParams(location.search).has('demo')) document.documentElement.dataset.demo = '';
    </script>
    {!anyBrowser && <script is:inline set:html={gate} />}
  </head>
  <body class:list={['min-h-dvh', bodyClass]}>
    <slot />
    <script>
      import '@/lib/mock-forms';
      import '@/lib/range-fill';
      import { syncSettings } from '@/lib/settings';

      // Settings live on the server; bring this browser's copy up to date.
      syncSettings();
    </script>
  </body>
</html>
