---
import '@/styles/global.css';

interface Props {
  title: string;
  /** Skip the Chrome-only redirect (used by the unsupported-browser page). */
  anyBrowser?: boolean;
  bodyClass?: string;
}

const { title, anyBrowser = false, bodyClass = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'Podstudio' ? title : `${title} · Podstudio`}</title>
    <script is:inline>
      // ?demo shows the design's example content instead of live data (see [data-demo-only]).
      if (new URLSearchParams(location.search).has('demo')) document.documentElement.dataset.demo = '';
    </script>
    {
      !anyBrowser && (
        <script is:inline>
          // Computers and Android: Chromium only (voice follow, MediaRecorder PCM capture).
          // iPhone and iPad: every browser is WebKit. iOS 17+ with AudioWorklet and OPFS
          // records like a computer, with manual scroll (see the recording screen).
          (function () {
            const go = (reason) =>
              location.replace('/unsupported?' + (reason ? 'reason=' + reason + '&' : '') + 'from=' + encodeURIComponent(location.href));
            const brands = navigator.userAgentData && navigator.userAgentData.brands;
            const chromium = brands ? brands.some((b) => b.brand === 'Chromium') : 'chrome' in window;
            const ua = navigator.userAgent;
            const ios = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
            if (!ios) {
              if (!chromium) go();
              return;
            }
            // iPhone UAs carry "OS 17_4"; iPad desktop mode only has "Version/17.4".
            const m = ua.match(/OS (\d+)_/) || ua.match(/Version\/(\d+)/);
            const major = m ? Number(m[1]) : 0;
            const capable = 'AudioWorkletNode' in window && !!(navigator.storage && navigator.storage.getDirectory);
            if (major < 17 || !capable) go('ios-old');
          })();
        </script>
      )
    }
  </head>
  <body class:list={['min-h-dvh', bodyClass]}>
    <slot />
    <script>
      import '@/lib/mock-forms';
    </script>
  </body>
</html>
