---
/*
 * Phone screens (join, 2FA, prompter, producer remote). Full-bleed on a
 * phone; on a larger screen the column is centered at phone width.
 */
import Base from './Base.astro';
interface Props {
  title: string;
  /** Prompter screens use pure black */
  black?: boolean;
}
const { title, black = false } = Astro.props;
---

<Base title={title} bodyClass={black ? 'bg-void!' : ''}>
  <div
    class:list={[
      'mx-auto flex h-dvh max-w-[430px] flex-col overflow-hidden pt-[env(safe-area-inset-top)] text-fg',
      black ? 'bg-void' : 'bg-ink',
    ]}
  >
    <slot />
  </div>
</Base>
