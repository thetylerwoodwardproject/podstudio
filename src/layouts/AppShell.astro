---
/* Desktop app frame: top bar with breadcrumbs, then a full-height work area. */
import Base from './Base.astro';
import TopBar, { type Crumb } from '@/components/app/TopBar.astro';

interface Props {
  title: string;
  crumbs: Crumb[];
  avatar?: boolean;
  /** Skip the browser check (pages that don't record) */
  anyBrowser?: boolean;
}
const { title, crumbs, avatar, anyBrowser } = Astro.props;
---

<Base title={title} anyBrowser={anyBrowser}>
  <div class="flex h-dvh flex-col">
    <TopBar crumbs={crumbs} avatar={avatar}>
      <slot name="topbar-center" slot="center" />
      <slot name="topbar" />
    </TopBar>
    <main class="min-h-0 flex-1 overflow-auto">
      <slot />
    </main>
  </div>
</Base>
