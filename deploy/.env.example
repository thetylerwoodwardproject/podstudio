# Copy to deploy/.env (gitignored) and fill in real values before `docker compose up`.
# BETTER_AUTH_SECRET: generate with `openssl rand -hex 32`. Never reuse across environments.
BETTER_AUTH_SECRET=
# The password for the single seeded admin account (tyler@fullymodulated.com).
# Only used once, on first boot against an empty database — changing it later
# does nothing (there's no "change password" flow yet; that needs Stage 01's
# full scope / email delivery).
PODSTUDIO_ADMIN_PASSWORD=
# MinIO root credentials (the local S3-compatible storage service). Generate the
# password with `openssl rand -hex 24`. Enter the same values (or a scoped
# key) in Studio -> Storage; they are stored in the DB, not read from here.
MINIO_ROOT_USER=podstudio
MINIO_ROOT_PASSWORD=
